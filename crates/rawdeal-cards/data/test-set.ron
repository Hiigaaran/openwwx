// Invented cards for exercising the engine. They are not Raw Deal cards;
// the real card database is loaded from the player's own files.
(
    name: "OpenWWX test set",
    superstars: [
        (id: "test/brawler", name: "The Brawler", hand_size: 6, superstar_value: 3,
         text: "No ability yet."),
        (id: "test/technician", name: "The Technician", hand_size: 5, superstar_value: 4,
         text: "Once during your turn, you may discard 1 card to make your opponent discard 1 card at random.",
         abilities: [Activated(cost: [Discard(who: You, n: 1, pick: Chosen)],
                               effects: [Discard(who: Opponent, n: 1, pick: Random)])]),
        (id: "test/veteran", name: "The Veteran", hand_size: 5, superstar_value: 2,
         text: "At the start of your turn, before you draw, you may put 1 card from your Ringside pile on the bottom of your Arsenal.",
         abilities: [StartOfTurn([Optional([RingsideToArsenalBottom(who: You, n: 1)])])]),
        (id: "test/hardcore", name: "The Hardcore Legend", hand_size: 4, superstar_value: 1,
         text: "Draw 2 cards in your Draw Segment. Damage from your opponent's cards is reduced by 1.",
         abilities: [DrawSegment(2), ReduceDamage(1)]),
        (id: "test/high-flyer", name: "The High Flyer", hand_size: 6, superstar_value: 2, female: true,
         text: "No ability. Cannot play Multi maneuvers."),
    ],
    cards: [
        // Maneuvers
        (id: "test/jab", title: "Jab", kinds: [Maneuver(Strike)], fortitude: 0, damage: 2, stun_value: 1),
        (id: "test/haymaker", title: "Haymaker", kinds: [Maneuver(Strike)], fortitude: 3, damage: 4, stun_value: 2),
        (id: "test/body-slam", title: "Body Slam", kinds: [Maneuver(Grapple)], fortitude: 0, damage: 3, stun_value: 1),
        (id: "test/suplex", title: "Suplex", kinds: [Maneuver(Grapple)], fortitude: 4, damage: 5, stun_value: 2),
        (id: "test/arm-lock", title: "Arm Lock", kinds: [Maneuver(Submission)], fortitude: 2, damage: 3, stun_value: 1),
        (id: "test/diving-elbow", title: "Diving Elbow", kinds: [Maneuver(HighRisk)], fortitude: 6, damage: 6, stun_value: 3),
        (id: "test/power-bomb", title: "Power Bomb", kinds: [Maneuver(Grapple)], fortitude: 10, damage: 8, stun_value: 4,
         text: "Opponent discards 1 card at random.",
         script: (on_play: [Discard(who: Opponent, n: 1, pick: Random)])),
        (id: "test/lock-up", title: "Lock Up", kinds: [Maneuver(Grapple)], fortitude: 0, damage: 1, traits: [SetUp]),

        // Actions
        (id: "test/catch-breath", title: "Catch Your Breath", kinds: [Action], fortitude: 0, damage: 0,
         text: "Draw 1 card.",
         script: (on_play: [Draw(who: You, n: 1)])),
        (id: "test/second-wind", title: "Second Wind", kinds: [Action], fortitude: 2, damage: 0,
         text: "Discard 1 card. Then put 1 card from your Ringside pile into your hand.",
         script: (on_play: [Discard(who: You, n: 1, pick: Chosen), RingsideToHand(who: You, n: 1)])),
        (id: "test/regroup", title: "Regroup", kinds: [Action], fortitude: 0, damage: 0,
         text: "You may shuffle 2 cards from your Ringside pile into your Arsenal.",
         script: (on_play: [Optional([RingsideToArsenal(who: You, n: 2)])])),

        (id: "test/follow-through", title: "Follow Through", kinds: [Maneuver(Strike)], fortitude: 0, damage: 3, stun_value: 1,
         text: "May only be played right after a Grapple maneuver that did 3D or more.",
         script: (play_after: Some(All([ManeuverType(Grapple), DamageAtLeast(3)])))),
        (id: "test/crowd-support", title: "Crowd Support", kinds: [Action], fortitude: 0, damage: 1, traits: [Active],
         text: "Active. Draw 1 card.",
         script: (on_play: [Draw(who: You, n: 1)])),
        (id: "test/title-belt", title: "Test Championship", kinds: [Action], fortitude: 4, damage: 2, traits: [UniversallyUnique],
         text: "Universally Unique."),

        (id: "test/double-team", title: "Double Team", kinds: [Maneuver(Grapple)], fortitude: 2, damage: 4, stun_value: 2,
         traits: [Multi], text: "Multi."),
        (id: "test/chain-punch", title: "Chain Punch", kinds: [Maneuver(Strike)], fortitude: 0, damage: 2, stun_value: 1,
         traits: [Chain], text: "Chain."),
        (id: "test/chain-kick", title: "Chain Kick", kinds: [Maneuver(Strike)], fortitude: 2, damage: 3, stun_value: 1,
         traits: [Chain], text: "Chain."),

        // Reversals
        (id: "test/block", title: "Block", kinds: [Reversal], fortitude: 0, damage: 0,
         text: "Reverse any Strike maneuver.",
         script: (reverses: Some((targets: ManeuverType(Strike))))),
        (id: "test/counter-hold", title: "Counter Hold", kinds: [Reversal], fortitude: 2, damage: 2,
         text: "Reverse any Grapple maneuver.",
         script: (reverses: Some((targets: ManeuverType(Grapple))))),
        (id: "test/escape", title: "Escape", kinds: [Reversal], fortitude: 3, damage: 0,
         text: "Reverse any Submission maneuver. Draw 1 card.",
         script: (reverses: Some((targets: ManeuverType(Submission), on_reverse: [Draw(who: You, n: 1)])))),
        (id: "test/duck", title: "Duck", kinds: [Reversal], fortitude: 5, damage: 0,
         text: "Reverse any maneuver that does 5D or less.",
         script: (reverses: Some((targets: All([Maneuver, DamageAtMost(5)]))))),
        (id: "test/no-chance", title: "Not A Chance", kinds: [Reversal], fortitude: 1, damage: 0,
         text: "Reverse any action.",
         script: (reverses: Some((targets: Action)))),

        (id: "test/sprawl", title: "Sprawl", kinds: [Reversal], fortitude: 0, damage: 0,
         text: "Reverse any Grapple maneuver.",
         script: (reverses: Some((targets: ManeuverType(Grapple))))),

        // Hybrid: Strike maneuver or a Reversal against Strikes.
        (id: "test/shove", title: "Shove", kinds: [Maneuver(Strike), Reversal], fortitude: 1, damage: 2, stun_value: 1,
         text: "Reverse any Strike maneuver.",
         script: (reverses: Some((targets: ManeuverType(Strike))))),

        // Backlash: Pre-match cards
        (id: "test/arena", title: "Test Arena", kinds: [PreMatch(Venue)], fortitude: 0, damage: 0,
         text: "Venue. At the end of Pre-match, draw 1 card.",
         script: (end_of_prematch: [Draw(who: You, n: 1)])),
        (id: "test/bad-blood", title: "Bad Blood", kinds: [PreMatch(Feud)], fortitude: 0, damage: 0,
         text: "Feud. At the end of Pre-match, your opponent takes 1 damage.",
         script: (end_of_prematch: [Damage(who: Opponent, n: 1)])),
        (id: "test/no-dq", title: "No Disqualification", kinds: [PreMatch(Stipulation)], fortitude: 0, damage: 0,
         text: "Stipulation."),
        (id: "test/manager", title: "Loudmouth Manager", kinds: [PreMatch(Manager)], fortitude: 0, damage: 0,
         text: "Manager. When played, your opponent discards 1 card at random.",
         script: (on_play: [Discard(who: Opponent, n: 1, pick: Random)])),
        (id: "test/ppv", title: "Pay-Per-View Main Event", kinds: [PreMatch(Event)], fortitude: 0, damage: 0,
         traits: [PayPerView], text: "Pay-Per-View Event."),
        (id: "test/pyro", title: "Pyro", kinds: [PreMatch(Event)], fortitude: 0, damage: 0,
         text: "Event. At the end of Pre-match, draw 1 card.",
         script: (end_of_prematch: [Draw(who: You, n: 1)])),
        (id: "test/chair", title: "Steel Chair", kinds: [PreMatch(Object)], fortitude: 0, damage: 0,
         text: "Object."),

        // Backlash: Mid-match cards
        (id: "test/ladder-spot", title: "Ladder Spot", kinds: [Maneuver(HighRisk)], fortitude: 0, damage: 3, stun_value: 1,
         traits: [MidMatch], text: "Mid-match."),
        (id: "test/ref-distraction", title: "Ref Distraction", kinds: [Reversal], fortitude: 0, damage: 0,
         traits: [MidMatch], text: "Mid-match. Reverse any maneuver.",
         script: (reverses: Some((targets: Maneuver)))),
    ],
)
