        ),
        "Juke 'N' Jive": (irreversible: true, on_play: [Mill(who: You, n: 2), Mill(who: Opponent, n: 8)]),
        "Let's Make Some Noise ...": (requires: Some(Never)),

        // X-Pac
        "X-Factor": (reverses: Some((targets: ManeuverType(HighRisk)))),
        "Leaping Spin Kick": (reverses: Some((targets: ManeuverType(Grapple)))),
        "Bronco Buster": (
            play_after: Some(Title("Throw Into the Corner Turnbuckle")),
            on_play: [Discard(who: Opponent, n: 3, pick: Chosen)],
