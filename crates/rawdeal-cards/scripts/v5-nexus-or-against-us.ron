// Hand-written scripts for V5: Nexus Or Against Us cards (Raw Deal Virtual set 31), merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// The set has two different cards titled "Dream Street"; the importer names the second one (Priceless / The
// Legacy logos) "Dream Street (The Legacy)".
// Skipped by the importer: Old School Raw ("Pre-match Event/Mid-match Reversal: Special" without spaces), The Good
// R-Truth or... The Bad R-Truth? (Little Jimmy Deck) and Rude's Changing Alliances (Allegiance Deck).
(
    abilities: {
        // Hiding and revealing other Superstar cards and the Corner/Manager packing rules are not supported yet.
        "The Nexus": [CannotPackTrait(Face)],
        // Approximation: the opponent draws 1 card at the end of this turn. "Your Chain cards are not Chain" is not
        // supported yet.
        "New Nexus": [
            Activated(
                requires: Some(CountAtLeast(count: YourArsenalSize, n: 3)),
                cost: [Mill(who: You, n: 3)],
                effects: [Discard(who: Opponent, n: 3, pick: Chosen), AtEndOfTurn([Draw(who: Opponent, n: 1)])],
            ),
            PacksLogos(["CM Punk"]),
            CannotPack("Thrust Knee Lift"),
            CannotPackTrait(SetUp),
        ],
        // Maneuvers in the Backstage Area are not supported yet.
        "The Corre": [],
        // The Strikes are Chain during your turns.
        "Wade Barrett": [
            StartOfTurn([
                Boost((
                    applies_to: All([
                        ManeuverType(Strike),
                        Not(TitleContains("kick")),
                        Not(Hybrid),
                        Not(Trait(Multi)),
                        Not(Keyword("Foreign Object")),
                    ]),
                    duration: ThisTurn,
                    chain: true,
                )),
            ]),
            FortitudeFor(
                filter: All([
                    ManeuverType(Strike),
                    Not(TitleContains("kick")),
                    Not(Hybrid),
                    Not(Trait(Multi)),
                    Not(Keyword("Foreign Object")),
                ]),
                delta: -3,
            ),
        ],
        // Approximation: the 2 cards are discarded at the end of each of your turns instead of put on the bottom of
        // the Arsenal (with the bottom, random matches against Revolution Sabu never ended).
        "David Otunga": [DrawSegment(3), StartOfTurn([AtEndOfTurn([Discard(who: You, n: 2, pick: Chosen)])])],
        // Changing '#D' texts to '0D' is not supported yet.
        "Justin Gabriel": [
            OnPlayMatching(filter: ManeuverType(HighRisk), effects: [MoveCards(who: You, from: Removed, to: Arsenal, n: 1, up_to: true)]),
        ],
        // The reversal restriction on the first Action is not supported yet.
        "Heath Slater": [FortitudeFor(filter: Antic, delta: -3)],
        // Approximation: after the random Backlash discard you always draw up to 2 cards (the discarded card's type
        // is not checked).
        "Darren Young": [
            OnPlayMatching(
                filter: Maneuver,
                effects: [Discard(who: You, n: 1, pick: Chosen), BacklashToRingside(who: Opponent, n: 1, random: true), DrawUpTo(who: You, n: 2)],
            ),
        ],
        // Approximation: the other 4 cards go to the bottom of the Arsenal and the found card can be any card.
        "Skip Sheffield": [
            Activated(requires: Some(InYourRing(Any)), cost: [RemoveFromGame(who: You, from: Ring, n: 1)], effects: [Dig(n: 5, take: 1)]),
        ],
        // Approximation: the Fortitude limit on the searched card is not checked.
        "Michael Tarver": [
            OnPlayMatching(
                filter: TitleContains("punch"),
                effects: [Optional([Draw(who: You, n: 1), Discard(who: Opponent, n: 1, pick: Chosen)])],
            ),
            OnOpponentReverses([
                If(
                    condition: OpponentReversed(TitleContains("punch")),
                    effects: [Search(filter: All([TitleContains("punch"), Not(Trait(Unique))]))],
                ),
            ]),
        ],
        // Choosing instead of random discards is not supported yet.
        "Alberto Del Rio": [CannotPack("Man of 1,000 Holds")],
        // Approximation: "3 different maneuver types" is read as a Strike, a Grapple and a Submission. Reversing by
        // removing Ringside cards is not supported yet.
        "Daniel Bryan": [
            OnPlayMatching(
                filter: All([
                    Maneuver,
                    Holds(All([
                        InYourRing(ManeuverType(Strike)),
                        InYourRing(ManeuverType(Grapple)),
                        InYourRing(ManeuverType(Submission)),
                    ])),
                ]),
                effects: [Choice([[RingsideToArsenalBottom(who: You, n: 1)], [Draw(who: You, n: 1)]])],
            ),
        ],
        // Drawing after discards and the Clumsy Opponent text are not supported yet.
        "Mark Henry": [CannotPackMatching(All([ManeuverType(HighRisk), Not(TitleContains("splash"))]))],
        // Pump Kick and playing maneuvers from the Backstage Area are not supported yet.
        "Sheamus": [],
        // Approximation: the same maneuver type is not checked. Searching the opponent's Arsenal by title is not
        // supported yet.
        "The Miz": [
            OnOpponentReverses([Optional([Discard(who: You, n: 2, pick: Chosen), Search(filter: All([Maneuver, Not(Trait(Unique))]))])]),
        ],
        // Revealing and comparing card types is not supported yet.
        "Cody Rhodes": [],
        // Replacing draws and the Starting Hand Size bonus are not supported yet.
        "Dolph Ziggler": [],
        // Replacing removals from the game and the 'can only be reversed' packing rule are not supported yet.
        "John Morrison": [],
        // Making a maneuver Unique and the Little Jimmy Deck are not supported yet.
        "R-Truth": [CannotPackTrait(Face), CannotPackTrait(Heel), CannotPack("There Is No Escape")],
        "Ted DiBiase": [
            Activated(
                requires: Some(CountAtLeast(count: YourRingsideMatching(Keyword("Throwback")), n: 1)),
                cost: [RemoveFromGame(who: You, from: Ringside, n: 1)],
                effects: [RingsideToArsenal(who: You, n: 1, filter: Some(Keyword("Throwback")))],
            ),
            OnPlayMatching(filter: All([Maneuver, Keyword("Throwback")]), effects: [DrawUpTo(who: You, n: 1)]),
        ],
        // The low-Fortitude ability is not supported yet.
        "Ezekiel Jackson": [
            FortitudeFor(filter: All([Maneuver, Holds(FortitudeAboveOpponent)]), delta: -3),
            DamageFor(filter: All([Maneuver, Holds(FortitudeAboveOpponent)]), delta: 3),
            CannotPackMatching(AnyOf([ManeuverType(Submission), ManeuverType(HighRisk), All([Action, Not(Hybrid)])])),
        ],
        // Activated Card Effects are not supported yet.
        "Zack Ryder": [],
        // Approximation: you choose 1 card of his revealed hand; naming a card and the restriction are not supported.
        "Michael Cole": [
            Activated(
                cost: [Discard(who: You, n: 2, pick: Chosen)],
                effects: [RevealHand(who: Opponent), Discard(who: Opponent, n: 1, pick: Controller)],
            ),
            CannotPack("Steel Chain Shot"),
        ],
        // Playing Actions during the opponent's turn is not supported yet.
        "Vickie Guerrero": [
            RevealEnforcers(Title("Dolph Ziggler, Chavo Guerrero, or...The Leader of the Edge Army?")),
            OpponentCannotPlay("Vickie Guerrero Interferes"),
            OpponentCannotPlay("Vickie's Slap"),
            OpponentCannotPlay("Vickie's Scream"),
            OpponentCannotPlay("Managed by Vickie Guerrero"),
            CannotPackMatching(AnyOf([Keyword("ECW"), Keyword("nWo")])),
        ],
        // Approximation: the F: 0 on the first Action is not supported; the packing rules are not supported.
        "The Great One": [
            FirstOfTurnIrreversible(All([Action, SuperstarSpecific, Not(Trait(MidMatch))])),
            FortitudeFor(filter: All([Maneuver, AnyOf([TitleContains("Sharpshooter"), TitleContains("Spine Buster")])]), delta: -60),
        ],
        // The Wrestlemania texts are not supported yet.
        "The Last Outlaw": [],
        // Stopping the opponent from continuing his turn is not supported yet.
        "The Texas Rattlesnake": [
            Activated(
                cost: [],
                effects: [
                    Draw(who: You, n: 1),
                    Draw(who: Opponent, n: 1),
                    If(condition: CountBelow(a: HandSize, b: OpponentHandSize), effects: [Discard(who: Opponent, n: 2, pick: Chosen)]),
                    If(condition: Not(CountBelow(a: HandSize, b: OpponentHandSize)), effects: [Discard(who: Opponent, n: 1, pick: Chosen)]),
                ],
            ),
        ],
        // The Leaping Knee to the Face text and the packing rules are not supported yet.
        "The King of Kings": [
            Activated(
                cost: [Mill(who: You, n: 3)],
                effects: [RingsideToArsenal(who: You, n: 1), Search(filter: All([Maneuver, SuperstarSpecific]))],
            ),
        ],
        // Permanent and the Heat text are not supported yet.
        "The Showstopper": [
            EndOfPrematch([MoveCards(who: You, from: Arsenal, to: Ring, n: 1, filter: Some(Title("The Legend Lives On")))]),
            CannotPackMatching(All([Maneuver, Keyword("Foreign Object")])),
            CannotPack("A Quick BASH-ing"),
        ],
        // Approximation: the Fortitude Rating and damage bonuses are not supported.
        "Mick Foley": [
            Activated(
                requires: Some(CountAtLeast(count: YourRingMatching(TitleContains("cheap")), n: 3)),
                cost: [MoveCards(who: You, from: Ring, to: Arsenal, n: 3, filter: Some(TitleContains("cheap")))],
                effects: [RemoveFromRing(who: Opponent, n: 1, filter: Any)],
            ),
            CannotPack("You Talkin' To Me?"),
        ],
        // Feud cards as Events and playing from Ringside are not supported yet.
        "The Second Coming": [CannotPack("Back to Basics"), CannotPack("First Of All")],
        // The Embrace the Hate ability and the discard limit are not supported yet.
        "The Devil's Favorite Demon": [CannotPack("Tonight I Unleash Hell")],
        // Approximation: applies whenever the opponent reverses one of your cards.
        "The Rock and Sock Connection": [OnOpponentReverses([Choice([[Draw(who: You, n: 1)], [RingsideToArsenalBottom(who: You, n: 1)]])])],
        // Approximation: Table! Table! Table! comes from the Arsenal only; the other texts are not supported.
        "The Dudley Family": [
            OnPlayMatching(
                filter: Maneuver,
                effects: [MoveCards(who: You, from: Arsenal, to: Ring, n: 1, filter: Some(All([Title("Table! Table! Table!"), Not(Trait(Unique))])))],
            ),
        ],
        // Counting the words in a title is not supported yet.
        "Scotty 2 Hotty": [],
        // Counting the words in a title is not supported yet.
        "Too Cool": [],
        // The Backlash blanking ability is not supported yet.
        "Lay-Cool": [
            Activated(
                requires: Some(HandHas(All([Maneuver, DamageAtLeast(8)]))),
                cost: [DiscardMatching(who: You, n: 1, filter: All([Maneuver, DamageAtLeast(8)]), pick: Chosen)],
                effects: [Search(filter: All([Maneuver, Not(Hybrid), DamageAtMost(7)]))],
            ),
            OpponentCannotPlay("A McCool Boot"),
            OpponentCannotPlay("The Lay-Out"),
            CannotPackTrait(SetUp),
        ],
        // Approximation: the top card of the Arsenal stands for the random card.
        "Eve": [
            Activated(
                cost: [],
                effects: [Choice([[MoveCards(who: You, from: Arsenal, to: Hand, n: 1)], [Draw(who: You, n: 1), HandToArsenalTop(who: You, n: 1)]]), Shuffle(who: You)],
            ),
            OpponentCannotPlay("Eve: Dirty Dancer"),
        ],
        // Playing with the top card revealed is not supported yet.
        "Maryse": [CannotPackTrait(SetUp), CannotPackMatching(All([ManeuverType(Grapple), DamageAtLeast(4)]))],
        // Making her cards not Raw is not supported yet. The +1D per face-down card applies during your turns.
        "Molly Holly": [
            CannotPack("Deadly Diva Duo"),
            CannotPack("Evening Gown Match"),
            CannotPack("Skirt vs Skirt Match"),
            StartOfTurn([
                Boost((
                    applies_to: AnyOf([ManeuverType(Submission), Keyword("Hold")]),
                    duration: ThisTurn,
                    damage: 1,
                    count: Some(YourFaceDown),
                )),
            ]),
        ],
    },
    scripts: {
        // ---------------------------------------------------------------- Strikes
        "Eat Your Words": (
            bonuses: [(count: Some(OpponentRingMatching(Action)), damage: 2)],
            reversal_limits: [(from: [Hand, Backlash, Ringside, Ring, Under], when: CountAtLeast(count: OpponentRingMatching(Action), n: 5))],
        ),
        // Approximation: drawing replaces taking the bottom card of the Arsenal. "Reversed as if non-Unique" and
        // the search rule are not supported yet.
        "Classic Boxing Jab": (
            on_play: [
                Draw(who: You, n: 1),
                If(condition: Superstar("Michael Tarver"), effects: [BacklashToRingside(who: Opponent, n: 1, random: true)]),
            ],
        ),
        // Classic Competitor in the Backstage Area also lets you choose.
        "Classic Back Kick": (
            on_play: [
                If(
                    condition: AnyOf([Superstar("Tajiri"), BackstageRevealed(who: You, filter: Title("Classic Competitor"))]),
                    effects: [Discard(who: You, n: 1, pick: Chosen)],
                ),
                If(
                    condition: Not(AnyOf([Superstar("Tajiri"), BackstageRevealed(who: You, filter: Title("Classic Competitor"))])),
                    effects: [Discard(who: You, n: 1, pick: Random)],
                ),
                Discard(who: Opponent, n: 1, pick: Random),
            ],
        ),
        // Approximation: the discards lower the F; the +1D for each is not added.
        "Classic Lariat": (fortitude_discount: Some((per: 1, max: 5))),
        // "Its Fortitude cannot be increased or decreased" is not supported yet.
        "Classic Clothesline": (),
        "Classic Arm Drag": (on_play: [Draw(who: You, n: 1), Draw(who: Opponent, n: 1)]),
        // Counting as played after Throw Opponent Out of the Ring is not supported yet.
        "Classic Toss Out of the Ring": (on_play: [Draw(who: You, n: 1)]),
        "Classic Leg Work": (bonuses: [(when: After(TitleContains("classic")), fortitude: -4)]),
        // Approximation: the damage is not reduced to 0; the found card cannot be reversed if played next.
        "Classic Body Slam": (
            on_play: [
                Optional([
                    Search(filter: AnyOf([Title("From the Top Rope"), Title("From the Middle Turnbuckle")])),
                    Boost((
                        applies_to: AnyOf([Title("From the Top Rope"), Title("From the Middle Turnbuckle")]),
                        duration: NextCard,
                        irreversible: true,
                    )),
                ]),
            ],
        ),
        // "Reversed as if non-Unique" is not supported yet.
        "Classic Power Slam": (multi_when: Some(After(AnyOf([Title("Irish Whip"), Title("Throw Into the Corner Turnbuckle")])))),
        // "You cannot play Maintain Hold after this card" is not enforced.
        "Classic Neck Wrench": (
            on_play: [Discard(who: Opponent, n: 1, pick: Chosen), RemoveFromGame(who: Opponent, from: Arsenal, n: 1)],
        ),
        // The +1 Stun Value is not supported yet.
        "Classic Sleeper Hold": (
            bonuses: [
                (
                    when: AnyOf([Superstar("Rowdy Roddy Piper"), Superstar("The Rowdy One"), Superstar("Brutus 'The Barber' Beefcake")]),
                    fortitude: -2,
                ),
            ],
        ),
        "Classic Double Axe Handle": (
            play_after: Some(All([Maneuver, DamageAtLeast(2)])),
            on_play: [RingsideToArsenal(who: You, n: 2, up_to: true)],
        ),
        "Classic Elbow Drop": (
            play_after: Some(All([Maneuver, DamageAtLeast(2)])),
            reversal_limits: [(from: [Backlash, Ringside, Ring, Under], when: After(Title("From the Top Rope")))],
        ),
        // ---------------------------------------------------------------- Reversals and Actions (general)
        // The reversed maneuver going to the opponent's hand and the Ring effects are not supported yet.
        "Back Flip": (
            reverses: Some((
                targets: All([Maneuver, Not(Trait(Unique))]),
                from_hand_only: true,
                requires: Some(AnyOf([Superstar("Carlito"), Superstar("Daniel Bryan"), InYourRing(Title("High-Flying Style"))])),
            )),
        ),
        // Reversal restrictions from cards and Allegiances are not supported yet.
        "A Great Deal of Confusion": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // "Allegiance: None" and the Allegiance cost change are not supported yet.
        "I Stand Alone": (
            not_packed_by: ["Rick Rude"],
            reverses: Some((
                targets: All([Maneuver, Not(Trait(Unique))]),
                from_hand_only: true,
                on_reverse: [If(condition: Superstar("Batista"), effects: [Draw(who: You, n: 1)])],
            )),
        ),
        // Approximation: Allegiance requirements are read as being that Superstar trait or having such a card in
        // your Ring.
        "Building Classic Momentum": (
            requires: Some(AnyOf([YouAre("WWF"), InYourRing(Keyword("WWF Classic"))])),
            play_after: Some(Maneuver),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            not_reversed_by: Some(Not(Trait(Unique))),
            on_play: [
                Boost((
                    applies_to: All([Maneuver, TitleContains("Classic")]),
                    duration: NextCard,
                    damage: 5,
                    ignore_play_after: true,
                    no_hand_reversal: true,
                )),
            ],
        ),
        // Approximation: the draw happens only when reversed from hand. The Overrated Superstar text is not supported.
        "Deflating Your Ego": (
            on_reversed_from_hand: [DrawUpTo(who: You, n: 2)],
            on_play: [BoostOpponent((applies_to: FortitudeAtLeast(1), duration: NextTurn, fortitude: 10))],
        ),
        // Revealing cards from hand after damage is not supported yet.
        "E-C-DUB! E-C-DUB!": (requires: Some(Never)),
        // Approximation: "Revolution or with a reversal restriction" is read as Core, Mean or Colossal. Reversing card
        // effects is not supported yet.
        "Don't Be a Douchebag!": (
            irreversible_when: Some(FortitudeBelowOpponent),
            as_action: Some((on_play: [RingsideToArsenal(who: You, n: 2, up_to: true)])),
            reverses: Some((
                targets: All([Maneuver, Not(Trait(Unique)), AnyOf([Trait(Core), Trait(Mean), Trait(Colossal)])]),
                effects: [Choice([[Draw(who: You, n: 1)], [Discard(who: Opponent, n: 1, pick: Chosen)]])],
            )),
        ),
        "Stand Up For WWE!": (
            requires: Some(AnyOf([YouAre("WWE"), InYourRing(Keyword("WWE"))])),
            irreversible_when: Some(FortitudeBelowOpponent),
            as_action: Some((on_play: [RingsideToArsenal(who: You, n: 4, up_to: true), Draw(who: You, n: 1)])),
            reverses: Some((targets: AnyOf([Keyword("ECW"), Keyword("nWo"), Keyword("WCW")]))),
        ),
        // F: 0 for Justin Gabriel or Michael Tarver applies to the reversal only.
        "Youthful Agility": (
            only_packed_by: ["NXT"],
            as_action: Some((on_play: [RingsideToArsenal(who: You, n: 3, up_to: true)])),
            reverses: Some((
                targets: AnyOf([ManeuverType(Strike), ManeuverType(Grapple), ManeuverType(Submission)]),
                effects: [DrawUpTo(who: You, n: 1)],
                fortitude_when: Some((AnyOf([Superstar("Justin Gabriel"), Superstar("Michael Tarver")]), 0)),
            )),
        ),
        // Approximation: the "lower Fortitude" requirement always applies; the packing exceptions are not supported.
        "Legendary Ruthlessness": (
            only_packed_by: ["Legend"],
            reverses: Some((
                targets: Not(Maneuver),
                requires: Some(FortitudeBelowOpponent),
                effects: [RingsideToArsenal(who: You, n: 2, up_to: true)],
            )),
        ),
        // Approximation: as a reversal it reverses any card when overturned; reversing card effects, playing it next
        // turn and the "Can only be reversed from Arsenal" change are not supported.
        "Out of Nowhere": (
            as_action: Some((
                on_play: [
                    Search(filter: ManeuverType(TrademarkFinisher), ringside: true),
                    Boost((
                        applies_to: ManeuverType(TrademarkFinisher),
                        duration: NextCard,
                        fortitude: -40,
                        ignore_play_after: true,
                    )),
                ],
            )),
            reverses: Some((
                targets: Any,
                fortitude: Some(0),
                overturned_only: true,
                requires: Some(CountAtMost(count: YourArsenalSize, n: 15)),
            )),
        ),
        "No Class, No Taste, No Shirt, $#!t Faced!": (
            requires: Some(AnyOf([YouAre("Raw"), InYourRing(Trait(Raw))])),
            on_play: [
                Boost((applies_to: Title("The Sex, the Gods, the Freaks, the Frauds."), duration: NextCard, irreversible: true)),
            ],
        ),
        // Approximation: "blank F: 0" is read as F: 0. Removing Pre-match cards to draw is not supported yet.
        "All I've Got Left is My Pride": (
            requires: Some(All([AnyOf([YouAre("SmackDown"), InYourRing(Trait(SmackDown))]), FortitudeBelowOpponent])),
            on_play: [
                MoveCards(
                    who: You,
                    from: Arsenal,
                    to: Ring,
                    n: 1,
                    filter: Some(AnyOf([All([Maneuver, FortitudeAtMost(0)]), All([Maneuver, FortitudeAtMost(2), Trait(SmackDown)])])),
                ),
            ],
        ),
        // The ACE (stopping an opponent's Arsenal search) is not supported yet.
        "Eve: Dirty Dancer": (
            not_packed_by: ["The Godfather", "The Home Team"],
            on_play: [Optional([Mill(who: You, n: 3), RingsideToArsenal(who: You, n: 6, up_to: true)])],
        ),
        // Approximation: "any number" is up to 3. Revealing the top card of the Arsenal is not supported yet.
        "Maryse: Femme Fatale": (
            not_packed_by: ["The Godfather"],
            on_play: [
                Choice([
                    [],
                    [Discard(who: You, n: 1, pick: Chosen), Mill(who: Opponent, n: 1)],
                    [Discard(who: You, n: 2, pick: Chosen), Mill(who: Opponent, n: 2)],
                    [Discard(who: You, n: 3, pick: Chosen), Mill(who: Opponent, n: 3)],
                ]),
            ],
        ),
        "I Will Rise Up!": (
            requires: Some(AnyOf([YouAre("SmackDown"), InYourRing(Trait(SmackDown))])),
            on_play: [
                RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Maneuver, Trait(SmackDown)]))),
                Boost((applies_to: TitleContains("Break It Out"), duration: NextCard, irreversible: true)),
            ],
        ),
        // Approximation: the Backlash pick, discarding down to 2 cards, the reversal restriction and the pinfall
        // win are not supported; the next TMF cannot be reversed.
        "No Fear, No Doubt, All In, Balls Out!": (
            requires: Some(AnyOf([YouAre("Raw"), InYourRing(Trait(Raw))])),
            on_play: [
                LookAtHand(who: Opponent),
                DiscardMatching(who: Opponent, n: 1, filter: Not(SuperstarSpecific), pick: Controller),
                Boost((applies_to: ManeuverType(TrademarkFinisher), duration: NextCard, irreversible: true)),
            ],
        ),
        // The -20F for removing Divine Intervention is not supported yet.
        "McMahon Intervention": (
            requires: Some(AnyOf([YouAre("McMahonism"), InYourRing(Keyword("McMahonism"))])),
            irreversible: true,
            on_play: [Draw(who: You, n: 12), HandToArsenalBottom(who: You, n: 8), RingsideToArsenalBottom(who: You, n: 8)],
        ),
        // ---------------------------------------------------------------- Pre-match (general)
        "Diva Bikini Contest": (),
        // Approximation: the random card is chosen; removing this card when both hands are 7 is not supported.
        "Evening Up the Odds": (
            not_packed_by: ["Ric Flair", "Stable"],
            in_ring_start_of_turn: [
                If(condition: CountAtLeast(count: HandSize, n: 8), effects: [HandToArsenal(who: You, n: 1)]),
                If(condition: CountAtLeast(count: HandSize, n: 15), effects: [HandToArsenal(who: You, n: 1)]),
                If(condition: CountAtMost(count: HandSize, n: 6), effects: [Optional([Draw(who: You, n: 1)])]),
            ],
            in_ring_opponent_start_of_turn: [
                If(condition: CountAtLeast(count: HandSize, n: 8), effects: [HandToArsenal(who: You, n: 1)]),
                If(condition: CountAtLeast(count: HandSize, n: 15), effects: [HandToArsenal(who: You, n: 1)]),
                If(condition: CountAtMost(count: HandSize, n: 6), effects: [Optional([Draw(who: You, n: 1)])]),
            ],
        ),
        // The changes to Ability draws and moves are not supported yet.
        "From NXT to WWE": (only_packed_by: ["NXT"], pre_match_limit: 1),
        // Playing the top card face-down as a Strike and the +3F are not supported yet.
        "Halloween Havoc": (
            requires: Some(YouAre("WCW")),
            pre_match_limit: 1,
            end_of_prematch: [Draw(who: Opponent, n: 3), Discard(who: Opponent, n: 2, pick: Chosen)],
        ),
        // Approximation: the packing rule, the Old School Psychology cards and the It's Hard Being This Original
        // bonus are not supported; you may play the cards under it during your turn.
        "Luck Is For Losers": (
            end_of_prematch: [
                PutUnder(from: Hand, n: 1, up_to: true),
                If(condition: Superstar("CM Punk"), effects: [DrawUpTo(who: You, n: 1)]),
            ],
            play_from_under: Some(Any),
        ),
