                effects: [Optional([Search(filter: Not(Trait(Unique)))])],
            )),
        ),
        "Shining Wizard Kick": (
            play_after: Some(Maneuver),
            irreversible: true,
            on_play: [Optional([RingsideToBacklash(who: You, n: 1)])],
