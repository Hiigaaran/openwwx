                (when: SuperstarValueAtLeast(3), fortitude: 1),
                (when: SuperstarValueAtLeast(4), fortitude: 1),
                (when: SuperstarValueAtLeast(5), fortitude: 1),
                (when: SuperstarValueAtLeast(6), fortitude: 1),
                (when: SuperstarValueAtLeast(7), fortitude: 1),
