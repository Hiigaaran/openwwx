        // The Pre-match limit part is not supported yet.
        "You Can't Manhandle the Big Show": (
            end_of_prematch: [Optional([HandToArsenalTop(who: You, n: 2), Search(filter: Not(Trait(Unique)))])],
        ),
        // Approximation: from the Ringside pile it is shuffled back during your Main Segment.
        "Dude ... Whatever": (
            irreversible: true,
            in_ring_start_of_turn: [Optional([ReturnThis(to: Arsenal)])],
            ringside_ability: Some((effects: [ReturnThis(to: Arsenal)])),
