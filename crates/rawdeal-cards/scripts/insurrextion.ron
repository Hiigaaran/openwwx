                Choice([[DrawUpTo(who: You, n: 2)], [Search(filter: Title("Maintain Hold"), ringside: true)]]),
            ],
            reverses: Some((targets: ManeuverType(Submission))),
        ),

        // Team Angle
        // The "When this card is Eliminated" line of the newer wording is not supported.
        "Collegiate Champions": (
