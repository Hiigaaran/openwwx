                    condition: CountAtMost(count: YourRingMatching(SuperstarSpecific), n: 6),
                    effects: [Counted(count: YourRingMatching(SuperstarSpecific), effect: DrawUpTo(who: You, n: 0))],
                ),
                If(
                    condition: CountAtLeast(count: YourRingMatching(SuperstarSpecific), n: 7),
                    effects: [DrawUpTo(who: You, n: 6)],
                ),
            ],
        ),
        "Stomp a Mudhole...": (
            play_after: Some(Maneuver),
            irreversible: true,
            on_play: [Optional([Search(filter: Title("...Walk It Dry"), ringside: true)])],
        ),
        "Don't Trust Nobody": (
            reverses: Some((
                targets: All([Maneuver, Not(ManeuverType(TrademarkFinisher))]),
                effects: [Optional([LookAtHand(who: Opponent)])],
            )),
        ),
        "...Walk It Dry": (
            requires: Some(InYourRing(Title("Stomp a Mudhole..."))),
            on_play: [
                Discard(who: You, n: 1, pick: Chosen),
                Counted(count: SuperstarValue, effect: RingsideToArsenal(who: You, n: 0, up_to: true)),
                Counted(count: SuperstarValue, effect: Mill(who: Opponent, n: 0)),
            ],
        ),

        // Shawn Michaels
        "The Icon ... The Showstoppa ... The Main Event": (
            value_bonus: 1,
            end_of_prematch: [
                Search(filter: Trait(Unique)),
                Search(filter: All([Reversal, Not(Trait(Unique))])),
                Search(filter: ManeuverType(TrademarkFinisher)),
            ],
        ),
        "Sweet Chin Music": (
            play_after: Some(All([Maneuver, DamageAtLeast(5)])),
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    RingsideToHand(who: You, n: 1, filter: Some(All([Maneuver, Not(Title("Sweet Chin Music"))]))),
                ],
            )),
            reverses: Some((targets: AnyOf([ManeuverType(Strike), ManeuverType(Grapple)]), from_hand_only: true)),
        ),
        "Don't Hunt What You Can't Kill": (reverses: Some((targets: All([Maneuver, Not(Trait(Unique))])))),
        "Top Rope Elbow Drop": (play_after: Some(Title("From the Top Rope")), no_hand_reversal: true),
        "The Heart Break Kid": (
            on_play: [
                Counted(count: OpponentValueTimes(1), effect: Mill(who: Opponent, n: 0)),
                Counted(count: OpponentRingMatching(AnyOf([Action, Maneuver])), effect: Mill(who: Opponent, n: 0)),
            ],
        ),

        // Chris Benoit
        // Ending the opponent's turn from a Ring card after damage is not supported yet.
        "There's No Holding Me Back": (requires: Some(Never)),
        // Played after a maneuver succeeds, outside the reversal window: not supported yet.
        "Toothless Aggression": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        "Cripple Opponent": (
            on_play: [
                LookAtHand(who: Opponent),
                Optional([DiscardMatching(who: Opponent, n: 1, filter: Maneuver, pick: Controller)]),
                Optional([DiscardMatching(who: Opponent, n: 1, filter: Action, pick: Controller)]),
            ],
        ),
        // Approximation: the next maneuver may ignore any "can only be played after" text.
        "Rabid Attack in the Corner": (
            play_after: Some(AnyOf([All([Maneuver, DamageAtLeast(6)]), Title("Throw Into the Corner Turnbuckle")])),
            on_play: [
                RingsideToArsenal(who: You, n: 5, up_to: true),
                Boost((applies_to: Maneuver, duration: NextCard, irreversible: true, ignore_play_after: true)),
            ],
        ),
        "Surprise Drop Kick": (
            on_play: [Optional([RemoveFromRing(who: Opponent, n: 2, filter: Not(Trait(MidMatch)))])],
            reverses: Some((targets: Action)),
        ),

        // Los Guerreros
        // Keeping cards under it is not supported yet.
        "We Lie, We Cheat, We Steal": (requires: Some(Never)),
        // Searching for it as a High Risk maneuver is not supported yet.
        "Chavo's Inverted Powerbomb": (
            play_after: Some(
                AnyOf([Maneuver, Title("Throw Into the Corner Turnbuckle"), Title("From the Top Rope")]),
            ),
            on_play: [
                Boost((applies_to: ManeuverType(HighRisk), duration: NextTurnFirstCard, ignore_play_after: true)),
            ],
            reverses: Some((
                targets: All([
                    Maneuver,
                    AnyOf([After(Title("Throw Into the Corner Turnbuckle")), After(Title("From the Top Rope"))]),
                ]),
                effects: [
                    Boost((applies_to: ManeuverType(HighRisk), duration: NextTurnFirstCard, ignore_play_after: true)),
                ],
            )),
        ),
        "Cheat 2 Win": (
            on_play: [
                Choice([
                    [Search(filter: Trait(Face), ringside: true, n: 2)],
                    [Search(filter: Trait(Heel), ringside: true, n: 2)],
                ]),
            ],
        ),
        "Tu Locas, Ese ... You Crazy, Man": (
            reverses: Some((targets: Not(Trait(Unique)), effects: [Discard(who: You, n: 3, pick: Chosen)])),
        ),

        // Eddie Guerrero
        "Lasso from El Paso": (
            irreversible_when: Some(After(Title("Eddie's Roll Up"))),
