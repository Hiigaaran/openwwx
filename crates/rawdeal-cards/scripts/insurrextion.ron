        // Doubling the numbers on Set-up cards is not supported yet.
        "Electrifying": (on_play: [Boost((applies_to: Maneuver, duration: NextCard, ignore_play_after: true))]),
        "Here Comes the Pain": (
            on_play: [RingsideToHand(who: You, n: 2, up_to: true)],
            while_in_ring: [(applies_to: Maneuver, damage: 3)],
        ),
        "West Coast Bronco Buster": (
            play_after: Some(AnyOf([Maneuver, Title("Throw Into the Corner Turnbuckle")])),
            no_hand_reversal: true,
