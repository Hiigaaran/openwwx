        "You're Going to Space Mountain": (on_play: [RemoveFromGame(who: Opponent, from: Arsenal, n: 4)]),
        "X-treme Hedonism": (
            ringside_ability: Some((cost: [Discard(who: You, n: 3, pick: Chosen)], effects: [ReturnThis(to: Hand)])),
            in_ring_on_play: [
