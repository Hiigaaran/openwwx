        "No Gimmicks Needed": (on_play: [Optional([MillChosen(who: You, n: 1, filter: Some(Title("Head")))])]),
        "Double Face Kick": (
            bonuses: [(fortitude: -10)],
            requires: Some(FirstCardThisTurn),
            on_play: [Optional([Search(filter: Not(Trait(Unique)))])],
            reverses: Some((
