                (whose: Some(You), filter: ManeuverType(Grapple), effects: [RingsideToArsenal(who: You, n: 4, up_to: true)]),
            ],
        ),
        // Approximation: the +2 starting hand is drawn at the end of the Pre-match phase.
        "X-treme Sendoff": (
            mid_match_limit: 1,
            end_of_prematch: [Draw(who: You, n: 2)],
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: AnyOf([TitleContains("xtreme"), TitleContains("x-treme")]),
                    effects: [Choice([[Draw(who: You, n: 2)], [Discard(who: Opponent, n: 2, pick: Chosen)]])],
                ),
