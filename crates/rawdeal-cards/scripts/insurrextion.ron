// Hand-written scripts for Insurrextion cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
(
    abilities: {
        // Approximation: the discard is used once per turn.
        "Big Poppa Pump": [
            Activated(
                cost: [],
                effects: [
                    Choice([
                        [
                            If(
                                condition: HandAtLeast(1),
                                effects: [
                                    Discard(who: You, n: 1, pick: Chosen),
                                    Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -4)),
                                ],
                            ),
                        ],
                        [
                            If(
                                condition: HandAtLeast(2),
                                effects: [
                                    Discard(who: You, n: 2, pick: Chosen),
                                    Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -8)),
                                ],
                            ),
                        ],
                        [
                            If(
                                condition: HandAtLeast(3),
                                effects: [
                                    Discard(who: You, n: 3, pick: Chosen),
                                    Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -12)),
                                ],
                            ),
                        ],
                        [
                            If(
                                condition: HandAtLeast(4),
                                effects: [
                                    Discard(who: You, n: 4, pick: Chosen),
                                    Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -16)),
                                ],
                            ),
                        ],
                        [
                            If(
                                condition: HandAtLeast(5),
                                effects: [
                                    Discard(who: You, n: 5, pick: Chosen),
                                    Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -20)),
                                ],
                            ),
                        ],
                    ]),
                ],
            ),
            CannotPlayMatching(All([Maneuver, EarlierThisTurn(filter: Maneuver, n: 2)])),
        ],
        // Blocking moves out of Ringside piles is not supported yet.
        "The Rattlesnake": [PacksLogos(["Stone Cold Steve Austin"])],
        // The extra Backlash and Arsenal cards are not supported yet.
        "Shawn Michaels": [],
        "The Crippler": [
            OnOpponentPlayMatching(
                filter: ManeuverType(Strike),
                effects: [Optional([Search(filter: All([ManeuverType(Strike), Not(Trait(Unique))]))])],
            ),
            OnOpponentPlayMatching(
                filter: ManeuverType(Grapple),
                effects: [Optional([Search(filter: All([ManeuverType(Grapple), Not(Trait(Unique))]))])],
            ),
            OnOpponentPlayMatching(
                filter: ManeuverType(Submission),
                effects: [Optional([Search(filter: All([ManeuverType(Submission), Not(Trait(Unique))]))])],
            ),
            OnOpponentPlayMatching(
                filter: ManeuverType(HighRisk),
                effects: [Optional([Search(filter: All([ManeuverType(HighRisk), Not(Trait(Unique))]))])],
            ),
            OnOpponentPlayMatching(
                filter: ManeuverType(TrademarkFinisher),
                effects: [Optional([Search(filter: All([ManeuverType(TrademarkFinisher), Not(Trait(Unique))]))])],
            ),
            Activated(
                cost: [],
                requires: Some(HandHas(Maneuver)),
                effects: [
                    Choice([
                        [
                            If(
                                condition: HandHas(ManeuverType(Strike)),
                                effects: [
                                    DiscardMatching(who: You, n: 1, filter: ManeuverType(Strike), pick: Chosen),
                                    MoveCards(
                                        who: You,
                                        from: Ringside,
                                        to: Arsenal,
                                        n: 3,
                                        up_to: true,
                                        filter: Some(ManeuverType(Strike)),
                                        bottom: true,
                                    ),
                                ],
                            ),
                        ],
                        [
                            If(
                                condition: HandHas(ManeuverType(Grapple)),
                                effects: [
                                    DiscardMatching(who: You, n: 1, filter: ManeuverType(Grapple), pick: Chosen),
                                    MoveCards(
                                        who: You,
                                        from: Ringside,
                                        to: Arsenal,
                                        n: 3,
                                        up_to: true,
                                        filter: Some(ManeuverType(Grapple)),
                                        bottom: true,
                                    ),
                                ],
                            ),
                        ],
                        [
                            If(
                                condition: HandHas(ManeuverType(Submission)),
                                effects: [
                                    DiscardMatching(who: You, n: 1, filter: ManeuverType(Submission), pick: Chosen),
                                    MoveCards(
                                        who: You,
                                        from: Ringside,
                                        to: Arsenal,
                                        n: 3,
                                        up_to: true,
                                        filter: Some(ManeuverType(Submission)),
                                        bottom: true,
                                    ),
                                ],
                            ),
                        ],
                        [
                            If(
                                condition: HandHas(ManeuverType(HighRisk)),
                                effects: [
                                    DiscardMatching(who: You, n: 1, filter: ManeuverType(HighRisk), pick: Chosen),
                                    MoveCards(
                                        who: You,
                                        from: Ringside,
                                        to: Arsenal,
                                        n: 3,
                                        up_to: true,
                                        filter: Some(ManeuverType(HighRisk)),
                                        bottom: true,
                                    ),
                                ],
                            ),
                        ],
                        [
                            If(
                                condition: HandHas(ManeuverType(TrademarkFinisher)),
                                effects: [
                                    DiscardMatching(who: You, n: 1, filter: ManeuverType(TrademarkFinisher), pick: Chosen),
                                    MoveCards(
                                        who: You,
                                        from: Ringside,
                                        to: Arsenal,
                                        n: 3,
                                        up_to: true,
                                        filter: Some(ManeuverType(TrademarkFinisher)),
                                        bottom: true,
                                    ),
                                ],
                            ),
                        ],
                    ]),
                ],
            ),
            PacksLogos(["Chris Benoit"]),
        ],
        // Removing Ringside cards to reduce the damage of the opponent's card and Title Belts are not supported yet.
        "Los Guerreros": [PacksLogos(["Eddie Guerrero"])],
        // The Title Belt part is not supported yet.
        "Team Angle": [
            OnPlayMatching(
                filter: AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]),
                effects: [Optional([RingsideToArsenalBottom(who: You, n: 1)])],
            ),
            OnOpponentReverses([
                If(
                    condition: OpponentReversed(AnyOf([ManeuverType(Grapple), ManeuverType(Submission)])),
                    effects: [Discard(who: Opponent, n: 1, pick: Chosen)],
                ),
            ]),
        ],
        // The deck building rules and the Managed by Stacy Keibler part are not supported yet.
        "Test": [
            StartOfTurn([
                AsOpponent([
                    If(condition: HandLargerBy(3), effects: [Discard(who: You, n: 1, pick: Chosen)]),
                    If(condition: HandLargerBy(3), effects: [Discard(who: You, n: 1, pick: Chosen)]),
                    If(condition: HandLargerBy(3), effects: [Discard(who: You, n: 1, pick: Chosen)]),
                    If(condition: HandLargerBy(3), effects: [Discard(who: You, n: 1, pick: Chosen)]),
                    If(condition: HandLargerBy(3), effects: [Discard(who: You, n: 1, pick: Chosen)]),
                    If(condition: HandLargerBy(3), effects: [Discard(who: You, n: 1, pick: Chosen)]),
                    If(condition: HandLargerBy(3), effects: [Discard(who: You, n: 1, pick: Chosen)]),
                    If(condition: HandLargerBy(3), effects: [Discard(who: You, n: 1, pick: Chosen)]),
                    If(condition: HandLargerBy(3), effects: [Discard(who: You, n: 1, pick: Chosen)]),
                    If(condition: HandLargerBy(3), effects: [Discard(who: You, n: 1, pick: Chosen)]),
                    If(condition: HandLargerBy(3), effects: [Discard(who: You, n: 1, pick: Chosen)]),
                    If(condition: HandLargerBy(3), effects: [Discard(who: You, n: 1, pick: Chosen)]),
                ]),
            ]),
        ],
        // Foreign Objects keep the Raw logo.
        // Approximation: the Foreign Object goes to the Ringside pile and you take a Foreign Object from there.
        "Rhyno": [
            Activated(
                cost: [],
                effects: [
                    MillUntil(who: You, filter: Keyword("Foreign Object")),
                    RingsideToHand(who: You, n: 1, filter: Some(Keyword("Foreign Object"))),
                ],
            ),
        ],
    },
    scripts: {
        // High Risk
        "Flying Choke Hold": (play_after: Some(ManeuverType(Submission))),
        "Flying Takedown": (play_after: Some(ManeuverType(Grapple))),
        "Flying Lariat": (play_after: Some(ManeuverType(Strike))),

        // Strikes
        "Poke": (not_reversed_by: Some(Not(Title("Step Aside")))),
        // Approximation: a Pre-match Manager is a card with "Managed by" in the title. Title Belts and Tag Team
        // matches are not supported yet.
        "Noggin Knocker": (
            requires: Some(OpponentRingHas(filter: TitleContains("Managed by"), n: 1)),
            reverses: Some((
                targets: All([Action, EarlierThisTurn(filter: Action, n: 1)]),
                requires: Some(All([FortitudeBelowOpponent, OpponentRingHas(filter: TitleContains("Managed by"), n: 1)])),
            )),
        ),
        // Approximation: only Unique cards can reverse it.
        "Series of Punches": (
            play_after: Some(AnyOf([Title("Throw Into the Corner Turnbuckle"), Title("From the Top Rope")])),
            not_reversed_by: Some(Not(Trait(Unique))),
        ),

        // Grapples
        "Shake": (not_reversed_by: Some(Not(Title("Escape Move")))),
        "Capture Suplex": (reverses: Some((targets: All([Maneuver, After(Title("From the Top Rope"))])))),
        // Removing cards with an Activated Card Effect is not supported yet.
        // Approximation: the next card may ignore any "can only be played after" text.
        "Tossed Between the Ropes": (
            no_backlash_reversal: true,
            on_play: [
                Boost((applies_to: Any, duration: NextCard, ignore_play_after: true)),
                If(condition: Superstar("Rey Mysterio"), effects: [Optional([Search(filter: Title("The 619"))])]),
            ],
        ),
        "Rolling Suplex": (
            on_play: [If(condition: FortitudeBelowOpponent, effects: [Search(filter: TitleContains("suplex"))])],
        ),
        // The pinfall only happens when played as a maneuver.
        "Inside Cradle": (
            play_after: Some(All([Maneuver, DamageAtLeast(5)])),
            on_play: [If(condition: AnyOf([FortitudeLeadAtLeast(20), RingStunLeadAtLeast(5)]), effects: [WinByPin])],
            reverses: Some((targets: ManeuverType(Grapple))),
        ),
        "Inverted Snake Eyes": (
            play_after: Some(AnyOf([Maneuver, Title("Throw Into the Corner Turnbuckle")])),
            not_reversed_by: Some(Title("Backlash!")),
            on_play: [DrawUpTo(who: You, n: 2)],
        ),
        "Snap Slam": (
            on_play: [AsOpponent([Optional([RemoveFromGame(who: Opponent, from: Ringside, n: 1, pick: Controller)])])],
        ),
        // The reversal limit after From the Top Rope is not supported yet.
        "Hangman's Neck Breaker": (
            in_ring_on_play: [
                (whose: Some(You), filter: ManeuverType(Grapple), effects: [Discard(who: Opponent, n: 1, pick: Chosen)]),
            ],
        ),
        // Edge's part is in his own Superstar script.
        "Faceplant": (
            play_after: Some(AnyOf([Trait(SetUp), Maneuver])),
            reverses: Some((targets: All([Not(Trait(Unique)), ForcesDiscard]), damage: None)),
        ),

        // Submissions
        "Split Finger Lock": (
            on_play: [
                Choice([
                    [],
                    [Discard(who: You, n: 1, pick: Chosen), Mill(who: Opponent, n: 1)],
                    [Discard(who: You, n: 2, pick: Chosen), Mill(who: Opponent, n: 2)],
                    [Discard(who: You, n: 3, pick: Chosen), Mill(who: Opponent, n: 3)],
                    [Discard(who: You, n: 4, pick: Chosen), Mill(who: Opponent, n: 4)],
                    [Discard(who: You, n: 5, pick: Chosen), Mill(who: Opponent, n: 5)],
                ]),
            ],
            as_action: Some((on_play: [DiscardThis, Boost((applies_to: Maneuver, duration: NextCard, damage: 3))])),
        ),
        "Body Vise": (
            on_play: [Optional([RemoveFromGame(who: Opponent, from: Ringside, n: 1, pick: Controller)])],
            on_reversed_from_hand: [
                AsOpponent([Optional([RemoveFromGame(who: Opponent, from: Ringside, n: 1, pick: Controller)])]),
            ],
        ),
        // Approximation: at most 5 cards are removed.
        "Inverted Leg Lock": (
            on_play: [
                Choice([
                    [],
                    [
                        RemoveFromGame(who: You, from: Ringside, n: 1),
                        RingsideToArsenal(who: You, n: 1, filter: Some(Maneuver)),
                    ],
                    [
                        RemoveFromGame(who: You, from: Ringside, n: 2),
                        RingsideToArsenal(who: You, n: 2, filter: Some(Maneuver)),
                    ],
                    [
                        RemoveFromGame(who: You, from: Ringside, n: 3),
                        RingsideToArsenal(who: You, n: 3, filter: Some(Maneuver)),
                    ],
                    [
                        RemoveFromGame(who: You, from: Ringside, n: 4),
                        RingsideToArsenal(who: You, n: 4, filter: Some(Maneuver)),
                    ],
                    [
                        RemoveFromGame(who: You, from: Ringside, n: 5),
                        RingsideToArsenal(who: You, n: 5, filter: Some(Maneuver)),
                    ],
                ]),
            ],
        ),

        // Reversals
        // Continuing the turn after a reversal is not supported yet.
        "Dude, Try Something Else": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // Continuing the turn after a reversal is not supported yet.
        "Fall into the Corner": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // Reversing Activated Card Effects is not supported yet.
        "Don't Try This at Home": (
            on_play: [Search(filter: Title("From the Top Rope"))],
            reverses: Some((targets: Not(Any))),
        ),
        // Tag Team matches are not supported yet.
        "Blind Tag": (requires: Some(Never), reverses: Some((targets: Not(Any)))),

        // Actions
        "The Devil's in the Detail": (
            on_play: [
                Optional([
                    MoveCards(
                        who: You,
                        from: Ringside,
                        to: Arsenal,
                        n: 1,
                        filter: Some(All([DamageAtLeast(1), DamageAtMost(1)])),
                        bottom: true,
                    ),
                ]),
                Optional([RingsideToHand(who: You, n: 1, filter: Some(All([DamageAtLeast(1), DamageAtMost(1)])))]),
            ],
        ),
        // Checking what the opponent attempted last turn is not supported yet.
        "Hey, Whatcha Doin'?": (requires: Some(Never)),
        // Approximation: the extra F only counts the 'shoot' cards in your own Ring.
        "Crowd Pleaser": (
            bonuses: [(per: Some(TitleContains("shoot")), fortitude: 1)],
            on_play: [
                Counted(count: YourRingMatching(TitleContains("shoot")), effect: DrawUpTo(who: You, n: 0)),
                Counted(count: OpponentRingMatching(TitleContains("shoot")), effect: DrawUpTo(who: You, n: 0)),
                Counted(count: YourRingMatching(TitleContains("shoot")), effect: Mill(who: Opponent, n: 0)),
                Counted(count: OpponentRingMatching(TitleContains("shoot")), effect: Mill(who: Opponent, n: 0)),
            ],
        ),
        // Tag Team matches are not supported yet.
        "Pump Up the Crowd": (requires: Some(Never)),
        "How Ya Like Me Now?": (play_after: Some(Maneuver), on_play: [RingsideToHand(who: You, n: 1)]),
        // Approximation: the opponent overturns 5 cards and draws 1 instead of choosing among the top 6.
        "Perplex Opponent": (on_play: [Mill(who: Opponent, n: 5), Draw(who: Opponent, n: 1)]),
        // Reversing effects that remove cards from your Ring is not supported yet.
        "Always": (
            irreversible_when: Some(InYourRing(Title("Backstage Politics"))),
            on_play: [Draw(who: You, n: 1)],
        ),
        "Add Insult to Injury": (
            play_after: Some(Maneuver),
            on_play: [OpponentChooses(n: 1, options: [[Mill(who: Opponent, n: 5)], [Discard(who: Opponent, n: 2, pick: Chosen)]])],
        ),
        "It's Your Own Fault": (
            on_play: [Counted(count: OpponentRingMatching(Reversal), effect: RingsideToArsenal(who: You, n: 0, up_to: true))],
        ),
        // The two cards found do not have to be different.
        "This is Gonna Get Ugly": (
            requires: Some(HandAtLeast(4)),
            on_play: [
                Discard(who: You, n: 3, pick: Chosen),
                Search(filter: Not(Trait(Unique)), n: 2),
                DrawUpTo(who: Opponent, n: 3),
            ],
        ),
        // Keeping cards under it is not supported yet.
        "What's Mine is Mine and What's Yours is Mine": (requires: Some(Never)),
        "Beat You Raw": (
            bonuses: [(when: Not(OpponentRingHas(filter: Trait(SmackDown), n: 1)), fortitude: -6)],
            on_play: [
                If(
                    condition: Not(OpponentRingHas(filter: Trait(SmackDown), n: 1)),
                    effects: [Optional([RemoveThis, Draw(who: You, n: 1)])],
                ),
                If(
                    condition: OpponentRingHas(filter: Trait(SmackDown), n: 1),
                    effects: [Boost((applies_to: Any, duration: ThisTurn, no_backlash_reversal: true))],
                ),
            ],
        ),
        "Forget the Smackdown, Jabronie!": (
            bonuses: [(when: Not(OpponentRingHas(filter: Trait(Raw), n: 1)), fortitude: -6)],
            on_play: [
                If(
                    condition: Not(OpponentRingHas(filter: Trait(Raw), n: 1)),
                    effects: [Optional([RemoveThis, Discard(who: Opponent, n: 1, pick: Chosen)])],
                ),
            ],
            reverses_from_ring: Some((
                targets: AnyOf([ManeuverType(Strike), ManeuverType(Grapple)]),
                fortitude: Some(0),
                requires: Some(OpponentRingHas(filter: Trait(Raw), n: 1)),
                effects: [
                    RemoveFromGame(
                        who: You,
                        from: Ringside,
                        n: 1,
                        filter: Some(Title("Forget the Smackdown, Jabronie!")),
                        pick: Controller,
                    ),
                ],
            )),
        ),
        // Removing it from the game to ignore Fortitude changes is not supported yet.
        "No One Wants to Watch Women Wrestle": (
            on_play: [
                If(condition: OpponentIs("Male"), effects: [DiscardThis, Draw(who: You, n: 1)]),
                If(condition: OpponentIs("Female"), effects: [MillChosen(who: Opponent, n: 5, filter: Some(Maneuver))]),
            ],
        ),
        "I Can't Be Reading This Right...": (
            not_packed_by: ["Female"],
            ringside_ability: Some((
                requires: Some(OpponentHandLarger),
                cost: [
                    RemoveFromGame(
                        who: You,
                        from: Ringside,
                        n: 1,
                        filter: Some(Not(Title("I Can't Be Reading This Right..."))),
                        pick: Chosen,
                    ),
                ],
                effects: [ReturnThis(to: Hand)],
            )),
        ),
        // Its Ring effect is not supported yet.
        "Pass the Buck": (
            irreversible_when: Some(InYourRing(Title("Backstage Politics"))),
            on_play: [Draw(who: You, n: 1)],
        ),
        "From the Mind of Eric Bischoff": (
            irreversible_when: Some(InYourRing(Title("Managed by Eric Bischoff"))),
            on_play: [
                Counted(
                    count: YourRingMatching(Trait(Raw)),
                    effect: RingsideToHand(who: You, n: 0, up_to: true, filter: Some(Trait(Raw))),
                ),
                Boost((applies_to: Title("Here's a Ratings Booster!"), duration: NextCard, irreversible: true)),
            ],
        ),
        // Changing the text of other cards and the Mid-match limit is not supported yet.
        "Stephanie McMahon Decrees...": (requires: Some(Never)),
        "The End Is Near": (
            on_play: [
                RingsideToHand(who: You, n: 1, up_to: true, filter: Some(Maneuver)),
                RingsideToHand(who: You, n: 1, up_to: true, filter: Some(Reversal)),
                RingsideToHand(who: You, n: 1, up_to: true, filter: Some(Action)),
                Boost((applies_to: Title("From the Top Rope"), duration: NextCard, ignore_play_after: true)),
            ],
        ),
        "Forceable Entry": (
            on_play: [
                Choice([
                    [],
                    [Discard(who: You, n: 2, pick: Chosen), MillChosen(who: Opponent, n: 1)],
                    [Discard(who: You, n: 4, pick: Chosen), MillChosen(who: Opponent, n: 2)],
                    [Discard(who: You, n: 6, pick: Chosen), MillChosen(who: Opponent, n: 3)],
                    [Discard(who: You, n: 8, pick: Chosen), MillChosen(who: Opponent, n: 4)],
                ]),
            ],
        ),

        // Pre-match
        // Tag Team matches are not supported yet.
        "Give and Take": (requires: Some(Never)),
        // Approximation: the opponent's Superstar Value is +1, however many Fans Love an Underdog are in your Ring.
        "I'm the Underdog!": (requires: Some(InYourRing(Title("Fans Love an Underdog"))), opponent_value_bonus: 1),
        // The opponent's 4D damage cap is not supported yet.
        "Ring Psychology: Arm": (
            while_in_ring: [
                (
                    applies_to: All([
                        AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]),
                        PlayerRingHas(
                            filter: All([
                                AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]),
                                AnyOf([TitleContains("arm"), TitleContains("shoulder"), TitleContains("wrist")]),
                            ]),
                            n: 4,
                        ),
                    ]),
                    damage: 4,
                ),
            ],
        ),
        "Ring Psychology: Leg": (
            while_in_ring: [
                (
                    applies_to: All([
                        Maneuver,
                        AnyOf([TitleContains("knee"), TitleContains("leg"), TitleContains("toe")]),
                        PlayerRingHas(
                            filter: All([
                                AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]),
                                AnyOf([TitleContains("knee"), TitleContains("leg"), TitleContains("toe")]),
                            ]),
                            n: 3,
                        ),
                    ]),
                    no_hand_reversal: true,
                ),
                (
                    applies_to: All([
                        Maneuver,
                        AnyOf([TitleContains("knee"), TitleContains("leg"), TitleContains("toe")]),
                        PlayerRingHas(
                            filter: All([
                                AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]),
                                AnyOf([TitleContains("knee"), TitleContains("leg"), TitleContains("toe")]),
                            ]),
                            n: 6,
                        ),
                    ]),
                    irreversible: true,
                ),
            ],
        ),
        "Stun the Crowd": (while_in_ring: [(applies_to: StunValueAtLeast(1), damage: 1, stun_value: 1)]),
        // Shuffling in 1 more card is not supported yet.
        "Take Care of Number One": (
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]),
                    effects: [
                        If(condition: Superstar("Team Angle"), effects: [Optional([RingsideToArsenalBottom(who: You, n: 1)])]),
                    ],
                ),
            ],
        ),
        // Approximation: Superstars who draw 2 fewer shuffle 2 cards of their choice back into the Arsenal.
        "Backstage Donnybrook": (
            end_of_prematch: [
                ShuffleHandAndRedraw(who: You),
                ShuffleHandAndRedraw(who: Opponent),
                If(
                    condition: AnyOf([Superstar("Rikishi"), Superstar("Brothers of Destruction"), Superstar("Ric Flair")]),
                    effects: [HandToArsenal(who: You, n: 2)],
                ),
                AsOpponent([
                    If(
                        condition: AnyOf([
                            Superstar("Rikishi"),
                            Superstar("Brothers of Destruction"),
                            Superstar("Ric Flair"),
                        ]),
                        effects: [HandToArsenal(who: You, n: 2)],
                    ),
                ]),
            ],
        ),
        "Dance, Coach, Dance!": (
            while_in_ring: [
                (applies_to: All([Not(Trait(Unique)), Trait(Raw), PlayerRingHas(filter: Trait(Raw), n: 1)]), fortitude: -1),
                (applies_to: All([Not(Trait(Unique)), Trait(Raw), PlayerRingHas(filter: Trait(Raw), n: 2)]), fortitude: -1),
                (applies_to: All([Not(Trait(Unique)), Trait(Raw), PlayerRingHas(filter: Trait(Raw), n: 3)]), fortitude: -1),
                (applies_to: All([Not(Trait(Unique)), Trait(Raw), PlayerRingHas(filter: Trait(Raw), n: 4)]), fortitude: -1),
                (applies_to: All([Not(Trait(Unique)), Trait(Raw), PlayerRingHas(filter: Trait(Raw), n: 5)]), fortitude: -1),
                (applies_to: All([Not(Trait(Unique)), Trait(Raw), PlayerRingHas(filter: Trait(Raw), n: 6)]), fortitude: -1),
