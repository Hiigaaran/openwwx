        "Rhyno's Garbage Can": (requires: Some(Never)),
        // Approximation: the discard cost is always 5, whatever the Stun Value in your Ring.
        "The Manbeast": (reverses_from_ring: Some((targets: Maneuver, fortitude: Some(0), discard_cost: 5))),
        "Rhyno Stampede": (),

        // Cards for earlier Superstars
        "Big Evil - Red Devil": (
            end_of_prematch: [Search(filter: All([Maneuver, Not(Trait(Unique))]))],
