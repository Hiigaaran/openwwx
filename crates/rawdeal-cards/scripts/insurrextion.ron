        // Approximation: any 3 random Backlash cards are discarded, not only Pre-match ones. The Tag Team part is not
        // supported yet.
        "3 Minutes and We're Out": (on_play: [BacklashToRingside(who: Opponent, n: 3, random: true)]),
        // Approximation: it is shuffled back from the Ringside pile during your Main Segment.
        "Nidia Interferes": (
            reverses: Some((targets: Maneuver, overturned_only: true)),
            ringside_ability: Some((effects: [ReturnThis(to: Arsenal)])),
        ),
