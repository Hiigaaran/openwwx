        ),
        "Makin' a Difference": (
            on_play: [RingsideToArsenal(who: You, n: 6, up_to: true), RingsideToHand(who: You, n: 1, filter: Some(Maneuver))],
        ),
        // Needing 3 Reversals to stop it is not supported yet.
        "Dudleyz3": (
            extra_traits: [Multi],
            bonuses: [
                (
                    when: YouAre("Tag Team"),
                    fortitude: -5,
                ),
            ],
