        "It's All About the Benjamins": (reverses: Some((targets: Any, effects: [Search(filter: Any)]))),
        "The Haas of Pain": (reverses: Some((targets: ManeuverType(Submission)))),

        // Test
        "Test Drive": (
            play_after: Some(All([Maneuver, DamageAtLeast(2)])),
            on_play: [DrawUpTo(who: You, n: 2)],
            reverses: Some((
