// Hand-written scripts for VR4: No Mercy (Raw Deal Virtual) cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// Every title starts with "Revolution ": text naming a card means the Revolution card.
// "Counter" = you reversed a card to end your opponent's last turn and this is your first card this turn.
// "A non-Revolution card" is a card without "Revolution" in its title. "When you are a Revolution Superstar" is
// treated as always true. "Your Superstar Card has a <X> logo" is approximated as "you are Revolution <X>".
// "You cannot pack Corners" is approximated as cards with "In My Corner" in the title.
// Maneuver / Antic hybrids: the Antic part is in `as_action`.
// "When reversed (from Arsenal)" texts on maneuvers use the card's Ringside trigger, checking that this card was
// the one reversed.
(
    abilities: {
        // Ignoring the Follow-up and Requirement on your Superstar-specific cards is not supported yet.
        "Revolution The Rock": [
            OpponentDamageCap(filter: All([Maneuver, Trait(Core)]), max: 1),
            CannotPackMatching(TitleContains("In My Corner")),
        ],
        "Revolution Brock Lesnar": [
            OnPlayMatching(filter: AnyOf([ManeuverType(Throw), ManeuverType(Hold)]), effects: [DrawUpTo(who: You, n: 1)]),
        ],
        // Drawing during the opponent's Draw Segment is not supported yet.
        "Revolution Chris Jericho": [],
        // Approximation: every Booker T-specific card may be packed (not only maneuvers and Sharmell cards).
        "Revolution King Booker": [
            OnPlayMatching(
                filter: Maneuver,
                effects: [
                    Optional([
                        RingsideToHand(who: You, n: 1, filter: Some(All([Not(Trait(Unique)), Not(Reversal)]))),
                        Discard(who: You, n: 1, pick: Chosen),
                    ]),
                ],
            ),
            PacksLogos(["Booker T"]),
        ],
        // Triggers on drawing cards outside the Draw Segment are not supported yet.
        "Revolution Sheamus": [],
        // Rewriting Ring Psychology cards and playing Pre-match cards from Ringside are not supported yet.
        "Revolution Daniel Bryan": [],
        // Making a Core be reversed as another maneuver type and the damage limit are not supported yet.
        "Revolution Dolph Ziggler": [CannotPackMatching(TitleContains("In My Corner"))],
        // "Blank text" maneuvers and the Faction packing limit are not supported yet.
        "Revolution Mark Henry": [CannotPackMatching(TitleContains("In My Corner"))],
        // Approximation: "once during each of your turns" is the first maneuver you play each turn.
        "Revolution Jack Swagger": [
            OnPlayMatching(
                filter: All([Maneuver, Not(EarlierThisTurn(filter: Maneuver, n: 1))]),
                effects: [
                    Search(
                        filter: All([Trait(FollowUp), Not(ManeuverType(Extreme)), Not(ManeuverType(Trademark))]),
                        up_to: true,
                    ),
                    Boost((applies_to: All([Maneuver, Trait(FollowUp)]), duration: NextCard, no_backlash_reversal: true)),
                ],
            ),
        ],
        // Approximation: the first maneuver each turn; you keep 1 of the top 3 and the other 2 go on the bottom.
        // The Backlash discard is not supported yet.
        "Revolution Carlito": [
            OnPlayMatching(filter: All([Maneuver, Not(EarlierThisTurn(filter: Maneuver, n: 1))]), effects: [Dig(n: 3, take: 1)]),
        ],
        // Ignoring the Follow-up for a discard and its riders are not supported yet.
        "Revolution Kofi Kingston": [],
        // Rewriting the Antic: Follow-up rules bars is not supported yet.
        "Revolution Santino Marella": [
            CannotPackTrait(Colossal),
            CannotPack("Revolution Never Give In, Never Give Up"),
        ],
        // Spinning Heel Kicks becoming Extremes and the Unique Extreme packing rule are not supported yet.
        "Revolution Rob Van Dam": [
            CannotBeReversedBy(
                played: Title("Revolution Spinning Heel Kick"),
                reversal: AnyOf([All([Not(Trait(Unique)), Hybrid]), Title("Revolution The Second Solution")]),
            ),
            CannotPack("The Whole F'n Show"),
        ],
        // Playing any number of Corners and the Faction packing limit are not supported yet.
        "Revolution John Laurinaitis": [],
    },
    scripts: {
        // Assaults
        "Revolution Quick Strike": (reverses: Some((targets: All([Not(Trait(Unique)), ManeuverType(Extreme), Trait(Core)])))),
        "Revolution Desperate Assault": (
            not_with: ["Revolution Desperate Throw", "Revolution Desperate Hold"],
            momentum_when: Some(CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 20)),
            from_ringside: Some(CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 20)),
            on_play: [DrawUpTo(who: You, n: 1)],
        ),

        // Throws
        "Revolution Quick Grapple": (),
        "Revolution Desperate Throw": (
            not_with: ["Revolution Desperate Assault", "Revolution Desperate Hold"],
            momentum_when: Some(CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 20)),
            from_ringside: Some(CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 20)),
            on_play: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, bottom: true)],
        ),

        // Holds
        "Revolution Quick Submission": (),
        "Revolution Desperate Hold": (
            not_with: ["Revolution Desperate Assault", "Revolution Desperate Throw"],
            momentum_when: Some(CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 20)),
            from_ringside: Some(CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 20)),
            on_play: [Discard(who: Opponent, n: 1, pick: Chosen)],
        ),

        // Extremes
        // "Can be reversed as if non-Unique": the card is already non-Unique.
        "Revolution Thumb to the Eye": (on_play: [CannotPlay(who: Opponent, filter: Antic, turns: 1)]),
        "Revolution Thrown Into the Ring Apron": (on_play: [Arrange(who: You, n: 3)]),
        "Revolution Ring Steps": (
            bonuses: [(when: YouAre("Extremist"), fortitude: -1), (when: Not(YouAre("Extremist")), damage: -2)],
        ),
        // Naming a Target is not supported yet.
        "Revolution Chair Shot": (
            ringside_on_opponent_reverses: [
                If(
                    condition: All([OpponentReversed(Title("Revolution Chair Shot")), OpponentReversedFrom([Arsenal])]),
                    effects: [Draw(who: You, n: 1)],
                ),
            ],
        ),
        "Revolution Driven into the Ring Post": (
            bonuses: [(when: YouAre("Extremist"), fortitude: -5)],
            reverses: Some((
                targets: All([ManeuverType(Extreme), Not(Trait(Colossal))]),
                damage: Fixed(4),
                effects: [Discard(who: You, n: 1, pick: Chosen), Discard(who: Opponent, n: 1, pick: Chosen)],
            )),
        ),
        "Revolution Thrown Off the Stage": (
            bonuses: [(when: YouAre("Extremist"), fortitude: -2)],
            ringside_on_opponent_reverses: [
                If(condition: OpponentReversed(Title("Revolution Thrown Off the Stage")), effects: [Discard(who: Opponent, n: 1, pick: Chosen)]),
            ],
        ),

        // Antics
        "Revolution May I Have Your Attention Please?": (
            on_play: [
                RevealHand(who: Opponent),
                Choice([
                    [ShuffleHandAndRedraw(who: You)],
                    [ShuffleHandAndRedraw(who: Opponent)],
                    [ShuffleHandAndRedraw(who: You), ShuffleHandAndRedraw(who: Opponent)],
                    [],
                ]),
            ],
        ),
        "Revolution ...And I Quote": (
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: Antic,
                    effects: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, bottom: true)],
                ),
            ],
        ),

        // Pre-match
        // Approximation: "cards with 'defense' in the title" are the Revolution Defense cards. Blanking cards and
        // ignoring the Requirement on Settle the Score are not supported yet.
        "Revolution Good Luck With That!": (
            not_with: ["Revolution Head-to-Toe Defense", "Revolution Centered Defense", "Revolution Lateral Flank Defense"],
        ),
        // Ignoring the Requirement on other cards is not supported yet.
        "Revolution I Brought Back-Up, Just In Case": (requires: Some(Never)),
        // Approximation: Corners are cards with "In My Corner" in the title. The packing limit is not supported yet.
        "Revolution John Laurinaitis Changes the Match!": (
            requires: Some(Not(OpponentIs("GM"))),
            end_of_prematch: [
                If(
                    condition: OpponentRingHas(filter: All([TitleContains("In My Corner"), Not(SuperstarSpecific)]), n: 1),
                    effects: [
                        OpponentChooses(
                            n: 1,
                            options: [
                                [Discard(who: Opponent, n: 2, pick: Chosen)],
                                [RemoveFromRing(who: Opponent, n: 1, filter: TitleContains("In My Corner"))],
                            ],
                        ),
                    ],
                ),
                If(
                    condition: AnyOf([
                        InYourRing(Not(TitleContains("Revolution"))),
                        OpponentRingHas(filter: Not(TitleContains("Revolution")), n: 1),
                    ]),
                    effects: [Discard(who: Opponent, n: 4, pick: Chosen)],
                ),
            ],
        ),
        // Packing another Superstar's Antics and Maneuvers (and their Requirement) and "Your Storyline is Permanent"
        // are not supported yet; only "You cannot play Corners" is scripted.
        "Revolution Brock Lesnar Is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Carlito Is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Chris Jericho Is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Daniel Bryan Is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Dolph Ziggler Is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution King Booker Is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Kofi Kingston Is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Jack Swagger Is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Mark Henry Is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Santino Marella Is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Sheamus Is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution The Rock Is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        // Overturning 3 fewer cards for not playing a maneuver is not supported yet.
        "Revolution Michael Cole Is In My Corner!": (
            on_play: [
                Search(
                    filter: AnyOf([Title("Revolution May I Have Your Attention Please?"), Title("Revolution ...And I Quote")]),
                    up_to: true,
                ),
            ],
            reverses_from_ring: Some((targets: All([Not(SuperstarSpecific), Trait(Unique), Antic]), damage: None)),
        ),

        // The Rock
        // Making 'attitude' antics irreversible by Uniques is not supported yet.
        "Revolution The Most Electrifying Man in ALL of Entertainment": (on_play: [Draw(who: You, n: 2)]),
        "Revolution Team Bring It!": (
            requires: Some(All([FortitudeBelowOpponent, OpponentHandLarger])),
            bonuses: [(when: FortitudeBelowOpponent, fortitude: -12)],
            on_play: [Boost((applies_to: Maneuver, duration: NextMatching, momentum: true))],
        ),
        "Revolution The People's Elbow": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [ThisToArsenal(bottom: true), Search(filter: All([Not(Trait(Unique)), Not(Reversal)]))],
            )),
        ),
        "Revolution The Rock's Punching Flurry": (
            requires: Some(FirstCardThisTurn),
            on_play: [Search(filter: All([ManeuverType(Assault), TitleContains("punch")]), up_to: true)],
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: All([ManeuverType(Assault), TitleContains("punch")]),
                    effects: [Optional([ReturnThis(to: Hand)])],
                ),
            ],
        ),
        "Revolution Electrifying Spine Buster": (
            reverses: Some((
                targets: AnyOf([
                    ManeuverType(Throw),
                    All([ManeuverType(Grapple), Holds(OpponentSuperstar("Revolution The Rock"))]),
                ]),
            )),
        ),
        "Revolution Rock Bottom": (
            bonuses: [(when: Superstar("Revolution The Rock"), fortitude: -10)],
            reverses: Some((
                targets: AnyOf([
                    ManeuverType(Assault),
                    All([ManeuverType(Strike), Holds(OpponentSuperstar("Revolution The Rock"))]),
                ]),
            )),
        ),
        "Revolution Boots to A$$es!": (
            reverses: Some((
                targets: AnyOf([
                    All([Maneuver, Not(ManeuverType(Trademark)), TitleContains("Revolution")]),
                    All([Maneuver, Holds(OpponentSuperstar("Revolution The Rock"))]),
                ]),
            )),
        ),
        "Revolution Flurry of Catchphrases": (
            reverses: Some((targets: Antic, effects: [RingsideToArsenal(who: You, n: 5, up_to: true)])),
        ),
        "Revolution If You Smell What The Rock Is Cookin'!": (
            requires: Some(FortitudeBelowOpponent),
            on_play: [ThisToArsenal(bottom: true), RingsideToArsenal(who: You, n: 5, up_to: true)],
            reverses: Some((targets: Hybrid, requires: Some(FortitudeBelowOpponent))),
        ),

        // Brock Lesnar
        // Approximation: "his Hold: Core Maneuvers deal no Damage" is -30D. The Pre-match Capacity and the reversal
        // damage texts are not supported yet.
        "Revolution The War Machine": (
            while_in_ring_opponent: [
                (
                    applies_to: All([ManeuverType(Hold), Trait(Core), Holds(SuperstarValueBelowOpponent)]),
                    damage: -30,
                ),
            ],
        ),
        "Revolution Bringing Legitimacy Back to the WWE": (
            on_play: [
                RingsideToArsenal(who: You, n: 8, up_to: true),
                Boost((applies_to: ManeuverType(Trademark), duration: NextMatching, momentum: true)),
            ],
            reverses: Some((targets: Trait(Momentum), damage: None)),
        ),
        "Revolution Ground and Pound": (
            on_play: [RingsideToHand(who: You, n: 1, up_to: true, filter: Some(AnyOf([ManeuverType(Throw), ManeuverType(Hold)])))],
            momentum_when: Some(Superstar("Revolution Brock Lesnar")),
        ),
        // "Cannot be reversed from Backlash when played as a Counter" is not supported yet.
        "Revolution Lesnar's Overhead Release Throw": (),
        "Revolution F-5": (on_play: [Discard(who: Opponent, n: 5, pick: Chosen)]),
        "Revolution You Couldn't Hold My Jock Strap": (
            reverses: Some((targets: Antic, effects: [RingsideToHand(who: You, n: 1, up_to: true, filter: Some(Trait(Unique)))])),
        ),
        // Ending the opponent's turn after an Extreme dealt its damage is not supported yet.
        "Revolution I'm Proud of Everything I Do": (
            bonuses: [(fortitude: -7)],
            on_play: [RingsideToArsenal(who: You, n: 2, up_to: true, filter: Some(AnyOf([Target("head"), Target("neck")])))],
            reverses: Some((targets: All([Maneuver, AnyOf([Target("head"), Target("neck")])]))),
        ),
        "Revolution Here Comes the Pain": (
            on_play: [Mill(who: You, n: 3), Boost((applies_to: Maneuver, duration: NextMatching, damage: 5, momentum: true))],
        ),
        // Ignoring 'Requirement: Overturned' is not supported yet.
        "Revolution Return of the Anomaly": (
            on_play: [RingsideToArsenal(who: You, n: 5, up_to: true), DrawUpTo(who: You, n: 2)],
        ),

        // Chris Jericho
        "Revolution Undisputed": (
            mid_match_limit: 1,
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: All([Trait(Unique), TitleContains("Revolution")]),
                    effects: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, bottom: true)],
                ),
            ],
        ),
        "Revolution Running Back Elbow": (
            requires: Some(AnyOf([FortitudeBelowOpponent, Superstar("Revolution Chris Jericho")])),
            bonuses: [(when: Superstar("Revolution Chris Jericho"), fortitude: -4, damage: 2)],
        ),
        "Revolution Jericho's One-Handed Bulldog": (
            reverses: Some((
                targets: ManeuverType(Throw),
                effects: [
                    Discard(who: You, n: 1, pick: Chosen),
                    RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Not(Trait(Unique)), Not(Hybrid)]))),
                ],
            )),
        ),
        "Revolution Lionsault": (
            play_after: Some(AnyOf([Maneuver, Holds(Superstar("Revolution Chris Jericho"))])),
            on_play: [BacklashToRingside(who: Opponent, n: 1, random: true)],
        ),
        // The extra 'neck' Target is not supported yet.
        "Revolution Walls of Jericho": (
            on_play: [RingsideToHand(who: You, n: 1, up_to: true, filter: Some(Trait(Unique)))],
        ),
        "Revolution The Codebreaker": (
            on_play: [Discard(who: Opponent, n: 5, pick: Chosen)],
            reverses: Some((
                targets: AnyOf([
                    ManeuverType(Assault),
                    Trait(FollowUp),
                    All([Trait(Momentum), Holds(OpponentSuperstar("Revolution Chris Jericho"))]),
                ]),
            )),
        ),
        "Revolution Break Down the Walls": (
            reverses: Some((
                targets: AnyOf([
                    All([ManeuverType(Extreme), Trait(FollowUp)]),
                    All([
                        AnyOf([Antic, ManeuverType(Extreme)]),
                        Holds(AnyOf([OpponentSuperstar("Revolution Chris Jericho"), OpponentSuperstar("The Sexy Beast")])),
                    ]),
                ]),
                effects: [HandToArsenalBottom(who: You, n: 2)],
            )),
        ),
        // Ending the opponent's turn after a non-Unique antic dealt its damage is not supported yet.
        "Revolution I've Returned to Claim What Is Mine": (
            bonuses: [(fortitude: -7)],
            on_play: [RingsideToArsenal(who: You, n: 2, up_to: true, filter: Some(AnyOf([Target("head"), Target("back")])))],
            reverses: Some((targets: All([Maneuver, AnyOf([Target("chest"), Target("back")])]))),
        ),
        "Revolution Do You Understand What I'm Saying To You Right Now?": (
            on_play: [Counted(count: YourRingMatching(SuperstarSpecific), effect: Discard(who: Opponent, n: 0, pick: Chosen))],
        ),

        // King Booker
        // The Storyline Ability (blanking the opponent's Ability) is not supported yet.
        "Revolution The Official Coronation Ceremony": (value_bonus: 1, on_play: [Draw(who: You, n: 3)]),
        // Approximation: "F:0" is -40F.
        "Revolution All Hail King Booker!": (
            requires: Some(All([
                CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 15),
                Not(InYourRing(All([Maneuver, TitleContains("Desperate")]))),
            ])),
            on_play: [
                Boost((applies_to: All([Not(Trait(Unique)), Trait(Core), Maneuver]), duration: NextCard, fortitude: -40, momentum: true)),
            ],
        ),
        "Revolution Booker's Backhand Chop": (
            bonuses: [(damage: 3), (when: Superstar("Revolution King Booker"), fortitude: -5)],
            reverses: Some((
                targets: AnyOf([
                    ManeuverType(Assault),
                    All([ManeuverType(Strike), Holds(OpponentSuperstar("Revolution King Booker"))]),
                ]),
            )),
        ),
        "Revolution Booker's Thrust Kick": (on_play: [Boost((applies_to: Maneuver, duration: NextCard, momentum: true))]),
        // Ignoring modifications to the opponent's card is not supported yet.
        "Revolution Booker's Spinebuster": (
            reverses: Some((
                targets: AnyOf([Trait(Momentum), All([Trait(SetUp), Holds(OpponentSuperstar("Revolution King Booker"))])]),
            )),
        ),
        // Approximation: it has Momentum while you hold another 'kick' card, which you discard when you play it.
        "Revolution Booker's Scissor Kick": (
            momentum_when: Some(HandHas(All([TitleContains("kick"), Not(Title("Revolution Booker's Scissor Kick"))]))),
            before_reversal: [
                If(
                    condition: HandHas(TitleContains("kick")),
                    effects: [DiscardMatching(who: You, n: 1, filter: TitleContains("kick"), pick: Chosen)],
                ),
            ],
        ),
        "Revolution Queen Sharmell Interferes": (
            reverses: Some((targets: All([Maneuver, Not(Hybrid)]), effects: [DrawUpTo(who: You, n: 2)])),
        ),
        "Revolution Making a Royal Proclamation": (
            on_play: [
                Choice([
                    [],
                    [Draw(who: You, n: 1), HandToArsenalBottom(who: You, n: 1)],
                    [Draw(who: You, n: 2), HandToArsenalBottom(who: You, n: 2)],
                    [Draw(who: You, n: 3), HandToArsenalBottom(who: You, n: 3)],
                    [Draw(who: You, n: 4), HandToArsenalBottom(who: You, n: 4)],
                    [Draw(who: You, n: 5), HandToArsenalBottom(who: You, n: 5)],
                ]),
            ],
        ),
        "Revolution Kiss My Royal Feet!": (
            on_play: [
                Counted(count: YourRingMatching(TitleContains("Booker")), effect: Mill(who: Opponent, n: 0)),
                Counted(count: YourRingMatching(TitleContains("Booker")), effect: Discard(who: Opponent, n: 0, pick: Random)),
            ],
        ),

        // Sheamus
        // Gaining a logo and triggers on the opponent's draws are not supported yet.
        "Revolution The Great White": (requires: Some(Never)),
        "Revolution Celtic Axehandle Blow": (
            bonuses: [(when: Superstar("Revolution Sheamus"), fortitude: -4)],
            on_play: [DrawUpTo(who: You, n: 1)],
        ),
        // Approximation: the 7 cards go back on top in any order (not on the bottom).
        "Revolution Repeated Clubbing Forearms": (
            momentum_when: Some(Superstar("Revolution Sheamus")),
            on_play: [Arrange(who: You, n: 7), DrawUpTo(who: You, n: 1)],
        ),
        // Approximation: you choose the reversal.
        "Revolution Irish Curse Backbreaker": (
            reverses: Some((
                targets: All([Not(Trait(Core)), ManeuverType(Throw)]),
                effects: [RemoveFromRing(who: Opponent, n: 1, filter: All([Not(Trait(Unique)), Not(Hybrid), Reversal]))],
            )),
        ),
        // Approximation: not reversible from hand nor Backlash.
        "Revolution White Noise": (
            on_play: [
                Boost((applies_to: All([Not(Trait(Unique)), Maneuver, Target("back")]), duration: NextCard, no_hand_reversal: true)),
            ],
        ),
        "Revolution The Celtic Cross": (
            on_play: [
                MoveCards(who: You, from: Hand, to: Arsenal, n: 5, up_to: true, bottom: true),
                RingsideToHand(who: You, n: 5, up_to: true),
            ],
        ),
        "Revolution Brogue Kick": (
            reverses: Some((targets: Antic, effects: [Discard(who: Opponent, n: 5, pick: Chosen)])),
        ),
        "Revolution Listen Here, Fella": (
            reverses: Some((targets: All([Not(Trait(Unique)), Antic]), effects: [Draw(who: Opponent, n: 1)])),
        ),
        "Revolution Don't Make An Arse of Yourself": (on_play: [RingsideToArsenal(who: You, n: 9, up_to: true)]),

        // Daniel Bryan
        // Approximation: "F:0" is -30F.
        "Revolution Wrestling Specialist": (
            while_in_ring: [
                (applies_to: Title("Revolution Outmaneuver"), fortitude: -30),
                (applies_to: Title("Revolution Right on Target"), momentum: true),
            ],
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: Title("Revolution WWE Tribute to the Troops"),
                    effects: [MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Random, bottom: true)],
                ),
            ],
        ),
        "Revolution Jumping High Knee": (on_play: [DrawUpTo(who: You, n: 1)]),
        "Revolution Flying Headbutt Drop": (
            on_play: [Mill(who: You, n: 1), Discard(who: Opponent, n: 1, pick: Chosen)],
            ringside_ability: Some((effects: [DrawUpTo(who: You, n: 1), ThisToArsenal(bottom: true)])),
        ),
        "Revolution Bryan's Buzzsaw Kick": (
            on_play: [Discard(who: You, n: 1, pick: Chosen), Mill(who: Opponent, n: 1)],
            ringside_ability: Some((effects: [Draw(who: Opponent, n: 1), ReturnThis(to: Hand)])),
        ),
        // Approximation: "not reversed from Arsenal" is not checked; the damage is applied as extra damage.
        "Revolution The YES! Lock": (
            after_damage: [
                If(
                    condition: All([Superstar("Revolution Daniel Bryan"), HandAtLeast(4)]),
                    effects: [Optional([Discard(who: You, n: 4, pick: Chosen), Damage(who: Opponent, n: 15)])],
                ),
            ],
        ),
        // Approximation: reverses any Antic ('diva' in the text is not checked).
        "Revolution Question and Answer Time": (
            reverses: Some((
                targets: Antic,
                fortitude_when: Some((Not(OpponentIs("Diva")), 5)),
