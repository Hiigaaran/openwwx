                If(condition: HandAtLeast(4), effects: [Optional([Discard(who: You, n: 4, pick: Chosen), Damage(who: Opponent, n: 20)])]),
            ],
        ),

        // Elijah Burke
        "Revolution Burke's Flying Shoulder Block": (
            on_play: [
                MoveCards(who: You, from: Ringside, to: Arsenal, n: 4, up_to: true, bottom: true),
                DrawUpTo(who: You, n: 2),
            ],
        ),
        // The Backlash reversal limit is not supported yet.
        "Revolution The Silver-Tongued Pugilist": (
            on_play: [If(condition: OpponentHandLarger, effects: [DrawToMatchOpponent])],
        ),

        // Kevin Thorn
        "Revolution The Crucifix Drop": (
            on_play: [
                Mill(who: You, n: 2),
                RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Not(Trait(Unique)), Not(Maneuver)]))),
            ],
        ),
        // The non-random choice with a non-Revolution card in your Ring is not supported yet.
        "Revolution Bats in the Belfry": (
            on_play: [
                LookAtHand(who: Opponent),
                MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 2, up_to: true, pick: Controller),
                Draw(who: Opponent, n: 1),
            ],
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: AnyOf([ManeuverType(Extreme), Title("Revolution The Dark Kiss")]),
                    effects: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, filter: Some(Not(Maneuver)), pick: Random, bottom: true)],
                ),
            ],
        ),

        // Marcus Cor Von
        // Counting as an Extreme is not supported yet.
        "Revolution Alpha Male Kick": (
            on_play: [RingsideToHand(who: You, n: 1, up_to: true, filter: Some(ManeuverType(Extreme)))],
        ),
        "Revolution Roar of the Alpha Male": (
            bonuses: [(fortitude: -4)],
            on_play: [ShuffleThisIntoArsenal, RingsideToArsenal(who: You, n: 4, up_to: true), DrawUpTo(who: You, n: 1)],
        ),

        // Matt Striker
        // The 'dynamic' text replacement is not supported yet.
        "Revolution Matt Striker's Classroom": (
            pre_match_limit: 1,
            on_play: [Optional([MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 3, pick: Random), Draw(who: Opponent, n: 3)])],
        ),
        "Revolution Striker's Reciprocity Suplex": (
            on_play: [
                Discard(who: You, n: 2, pick: Chosen),
                RingsideToHand(who: You, n: 2, up_to: true, filter: Some(Not(Trait(Unique)))),
            ],
        ),

        // Sabu
        // Making the next maneuver an Assault is not supported yet.
        "Revolution The Houdini of Hardcore": (on_play: [Mill(who: You, n: 1)]),
        // Discarding this card from hand to draw is not supported yet.
        "Revolution Sabu's Camel Clutch": (bonuses: [(when: After(ManeuverType(Assault)), fortitude: -5)]),

        // Sandman
        // Playing Struck by a Singapore Cane from the Ring or Ringside is not supported yet.
        "Revolution Sandman's Singaporean Vengeance": (
            requires: Some(AnyOf([
                InYourRing(Title("Revolution Struck by a Singapore Cane")),
                CountAtLeast(count: YourRingsideMatching(Title("Revolution Struck by a Singapore Cane")), n: 1),
            ])),
            on_play: [Mill(who: You, n: 2)],
            reverses: Some((
                targets: All([Not(Trait(Unique)), Not(ManeuverType(Extreme)), Trait(Mean)]),
                requires: Some(AnyOf([
                    InYourRing(Title("Revolution Struck by a Singapore Cane")),
                    CountAtLeast(count: YourRingsideMatching(Title("Revolution Struck by a Singapore Cane")), n: 1),
                ])),
            )),
        ),
        // Putting a D:0 card from the Ring into the Ringside to ignore the Follow-up is not supported yet.
        "Revolution Sandman's Flying Leg Drop": (
            on_play: [
                MoveCards(who: You, from: Hand, to: Arsenal, n: 1, up_to: true, bottom: true),
                MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, bottom: true),
            ],
        ),

        // Terry Funk
        // The ECW Originals, Title Belt, reversal limit and Legend packing texts are not supported yet.
        "Revolution Original Hardcore Legend": (pre_match_limit: 2),
        // Approximation: "F: 0" is -30F.
        "Revolution Armed and Rambunctious": (
            on_play: [Search(filter: Title("Revolution Keeping It Original"), ringside: true, up_to: true)],
            while_in_ring: [(applies_to: Title("Revolution Keeping It Original"), fortitude: -30, no_backlash_reversal: true)],
        ),

        // Test
        // The packing limit is not supported yet.
        "Revolution The Impact Player": (
            while_in_ring: [(applies_to: All([Maneuver, Holds(FortitudeBelowOpponent)]), damage: 2)],
            while_in_ring_opponent: [(applies_to: All([Maneuver, Holds(OpponentSuperstar("Revolution Test"))]), damage: -2)],
            ring_ability: Some((
                requires: Some(Superstar("Revolution Test")),
                effects: [RingsideToArsenal(who: You, n: 6, up_to: true), DrawUpTo(who: You, n: 1)],
                sacrifice: true,
            )),
        ),
        "Revolution Test's Boot Choke": (
            bonuses: [(when: After(AnyOf([ManeuverType(Assault), ManeuverType(Extreme)])), damage: 2)],
        ),

        // Tommy Dreamer
        // The overturn, Ring and non-Revolution texts are not supported yet.
        "Revolution Beulah: Hardcore Liaison": (),
        // The Backlash reversal limit on the next 'ECW Originals' card is not supported yet.
        "Revolution The Heart of ECW": (
            on_play: [RingsideToArsenal(who: You, n: 5, up_to: true, filter: Some(Not(ManeuverType(Extreme))))],
        ),
    },
)
