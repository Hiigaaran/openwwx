// Hand-written scripts for V4: Saturday Night's Main Event (Raw Deal Virtual) cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// "Can be reversed as if it was non-Unique" on the 'Classic' maneuvers is not supported (they count as Unique).
// "Counter" = you reversed a card to end your opponent's last turn and this is your first card this turn.
// "Heenan Family Member": The Heenan Family in your Ring, or Ravishing Rick Rude.
// "Million Dollar Corporation Member": The Million Dollar Corporation in your Ring.
// "When your logo is printed on <Faction>" bonuses and ACE effects used during the opponent's turn are not supported.
// Superstar abilities make cards Multi or Chain with a start-of-turn Boost for that turn (not in the opponent's turn).
(
    abilities: {
        // Approximation: not limited to once per turn; Hulk Hogan / Macho Man cards are not limited to Unique ones.
        // The BASH and Revolution packing limits are not supported yet.
        "The Mega Powers": [
            OnOpponentReverses([
                Optional([
                    MoveCards(who: You, from: Hand, to: Arsenal, n: 1, filter: Some(Trait(Unique)), top: true),
                    Search(filter: All([Maneuver, SuperstarSpecific])),
                ]),
            ]),
            PacksLogos(["Hulk Hogan", "Macho Man", "Hollywood Hulk Hogan", "Macho Man Randy Savage"]),
            CannotPackTrait(Heel),
            CannotPackMatching(TitleBelt),
        ],
        // Approximation: the extra cards are drawn at the start of the turn, before the Draw Segment.
        // "Your Obey now reads 'Reverse any card'" is not supported yet.
        "The 8th Wonder of the World": [
            StartOfTurn([
                If(
                    condition: CountAtMost(count: HandSize, n: 4),
                    effects: [Optional([Counted(count: Minus(Const(7), HandSize), effect: Draw(who: You, n: 0))])],
                ),
            ]),
            PacksLogos(["Andre the Giant", "8th Wonder"]),
            CannotPack("We Face Each Other as God Intended"),
            CannotPackMatching(ManeuverType(HighRisk)),
            CannotPack("Frankie Takes Ho-llywood"),
            CannotPack("In The Interest Of Fairness"),
        ],
        // Making the opponent discard or overturn 2 cards to reverse Heat maneuvers is not supported yet.
        "The Iron Sheik": [CannotBeReversedBy(played: Title("Drawing Extra Heat"), reversal: DamageAtLeast(1))],
        // The +1 Stun Value is not supported yet.
        "Diesel": [
            Activated(
                cost: [HandToArsenalBottom(who: You, n: 1)],
                effects: [
                    Search(filter: All([
                        Maneuver,
                        Not(Trait(Unique)),
                        AnyOf([TitleContains("bomb"), TitleContains("power"), TitleContains("slam")]),
                    ])),
                ],
            ),
        ],
        // Flying Body Press and Chicken Wing becoming Trademark Finishers is not supported yet.
        "Ricky 'The Dragon' Steamboat": [
            StartOfTurn([Boost((applies_to: AnyOf([Title("Flying Body Press"), Title("Chicken Wing")]), duration: ThisTurn, multi: true))]),
            Activated(
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [
                    Search(filter: AnyOf([
                        TitleContains("chop"),
                        TitleContains("drag"),
                        TitleContains("flying"),
                        TitleContains("small package"),
                        TitleContains("toss"),
                    ])),
                ],
            ),
            PacksLogos(["Ricky Steamboat"]),
            CannotPack("Ring Psychology: Arm"),
        ],
        // Approximation: drawing up to the opponent's hand size +1 happens at the start of the turn.
        "Sid": [
            StartOfTurn([If(condition: OpponentHandLarger, effects: [Optional([DrawToMatchOpponent, Draw(who: You, n: 1)])])]),
            FortitudeFor(filter: All([Maneuver, Holds(FortitudeBelowOpponent)]), delta: -5),
        ],
        // "Your Fortitude is +3F" and the Managed by Mr. Fuji changes are not supported yet.
        "Yokozuna": [
            CannotPlayMatching(All([
                Maneuver,
                Not(Title("Yokozuna's Leg Drop")),
                EarlierThisTurn(filter: Maneuver, n: 1),
            ])),
            CannotPack("A Quick BASH-ing"),
        ],
        // The Cartwheel and Head Butt Drop texts are not supported yet.
        "Bam Bam Bigelow": [
            Activated(
                cost: [RemoveFromGame(who: You, from: Hand, n: 1)],
                effects: [
                    Counted(
                        count: Plus(YourRingStun, Const(1)),
                        effect: Boost((applies_to: Any, duration: NextCard, fortitude: -1)),
                    ),
                ],
            ),
        ],
        // Approximation: the opponent discards 1 card (not 1 + the Reversal's damage). Cannot pack Managers is not supported.
        "Hacksaw Jim Duggan": [
            Activated(
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [
                    Search(filter: All([
                        ManeuverType(Strike),
                        TitleContains("clothesline"),
                        Not(Hybrid),
                        Not(Keyword("Throwback")),
                    ])),
                    Boost((applies_to: TitleContains("clothesline"), duration: NextCard, fortitude: -8)),
                ],
            ),
            DamageFor(filter: TitleContains("clothesline"), delta: 1),
            OnOpponentReverses([
                If(
                    condition: OpponentReversed(TitleContains("clothesline")),
                    effects: [Discard(who: Opponent, n: 1, pick: Chosen)],
                ),
            ]),
        ],
        // The -1F per removed card and the Not According to the Fine Print text apply during your turns.
        "Irwin R. Schyster": [
            StartOfTurn([
                Boost((applies_to: All([Maneuver, Not(Trait(Unique))]), duration: ThisTurn, fortitude: -1, count: Some(OpponentRemoved))),
                Boost((applies_to: Title("Not According to the Fine Print"), duration: ThisTurn, ignore_play_after: true)),
            ]),
        ],
        // Approximation: not limited to once per turn, nor to maneuvers not reversed from the Arsenal.
        "Razor Ramon": [
            OnPlayMatching(
                filter: All([Maneuver, DamageAtLeast(4)]),
                effects: [
                    Optional([
                        Discard(who: You, n: 1, pick: Chosen),
                        OpponentChooses(n: 1, options: [
                            [Discard(who: Opponent, n: 2, pick: Chosen)],
                            [Mill(who: Opponent, n: 4)],
                        ]),
                    ]),
                ],
            ),
        ],
        "Ravishing Rick Rude": [
            Activated(
                cost: [
                    MoveCards(who: You, from: Hand, to: Arsenal, n: 1, filter: Some(TitleContains("neck breaker")), bottom: true),
                ],
                effects: [LookAtHand(who: Opponent), RingsideToArsenal(who: You, n: 2, up_to: true)],
                requires: Some(HandHas(TitleContains("neck breaker"))),
            ),
            FortitudeFor(filter: All([ManeuverType(Grapple), TitleContains("neck breaker")]), delta: -5),
        ],
        // "You are considered to have played no cards this turn" is not supported yet.
        "The Heart Break Kid": [],
        "Honky Tonk Man": [FortitudeFor(filter: AnyOf([TitleContains("interfere"), TitleContains("assistance")]), delta: -5)],
        // Approximation: reversing a Fan Favorite or Cheater card costs 1 discard instead of 2.
        // Removing Chain/Volley/Multi from the opponent's card is not supported yet.
        "Big Boss Man": [
            ReverseByDiscardingAny(AnyOf([Trait(FanFavorite), Trait(Cheater)])),
            CannotPackMatching(ManeuverType(HighRisk)),
            CannotPackTrait(FanFavorite),
            CannotPackTrait(Cheater),
        ],
        // The -#F applies during your turns.
        "Brutus 'The Barber' Beefcake": [
            PacksLogos(["Brutus Beefcake"]),
            OnOpponentReverses([
                If(
                    condition: OpponentReversed(TitleContains("Classic")),
                    effects: [DrawUpTo(who: You, n: 1), RingsideToArsenalBottom(who: You, n: 1)],
                ),
            ]),
            StartOfTurn([
                Boost((
                    applies_to: All([Maneuver, TitleContains("Classic"), Holds(OpponentRingHas(filter: Reversal, n: 5))]),
                    duration: ThisTurn,
                    fortitude: -1,
                    count: Some(OpponentRingMatching(Reversal)),
                )),
            ]),
        ],
        // The Chain search restriction is not supported yet.
        "Nikolai Volkoff": [
            OnPlayMatching(
                filter: All([Maneuver, Trait(Chain)]),
                effects: [
                    OpponentChooses(n: 1, options: [
                        [BacklashToRingside(who: Opponent, n: 2)],
                        [RemoveFromGame(who: Opponent, from: Ringside, n: 2, up_to: true, pick: Controller)],
                    ]),
                ],
            ),
            CannotBeReversedBy(played: Title("Drawing Extra Heat"), reversal: AnyOf([Trait(Unique), DamageAtLeast(1)])),
        ],
        // Making Tag logo maneuvers Chain and packing them are not supported yet. Approximation: all Bret Hart cards.
        "Hart Foundation": [
            StartOfTurn([Boost((applies_to: All([Maneuver, TitleContains("classic")]), duration: ThisTurn, chain: true))]),
            PacksLogos(["Bret Hart"]),
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
        ],
        // Putting removed cards in the Backstage Area is not supported yet.
        "Money Inc.": [
            PacksLogos(["The Million Dollar Man", "Million Dollar Man Ted DiBiase", "Irwin R. Schyster"]),
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
        ],
        // Turning Double Axe Handle cards into blank Strikes is not supported yet.
        "Demolition": [CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))]))],
        // Making the opponent's Reversals deal no damage is not supported yet.
        "The Natural Disasters": [
            FortitudeFor(filter: All([Maneuver, TitleContains("splash")]), delta: -2),
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
            CannotPack("Back Splash"),
        ],
        // Making the searched Propel Partner unanswerable and Tag logo cards Multi are not supported yet.
        "The Rockers": [
            StartOfTurn([Boost((applies_to: All([Maneuver, After(Title("Propel Partner"))]), duration: ThisTurn, multi: true))]),
            OnPlayMatching(filter: Maneuver, effects: [Search(filter: Title("Propel Partner"), ringside: true)]),
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
        ],
        // "Your cards cannot be modified" is not supported yet.
        "The Total Package": [PacksLogos(["Lex Luger"])],
    },
    scripts: {
        // Strikes
        "Classic Left Cross Punch": (
            on_play: [Search(filter: All([Maneuver, TitleContains("cross")]))],
            while_in_ring: [(applies_to: All([Maneuver, TitleContains("cross")]), stun_value: 1)],
        ),
        // Approximation: every 'cross' maneuver, not only the first two each turn.
        "Classic Right Cross Punch": (
            on_play: [Search(filter: All([Maneuver, TitleContains("cross")]))],
            while_in_ring: [(applies_to: All([Maneuver, TitleContains("cross")]), no_backlash_reversal: true)],
        ),
        "Classic Kick": (on_play: [Boost((applies_to: ManeuverType(TrademarkFinisher), duration: NextCard, fortitude: -6))]),
        // Becoming a High Risk is not supported yet.
        "Classic Elbow Smash": (not_reversed_by: Some(DamageAtLeast(2))),
        // Becoming a High Risk is not supported yet.
        "Classic Drop Kick": (),
        // The As Big and Tough as Any Two Men and Tag Team/Stable texts are not supported yet.
        "Classic Double Clothesline": (),
        "Classic Power Punch": (on_play: [Discard(who: You, n: 1, pick: Chosen)]),
        // Counting the next card as played after Throw Into the Corner Turnbuckle is not supported yet.
        "Classic Turnbuckle Smash": (
            bonuses: [(when: After(Title("Throw Into the Corner Turnbuckle")), reversal_fortitude: 8)],
        ),

        // Grapples
        "Classic Fireman's Carry": (on_play: [LookAtHand(who: Opponent)]),
        // "Considered to be blank for card effects" is not supported yet.
        "Classic Hip Toss": (),
        // The opponent's optional draw is not supported yet.
        "Classic Headlock Takedown": (on_play: [DrawUpTo(who: You, n: 1)]),
        "Classic Vertical Suplex": (on_play: [DrawUpTo(who: You, n: 1)]),
        "Classic Bulldog": (
            bonuses: [(when: YouAre("Trish Stratus"), fortitude: -2)],
            on_play: [RevealHand(who: Opponent), MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Controller, bottom: true)],
        ),
        // "Can only be reversed by cards that reverse Back Body Drop" is not supported yet.
        "Classic Back Body Drop": (),
        "Classic Bulldog Lariat": (
            bonuses: [(fortitude: -6)],
            not_reversed_by: Some(DamageAtLeast(1)),
            reverses: Some((
                targets: All([
                    AnyOf([ManeuverType(Strike), ManeuverType(Grapple), ManeuverType(Submission)]),
                    Keyword("RMS"),
                ]),
            )),
        ),

        // Submissions
        "Classic Wrist Lock": (on_play: [RingsideToArsenalBottom(who: You, n: 1)]),
        // The ACE (removing it to blank the opponent's maneuver) is not supported yet.
        "Classic Arm Bar": (),
        "Classic Headlock": (
            on_play: [
                Discard(who: Opponent, n: 1, pick: Chosen),
                Optional([Discard(who: You, n: 1, pick: Chosen), Discard(who: Opponent, n: 1, pick: Chosen)]),
            ],
        ),
        "Classic Abdominal Stretch": (on_play: [Search(filter: AnyOf([TitleContains("leverage"), TitleContains("maintain")]))]),
        // Removing an overturned card is not supported yet.
        "Classic Claw": (reversal_limits: [(from: [Hand, Backlash, Ringside])]),

        // High Risk
        // The +1 Stun Value is not supported yet.
        "Classic Knee to the Groin": (
            requires: Some(All([ReversedLastTurn(Maneuver), FirstCardThisTurn])),
            bonuses: [(damage: 4)],
        ),

        // Trademark Finishers
        // "You must discard 2 cards to play a Trademark Finisher" and -1 Stun Value are not supported yet.
        "What a Maneuver!": (bonuses: [(per: Some(ManeuverType(TrademarkFinisher)), damage: -5)]),

        // Actions
        // Blocking Restricted Use In This Area is not supported. The ACE from the Ring and Ringside returns it to hand.
        "On the Warpath": (
            not_packed_by: ["The Home Team"],
            on_play: [
                Search(filter: TitleContains("chop")),
                Boost((applies_to: AnyOf([TitleContains("chop"), TitleContains("samoan drop"), TitleContains("war")]), duration: NextCard, multi: true)),
            ],
            ring_ability: Some((cost: [Discard(who: You, n: 3, pick: Chosen)], effects: [ReturnThis(to: Hand)])),
            ringside_ability: Some((cost: [Discard(who: You, n: 3, pick: Chosen)], effects: [ReturnThis(to: Hand)])),
        ),
        "Time to Take Out the Trash!": (
            not_packed_by: ["The Home Team"],
            on_play: [
                Counted(
                    count: Plus(
                        Const(1),
                        Plus(OpponentRingMatching(TitleContains("trash")), OpponentRingsideMatching(TitleContains("trash"))),
                    ),
                    effect: RemoveFromRing(who: Opponent, n: 0, filter: Any),
                ),
            ],
        ),
        // Rhyming titles are not supported.
        "A Poem From The Genius": (requires: Some(Never)),
        // Counting the next card as played after Throw Opponent Out of the Ring is not supported yet.
        "Husssssssssssssss!": (
            on_play: [
                Search(filter: All([Not(Reversal), Not(Trait(Unique))])),
                Search(filter: Title("Roll Out of the Ring")),
                Mill(who: Opponent, n: 6),
            ],
        ),
        // Stealing cards from the opponent's Ring and copying his searches are not supported yet.
        "What's Mine is Mine and What's Yours is Mine": (
            not_packed_by: ["The Heat Seekers"],
            on_play: [DrawUpTo(who: You, n: 2), RingsideToHand(who: You, n: 1, up_to: true)],
        ),
        // Going to the Ring when unsuccessful is not supported yet.
        "Win If you Can, Lose if you Must, But Always Cheat": (
            not_packed_by: ["The Heat Seekers"],
            on_play: [
                RingsideToHand(who: You, n: 3, up_to: true, filter: Some(AnyOf([Trait(Heel), Trait(Cheater)]))),
                MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, top: true),
            ],
            ring_ability: Some((
                cost: [BacklashToRingside(who: You, n: 1), Discard(who: You, n: 2, pick: Chosen)],
                effects: [RingsideToBacklash(who: You, n: 1)],
            )),
        ),
        // The BASH texts are not supported yet.
        "I'll BASH You 'Til Fiiiiive!": (not_packed_by: ["Kane"], on_play: [RingsideToArsenal(who: You, n: 5, up_to: true)]),
        "The Princess Bride": (
            fortitude_discount: Some((per: 8, max: 2, overturn: true)),
            on_play: [
                Search(filter: All([Action, Keyword("Run-in")])),
                Search(filter: All([Maneuver, FortitudeAtMost(0)])),
            ],
        ),

        // Reversals
        "Ole!": (
            not_packed_by: ["The Home Team"],
            reverses: Some((targets: Not(Any))),
            after_success: Some((
                filter: All([Maneuver, Not(Trait(Unique)), Not(SuperstarSpecific)]),
                at: BeforeEffects,
                cancel: true,
                end_turn: false,
                effects: [Discard(who: You, n: 1, pick: Chosen), RingsideToArsenal(who: You, n: 7, up_to: true)],
            )),
        ),
        "You're a Jive Soul Bro!": (
            not_packed_by: ["The Heat Seekers"],
            reverses: Some((
                targets: All([Not(SuperstarSpecific), Not(Maneuver)]),
                effects: [Draw(who: You, n: 1), RemoveFromGame(who: Opponent, from: Ringside, n: 4, pick: Controller)],
            )),
        ),
        "Shocking Interference": (
            not_packed_by: ["The Heat Seekers"],
            on_play: [Discard(who: Opponent, n: 6, pick: Chosen)],
            reverses: Some((
                targets: All([Not(Trait(Unique)), Not(SuperstarSpecific)]),
                effects: [MillUntil(who: Opponent, filter: Reversal), MillUntil(who: Opponent, filter: Reversal)],
            )),
        ),
        // "Counts as 2 reversal cards" and the ACE are not supported yet.
        "A Giant Assist": (
            reverses: Some((
                targets: Maneuver,
                requires: Some(AnyOf([InYourRing(Title("The Heenan Family")), YouAre("Ravishing Rick Rude")])),
            )),
        ),
        // Reversing Activated Card Effects and the ACE are not supported yet.
        "Rude-ly Interrupting": (
            reverses: Some((
                targets: Trait(MidMatch),
                requires: Some(AnyOf([InYourRing(Title("The Heenan Family")), YouAre("Ravishing Rick Rude")])),
            )),
        ),
        // The Backlash discount and the draw-and-bury are not supported yet.
        "Thinking One Step Ahead": (
            reverses: Some((
                targets: All([Not(Trait(Unique)), AnyOf([Not(Maneuver), Hybrid])]),
                requires: Some(AnyOf([InYourRing(Title("The Heenan Family")), YouAre("Ravishing Rick Rude")])),
            )),
        ),
        "Once is Enough": (reverses: Some((targets: AnyOf([Trait(Multi), SameTitleInRing])))),
        "Sloppy ... Very Sloppy": (
            reverses: Some((
                targets: Any,
                from_hand_only: true,
                fortitude_when: Some((AnyOf([YouAre("Mae Young"), YouAre("The Fabulous Moolah"), YouAre("Moolah")]), 6)),
            )),
        ),
        "Manager Interferes": (reverses: Some((targets: Maneuver, effects: [Draw(who: You, n: 1), Draw(who: Opponent, n: 1)]))),
        "Help's On the Way!": (
            not_with: ["Tori Enters the Fray!"],
            reverses: Some((
                targets: All([Maneuver, Not(ManeuverType(TrademarkFinisher))]),
                effects: [RingsideToArsenal(who: You, n: 2, up_to: true)],
            )),
        ),

        // Pre-match
        // Approximation: the belt with 'World Wrestling Federation' in the title also comes from the Backlash.
        // The Pencil-Necked Geek text is not supported yet.
        "Classy Freddie Blassie, The Maker of Champions": (
            only_packed_by: ["Legend", "WWF Classic"],
            pre_match_limit: 1,
            end_of_prematch: [
                MoveCards(
                    who: You,
                    from: Backlash,
                    to: Ring,
                    n: 2,
                    up_to: true,
                    filter: Some(AnyOf([
                        Title("Managed by 'Classy' Freddie Blassie"),
                        All([TitleBelt, TitleContains("World Wrestling Federation")]),
                    ])),
                ),
            ],
        ),
        // Making the listed cards Unique/Permanent and unanswerable is not supported yet.
        "Interviewed by Mean Gene Okerlund": (
            not_packed_by: ["Cryme Tyme", "Eddie Guerrero", "Eugene", "Mr. Pay-Per-View", "The Home Team"],
        ),
        // The Survivor Series texts are not supported yet.
        "The Survivor Series Surprise is...The Gobbledygooker!": (pre_match_limit: 1),
        // Blanking the opponent's Manager or Object and returning it from the Ringside are not supported yet.
        "Managed by Mr. Fuji": (
            only_packed_by: ["Legend", "WWF Classic"],
            end_of_prematch: [DrawUpTo(who: You, n: 1)],
            ring_ability: Some((
                sacrifice: true,
                effects: [Boost((applies_to: Maneuver, duration: NextMatching, damage: 5, reversal_damage: 3))],
            )),
        ),
        // The Pay-Per-View Event and WrestleMania texts are not supported yet.
        "Madison Square Garden, New York City": (),
        // The blank-text draw and the Ultimate Warrior texts are not supported yet.
        "Parts Unknown": (hand_size_bonus: 3, opponent_hand_size_bonus: 2),
        // Approximation: the Hand Size bonus applies to every Superstar. The Capacity and 'Classic' texts are not supported yet.
        "Saturday Night's Main Event": (hand_size_bonus: 1),
        // Approximation: the Million Dollar Corporation bonuses apply with 10+ of your cards removed; logo bonus not supported.
        "The Million Dollar Corporation": (
            while_in_ring: [
                (applies_to: All([Maneuver, Holds(CountAtLeast(count: YourRemoved, n: 10))]), fortitude: -2, damage: 1),
                (applies_to: All([Action, Not(SuperstarSpecific), Holds(CountAtLeast(count: YourRemoved, n: 10))]), fortitude: -2),
            ],
        ),
        // The Heenan Family texts (Permanent Manager, Unique reversals not affected) are not supported yet.
        "The Heenan Family": (),
        "What'cha Gonna Do When The Mega Powers Come Runnin' Through?": (
            ring_ability: Some((
                requires: Some(OpponentRingHas(filter: Maneuver, n: 5)),
                effects: [
                    ReturnThis(to: Removed),
                    Boost((applies_to: All([Maneuver, DamageAtMost(7)]), duration: NextMatching, no_hand_reversal: true)),
                ],
            )),
        ),
        // Approximation: "Eliminate" removes it from the game and "Recover 8-" shuffles up to 8 Ringside cards into the Arsenal.
        "Giant Eiffel Tower": (
            while_in_ring: [(applies_to: Maneuver, damage: 2)],
            ring_ability: Some((effects: [ReturnThis(to: Removed), RingsideToArsenal(who: You, n: 8, up_to: true)])),
        ),
        // Naming a maneuver to make it Heat is not supported yet.
        "IRAN... Number One!": (
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: All([Maneuver, Keyword("Heat")]),
                    effects: [
                        MillChosen(who: You, n: 1, filter: Some(All([Maneuver, Keyword("Heat")]))),
                        If(condition: OpponentIs("Legend"), effects: [RevealHand(who: Opponent)]),
                    ],
                ),
            ],
        ),
        // The ACE is not supported yet.
        "Diesel Power": (
            end_of_prematch: [
                LookAtHand(who: Opponent),
                MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, filter: Some(Reversal), pick: Controller),
                OpponentChooses(n: 1, options: [[Discard(who: Opponent, n: 2, pick: Chosen)], [Draw(who: You, n: 2)]]),
            ],
        ),
        // Approximation: always 3 cards; the opponent puts 2 random cards on the bottom.
        "Sycho Sid": (
            ring_ability: Some((
                effects: [
                    HandToArsenalBottom(who: You, n: 3),
                    MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 2, pick: Random, bottom: true),
                    Draw(who: Opponent, n: 1),
                ],
            )),
        ),
        // The ACE is not supported yet.
        "The Biggest Champion in WWF History": (end_of_prematch: [Search(filter: All([Maneuver, Not(Trait(Unique)), Not(Hybrid)]))]),
        // Approximation: every non-Unique maneuver with Stun Value. The Head Butt Drop text is not supported yet.
        "Asbury Park, New Jersey": (
            while_in_ring: [(applies_to: All([Maneuver, StunValueAtLeast(1), Not(Trait(Unique))]), no_backlash_reversal: true)],
        ),
        // Doubling the USA! USA! USA! numbers is not supported yet.
        "American Flag": (),
        "You're All a Bunch of Tax Cheats!": (
            end_of_prematch: [Mill(who: Opponent, n: 5), RemoveFromGame(who: Opponent, from: Ringside, n: 2, pick: Chosen)],
        ),
        "Say Hello to the Bad Guy": (
            end_of_prematch: [Search(filter: Trait(Heel))],
            ring_ability: Some((
                sacrifice: true,
                effects: [Counted(count: Plus(YourRingMatching(Trait(Heel)), Const(2)), effect: RingsideToArsenal(who: You, n: 0, up_to: true))],
            )),
        ),
        // Immediately playing more Pre-match cards and the 'neck breaker' choices are not supported yet.
        "Cut the Music!": (
            end_of_prematch: [
