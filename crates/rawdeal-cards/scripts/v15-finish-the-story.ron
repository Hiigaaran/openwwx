// Hand-written scripts for V15: Finish The Story (Raw Deal Virtual set 51) cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// "Counter" = you reversed a card to end your opponent's last turn and this is your first card this turn.
// "Promo: N" is approximated as `Dig`: you keep 1 of the top N cards and the rest go on the bottom of the Arsenal.
// "Bury" puts cards on the bottom of the Arsenal; "Stack" on top; "RFG" / "Eliminate" remove them from the game;
// "Recover" shuffles cards into the Arsenal. "Arsenal Search N" = `Search`; "Ringside Search N" = `RingsideToHand`.
// "N+ lower Fortitude" = `CountBelow(a: Plus(YourFortitude, Const(N - 1)), b: OpponentFortitude)`.
// "Reversal: Special" cards: "Reverse any X" is the reversal target. Reversals after a card was successfully
// played, of card effects, of ACEs and of "cards that move cards from a Ringside" are not supported
// (`targets: Not(Any)`).
// ACE (Activated Card Effects) are ring abilities used during your own turn. Not supported: face-down (Flip)
// cards, conditional Multi / Chain / TMF / card types, "only reversed by N reversals", 'completely', "cannot be
// blanked or blocked", "your opponent cannot respond", conditional "cannot be reversed from Hand / Backlash /
// Arsenal", "must Bury / RFG N to play reversals to this card", "does not take up a Ring slot", "In Hand:" and
// "In Backlash:" triggers, "reveal this card when ..." Backstage cards (they start hidden), cards played from the
// Backstage Area or the removed pile, playing two cards at once, and packing permissions (only other Superstars'
// logos, with `PacksLogos`).
// "Spirit Squad member" = The Spirit Squad, one of its members, or We Are The Spirit Squad! in your Ring;
// "LDF member" = Legado del Fantasma in your Ring; "LWO member" = LWO in your Ring; "you are HIM" = HIM revealed
// and 10+ lower or 10+ greater Fortitude.
(
    abilities: {
        // The logo cards print "Trish Stratus". Approximation: the ability digs 5 cards instead of the discarded
        // card's Fortitude (overturning instead of discarding is not supported). Managers cannot be told apart.
        "Canada's Greatest Export": [
            PacksLogos(["Trish Stratus"]),
            Activated(cost: [Discard(who: You, n: 1, pick: Chosen)], effects: [Dig(n: 5, take: 1)], requires: Some(HandAtLeast(1))),
            CannotPackMatching(Keyword("Run-in")),
            CannotPack("Evening Gown Match"),
        ],
        // The logo cards print "Lita". Reversing during the opponent's turn with the ability is not supported yet.
        "Crimson Goddess": [PacksLogos(["Lita"]), CannotPackMatching(Keyword("Run-in"))],
        // The non-Superstar-specific Hybrid reversal damage text and the packing permissions are not supported yet.
        "Logan Paul": [
            OnPlayMatching(
                filter: All([Maneuver, Not(Trait(Chain))]),
                effects: [Dig(n: 2, take: 1), MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, bottom: true)],
            ),
            OnOpponentReverses([
                If(condition: OpponentReversed(All([Maneuver, Not(Trait(Chain))])), effects: [HandToArsenalBottom(who: Opponent, n: 2), Draw(who: Opponent, n: 1)]),
            ]),
            CannotPack("Frankie Takes Ho-llywood"),
        ],
        // The Drew McIntyre logo cards may be packed ('Hits' cards are not excluded). Blanking the non-Unique
        // maneuvers, Multi: 3 and the RFG are not supported yet.
        "The Scottish Warrior": [
            PacksLogos(["Drew McIntyre"]),
            CannotPackTrait(Chain),
            CannotPackMatching(Keyword("Heat")),
            CannotPackMatching(Keyword("Volley")),
            CannotPackMatching(TitleContains("Frankie")),
        ],
        // The Promo discard trigger and the Grab the Mic! text are not supported yet.
        "L.A. Knight": [CannotPackTrait(Chain)],
        // Approximation: the opponent removes 2 random Ringside cards (not the card's Stun Value +1).
        "Liv Morgan": [
            Activated(
                cost: [RemoveFromGame(who: You, from: Ring, n: 1, filter: Some(Not(Trait(Active))))],
                effects: [RemoveFromGame(who: Opponent, from: Ringside, n: 2, pick: Random)],
                requires: Some(InYourRing(Not(Trait(Active)))),
            ),
        ],
        // Drawing when the opponent draws for a card effect is not supported yet.
        "Tiffany Stratton": [],
        "Mandy Rose": [
            OnPlayMatching(filter: Maneuver, effects: [RemoveFromGame(who: Opponent, from: Ringside, n: 1, pick: Controller)]),
            OnOpponentReverses([
                If(condition: OpponentReversed(Maneuver), effects: [RemoveFromGame(who: Opponent, from: Ringside, n: 2, pick: Chosen)]),
            ]),
            CannotPack("Lethal nWo Poison"),
        ],
        "Jey Uso": [
            OnPlayMatching(filter: ManeuverType(HighRisk), effects: [RemoveFromGame(who: Opponent, from: Ring, n: 1, up_to: true, pick: Controller)]),
        ],
        // The Superkick / Samoan Drop text is not supported yet.
        "Jimmy Uso": [
            OnOpponentReverses([
                If(
                    condition: OpponentReversed(Maneuver),
                    effects: [Optional([RingsideToHand(who: You, n: 1, filter: Some(Not(Reversal)))])],
                ),
            ]),
        ],
        // Approximation: the High Risk right after Springboard cannot be reversed from hand, Backlash or Ringside
        // (only from the Arsenal) and ends your turn.
        "Carmelo Hayes": [
            OnPlayMatching(
                filter: Title("Springboard"),
                effects: [Boost((applies_to: ManeuverType(HighRisk), duration: NextCard, no_hand_reversal: true, end_turn: true))],
            ),
        ],
        // The Multi: 3 High Risk and the Faction slot text are not supported yet.
        "Santos Escobar": [],
        "Toxic Attraction": [
            StartOfTurn([
                OpponentChooses(n: 1, options: [[RemoveFromGame(who: Opponent, from: Ringside, n: 2, pick: Random)], [Mill(who: Opponent, n: 2)]]),
            ]),
            CannotPack("Lethal nWo Poison"),
        ],
        // The Chase University ACE trigger and the STF text are not supported yet.
        "Andre Chase": [CannotPackMatching(Keyword("Foreign Object"))],
        // The discard / overturn triggers, We Are Not Your Kind and revealing Students are not supported yet
        // (Student cards are revealed like other Backstage cards).
        "Chase U.": [CannotPackMatching(Keyword("Foreign Object"))],
    },
    scripts: {
        // Backstage cards
        // The packing text and "cannot be revealed during any player's turn" are not supported yet.
        "Raw Deal 25th Anniversary": (
            backstage_ability: Some((effects: [DrawUpTo(who: You, n: 2), MoveCards(who: You, from: Ringside, to: Arsenal, n: 5, up_to: true, bottom: true)], sacrifice: true)),
        ),
        // The packing texts are not supported yet.
        "Breaking Barriers for Women's Wrestling": (
            backstage_ability: Some((
                effects: [
                    RingsideToHand(
                        who: You,
                        n: 1,
                        filter: Some(AnyOf([
                            All([Maneuver, AnyOf([Trait(SmackDown), Keyword("BASH")])]),
                            Title("Back Breaker Torture Rack"),
                            Title("Rolling Headlock Vice"),
                            Title("Short Arm Rib Breaker"),
                            Title("The Era of The Superstar"),
                        ])),
                    ),
                ],
                sacrifice: true,
            )),
        ),
        // "Reveal this card when ..." is not supported (it starts hidden).
        "I'll Show You Extreme!": (starts_hidden: true),
        // "Reveal this card when ..." is not supported (it starts hidden). "Cannot be packed by an ECW Superstar"
        // is left out (`not_packed_by` with a Superstar trait breaks automatic decks).
        "We're Hardcore 24/7": (starts_hidden: true),

        // Pre-match
        // Becoming an Event, the ACE during the opponent's turn and the 'Table!' texts are not supported yet.
        "Tables Match": (),
        // Choosing the opponent's next card is not supported yet.
        "Calling You Out": (),
        // Counting as Lilian: Amazing Announcer and the packing restriction are not supported yet.
        "Magnificent Intro by Lilian Garcia": (pre_match_limit: 1, mid_match_limit: 1),

        // Mid-match
        // Approximation: you put 1 non-Unique card (with or without an ACE) from their Ring into their Ringside.
        // The other choices are not supported yet.
        "WrestleMania Goes Hollywood!": (
            bonuses: [(when: InYourRing(TitleContains("Wrestlemania")), fortitude: -5)],
            on_play: [RemoveFromRing(who: Opponent, n: 1, filter: Not(Trait(Unique)))],
            ring_ability: Some((
                requires: Some(HandHas(Keyword("Movie"))),
                cost: [DiscardMatching(who: You, n: 1, filter: Keyword("Movie"), pick: Chosen)],
                effects: [ReturnThis(to: Backlash), EndTurn],
            )),
        ),

        // Strikes / Submissions
        // The "only reversed from Arsenal" text is not supported yet.
        "Iron Claw": (bonuses: [(when: AnyOf([OpponentIs("GM"), OpponentIs("Legend")]), fortitude: -9)]),
        // The D: 1+ reversal restriction is not supported yet.
        "Thrown into the Ring Steps": (
            bonuses: [(when: CountBelow(a: Plus(YourFortitude, Const(4)), b: OpponentFortitude), fortitude: -10)],
            from_ringside: Some(CountBelow(a: Plus(YourFortitude, Const(4)), b: OpponentFortitude)),
            reverses: Some((targets: All([Action, Not(Trait(Unique)), Not(SuperstarSpecific)]), damage: Fixed(0))),
        ),
        // Being a TMF is not supported yet.
        "Everything and the Kitchen Sink": (
            requires: Some(BackstageRevealed(who: You, filter: AnyOf([Keyword("ECW"), TitleContains("Hardcore")]))),
            after_damage: [
                If(condition: CountAtLeast(count: YourRingMatching(All([Maneuver, Keyword("Foreign Object")])), n: 8), effects: [WinByPin]),
            ],
        ),

        // Actions
        // Approximation: "Enrolled at Chase University" = Chase University in your Ring; the boost after the
        // reversal is for your first card next turn.
        "Hold the Megaphone!": (
            requires: Some(AnyOf([AnyOf([YouAre("The Spirit Squad"), YouAre("Johnny"), YouAre("Kenny"), YouAre("Mitch"), YouAre("Nicky"), YouAre("Mikey"), InYourRing(Title("We Are The Spirit Squad!"))]), InYourRing(Title("Chase University"))])),
            bonuses: [(fortitude: -5)],
            on_play: [DrawUpTo(who: You, n: 1), HandToArsenalBottom(who: Opponent, n: 1)],
            reverses: Some((
                targets: All([Action, Not(SuperstarSpecific)]),
                from_hand_only: true,
                requires: Some(AnyOf([AnyOf([YouAre("The Spirit Squad"), YouAre("Johnny"), YouAre("Kenny"), YouAre("Mitch"), YouAre("Nicky"), YouAre("Mikey"), InYourRing(Title("We Are The Spirit Squad!"))]), InYourRing(Title("Chase University"))])),
                effects: [Boost((applies_to: Maneuver, duration: NextTurnFirstCard, fortitude: -5, reversal_fortitude: 10))],
            )),
        ),
        "Top Deck": (
            irreversible_when: Some(AnyOf([YouAre("The Miz"), YouAre("Maryse")])),
            on_play: [ShuffleThisIntoArsenal, MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, top: true)],
        ),
        "The 40-Year-Old Banger": (
            irreversible_when: Some(AnyOf([
                YouAre("Sheamus"), YouAre("Pete Dunne"), YouAre("Ridge Holland"), YouAre("Drew McIntyre"),
                YouAre("The Scottish Warrior"), YouAre("The Brawling Brutes"),
            ])),
            on_play: [NextPlayWatch(filter: Maneuver, on_reversed: [Discard(who: Opponent, n: 4, pick: Chosen)])],
        ),
        // Face-down (Flip) cards are not supported yet.
        "Stranger Rings": (requires: Some(Never)),
        // Approximation: they overturn 4 (not the removed card's Damage).
        "TitanEST": (
            irreversible_when: Some(AnyOf([YouAre("Bianca Belair"), YouAre("Montez Ford"), YouAre("Street Profits")])),
            on_play: [RemoveFromGame(who: Opponent, from: Ring, n: 1, pick: Controller), Mill(who: Opponent, n: 4)],
        ),
        "To The Man-Cave!": (
            irreversible_when: Some(AnyOf([YouAre("Becky Lynch"), YouAre("The Man"), YouAre("Seth Rollins"), YouAre("The Visionary")])),
            on_play: [
                Dig(n: 6, take: 1),
                MoveCards(who: You, from: Ringside, to: Arsenal, n: 6, up_to: true, bottom: true),
                Boost((applies_to: TitleContains("Precision"), duration: NextCard, irreversible: true)),
            ],
        ),
        // Approximation: you choose 2 cards of their hand and they remove them from the game.
        "Bloodfellas": (
            irreversible_when: Some(AnyOf([
                YouAre("The Bloodline"), YouAre("The Tribal Chief"), YouAre("Roman Reigns"), YouAre("Paul Heyman"),
                YouAre("The Usos"), YouAre("Solo Sikoa"), YouAre("Jey Uso"), YouAre("Jimmy Uso"),
            ])),
            on_play: [LookAtHand(who: Opponent), RemoveFromGame(who: Opponent, from: Hand, n: 2, pick: Controller)],
        ),

        // Canada's Greatest Export / Trish Stratus
        // The Face / Heel bury texts are not supported yet. Approximation: the hide search takes up to 10
        // Superstar-specific cards (any logo).
        "100% Stratusfaction Guaranteed": (
            backstage_abilities: [FortitudeFor(filter: All([Maneuver, Holds(InYourRing(Trait(Face)))]), delta: -5)],
            backstage_ability: Some((effects: [RingsideToHand(who: You, n: 10, up_to: true, filter: Some(SuperstarSpecific))], sacrifice: true)),
        ),
        // Approximation: the Trish Stratus-specific non-Hybrid actions are -30F. The reversal restrictions are not
        // supported yet.
        "It's Time to Rock and Roll": (
            pre_match_limit: 2,
            mid_match_limit: 2,
            while_in_ring: [(applies_to: All([Action, SuperstarSpecific, Not(Hybrid)]), fortitude: -30)],
        ),
        // The "only reversed from Arsenal" text and counting as Face and Heel are not supported yet.
        "I'm Not Your Teenage Fantasy!": (
            bonuses: [(when: CountBelow(a: Plus(YourFortitude, Const(9)), b: OpponentFortitude), fortitude: -10)],
            on_play: [
                DrawUpTo(who: You, n: 2),
                LookAtHand(who: Opponent),
                MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Controller, bottom: true),
            ],
        ),
        // Playing a second Submission with it and the Ring trigger are not supported yet.
        "Trish Hook": (on_play: [DrawUpTo(who: You, n: 1)]),
        // The Ringside bury trigger is not supported yet.
        "Trish's Sharpshooter": (
            on_play: [
                RemoveFromRing(who: Opponent, n: 1, filter: Any),
                MoveCards(who: You, from: Ringside, to: Arsenal, n: 2, up_to: true, bottom: true),
                Choice([[Search(filter: Title("Maintain Hold"))], [DrawUpTo(who: You, n: 1)]]),
            ],
        ),
        // The discard-from-hand text is not supported yet.
        "Trish's Chick Kick": (
            bonuses: [(fortitude: -15)],
            while_in_ring: [(applies_to: Title("Stratusfaction Bulldog"), damage: 10)],
        ),
        "Thank You Trish!": (
            on_play: [
                MoveCards(who: You, from: Removed, to: Arsenal, n: 3, up_to: true),
                DrawUpTo(who: You, n: 2),
                If(
                    condition: Superstar("Canada's Greatest Export"),
                    effects: [
                        Counted(count: YourRingMatching(SuperstarSpecific), effect: RingsideToArsenal(who: You, n: 0, up_to: true)),
                        Counted(count: YourRingMatching(SuperstarSpecific), effect: Mill(who: Opponent, n: 0)),
                    ],
                ),
                If(
                    condition: Not(Superstar("Canada's Greatest Export")),
                    effects: [
                        OpponentChooses(n: 1, options: [
                            [Counted(count: YourRingMatching(SuperstarSpecific), effect: RingsideToArsenal(who: You, n: 0, up_to: true))],
                            [Counted(count: YourRingMatching(SuperstarSpecific), effect: Mill(who: Opponent, n: 0))],
                        ]),
                    ],
                ),
            ],
        ),

        // Crimson Goddess / Lita
        // Backstage packing, putting Arsenal reversals into the Ring and the Fortitude bonus are not supported yet.
        "Attitude Era's X-Treme Redhead": (),
        // Approximation: +1 Pre-match capacity for "does not take up a Ring slot". The Title Belt and Lita texts are
        // not supported yet.
        "X-Treme Women's Champion": (
            pre_match_limit: 1,
            end_of_prematch: [
                Optional([MoveCards(who: You, from: Backlash, to: Ring, n: 1, up_to: true, filter: Some(Title("High-Flying Style")))]),
            ],
        ),
        // Approximation: they Bury their hand, draw as many and Bury 2. Multi is not supported yet.
        "Vertigo": (on_play: [BuryHand(who: Opponent, then: Draw), HandToArsenalBottom(who: Opponent, n: 2)]),
        "The Goddess Returns": (
            reverses: Some((targets: All([Maneuver, Not(ManeuverType(TrademarkFinisher))]), overturned_only: true)),
            ring_ability: Some((effects: [ThisToArsenal(bottom: true), Draw(who: You, n: 1)])),
        ),
        // Reversing ACEs and the Title Belt text are not supported yet.
        "Crimson Champions": (
            on_play: [DrawUpTo(who: You, n: 2), MoveCards(who: You, from: Ringside, to: Arsenal, n: 2, up_to: true, bottom: true)],
            reverses: Some((
                targets: All([Maneuver, Not(ManeuverType(TrademarkFinisher))]),
                overturned_only: true,
                requires: Some(Superstar("Crimson Goddess")),
            )),
        ),

        // Logan Paul
        // Playing Pre-match cards at any time and the Ringside / High Risk texts are not supported yet.
        "ImPaulsive": (),
        // The Counter texts are not supported yet.
        "The Maverick": (),
        // Treating their maneuvers as other types and choosing their next card are not supported yet.
        "The Ultimate Influencer": (),
        // The Springboard reversal restriction is not supported yet.
        "Logan's ImPaulsive Leap": (on_play: [Dig(n: 3, take: 1)]),
        // The +1 Stun and the -#F / +#D choice are not supported yet.
        "One Lucky Punch": (
            bonuses: [(when: Not(InYourRing(Maneuver)), fortitude: -20)],
            not_reversed_by: Some(Not(Trait(Unique))),
        ),
        // Reversing maneuvers not played from hand is not supported yet.
        "Logan's Slingshot Lariat": (
            bonuses: [(fortitude: -10)],
            play_after: Some(Maneuver),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            reverses: Some((targets: Not(Any))),
        ),
        // Multi: 3, 'completely' and the In Hand text are not supported yet.
        "Maverick Frog Splash": (
            bonuses: [(when: InYourRing(TitleContains("Table")), damage: 5)],
            on_play: [Discard(who: Opponent, n: 2, pick: Chosen)],
        ),
        // The overturned text (actions and card effects) is not supported yet.
        "Logan's Leapfrog": (
            reverses: Some((targets: Not(Trait(Unique)), from_hand_only: true, on_reverse: [ReturnThis(to: Arsenal)])),
        ),
        // Approximation: Recover 3- RFG cards only (not Ringside cards).
        "#DrinkPrime": (
            bonuses: [(fortitude: -5)],
            on_play: [MoveCards(who: You, from: Removed, to: Arsenal, n: 3, up_to: true), DrawUpTo(who: You, n: 3), HandToArsenalBottom(who: You, n: 1)],
            reverses: Some((targets: Maneuver, effects: [DrawUpTo(who: You, n: 3), HandToArsenalBottom(who: You, n: 1)])),
            while_in_ring: [(applies_to: Maneuver, stun_value: 1)],
        ),
        // Approximation: Arsenal / Ringside search for any card (RFG and the Brass 'Nuks' Shot text are not
        // supported). The reversal is not supported yet.
        "Entourage Ringside Interference": (
            on_play: [Search(filter: Any, ringside: true)],
            reverses: Some((targets: Not(Any))),
        ),
        // Approximation: the next maneuver is -5F and +5D (Multi and Counter choices are not supported).
        "Do It For the Content": (
            on_play: [Boost((applies_to: Maneuver, duration: NextCard, fortitude: -5, damage: 5))],
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: AnyOf([ManeuverType(HighRisk), ManeuverType(TrademarkFinisher)]),
                    effects: [Optional([RingsideToArsenal(who: You, n: 2, up_to: true)])],
                ),
            ],
        ),

        // The Scottish Warrior / Drew McIntyre
        // The reversal Fortitude, What Lies Within and Ability texts are not supported yet.
        "Gallantry": (
            backstage_ability: Some((effects: [MoveCards(who: You, from: Removed, to: Arsenal, n: 10, up_to: true)], sacrifice: true)),
        ),
        // The removal-reduction text and the reversed-ACE draw are not supported yet.
        "Angela": (
            ring_ability: Some((
                requires: Some(HandAtLeast(2)),
                cost: [RemoveFromGame(who: You, from: Hand, n: 2)],
                effects: [MoveCards(who: You, from: Removed, to: Hand, n: 1, up_to: true, filter: Some(Maneuver))],
            )),
        ),
        // The Divine Intervention texts are not supported yet.
        "I Prayed For This, And It Happened": (pre_match_limit: 2),
        // Approximation: it reverses cards printed "cannot be reversed" (Irreversible). Revealing a Backstage card is
        // not supported yet.
        "Glasgow Kiss": (
            on_play: [
                Choice([[RemoveFromGame(who: You, from: Hand, n: 1)], [RemoveFromGame(who: You, from: Ringside, n: 2)]]),
                RemoveFromGame(who: Opponent, from: Hand, n: 1),
            ],
            reverses: Some((
                targets: Trait(Irreversible),
                ignores_irreversible: true,
                effects: [
                    Choice([[RemoveFromGame(who: You, from: Hand, n: 1)], [RemoveFromGame(who: You, from: Ringside, n: 2)]]),
                    RemoveFromGame(who: Opponent, from: Hand, n: 1),
                ],
            )),
        ),
        // Approximation: Claymore Kick is -30F for the rest of the turn (playing it as a Strike, Multi and the
        // unsuccessful text are not supported).
        "The Claymore Countdown": (
            on_play: [
                MoveCards(who: You, from: Ringside, to: Arsenal, n: 2, up_to: true, bottom: true),
                MoveCards(who: You, from: Removed, to: Arsenal, n: 1, up_to: true, bottom: true),
                Search(filter: Title("Claymore Kick")),
                Boost((applies_to: Title("Claymore Kick"), duration: NextMatching, fortitude: -30)),
            ],
        ),

        // L.A. Knight
        // The Listen Loud and Clear text and the +1D per Ring Action are not supported yet.
        "The Megastar": (
            backstage_abilities: [OnOpponentPlayMatching(filter: Action, effects: [Optional([Dig(n: 2, take: 1)])])],
            backstage_ability: Some((
                requires: Some(InYourRing(Action)),
                cost: [RemoveFromGame(who: You, from: Ring, n: 1, filter: Some(Action))],
                effects: [Dig(n: 2, take: 1)],
            )),
        ),
        // Approximation: you draw up to 3 at the end of the Pre-match phase. The Promo and reversal texts are not
        // supported yet.
        "Knight's Custom Shades": (backstage_abilities: [EndOfPrematch([DrawUpTo(who: You, n: 3)])]),
        // Playing it at any time / from Ringside and the opponent's Promo are not supported yet.
        "Lemme Talk To Ya!": (
            end_of_prematch: [
                MoveCards(who: You, from: Arsenal, to: Ring, n: 1, up_to: true, filter: Some(Title("Grab the Mic!"))),
                Dig(n: 4, take: 1),
            ],
            ring_ability: Some((
                requires: Some(HandHas(Action)),
                cost: [DiscardMatching(who: You, n: 1, filter: Action, pick: Chosen)],
                effects: [Boost((applies_to: Any, duration: NextCard, fortitude: -3))],
            )),
        ),
        // The Ringside / RFG text is not supported yet.
        "With Everybody Sayin'... L! A! Knight!": (
            end_of_prematch: [
                Optional([
                    Discard(who: You, n: 1, pick: Random),
                    Search(filter: All([Not(SuperstarSpecific), Not(Maneuver)])),
                    ReturnThis(to: Backlash),
                ]),
            ],
            as_action: Some((
                on_play: [
                    Search(filter: Title("YEAH!")),
                    Choice([
                        [Draw(who: You, n: 3)],
                        [Dig(n: 3, take: 1)],
                        [Boost((applies_to: Any, duration: NextCard, no_hand_reversal: true))],
                    ]),
                ],
            )),
        ),
        "Name Drop Elbow": (
            play_after: Some(Action),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            on_play: [Search(filter: Title("YEAH!"))],
        ),
        // The reversal (cards that move Ringside cards) is not supported yet.
        "Knight Rider Knee": (
            bonuses: [(fortitude: -8)],
            not_reversed_by: Some(DamageAtLeast(1)),
            reverses: Some((targets: Not(Any))),
        ),
        "L.A.'s Missile Shoulder Block": (
            play_after: Some(Title("Listen Loud and Clear")),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn, YouReversedFrom([Arsenal])])),
            no_arsenal_reversal: true,
            as_action: Some((fortitude: Some(0), on_play: [DiscardThis, Dig(n: 3, take: 1)])),
        ),
        // Choosing 0 cards for a Promo needs no script.
        "Knight's Neck Breaker": (bonuses: [(fortitude: -15)]),
        // The Promo reveal text is not supported yet.
        "Blunt Force Trauma": (
            on_play: [If(condition: After(Action), effects: [Dig(n: 10, take: 1)])],
            ringside_ability: Some((
                effects: [
                    ThisToArsenal(bottom: true),
