        // Eddie Guerrero
        // Keeping Backlash! from reversing Eddie's Roll Up is not supported yet.
        "Gory Special": (
            on_play: [Optional([Search(filter: Title("Eddie's Roll Up"))])],
            reverses: Some((targets: All([ManeuverType(Strike), DamageAtLeast(7)]))),
        ),

        // Dudley Boyz
        // Approximation: only the first card of turn 1 counts, so the second player's first card is not protected.
        "Beatings from Dudleyville": (
            reversal_limits: [(from: [Hand], when: All([FirstTurnOfGame, FirstCardThisTurn]))],
            on_play: [Discard(who: You, n: 1, pick: Chosen)],
        ),

        // Matt Hardy
        "Side Effect": (
            play_after: Some(Maneuver),
            on_play: [Optional([RingsideToHand(who: You, n: 1)]), Optional([RingsideToBacklash(who: You, n: 1)])],
        ),

        // Big Show
        "Showdown!": (
            reverses: Some((targets: Not(Any))),
            after_success: Some((
                filter: Action,
                effects: [Boost((applies_to: Any, duration: NextTurnFirstCard, reversal_fortitude: 8))],
            )),
        ),

        // Rob Van Dam
        "Mr. Monday Night": (
            play_after: Some(Maneuver),
            play_after_unless: Some(All([FirstCardThisTurn, ReversedLastTurn(Any), YouReversedFrom([Hand, Backlash])])),
            reversal_limits: [(from: [Hand, Backlash, Ringside, Ring, Under])],
        ),

        // Booker T
        "Houston Hangover": (play_after: Some(All([Maneuver, DamageAtLeast(4)])), on_play: [Search(filter: Any)]),

        // Lita
        "The Goddess Returns": (
            as_action: Some((fortitude: Some(0), on_play: [ShuffleThisIntoArsenal, Draw(who: You, n: 1)])),
            reverses: Some((targets: All([Maneuver, Not(ManeuverType(TrademarkFinisher))]), overturned_only: true)),
        ),

        // APA
        "Drinking Beer - Raising Hell - Kicking Ass": (
            ring_ability: Some((
                requires: Some(FortitudeAtLeast(5)),
                sacrifice: true,
                effects: [
                    Counted(count: SuperstarValue, effect: RingsideToArsenal(who: You, n: 0, up_to: true)),
                    Counted(count: SuperstarValue, effect: Discard(who: Opponent, n: 0, pick: Chosen)),
                    Counted(count: SuperstarValue, effect: Boost((applies_to: Maneuver, duration: ThisTurn, damage: 1))),
                ],
            )),
        ),

        // Ric Flair
        // Played after the maneuver's damage. Missing: blanking that maneuver's text (its effects still happen).
        "The Flair Flop": (
            reverses: Some((targets: Not(Any))),
            after_success: Some((
                filter: All([Maneuver, DamageAtLeast(4)]),
                effects: [RingsideToHand(who: You, n: 60, up_to: true, filter: Some(Title("Over Sell Maneuver")))],
            )),
        ),

        // Trish Stratus
        "Puppy Power!": (
            on_play: [
                Choice([
                    [RingsideToArsenal(who: You, n: 3, up_to: true), Draw(who: You, n: 1)],
                    [Discard(who: You, n: 1, pick: Chosen), Mill(who: Opponent, n: 2)],
                ]),
                EndTurn,
            ],
            ring_ability: Some((
                cost: [Discard(who: You, n: 2, pick: Chosen)],
                effects: [RingToHand(who: You, n: 1, filter: Title("Puppy Power!"))],
            )),
        ),

        // Al Snow
        "Tough Enough Head Trainer": (
            requires: Some(AnyOf([InYourRing(Title("Tough Enough!")), OpponentRingHas(filter: Title("Tough Enough!"), n: 1)])),
            ring_ability: Some((cost: [Discard(who: You, n: 2, pick: Chosen)], effects: [Search(filter: Any)])),
        ),

        // Tajiri
        // Repeating its damage by discarding 2 cards is not supported yet.
        "Series of Kicks": (
            play_after: Some(TitleContains("kick")),
            reversal_limits: [(from: [Hand, Backlash, Ringside, Ring, Under])],
        ),

        // Hurricane
        // Approximation: the extra starting hand cards are drawn at the end of the Pre-match phase.
        "Gregory Helms, Ace Reporter": (end_of_prematch: [Counted(count: SuperstarValue, effect: Draw(who: You, n: 0))]),

        // Goldust
        "You Will Never Forget the Name of...": (on_play: [Search(filter: Maneuver, n: 2, up_to: true)]),

        // Brock Lesnar
        "Brock Block": (
            reversal_limits: [(from: [Arsenal, Backlash, Ringside, Ring, Under])],
            on_play: [Optional([Search(filter: Title("Series of Back Breakers"))])],
        ),

        // Rey Mysterio
        // It is printed only as a High Risk maneuver, so its "As an action" part cannot be used.
        "Rey Rey's Flying Body Press": (play_after: Some(Title("From the Top Rope"))),

        // Jamie Noble
        // Approximation: the 10-card limit is not applied.
        "Nidia, Hook Up the Double Wide": (
            on_play: [RingsideToArsenalCount(who: You, count: HandSize), RingsideToArsenalCount(who: You, count: HandSize)],
        ),

        // Big Poppa Pump
        "Steiner Flatliner": (play_after: Some(Maneuver)),

        // Shawn Michaels
        "I'm Just a Sexy Boy": (
            requires: Some(FirstCardThisTurn),
            irreversible_when: Some(OpponentIs("Female")),
            on_play: [DrawUpTo(who: You, n: 6)],
            reverses: Some((targets: Action, effects: [Discard(who: Opponent, n: 4, pick: Chosen)])),
        ),

        // Team Angle
        "The World's Greatest Suplex": (on_play: [Optional([RingsideToHand(who: You, n: 1, filter: Some(Maneuver))])]),

        // Test
        // Putting it into the Ring before the Pre-match is not supported yet.
        "Once You Go Test, You Forget the Rest": (
            pre_match_limit: 1,
            mid_match_limit: 1,
            reverses_from_ring: Some((targets: Any, requires: Some(OpponentIs("Female")))),
        ),

        // Rhyno
        "Unstoppable": (
            reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]))),
            in_ring_on_play: [
                (whose: Some(You), filter: Keyword("Foreign Object"), effects: [Optional([RingsideToArsenal(who: You, n: 3, up_to: true)])]),
            ],
        ),

        // Enforcers (Raw)
        "Test or Freakzilla?": (
            enforcer_abilities: [
                [
                    StartOfTurn([
                        Counted(
                            count: AtMost(Minus(OpponentHandSize, HandPlus(2)), 2),
                            effect: Discard(who: Opponent, n: 0, pick: Chosen),
                        ),
                    ]),
                ],
                [
                    Activated(
                        cost: [Discard(who: You, n: 2, pick: Chosen)],
                        effects: [Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -8))],
                    ),
                    CannotPlayMatching(All([Maneuver, EarlierThisTurn(filter: Maneuver, n: 2)])),
                ],
            ],
        ),
        // Raising the Mid-match limit by 2 when the card is revealed is not supported yet.
        "RVD or Booker T?": (
            enforcer_abilities: [
                [
                    Activated(
                        cost: [
                            DiscardMatching(who: You, n: 1, filter: AnyOf([ManeuverType(Strike), ManeuverType(HighRisk)]), pick: Chosen),
                        ],
                        effects: [
                            Counted(
                                count: LastDiscardedFortitude,
                                effect: Boost((
                                    applies_to: AnyOf([ManeuverType(Strike), ManeuverType(HighRisk)]),
                                    duration: NextCard,
                                    fortitude: -1,
                                )),
                            ),
                        ],
                    ),
                ],
                [
                    StartOfTurn([
                        If(
                            condition: FortitudeAboveOpponent,
                            effects: [Optional([RingsideToArsenalBottom(who: You, n: 2)])],
                        ),
                    ]),
                ],
            ],
        ),

        // Enforcers (SmackDown!)
        // Approximation: the APA bonus and ban also apply to cards played from elsewhere than your hand.
        "APA or A-Train?": (
            enforcer_abilities: [
                [DamageFor(filter: Maneuver, delta: 1), CannotPlayMatching(All([Action, Not(Trait(Unique))]))],
                [
                    Activated(
                        cost: [Discard(who: You, n: 1, pick: Chosen)],
                        effects: [
                            Search(
                                filter: All([
                                    Not(Trait(Unique)),
                                    AnyOf([TitleContains("power"), TitleContains("bomb"), TitleContains("slam")]),
                                ]),
                            ),
                        ],
                    ),
                    FortitudeFor(filter: AnyOf([TitleContains("power"), TitleContains("bomb"), TitleContains("slam")]), delta: -4),
                ],
            ],
        ),
        // Edge's "+#" Hand Size uses HandSizeFromOpponentValue (twice the opponent's Superstar Value; it replaces
        // the printed Hand Size, which is 0 for every Superstar that may reveal this card).
        // Not playing cards that raise the opponent's Superstar Value and starting after the Pre-match phase
        // are not supported yet.
        "Edge or Big Show?": (
            enforcer_abilities: [
                [HandSizeFromOpponentValue(times: 2, min: 0)],
                [
                    PlayCost(filter: All([Maneuver, EarlierThisTurn(filter: Maneuver, n: 1)]), discard: 2),
                    CannotPlayMatching(ManeuverType(HighRisk)),
                    OpponentDamageCap(filter: ManeuverType(Grapple), max: 3),
                ],
            ],
        ),
    },
)
