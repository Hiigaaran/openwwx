        // Hurricane
        // Approximation: the extra starting hand cards are drawn at the end of the Pre-match phase.
        "Gregory Helms, Ace Reporter": (end_of_prematch: [Counted(count: SuperstarValue, effect: Draw(who: You, n: 0))]),

        // Goldust
        "You Will Never Forget the Name of...": (on_play: [Search(filter: Maneuver, n: 2, up_to: true)]),

        // Brock Lesnar
        "Brock Block": (no_arsenal_reversal: true, on_play: [Optional([Search(filter: Title("Series of Back Breakers"))])]),

        // Rey Mysterio
        // It is printed only as a High Risk maneuver, so its "As an action" part cannot be used.
        "Rey Rey's Flying Body Press": (play_after: Some(Title("From the Top Rope"))),

        // Jamie Noble
        // Approximation: the 10-card limit is not applied.
        "Nidia, Hook Up the Double Wide": (
            on_play: [RingsideToArsenalCount(who: You, count: HandSize), RingsideToArsenalCount(who: You, count: HandSize)],
        ),

        // Big Poppa Pump
        "Steiner Flatliner": (play_after: Some(Maneuver)),

        // Shawn Michaels
        "I'm Just a Sexy Boy": (
            requires: Some(FirstCardThisTurn),
            irreversible_when: Some(OpponentFemale),
            on_play: [DrawUpTo(who: You, n: 6)],
            reverses: Some((targets: Action, effects: [Discard(who: Opponent, n: 4, pick: Chosen)])),
        ),

        // Team Angle
        "The World's Greatest Suplex": (on_play: [Optional([RingsideToHand(who: You, n: 1, filter: Some(Maneuver))])]),

        // Test
        // Playing it before the Pre-match and the larger Pre-match and Mid-match limits are not supported yet.
        "Once You Go Test, You Forget the Rest": (reverses_from_ring: Some((targets: Any, requires: Some(OpponentFemale)))),

        // Rhyno
        "Unstoppable": (
            reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]))),
            in_ring_on_play: [
                (whose: Some(You), filter: Keyword("Foreign Object"), effects: [Optional([RingsideToArsenal(who: You, n: 3, up_to: true)])]),
            ],
        ),
    },
)
