// Hand-written scripts for Divas Overload cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// Enforcer cards and That One Thing are skipped by the importer: Enforcers and
// "Maneuver: Special" cards are not supported yet. Removing cards from the game is
// not supported yet either.
// Approximation: there is no "you are Female" condition, so "Female Superstar" and
// "Diva Superstar" are read from Superstar names. Divas are the Superstars printed
// with the Diva trait (this set and the next ones); Female Superstars are the Divas
// plus Chyna, Lita, Trish Stratus, Stephanie McMahon, Mae Young and The Fabulous Moolah.
(
    abilities: {
        // Reversing by discarding 3 cards is not supported yet.
        "Goldberg": [
            CannotPackMatching(All([Reversal, Not(Maneuver), Not(Action)])),
            Activated(
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [
                    Search(filter: All([Not(Trait(Unique)), AnyOf([TitleContains("spear"), TitleContains("jackhammer")])])),
                ],
            ),
            CardFortitude(title: "Spear", delta: -100),
            CardFortitude(title: "Jackhammer", delta: -100),
            DamageFor(filter: AnyOf([Title("Spear"), Title("Jackhammer")]), delta: 3),
        ],
        // Enforcers (her printed Hand Size is 0+), the 50-card Arsenal, Diversion being a Set-up card and the
        // Managed by Stacy Keibler part are not supported yet.
        "Stacy Keibler": [
            CardFortitude(title: "Diversion", delta: -9),
            OpponentCannotPlay("Keibler's Cookies"),
            OpponentCannotPlay("Managed by Stacy Keibler"),
            OpponentCannotPlay("Stacy Keibler, Marketing Manager"),
        ],
        // Tag Teams are not supported yet. They count as Gail Kim and Molly Holly to pack their logo cards.
        "Gail Kim and Molly Holly": [
            CountsAs(["Gail Kim", "Molly Holly"]),
            EndOfPrematch([Search(filter: All([SuperstarSpecific, Not(Reversal)]))]),
            StartOfTurn([
                Choice([
                    [
                        Boost((
                            applies_to: AnyOf([ManeuverType(HighRisk), ManeuverType(Strike)]),
                            duration: ThisTurn,
                            fortitude: -3,
                        )),
                    ],
                    [
                        Boost((
                            applies_to: AnyOf([ManeuverType(HighRisk), ManeuverType(Grapple)]),
                            duration: ThisTurn,
                            fortitude: -3,
                        )),
                    ],
                ]),
            ]),
        ],
        // Taunt the Fans and Steel Chain Shot not being Heel, and ignoring the "Can only be played" text of
        // "chain" cards, are not supported yet.
        "John Cena": [
            OnPlayMatching(
                filter: Maneuver,
                effects: [
                    Optional([Discard(who: You, n: 1, pick: Chosen), BacklashToRingside(who: Opponent, n: 3, random: true)]),
                ],
            ),
        ],
        // Enforcers (her printed Hand Size is 0+) and the 50-card Arsenal are not supported yet.
        // Approximation: the ability is used once per turn, and the opponent's top card goes to his Ringside pile
        // instead of leaving the game.
        "Sable": [
            Activated(cost: [Mill(who: You, n: 2)], effects: [Mill(who: Opponent, n: 1)]),
            OpponentCannotPlay("Sable Bomb"),
            OpponentCannotPlay("Sable-licious"),
        ],
        "Torrie Wilson": [
            CannotPackMatching(All([Maneuver, DamageAtLeast(4), Not(TitleContains("DDT"))])),
            Activated(
                cost: [Discard(who: You, n: 2, pick: Chosen)],
                effects: [Search(filter: All([Action, Not(Trait(Unique))]))],
            ),
            OpponentCannotPlay("Managed by Torrie Wilson"),
            OpponentCannotPlay("Torrie Wilson, On It!"),
            OpponentCannotPlay("Torrie's DDT"),
        ],
        "Victoria": [
            Activated(cost: [], effects: [ShuffleHandAndRedraw(who: You)]),
            CardFortitude(title: "Battling the Voices", delta: -6),
            CannotBeReversedBy(played: Title("Battling the Voices"), reversal: Any),
        ],
        // Trailer Park Trash and Kissing Up to the Stinkin' Fans not being Heel is not supported yet.
        "Nidia": [
            CannotPackMatching(All([Maneuver, DamageAtLeast(4)])),
            Activated(
                cost: [DiscardMatching(who: You, n: 1, filter: Action, pick: Chosen)],
                effects: [
                    RingsideToArsenal(
                        who: You,
                        n: 2,
                        up_to: true,
                        filter: Some(Not(AnyOf([All([Maneuver, Action]), All([Maneuver, Reversal]), All([Action, Reversal])]))),
                    ),
                ],
            ),
        ],
    },
    scripts: {
        // High Risk
        // Drawing when the opponent removes it from the Ring is not supported yet.
        "Show and Go": (
            only_packed_by: ["Chyna", "Lita", "Trish Stratus", "Stephanie McMahon", "Mae Young", "The Fabulous Moolah", "Stacy Keibler", "Gail Kim and Molly Holly", "Sable", "Torrie Wilson", "Victoria", "Nidia", "Babe of the Year", "Christy", "X-treme Diva", "Mickie James"],
            play_after: Some(Action),
        ),
        "Diving Bulldog": (requires: Some(All([ReversedLastTurn(Any), FirstCardThisTurn]))),
        "Suicide Dive": (
            bonuses: [(when: InYourRing(Trait(Raw)), fortitude: -2)],
            play_after: Some(Any),
            on_play: [Mill(who: Opponent, n: 1)],
        ),

        // Strikes
        // Stopping Over Sell Maneuver right after it is not supported yet.
        "Girly Punch": (
            only_packed_by: ["Chyna", "Lita", "Trish Stratus", "Stephanie McMahon", "Mae Young", "The Fabulous Moolah", "Stacy Keibler", "Gail Kim and Molly Holly", "Sable", "Torrie Wilson", "Victoria", "Nidia", "Babe of the Year", "Christy", "X-treme Diva", "Mickie James"],
            not_reversed_by: Some(Not(DamageAtMost(0))),
        ),
        "Boot Lace": (
            no_hand_reversal: true,
            requires: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            as_action: Some((on_play: [DiscardThis, Draw(who: You, n: 1)])),
        ),
        "Chop Block": (
            bonuses: [(per: Some(Trait(Heel)), damage: 2)],
            play_after: Some(AnyOf([Title("Irish Whip"), Title("Throw Into the Corner Turnbuckle")])),
            reverses: Some((
                targets: AnyOf([
                    Title("Irish Whip"),
                    Title("Throw Into the Corner Turnbuckle"),
                    Title("Over the Top Rope"),
                    All([
                        Maneuver,
                        After(AnyOf([Title("Irish Whip"), Title("Throw Into the Corner Turnbuckle"), Title("Over the Top Rope")])),
                    ]),
                ]),
            )),
        ),
        "Elbow Smash": (
            on_play: [
                RingsideToHand(who: You, n: 1, filter: Some(Trait(SetUp))),
                RingsideToHand(who: You, n: 1, filter: Some(TitleContains("elbow"))),
            ],
        ),
        "Jab": (on_play: [BacklashToRingside(who: Opponent, n: 1, random: true)]),
        "Forearm Uppercut": (
            on_play: [Mill(who: Opponent, n: 1), Optional([Draw(who: You, n: 1)]), Discard(who: Opponent, n: 1, pick: Chosen)],
        ),
        // Reversing cards that search the Arsenal is not supported yet.
        "Ax Kick": (reverses: Some((targets: Not(Any)))),
        "Spinning Clothesline": (bonuses: [(reversal_damage: 2)]),
        // Getting it back from the Ringside pile is not supported yet.
        "Chick Kick": (
            only_packed_by: ["Stacy Keibler", "Gail Kim and Molly Holly", "Sable", "Torrie Wilson", "Victoria", "Nidia", "Babe of the Year", "Christy", "X-treme Diva", "Mickie James", "Trish Stratus"],
            on_play: [If(condition: Not(OpponentFemale), effects: [Mill(who: Opponent, n: 4)])],
            ring_ability: Some((
                sacrifice: true,
                effects: [Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -6))],
            )),
        ),
        // Playing it from hand after the opponent's successful Double Clothesline Takedown is not supported yet.
        "Double Clothesline Takedown": (
            reverses: Some((targets: Title("Double Clothesline Takedown"), overturned_only: true)),
        ),
        "Atomic Lariat": (not_reversed_by: Some(Not(AnyOf([Trait(Unique), Maneuver, Action])))),
        "Hurricane Clothesline": (
            bonuses: [(when: Superstar("Hurricane"), fortitude: -4), (reversal_damage: 3)],
            reverses: Some((targets: All([Maneuver, TitleContains("clothesline")]))),
        ),

        // Grapples
        // Keeping the opponent from modifying Fortitude is not supported yet.
        "Chest Lock Drop": (),
        "Wheelbarrow Slam": (no_arsenal_reversal: true, on_play: [Mill(who: Opponent, n: 1)]),
        "Running Spinebuster": (bonuses: [(when: FortitudeBelowOpponent, fortitude: -5)]),
        "Gut Buster On Top Rope": (
            irreversible_when: Some(InYourRing(Title("Gut Buster"))),
            bonuses: [(when: After(Title("Gut Wrench")), reversal_fortitude: 10)],
        ),
        // Approximation: only the card titled Throw Opponent Out of the Ring is found, the next card may ignore any
        // "can only be played after" text, and the opponent chooses between discarding and overturning.
        "Top Rope Toss": (
            on_play: [
                RingsideToArsenal(who: You, n: 1),
                Search(filter: Title("Throw Opponent Out of the Ring")),
                Boost((applies_to: Any, duration: NextCard, ignore_play_after: true)),
                If(
                    condition: AnyOf([InYourRing(Title("Lumberjack Match")), OpponentRingHas(filter: Title("Lumberjack Match"), n: 1)]),
                    effects: [OpponentChooses(n: 1, options: [[Discard(who: Opponent, n: 2, pick: Chosen)], [Mill(who: Opponent, n: 5)]])],
                ),
            ],
        ),
        // Approximation: the card from the opponent's hand is discarded instead of leaving the game.
        "Reverse Fall-away Slam": (
            on_play: [Choice([[], [RingsideToHand(who: You, n: 1)], [Discard(who: Opponent, n: 1, pick: Random)]])],
        ),

        // Submissions
        // Being reversed only by cards that reverse Clutch onto Opponent is not supported yet.
        "Modified Clutch Onto Opponent": (
            only_packed_by: ["Stacy Keibler", "Gail Kim and Molly Holly", "Sable", "Torrie Wilson", "Victoria", "Nidia", "Babe of the Year", "Christy", "X-treme Diva", "Mickie James"],
            on_play: [
                Choice([[Draw(who: You, n: 1)], [LookAtHand(who: Opponent)]]),
                NextCardMustBe(Not(AnyOf([Title("Maintain Hold"), Title("Apply Illegal Leverage")]))),
            ],
        ),
        // Making the opponent discard to play Actions is not supported yet.
        "Arm Breaker": (),
        "Unorthodox Wrist Lock": (
            play_after: Some(Maneuver),
            not_reversed_by: Some(Title("Backlash!")),
            on_play: [
                Optional([
                    RingsideToHand(who: You, n: 1, filter: Some(ManeuverType(HighRisk))),
                    HandToArsenalTop(who: You, n: 1),
                ]),
            ],
        ),
        "Modified Bow and Arrow": (
            play_after: Some(ManeuverType(Submission)),
            play_after_unless: Some(FortitudeAboveOpponent),
            not_reversed_by: Some(AnyOf([Title("Backlash!"), Title("Strangle Hold")])),
            on_play: [Search(filter: Title("Maintain Hold"))],
        ),
        "Front Chancery": (on_play: [AsOpponent([Optional([RingsideToArsenal(who: You, n: 1)])])]),
        // Locking both players until it is reversed and its repeated damage are not supported yet.
        "Lady's Grapevine": (
            only_packed_by: ["Stacy Keibler", "Gail Kim and Molly Holly", "Sable", "Torrie Wilson", "Victoria", "Nidia", "Babe of the Year", "Christy", "X-treme Diva", "Mickie James"],
            not_reversed_by: Some(Title("Backlash!")),
            play_after: Some(ManeuverType(Submission)),
            reverses: Some((targets: AnyOf([Title("Backslide"), Title("Roll Up"), Title("Inside Cradle"), Title("Victory Roll")]))),
        ),

        // Actions
        // Approximation: the only GM opponent is Eric Bischoff.
        "Girl on Girl Action!": (
            only_packed_by: ["Chyna", "Lita", "Trish Stratus", "Stephanie McMahon", "Mae Young", "The Fabulous Moolah", "Stacy Keibler", "Gail Kim and Molly Holly", "Sable", "Torrie Wilson", "Victoria", "Nidia", "Babe of the Year", "Christy", "X-treme Diva", "Mickie James"],
            on_play: [RingsideToHand(who: You, n: 1, filter: Some(All([Action, Not(Trait(Unique))])))],
            reverses: Some((
                targets: All([Action, Not(Trait(Unique))]),
                requires: Some(AnyOf([OpponentFemale, OpponentSuperstar("Eric Bischoff")])),
            )),
        ),
        "Some Gals Don't Get Any Action": (
            only_packed_by: ["Chyna", "Lita", "Trish Stratus", "Stephanie McMahon", "Mae Young", "The Fabulous Moolah", "Stacy Keibler", "Gail Kim and Molly Holly", "Sable", "Torrie Wilson", "Victoria", "Nidia", "Babe of the Year", "Christy", "X-treme Diva", "Mickie James"],
            on_play: [RingsideToHand(who: You, n: 1, filter: Some(All([Maneuver, Not(Trait(Unique))])))],
            reverses: Some((
                targets: All([Action, Not(Trait(SetUp)), Not(Trait(Unique))]),
                requires: Some(Not(OpponentFemale)),
            )),
        ),
        "Overshot Your Mark": (
            reverses: Some((
                targets: AnyOf([
                    All([ManeuverType(Strike), DamageAtLeast(5)]),
                    ManeuverType(HighRisk),
                    All([Maneuver, After(Title("Irish Whip"))]),
                ]),
                damage: SameAsReversed,
            )),
        ),
        "Reach for the Ropes": (
            reverses: Some((
                targets: AnyOf([ManeuverType(Submission), Title("Clutch onto Opponent")]),
                effects: [Optional([Draw(who: You, n: 1)])],
            )),
        ),
        // Reversing cards that make you overturn cards and non-damage effects is not supported yet; only the
        // part against Female opponents is scripted.
        "You Fight Like a Woman": (
            reverses: Some((
                targets: All([Maneuver, Not(Trait(Unique))]),
                requires: Some(OpponentFemale),
                effects: [
                    If(
                        condition: Not(AnyOf([OpponentSuperstar("Stacy Keibler"), OpponentSuperstar("Gail Kim and Molly Holly"), OpponentSuperstar("Sable"), OpponentSuperstar("Torrie Wilson"), OpponentSuperstar("Victoria"), OpponentSuperstar("Nidia"), OpponentSuperstar("Babe of the Year"), OpponentSuperstar("Christy"), OpponentSuperstar("X-treme Diva"), OpponentSuperstar("Mickie James")])),
                        effects: [LookAtHand(who: Opponent), Discard(who: Opponent, n: 1, pick: Controller)],
                    ),
                ],
            )),
        ),
        // Being Permanent is not supported yet.
        "Too Many Rules and Too Many Refs": (
            on_play: [Optional([DiscardThis, Draw(who: You, n: 1)])],
            reverses: Some((
                targets: Keyword("RMS"),
                effects: [AsOpponent([RingsideToArsenal(who: You, n: 3, up_to: true)])],
            )),
        ),
        // Reversing non-damage effects is not supported yet.
        "Let's Wrestle Already!": (on_play: [ShuffleThisIntoArsenal, Draw(who: You, n: 1)], reverses: Some((targets: Not(Any)))),
        // Approximation: reversing by revealing a card with the reversed card's title from your hand is not supported.
        "No Matching Tights": (
            requires: Some(HandHas(SameTitleInRing)),
            on_play: [DiscardMatching(who: You, n: 1, filter: SameTitleInRing, pick: Chosen), DrawUpTo(who: You, n: 2)],
            reverses: Some((targets: SameTitleInRing, from_hand_only: true)),
        ),
        // Choosing the opponent's first card next turn is not supported yet.
        "Don't Be Shy": (requires: Some(Never)),
        "It's Time I Made Some Changes": (on_play: [Mulligan(n: 100)]),
        "Lousy Foot Work": (
            on_play: [
                If(
                    condition: OpponentHandHas(AnyOf([Title("Escape Move"), Title("Step Aside")])),
                    effects: [
                        OpponentChooses(
                            n: 1,
                            options: [
                                [DiscardMatching(who: Opponent, n: 1, filter: AnyOf([Title("Escape Move"), Title("Step Aside")]), pick: Chosen)],
                                [CannotPlay(who: Opponent, filter: Maneuver, turns: 1)],
                            ],
                        ),
                    ],
                ),
                If(
                    condition: Not(OpponentHandHas(AnyOf([Title("Escape Move"), Title("Step Aside")]))),
                    effects: [CannotPlay(who: Opponent, filter: Maneuver, turns: 1)],
                ),
            ],
        ),
        "Recover Again": (
            bonuses: [(when: InYourRing(Title("Recovery")), fortitude: -2)],
            on_play: [
                RingsideToArsenal(who: You, n: 4, up_to: true),
                Draw(who: You, n: 1),
                If(condition: Not(InYourRing(Title("Recovery"))), effects: [Discard(who: You, n: 1, pick: Chosen)]),
            ],
        ),
        // The "fewer Action cards in your Ring" requirement is not supported yet.
        // Approximation: the card goes to the Ringside pile instead of leaving the game.
        "The Name of the Game Is Wrestling": (
            in_ring_on_play: [
                (
                    whose: Some(Opponent),
                    filter: All([Action, Not(Trait(SetUp))]),
                    effects: [AsOpponent([Optional([SacrificeThis, EndTurn])])],
                ),
            ],
        ),
        "I've Got a Leg Up On You": (
            irreversible_when: Some(AnyOf([Superstar("Stacy Keibler"), Superstar("Gail Kim and Molly Holly"), Superstar("Sable"), Superstar("Torrie Wilson"), Superstar("Victoria"), Superstar("Nidia"), Superstar("Babe of the Year"), Superstar("Christy"), Superstar("X-treme Diva"), Superstar("Mickie James")])),
            ring_ability: Some((
                requires: Some(FortitudeAboveOpponent),
                effects: [Mill(who: You, n: 1), Mill(who: Opponent, n: 2)],
            )),
        ),
        // Overturning cards onto this card is not supported yet.
        "I've Got a Nice ... Bottom": (
            only_packed_by: ["Stacy Keibler", "Gail Kim and Molly Holly", "Sable", "Torrie Wilson", "Victoria", "Nidia", "Babe of the Year", "Christy", "X-treme Diva", "Mickie James"],
            requires: Some(Never),
        ),
        // Revealing the card and what happens if it is or is not the next card played are not supported yet.
        "I'll Take a Shot": (on_play: [Draw(who: You, n: 1)]),
        // Approximation: Enforcers are not supported, so the opponent always discards 2 cards.
        "The Hubbub Backstage": (
            requires: Some(OpponentRingHas(filter: Title("Backstage Politics"), n: 1)),
            irreversible: true,
            on_play: [BacklashToRingside(who: Opponent, n: 2, random: true)],
        ),
        // Overturning cards equal to the damage of the discarded cards is not supported yet.
        "Get a Look at These": (
            only_packed_by: ["Stacy Keibler", "Gail Kim and Molly Holly", "Sable", "Torrie Wilson", "Victoria", "Nidia", "Babe of the Year", "Christy", "X-treme Diva", "Mickie James"],
            requires: Some(Never),
        ),
        // Removing cards in the opponent's Ringside pile from the game is not supported yet.
        "So Solly! So Sorey!": (requires: Some(Never)),
        // Removing it from the game in place of other cards is not supported yet.
        "Sump'tin' Be Started": (
            bonuses: [(when: InYourRing(Title("I Aims ta be Startin' Sump'tin'")), fortitude: -9)],
            on_play: [BacklashToRingside(who: Opponent, n: 2, random: true)],
        ),
        // Using it from the Ringside pile is not supported yet.
        "This Diva's Got Claws!": (
            only_packed_by: ["Stacy Keibler", "Gail Kim and Molly Holly", "Sable", "Torrie Wilson", "Victoria", "Nidia", "Babe of the Year", "Christy", "X-treme Diva", "Mickie James"],
            while_in_ring: [(applies_to: ManeuverType(Strike), damage: 1)],
            in_ring_on_play: [(whose: Some(You), filter: All([Maneuver, Not(ManeuverType(Strike))]), effects: [SacrificeThis])],
        ),
        "Shake My Hand, Boy!": (
            on_play: [
                OpponentChooses(
                    n: 1,
                    options: [
                        [Draw(who: Opponent, n: 1), Discard(who: Opponent, n: 3, pick: Chosen)],
                        [Boost((applies_to: Maneuver, duration: NextCard, no_hand_reversal: true))],
                    ],
                ),
            ],
        ),
        // Making a title Permanent is not supported yet.
        "My New Gimmick": (on_play: [Draw(who: You, n: 1)]),
        // Putting cards under this card is not supported yet.
        "Puppy Love": (
            only_packed_by: ["Chyna", "Lita", "Trish Stratus", "Stephanie McMahon", "Mae Young", "The Fabulous Moolah", "Stacy Keibler", "Gail Kim and Molly Holly", "Sable", "Torrie Wilson", "Victoria", "Nidia", "Babe of the Year", "Christy", "X-treme Diva", "Mickie James"],
            requires: Some(Never),
        ),
        "What Are You Gawking At?": (
            only_packed_by: ["Stacy Keibler", "Gail Kim and Molly Holly", "Sable", "Torrie Wilson", "Victoria", "Nidia", "Babe of the Year", "Christy", "X-treme Diva", "Mickie James"],
            requires: Some(Not(OpponentFemale)),
            on_play: [
                If(
                    condition: OpponentHandHas(Title("Break the Hold")),
                    effects: [
                        OpponentChooses(
                            n: 1,
                            options: [
                                [DiscardMatching(who: Opponent, n: 1, filter: Title("Break the Hold"), pick: Chosen)],
                                [Counted(count: OpponentHandExcess, effect: Discard(who: Opponent, n: 0, pick: Chosen))],
                            ],
                        ),
                    ],
                ),
                If(
                    condition: Not(OpponentHandHas(Title("Break the Hold"))),
                    effects: [Counted(count: OpponentHandExcess, effect: Discard(who: Opponent, n: 0, pick: Chosen))],
                ),
            ],
        ),
        "Where's the Payoff?": (
            not_packed_by: ["Chyna", "Lita", "Trish Stratus", "Stephanie McMahon", "Mae Young", "The Fabulous Moolah", "Stacy Keibler", "Gail Kim and Molly Holly", "Sable", "Torrie Wilson", "Victoria", "Nidia", "Babe of the Year", "Christy", "X-treme Diva", "Mickie James"],
            on_play: [
                If(
                    condition: OpponentHandHas(AnyOf([Title("Escape Move"), Title("Step Aside")])),
                    effects: [
                        OpponentChooses(
                            n: 1,
                            options: [
                                [DiscardMatching(who: Opponent, n: 1, filter: AnyOf([Title("Escape Move"), Title("Step Aside")]), pick: Chosen)],
                                [DiscardMirror(max: 100)],
                            ],
                        ),
                    ],
                ),
                If(
                    condition: Not(OpponentHandHas(AnyOf([Title("Escape Move"), Title("Step Aside")]))),
                    effects: [DiscardMirror(max: 100)],
                ),
            ],
        ),
        // Its Ringside pile effects and the Managed by Vince McMahon part are not supported yet.
        "Don't Cross the Boss": (
            while_in_ring: [(applies_to: Title("No Chance in Hell"), fortitude: -6)],
            in_ring_on_play: [
                (whose: Some(Opponent), filter: Action, effects: [AsOpponent([Optional([Draw(who: You, n: 1)])])]),
            ],
        ),
        "Twisted Smile": (
            on_play: [
                If(
                    condition: OpponentHandAtLeast(4),
                    effects: [
                        OpponentChooses(n: 1, options: [[Discard(who: Opponent, n: 4, pick: Chosen)], [DrawUpTo(who: You, n: 3)]]),
                    ],
                ),
                If(condition: Not(OpponentHandAtLeast(4)), effects: [DrawUpTo(who: You, n: 3)]),
            ],
        ),
        // The "cannot be played after" rule and turning the maintained maneuver into a blank Submission Multi
        // are not supported yet.
        "Tap! Tap! Tap, You Sonofa-!": (
            play_after: Some(All([ManeuverType(Submission), Not(Keyword("RMS"))])),
            irreversible_when: Some(InYourRing(Title("First to Tap Out Match"))),
            on_play: [Boost((applies_to: Title("Maintain Hold"), duration: NextCard, ignore_play_after: true))],
        ),
        // Approximation: no card is removed from the game; you put 1 card from your Ringside pile into your hand.
        "If You're Not Cheating, You're Not Trying": (
            irreversible_when: Some(Superstar("Los Guerreros")),
            on_play: [RingsideToHand(who: You, n: 1)],
        ),

        // Pre-match
        // Approximation: the cards "packed by a Female/Diva Superstar" are the ones of this set.
        "Asset Retrieval": (ring_ability: Some((sacrifice: true, effects: [Search(filter: AnyOf([Title("Show and Go"), Title("Girly Punch"), Title("Chick Kick"), Title("Modified Clutch Onto Opponent"), Title("Lady's Grapevine"), Title("Girl on Girl Action!"), Title("Some Gals Don't Get Any Action"), Title("I've Got a Nice ... Bottom"), Title("Get a Look at These"), Title("This Diva's Got Claws!"), Title("Puppy Love"), Title("What Are You Gawking At?"), Title("Skirt vs. Skirt Match"), Title("Divas Overload!")]))]))),
        // Blanking cards is not supported yet.
        "Not Today, Cupcake!": (requires: Some(Never)),
        // Approximation: the Fortitude check is made at the start of your next turn instead of the end of this one.
        "I'm Always on Top...": (
