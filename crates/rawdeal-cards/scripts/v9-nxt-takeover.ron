// Hand-written scripts for V9: NXT Takeover (Raw Deal Virtual) cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// "Counter" = you reversed a card to end your opponent's last turn and this is your first card this turn.
// "Promo: N" is approximated as `Dig`: you keep 1 of the top N cards and the rest go on the bottom of the Arsenal.
// "Bury" puts cards on the bottom of the Arsenal; "Stack" on top; "RFG" removes them from the game.
// "Arsenal Search N" = `Search`; "Ringside Search N" = `RingsideToHand`.
// "Reversal: Special" cards: "Reverse any X" is the reversal target. Reversals after a card was successfully
// played and of card effects / Activated Card Effects are not supported (`targets: Not(Any)`).
// ACE (Activated Card Effects) are ring abilities used during your own turn. Not supported: cards under a
// Superstar card, under NXT Arrival or The Selfie Stick (also face-down cards), 'completely' and packing
// permissions.
// "N lower Fortitude" = `CountBelow(a: Plus(YourFortitude, Const(N - 1)), b: OpponentFortitude)`.
// The RMS logo and the NXT / Tag / Run-in / WWF Classic traits are printed keywords (`Keyword("RMS")`, ...).
(
    abilities: {
        // Missing: putting the cards not chosen when you Promo under the Superstar card.
        "Finn Balor": [
            Activated(
                requires: Some(CountAtLeast(count: YourUnderSuperstar, n: 2)),
                cost: [TakeFromUnder(to: Ringside, n: 2, superstar: true)],
                effects: [Draw(who: You, n: 2), HandToArsenalBottom(who: You, n: 1)],
            ),
        ],
        // The Chain text and playing Pre-match cards in any Pre-match phase are not supported yet.
        "Samoa Joe": [],
        // Applying the damage twice is not supported yet.
        "Shinsuke Nakamura": [CannotPackMatching(All([Maneuver, TitleContains("Revolution")]))],
        // Removing cards for the opponent's 'completely' reversals and the Corner packing text are not supported yet.
        "Baron Corbin": [
            OnOpponentReverses([If(condition: OpponentReversed(All([Maneuver, Keyword("RMS")])), effects: [Optional([Dig(n: 2, take: 1)])])]),
            CannotPack("First of All"),
        ],
        // Putting removed cards under NXT Arrival and the packing permissions are not supported yet.
        "Neville": [
            EndOfPrematch([
                Optional([
                    MoveCards(who: You, from: Backlash, to: Ring, n: 1, up_to: true, filter: Some(Title("NXT Arrival"))),
                    If(
                        condition: Not(InYourRing(Title("NXT Arrival"))),
                        effects: [MoveCards(who: You, from: Ringside, to: Ring, n: 1, up_to: true, filter: Some(Title("NXT Arrival")))],
                    ),
                ]),
            ]),
            CardFortitude(title: "Youthful Agility", delta: -8),
        ],
        // His 'kick' cards are Multi (so they need 2 reversal cards). The Selfie Stick texts are not supported yet.
        "Tyler Breeze": [StartOfTurn([Boost((applies_to: TitleContains("kick"), duration: ThisTurn, multi: true))])],
        // Approximation: the Multi maneuver after an action may have 'reversed' in its text. The 'cheap pop' / 'Bo'
        // packing and the Corner / Pre-match packing limits are not supported yet.
        "Bo Dallas": [OnPlayMatching(filter: Action, effects: [Boost((applies_to: Maneuver, duration: NextCard, multi: true))])],
        // Approximation: on every card you play (not once per turn). The blanking protection is not supported yet.
        "Mojo Rawley": [OnPlayMatching(filter: Any, effects: [Optional([Mill(who: You, n: 1), Dig(n: 2, take: 1)])])],
        // The Unique Multi packing permission is not supported yet.
        "Asuka": [
            OnOpponentReverses([
                If(
                    condition: OpponentReversed(Maneuver),
                    effects: [MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Random, bottom: true), Draw(who: Opponent, n: 1)],
                ),
            ]),
            CannotPackMatching(
                All([
                    Maneuver,
                    AnyOf([
                        Keyword("Heat"),
                        Trait(Chain),
                        Keyword("Volley"),
                        TitleContains("dynamic"),
                        TitleContains("girly"),
                        TitleContains("precision"),
                        TitleContains("shoot"),
                        TitleContains("technical"),
                    ]),
                ]),
            ),
        ],
        // Approximation: every printed D:7- maneuver (the 'reversed' text is not checked). The Backstage packing
        // permission is not supported yet.
        "Alexa Bliss": [
            FortitudeFor(filter: All([Maneuver, DamageAtMost(7)]), delta: -5),
            CannotBeReversedBy(played: All([Maneuver, DamageAtMost(7)]), reversal: TitleContains("Reach")),
            OnPlayMatching(filter: All([Maneuver, DamageAtMost(7)]), effects: [Optional([Dig(n: 2, take: 1)])]),
        ],
        // Watching the opponent's Arsenal moves and random discards is not supported yet.
        "Emma": [],
        // Approximation: printed 5F- Chain cards are -5F. The Ring reversal and The Straps Are Down texts are not
        // supported yet.
        "American Alpha": [
            FortitudeFor(filter: All([Trait(Chain), FortitudeAtMost(5)]), delta: -5),
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
        ],
        // The 'classic' packing permission is not supported yet.
        "The Vaudevillains": [
            OnPlayMatching(filter: TitleContains("classic"), effects: [Draw(who: You, n: 1), HandToArsenalBottom(who: You, n: 1)]),
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
            CannotPack("There is No Escape"),
        ],
        // The overturn texts and removing the Chain trait are not supported yet.
        "The Ascension": [
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
            CannotPack("Underrated Superstar"),
        ],
    },
    scripts: {
        // Grapples
        // The Jerry Lawler packing text is not supported yet.
        "Piledriver": (on_play: [Discard(who: Opponent, n: 2, pick: Chosen)]),

        // Reversals
        // The +5F per Sidewalk Slam, GenCon and Fortitude Rating texts are not supported yet.
        "Unintended CONsequences": (
            reverses: Some((targets: AnyOf([Trait(Irreversible), All([Antic, Trait(Unique)])]), ignores_irreversible: true)),
        ),
        // The WWF Superstar texts are not supported yet.
        "Will You Stop!": (
            reverses: Some((
                targets: All([Not(Maneuver), Not(SuperstarSpecific)]),
                effects: [
                    Discard(who: Opponent, n: 1, pick: Chosen),
                    MoveCards(who: You, from: Removed, to: Arsenal, n: 2, up_to: true),
                ],
            )),
        ),
        // Approximation: always only when overturned (the ignore-Requirement and Ringside texts are not supported).
        "Revolution Masochist at Heart": (reverses: Some((targets: Trait(Colossal), overturned_only: true))),
        // Removing D:4+ from your Ring and the Ringside text are not supported yet.
        "Revolution I Won't Be Beat Tonight": (
            reverses: Some((targets: Trait(Colossal), fortitude_when: Some((CountAtMost(count: YourFortitude, n: 5), 0)))),
        ),
        // The F:0 conditions and the Ringside text are not supported yet.
        "Revolution Losing the Crowd's Favor": (
            reverses: Some((
                targets: All([Trait(Colossal), Not(ManeuverType(Trademark))]),
                effects: [
                    If(
                        condition: CountBelow(a: OpponentRingMatching(Trait(Colossal)), b: YourRingMatching(Trait(Colossal))),
                        effects: [Discard(who: You, n: 1, pick: Random)],
                    ),
                ],
            )),
        ),

        // Pre-match
        // Approximation: The NXT Generation cannot be reversed from hand or Backlash. Moving cards from under NXT
        // Arrival is not supported yet.
        "Corey Graves: Savior of Misbehavior": (
            no_slot: true,
            frees_slots: Some(Title("NXT Arrival")),
            while_in_ring: [(applies_to: Title("The NXT Generation"), no_hand_reversal: true)],
        ),
        // The NXT / Fortitude and named-Superstar texts are not supported yet.
        "NXT North American Championship Title Belt": (),
        // The Starting Hand Size texts are not supported yet.
        "NXT Tag Team Title Belts": (
            value_bonus: 1,
            end_of_prematch: [
                If(
                    condition: AnyOf([
                        Superstar("Neville"),
                        Superstar("The Wyatt Family"),
                        Superstar("The Ascension"),
                        Superstar("The Vaudevillains"),
                        Superstar("American Alpha"),
                    ]),
                    effects: [RingsideToHand(who: You, n: 1, up_to: true, filter: Some(Not(Trait(Unique))))],
                ),
            ],
        ),
        // The Starting Hand Size and Superstar-specific texts are not supported yet.
        "NXT Women's Championship Title Belt": (only_packed_by: ["Female"], value_bonus: 1),
        // Approximation: Promo on every Face / Heel / Cheater / Fan Favorite card (not once per turn). The Pro
        // packing, The NXT Generation and the -1F texts are not supported yet.
        "The NXT Arena, Full Sail University": (
            only_packed_by: ["NXT"],
            not_with: ["The Nexus Armband", "From NXT to WWE"],
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: AnyOf([Trait(Face), Trait(Heel), Trait(Cheater), Trait(FanFavorite)]),
                    effects: [Optional([Dig(n: 2, take: 1)])],
                ),
            ],
        ),
        // The antic reversal text is not supported yet (the Requirement and the Corner ban have no effect: no Corners
        // are checked).
        "Revolution Ruling From the Commissioner": (),

        // Backstage cards
        // The cards-under-this-card texts are not supported yet.
        "205 Live": (only_packed_by: ["Cruiserweight"], not_with: ["The NXT Breakout Star"]),

        // Finn Balor
        // Approximation: "unsuccessful" is when it is reversed, and you choose the cards removed instead of at random.
        // The hide text is not supported yet.
        "Finn's Leather Jacket": (
            backstage_abilities: [
                StartOfTurn([Boost((applies_to: Maneuver, duration: ThisTurn, fortitude: -1, count: Some(YourUnderSuperstar)))]),
                OnOpponentReverses([
                    If(
                        condition: All([OpponentReversed(All([Maneuver, Not(Trait(Chain))])), CountAtLeast(count: YourUnderSuperstar, n: 2)]),
                        effects: [Optional([TakeFromUnder(to: Removed, n: 2, superstar: true), Discard(who: Opponent, n: 2, pick: Chosen)])],
                    ),
                ]),
            ],
        ),
        // Approximation: the ACE removes exactly 2 cards you choose from under the Superstar card (not 2+ at random)
        // and takes a D: 2 or lower card. The hide text is not supported yet.
        "The Demon Arrives": (
            backstage_abilities: [
                StartOfTurn([
                    If(condition: CountAtMost(count: YourRingSize, n: 0), effects: [RemoveFromGame(who: You, from: Ringside, n: 3, pick: Random)]),
                    PutUnder(from: Ring, n: 1, superstar: true),
                ]),
            ],
            backstage_ability: Some((
                requires: Some(CountAtLeast(count: YourUnderSuperstar, n: 2)),
                cost: [TakeFromUnder(to: Removed, n: 2, superstar: true)],
                effects: [RemoveFromRing(who: Opponent, n: 1, filter: DamageAtMost(2))],
            )),
        ),
        // The blanking text and the ACE's draw / Ringside part (it depends on the card put under) are not supported yet.
        "Catch Your Breath": (
            no_slot: true,
            end_of_prematch: [Dig(n: 2, take: 1), Dig(n: 2, take: 1), Dig(n: 2, take: 1)],
            ring_ability: Some((cost: [Discard(who: You, n: 1, pick: Chosen)], effects: [PutUnder(from: Ring, n: 1, superstar: true)])),
        ),
        // The Backlash text is not supported yet.
        "Sling Blade": (bonuses: [(fortitude: -1, count: Some(YourUnderSuperstar))], on_play: [Discard(who: Opponent, n: 2, pick: Chosen)]),
        // The Backlash and ACE texts are not supported yet.
        "Balor's Intimidating Visage": (
            reverses: Some((
                targets: Not(Maneuver),
                requires: Some(BackstageRevealed(who: You, filter: Title("The Demon Arrives"))),
                effects: [Optional([Dig(n: 3, take: 1)])],
            )),
        ),
        "Balor's Running Drop Kick": (
            play_after: Some(Any),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            requires: Some(Not(After(Title("From the Top Rope")))),
            reversal_limits: [
                (
                    from: [Hand, Backlash, Ringside, Ring, Under],
                    when: AnyOf([CountBelow(a: Plus(YourFortitude, Const(5)), b: OpponentFortitude), After(Title("Irish Whip"))]),
                ),
            ],
        ),
        "Balor's Lifting Inverted DDT": (
            not_reversed_by: Some(Hybrid),
            on_play: [DrawUpTo(who: You, n: 2), Discard(who: Opponent, n: 2, pick: Random)],
        ),
        "Finn's Pele Kick": (
            bonuses: [(fortitude: -10)],
            on_play: [Optional([Dig(n: 2, take: 1)])],
            reverses: Some((targets: AnyOf([Trait(SetUp), ManeuverType(Grapple), ManeuverType(Throw)]))),
        ),
        // Approximation: 'Finn Balor-specific' is any Superstar-specific card.
        "The 1916": (
            reversal_limits: [(from: [Hand], when: After(SuperstarSpecific)), (from: [Arsenal], when: InYourRing(Title("Coup de Grace")))],
            on_play: [DrawUpTo(who: You, n: 3)],
            reverses: Some((
                targets: AnyOf([ManeuverType(Strike), ManeuverType(Submission)]),
                damage: Fixed(10),
                effects: [DrawUpTo(who: You, n: 3)],
            )),
        ),
        "Coup de Grace": (
            play_after: Some(All([Maneuver, DamageAtLeast(5)])),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            reversal_limits: [(from: [Arsenal, Backlash, Ringside, Ring, Under], when: CountAtLeast(count: YourUnderSuperstar, n: 7))],
        ),
        // Approximation: "recover" shuffles the cards into the Arsenal. Its In Ring text is always so (cards under
        // the Superstar card are always chosen).
        "Balor Club": (
            bonuses: [(when: BackstageRevealed(who: You, filter: Title("Finn's Leather Jacket")), fortitude: -5)],
            reversal_limits: [(from: [Hand], when: BackstageRevealed(who: You, filter: Title("Finn's Leather Jacket")))],
            on_play: [
                MoveCards(who: You, from: Removed, to: Arsenal, n: 6, up_to: true),
                RingsideToArsenal(who: You, n: 4, up_to: true),
                PutUnder(from: Removed, n: 2, up_to: true, superstar: true),
            ],
        ),

        // Samoa Joe
        // Approximation: "under this card" is under the Superstar card, and the maneuvers there can be played at any
        // time (not once per turn).
        "The Samoan Submission Machine": (
            backstage_abilities: [
                StartOfTurn([Boost((applies_to: Maneuver, duration: ThisTurn, fortitude: -3, count: Some(YourUnderSuperstar)))]),
                PlayFromUnder(Maneuver),
            ],
            backstage_ability: Some((
                cost: [HandToArsenalBottom(who: You, n: 1)],
                effects: [
                    Choice([
                        [PutUnder(from: Hand, n: 1, filter: Some(ManeuverType(Submission)), superstar: true)],
                        [PutUnder(from: Ringside, n: 1, filter: Some(ManeuverType(Submission)), superstar: true)],
                    ]),
                ],
            )),
        ),
        // Approximation: at the end of the Pre-match phase you search for 1 non-Unique maneuver (the opponent's
        // discard choice and putting cards under The Samoan Submission Machine are not supported).
        "Joe's Gonna Kill You!": (
            end_of_prematch: [Search(filter: All([Maneuver, Not(Trait(Unique))]), up_to: true)],
            ring_ability: Some((effects: [RingsideToHand(who: You, n: 3, up_to: true, filter: Some(Maneuver))], sacrifice: true)),
        ),
        // Moving it between zones before the Draw Segment is not supported yet.
        "The Right Hand of Destruction": (),
        // The Breakout Star text is not supported yet.
        "The First-Ever Two-Time NXT Champion": (
            on_play: [
                RingsideToArsenalBottom(who: You, n: 2),
                Discard(who: Opponent, n: 1, pick: Chosen),
                If(
                    condition: InYourRing(Title("NXT Championship Title Belt")),
                    effects: [RingsideToArsenalBottom(who: You, n: 2), Discard(who: Opponent, n: 1, pick: Chosen)],
                ),
            ],
        ),
        // Approximation: it can be played from the Ringside pile (not from the Ring); the once-per-turn limit is not
        // supported yet.
        "Samoan Chop": (
            from_ringside: Some(CountAtLeast(count: HandSize, n: 1)),
            on_play: [If(condition: PlayedFromRingside, effects: [HandToArsenalBottom(who: You, n: 1)])],
        ),
        // The D:0 limit on hand reversals when played as a Counter is not supported yet.
        "STJoe": (
            reversal_limits: [(from: [Backlash, Ringside, Ring, Under], when: All([ReversedLastTurn(Any), FirstCardThisTurn]))],
            reverses: Some((targets: AnyOf([ManeuverType(Strike), After(Trait(SetUp))]))),
        ),
        // Approximation: the shuffle is not reduced by reversals; the 'completely' text is not supported yet.
        "Avalanche/Kick Combination": (
            bonuses: [(when: After(Title("Throw Into the Corner Turnbuckle")), damage: 5, reversal_fortitude: 12)],
            on_play: [RingsideToArsenal(who: You, n: 6, up_to: true)],
        ),
        "Cocquina Clutch": (
            reversal_limits: [(from: [Arsenal, Ring])],
            on_play: [Boost((applies_to: Title("Maintain Hold"), duration: NextCard, ignore_play_after: true))],
            reverses: Some((targets: Not(Maneuver))),
        ),
        // Counting as a Grapple is not supported yet.
        "Muscle Buster": (
            play_after: Some(All([Maneuver, DamageAtLeast(5)])),
            play_after_unless: Some(All([ReversedLastTurn(AnyOf([All([Maneuver, DamageAtLeast(5)]), Trait(SetUp)])), FirstCardThisTurn])),
            in_ring_opponent_start_of_turn: [Discard(who: You, n: 1, pick: Random)],
        ),
        // The +1D per Strike Ring text is not supported yet.
        "I Am Not a Virtuous Man": (
            on_play: [LookAtHand(who: Opponent), MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 2, pick: Controller, bottom: true)],
            reverses: Some((targets: Not(Maneuver))),
        ),
        // The Samoan Submission Machine text is not supported yet.
        "The Destroyer": (
            on_play: [
                Counted(count: YourRingMatching(Maneuver), effect: Discard(who: Opponent, n: 0, pick: Chosen)),
                Boost((applies_to: Maneuver, duration: NextMatching, no_hand_reversal: true, no_backlash_reversal: true)),
            ],
        ),

        // Shinsuke Nakamura
        // The 'elbow'/'knee'/'fist' unsuccessful text is not supported yet. Approximation: only Mid-match cards go
        // back to the Backlash deck.
        "King of Strong Style": (
            backstage_ability: Some((
                requires: Some(InYourRing(All([Trait(MidMatch), Not(Reversal)]))),
                cost: [MoveCards(who: You, from: Ring, to: Backlash, n: 1, filter: Some(All([Trait(MidMatch), Not(Reversal)])))],
                effects: [Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -5, no_backlash_reversal: true))],
            )),
        ),
        // The moved-from-Ring and Backlash texts are not supported yet.
        "The Artist Known as Shinsuke Nakamura": (
            while_in_ring: [
                (
                    applies_to: All([Maneuver, AnyOf([TitleContains("elbow"), TitleContains("knee"), TitleContains("fist")])]),
                    damage: 1,
                    stun_value: 1,
                ),
            ],
        ),
        // The Ability and King of Strong Style texts are not supported yet.
        "The Second-Ever Two-Time NXT Champion": (
            on_play: [
                RingsideToArsenalBottom(who: You, n: 2),
                Discard(who: Opponent, n: 1, pick: Chosen),
                If(
                    condition: InYourRing(Title("NXT Championship Title Belt")),
                    effects: [RingsideToArsenalBottom(who: You, n: 2), Discard(who: Opponent, n: 1, pick: Chosen)],
                ),
            ],
        ),
        // The removed-to-Arsenal text is not supported yet.
        "Nakamura's German Suplex": (
            reversal_limits: [
                (
                    from: [Hand],
                    when: All([ReversedLastTurn(Any), FirstCardThisTurn, OpponentHandLarger, FortitudeBelowOpponent]),
                ),
            ],
        ),
        "Good Vibrations": (
            play_after: Some(AnyOf([Maneuver, Title("Throw Into the Corner Turnbuckle")])),
            play_after_unless: Some(All([ReversedLastTurn(All([Maneuver, DamageAtLeast(5)])), FirstCardThisTurn])),
            no_backlash_reversal: true,
        ),
        // The discard text is not supported yet.
        "Nakamura's Corner Knee Strike": (
            play_after: Some(Any),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            reversals_needed: 3,
            reversals_needed_when: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
        ),
        "Shinsuke's Cross Arm Breaker": (
            on_play: [
                Boost((applies_to: Title("Maintain Hold"), duration: NextCard, ignore_play_after: true)),
                Discard(who: Opponent, n: 4, pick: Chosen),
            ],
        ),
        "Nakamura's Wheel Kick": (
            bonuses: [(fortitude: -11)],
            not_reversed_by: Some(DamageAtLeast(1)),
            reverses: Some((targets: ManeuverType(Grapple))),
        ),
        "KINSHASA!": (
            bonuses: [(count: Some(YourBacklashSize), fortitude: -1)],
            play_after: Some(Any),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            no_arsenal_reversal: true,
            reverses: Some((targets: ManeuverType(TrademarkFinisher))),
        ),
        // The Ring Promo text is not supported yet.
        "Strong Style has Arrived": (
            reverses: Some((
                targets: AnyOf([ManeuverType(Strike), ManeuverType(Grapple)]),
                effects: [RingsideToArsenal(who: You, n: 5, up_to: true)],
            )),
        ),
        // The 'completely' text and removing the reversed card are not supported yet.
        "COME ON!": (from_ringside: Some(Always), reverses: Some((targets: Not(Maneuver)))),

        // Baron Corbin
        // The Pre-match and Backlash protection texts are not supported yet.
        "Superhuman": (
            backstage_abilities: [
                OnOpponentReverses([
                    If(
                        condition: CountAtMost(count: YourArsenalSize, n: 10),
                        effects: [Optional([RingsideToArsenal(who: You, n: 2, up_to: true, filter: Some(All([Not(Trait(Unique)), Not(Reversal)])))])],
                    ),
                ]),
            ],
        ),
        // Approximation: on every RMS maneuver (not once per turn). The blanking and Hell in a Cell texts are not
        // supported yet.
        "The Lone Wolf": (
            no_slot: true,
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: All([Maneuver, Keyword("RMS")]),
                    effects: [RingsideToHand(who: You, n: 1, up_to: true, filter: Some(Not(Reversal)))],
                ),
            ],
        ),
        // The Backlash text is not supported yet.
        "The Alpha of NXT": (
            irreversible_when: Some(OpponentIs("NXT")),
            while_in_ring: [(applies_to: All([Maneuver, Keyword("RMS"), Not(TitleContains("precision"))]), fortitude: -5)],
            on_opponent_reverses: [
                If(
                    condition: All([OpponentReversed(All([Maneuver, Keyword("RMS")])), OpponentReversedFrom([Hand, Arsenal])]),
                    effects: [DrawUpTo(who: You, n: 1)],
                ),
            ],
        ),
        "Corbin's Powerful Punch": (
            reversals_needed: 3,
            reversals_needed_when: Some(FortitudeBelowOpponent),
            on_play: [RingsideToArsenal(who: You, n: 2, up_to: true)],
        ),
        "Lone Wolf Clothesline": (not_reversed_by: Some(Hybrid), on_play: [Discard(who: Opponent, n: 1, pick: Random)]),
        "Corbin's Big Boot": (
            bonuses: [(fortitude: -10)],
            on_play: [Discard(who: Opponent, n: 2, pick: Chosen)],
            reverses: Some((targets: AnyOf([ManeuverType(Grapple), ManeuverType(Throw), After(Trait(SetUp))]))),
        ),
        "Deep Six": (
            multi_when: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            bonuses: [(fortitude: -16, damage: 6)],
            on_play: [RemoveFromGame(who: Opponent, from: Arsenal, n: 6)],
            reverses: Some((
                targets: ManeuverType(Strike),
                effects: [Dig(n: 6, take: 1), RingsideToArsenalBottom(who: You, n: 6)],
            )),
        ),
        // Removing overturned cards is not supported yet.
        "End of Days": (
            play_after: Some(All([Maneuver, DamageAtLeast(5)])),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            reversal_limits: [
                (
                    from: [Hand, Backlash, Ringside, Ring, Under],
                    when: AnyOf([After(All([Maneuver, DamageAtLeast(5)])), OpponentIs("NXT")]),
                ),
            ],
        ),
        // Reversing Activated Card Effects is not supported yet.
        "All Hail Baron Corbin": (
