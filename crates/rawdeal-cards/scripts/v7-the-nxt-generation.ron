// Hand-written scripts for V7: The NXT Generation (Raw Deal Virtual set 34) cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// "Counter" = you reversed a card to end your opponent's last turn and this is your first card this turn.
// "Promo: N" is approximated as `Dig`: you keep 1 of the top N cards and the rest go on the bottom of the Arsenal.
// "Bury" puts cards on the bottom of the Arsenal; "RFG" removes them from the game.
// "Reversal: Special" cards: "Reverse any X" is the reversal target. Reversals played after a card was successfully
// played use `after_success`; reversals of card effects and of Activated Card Effects are not supported
// (`targets: Not(Any)`). Superstar abilities make cards Multi with a start-of-turn Boost for that turn.
// ACE (Activated Card Effects) are ring abilities used during your own turn. Packing permissions printed on
// Superstar cards ("You can pack X") are not supported unless they are other Superstars' logos (`PacksLogos`).
(
    abilities: {
        // Answering a reversed Activated Card Effect and the German Suplex / packing texts are not supported yet.
        "The Beast Incarnate": [PacksLogos(["Brock Lesnar"])],
        // Approximation: he may pack every Randy Orton card.
        "The Viper": [
            OnOpponentPlayMatching(
                filter: Maneuver,
                effects: [MoveCards(who: You, from: Removed, to: Arsenal, n: 1, up_to: true, filter: Some(Not(Reversal)), bottom: true)],
            ),
            PacksLogos(["Randy Orton"]),
        ],
        // Removing a Reversal from hand to make the opponent's card -4D is not supported yet.
        "Bray Wyatt": [CannotPack("Ring Psychology: Arm"), CannotPack("Beg For Mercy")],
        // Playing Backlash cards face-down as European Uppercut is not supported yet.
        "Cesaro": [],
        // Punishing the opponent's draws and Ringside moves is not supported yet.
        "Damien Sandow": [],
        // Approximation: any reversed maneuver or Superstar-specific card, not only the first card of the turn.
        "Ryback": [
            OnOpponentReverses([
                If(
                    condition: All([OpponentReversed(AnyOf([Maneuver, SuperstarSpecific])), HandAtLeast(2)]),
                    effects: [Optional([Discard(who: You, n: 2, pick: Chosen), ContinueTurn])],
                ),
            ]),
        ],
        "Brodus Clay": [
            Activated(
                requires: Some(HandAtLeast(1)),
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [RingsideToHand(who: You, n: 1, filter: Some(All([Reversal, Not(SameTitleInRing)])))],
            ),
            DamageFor(filter: ManeuverType(HighRisk), delta: 2),
            CannotPack("Over Sell Maneuver"),
        ],
        // Approximation: Dean Ambrose-specific means Superstar-specific. The Heat removal and blindside texts are not
        // supported yet.
        "Dean Ambrose": [OnPlayMatching(filter: AnyOf([Keyword("Heat"), SuperstarSpecific]), effects: [Optional([Dig(n: 2, take: 1)])])],
        // The BASH and packing texts are not supported yet.
        "Roman Reigns": [
            DamageFor(filter: Maneuver, delta: 2),
            StartOfTurn([Boost((applies_to: TitleContains("Samoan Drop"), duration: ThisTurn, multi: true))]),
        ],
        // Approximation: Promo when the opponent reverses a precision / technical or Superstar-specific card.
        "Seth Rollins": [
            OnOpponentReverses([
                If(
                    condition: OpponentReversed(AnyOf([TitleContains("precision"), TitleContains("technical"), SuperstarSpecific])),
                    effects: [Optional([Dig(n: 2, take: 1)])],
                ),
            ]),
        ],
        "Sin Cara": [],
        // Approximation: you reveal your whole hand; # counts its D:10+ cards (at most 6).
        "Titus O'Neil": [
            Activated(
                requires: Some(HandHas(DamageAtLeast(10))),
                cost: [RevealHand(who: You)],
                effects: [
                    Counted(
                        count: AtMost(YourHandMatching(DamageAtLeast(10)), 6),
                        effect: Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -1)),
                    ),
                    NextPlayWatch(filter: Maneuver, on_success: [DrawUpTo(who: You, n: 1)]),
                ],
            ),
            CannotPack("The Nexus Armband"),
        ],
        "Luke Harper": [
            OnPlayMatching(
                filter: All([
                    Maneuver,
                    Not(TitleContains("Revolution")),
                    AnyOf([TitleContains("slam"), TitleContains("bomb"), TitleContains("clothesline"), TitleContains("lariat")]),
                ]),
                effects: [Optional([Dig(n: 3, take: 1), MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, bottom: true)])],
            ),
        ],
        // The Drawing a Blank texts are not supported yet.
        "Erick Rowan": [],
        // Approximation: Promo whenever the opponent reverses your card; the D:1+ text is not supported yet.
        "Sami Zayn": [OnOpponentReverses([Optional([Dig(n: 2, take: 1)])])],
        // Approximation: you choose the Ringside card instead of a random one; Corners are not blocked.
        "Team Hell No": [
            OnPlayMatching(
                filter: SuperstarSpecific,
                effects: [Choice([[RingsideToArsenal(who: You, n: 1), Draw(who: You, n: 1)], [Mill(who: Opponent, n: 1)]])],
            ),
            PacksLogos(["Daniel Bryan", "Kane"]),
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
        ],
        // Removing Backlash cards to ignore play requirements is not supported yet; Corners are not blocked.
        "The Rhodes Brothers": [
            PacksLogos(["Goldust", "Cody Rhodes"]),
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
        ],
        "Prime Time Players": [
            OnYouReverse([Optional([Dig(n: 2, take: 1)])]),
            OnPlayMatching(filter: SuperstarSpecific, effects: [Optional([Dig(n: 4, take: 1)])]),
            PacksLogos(["Darren Young", "Titus O'Neil"]),
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
        ],
        // The 'Tag Team' text and the packing permissions are not supported yet.
        "The Usos": [
            OnPlayMatching(filter: SuperstarSpecific, effects: [DrawUpTo(who: You, n: 1)]),
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
        ],
        // Approximation: on every Reversal you play (not once per turn). The Total Teamwork and Corner texts are not
        // supported yet.
        "The Shield": [OnYouReverse([Optional([DrawUpTo(who: You, n: 3), HandToArsenalBottom(who: You, n: 2)])]), CannotPack("First of All")],
        // Packing Bray Wyatt hidden is not supported yet.
        "The Wyatt Family": [
            Activated(
                requires: Some(HandAtLeast(1)),
                cost: [],
                effects: [
                    Choice([
                        [RemoveFromGame(who: You, from: Hand, n: 1), Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -2, damage: 2))],
                        [RemoveFromGame(who: You, from: Hand, n: 2), Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -4, damage: 4))],
                    ]),
                ],
            ),
        ],
        // Swapping cards under We're a 3 Man Band! and the Hornswoggle! text are not supported yet.
        "3MB": [PacksLogos(["Heath Slater"])],
        // Approximation: always 3 cards, chosen instead of random. The packing permissions are not supported yet.
        "A.J. Lee": [
            Activated(
                requires: Some(HandAtLeast(3)),
                cost: [],
                effects: [HandToArsenal(who: You, n: 3), HandToArsenal(who: Opponent, n: 3), Draw(who: You, n: 3), Draw(who: Opponent, n: 3)],
            ),
            CannotPackMatching(All([AnyOf([ManeuverType(Grapple), ManeuverType(Throw)]), DamageAtLeast(4)])),
        ],
        // The NXT Breakout Star, Diva-packed and Skirt the Issue texts are not supported yet.
        "Paige": [CannotPackMatching(TitleContains("girly"))],
        // The one-ACE limit and Corner / Manager limits are not supported yet. Approximation: all Edge cards.
        "The Rated R Superstar": [
            OnOpponentPlayMatching(filter: Any, effects: [If(condition: OpponentHandLarger, effects: [Discard(who: Opponent, n: 1, pick: Chosen)])]),
            PacksLogos(["Edge"]),
            CannotPackMatching(Keyword("Run-in")),
        ],
    },
    scripts: {
        // Strikes
        // Its reversal (after a successfully played maneuver with a reversal restriction) is not supported yet.
        "Counter Strike": (
            reversal_limits: [
                (by: Some(All([Not(Trait(Unique)), DamageAtLeast(2)])), when: All([ReversedLastTurn(Any), FirstCardThisTurn])),
            ],
            reverses: Some((targets: Not(Any))),
        ),

        // Submissions
        // "Reversed as if non-Unique" and "damage cannot be increased" are not supported yet.
        "Classic Rest Hold": (
            on_play: [
                DrawUpTo(who: You, n: 1),
                Boost((applies_to: Title("Maintain Hold"), duration: NextCard, irreversible: true)),
            ],
        ),
        // "Reversed as if non-Unique" and the +1 Stun Value are not supported yet.
        "Classic Bear Hug": (),

        // Grapples
        // "Reversed as if non-Unique" is not supported yet.
        "Classic DDT": (on_play: [Mill(who: Opponent, n: 1), Discard(who: Opponent, n: 2, pick: Random)]),
        // "Reversed as if non-Unique" is not supported yet. Approximation: every Grapple counts as a WWF Grapple.
        "Classic Power Bomb": (
            bonuses: [(per: Some(ManeuverType(Grapple)), damage: 1)],
            on_play: [DrawUpTo(who: You, n: 1)],
        ),

        // Reversals
        // Approximation: # is 1 (the Adam Crites Memorial Tournament count is not supported yet).
        "I've Got One Thing To Say About That!": (
            not_with: ["Sidewalk Slam"],
            reverses: Some((
                targets: AnyOf([Trait(Momentum), Trait(Irreversible)]),
                from_hand_only: true,
                ignores_irreversible: true,
                on_reverse: [
                    If(
                        condition: Not(InYourRing(AnyOf([Title("Back to Basics"), Keyword("BASH")]))),
                        effects: [DrawUpTo(who: You, n: 1), RingsideToArsenal(who: You, n: 1, up_to: true)],
                    ),
                ],
            )),
        ),
        // The removed-from-game lock and the On One Arena / Tournament bonus are not supported yet.
        "One!": (
            reverses: Some((
                targets: All([Maneuver, Not(SuperstarSpecific)]),
                overturned_only: true,
                removed_after: true,
                effects: [RemoveFromGame(who: You, from: Ringside, n: 1), Discard(who: You, n: 1, pick: Chosen)],
            )),
        ),
        // Approximation: the reversed card goes to the Ringside pile instead of back to his hand; the 4+ Heyman
        // choices are not supported yet.
        "Heyman Interferes": (
            reverses: Some((
                targets: Any,
                requires: Some(CountAtLeast(count: YourRingAndRingsideMatching(TitleContains("Heyman")), n: 2)),
                fortitude_when: Some((CountAtLeast(count: YourRingMatching(TitleContains("Heyman")), n: 4), 5)),
            )),
        ),

        // Actions
        // The PRO packing rule is not supported yet.
        "Getting Extra PROmotion": (
            irreversible_when: Some(After(SuperstarSpecific)),
            on_play: [
                RingsideToArsenal(who: You, n: 4, up_to: true),
                DrawUpTo(who: You, n: 2),
                Boost((duration: NextCard, reversal_fortitude: 8)),
            ],
        ),
        // Approximation: "Classic WWF Superstar" is not recognised (only Legends).
        "The NXT Generation": (
            on_play: [
                If(
                    condition: YouAre("NXT"),
                    effects: [
                        RingsideToArsenal(who: You, n: 8, up_to: true, filter: Some(Not(Reversal))),
                        DrawUpTo(who: You, n: 2),
                        If(condition: OpponentIs("Legend"), effects: [HandToArsenalBottom(who: Opponent, n: 2)]),
                    ],
                ),
                If(
                    condition: Not(YouAre("NXT")),
                    effects: [
                        RingsideToArsenal(who: You, n: 4, up_to: true, filter: Some(Not(Reversal))),
                        DrawUpTo(who: You, n: 1),
                        If(condition: OpponentIs("Legend"), effects: [HandToArsenalBottom(who: Opponent, n: 1)]),
                    ],
                ),
            ],
        ),
        // Approximation: "choose two" offers four pairs; the -2F per D:2+ card, flipping cards and the
        // It is printed Multi, so it always needs 2 Reversals.
        "Two-Time! Two-Time!": (
            bonuses: [(count: Some(OpponentRingMatching(DamageAtLeast(2))), fortitude: -2)],
            on_play: [
                Choice([
                    [DrawUpTo(who: You, n: 2), RingsideToArsenal(who: You, n: 2, up_to: true)],
                    [DrawUpTo(who: You, n: 2), Mill(who: Opponent, n: 2)],
                    [RingsideToArsenal(who: You, n: 2, up_to: true), HandToArsenalBottom(who: Opponent, n: 2)],
                    [HandToArsenalBottom(who: Opponent, n: 2), Mill(who: Opponent, n: 2)],
                ]),
            ],
            reverses: Some((
                targets: AnyOf([Title("Poke"), Title("Shake")]),
                fortitude: Some(0),
                effects: [Discard(who: Opponent, n: 2, pick: Chosen)],
            )),
        ),

        // Pre-match
        // The Back to Basics, old school and ACE texts are not supported yet.
        "A Foundation of Old School Wrestling": (),
        // Putting overturned cards under this card and the Counter discount are not supported yet.
        "NXT Arrival": (
            only_packed_by: ["NXT"],
            not_with: ["The Nexus Armband"],
            ring_ability: Some((effects: [RingsideToArsenal(who: You, n: 5, up_to: true), ReturnThis(to: Removed)])),
        ),
        // Blocking your own Pre-match cards and putting cards under it are not supported yet.
        "Shut Up and Wrestle!": (
            not_with: ["I'm Gonna Break You!"],
            ring_ability: Some((effects: [TakeFromUnder(to: Hand, n: 1)])),
        ),
        // Approximation: +1 Hand Size while in your Ring. The Superstar Value 0 text is not supported yet.
        "NXT Championship Title Belt": (hand_size_bonus: 1, value_bonus: 1),
        // Putting this card into the Ringside pile after playing the card under it and the ACE texts are not
        // supported yet.
        "Tech In a Bottle": (
            end_of_prematch: [
                PutUnder(
                    from: Arsenal,
                    n: 1,
                    up_to: true,
                    filter: Some(All([
                        Maneuver,
                        Not(SuperstarSpecific),
                        Not(Trait(Unique)),
                        AnyOf([
                            Trait(Chain), Keyword("Heat"), Keyword("Volley"), Trait(Face), Trait(Heel),
                            TitleContains("blindside"), TitleContains("precision"), TitleContains("technical"),
                        ]),
                    ])),
                ),
            ],
            play_from_under: Some(Not(Trait(Multi))),
        ),

        // Backstage cards
        // The Superstar Value start and the Activate texts are not supported yet.
        "PRO Zack Ryder": (only_packed_by: ["Rookie"]),
        // Approximation: always hidden (the Adam Crites Memorial Tournament is not supported).
        "Cause Adam Crites Said So": (not_packed_by: ["Doink"], starts_hidden: true),
        // Approximation: always hidden (the Adam Crites Memorial Tournament is not supported).
        "Best There Is, Best There Was": (not_packed_by: ["Doink"], starts_hidden: true),
        "Celebrity Shenanigans": (),
        "Defeating Villainous Shenanigans": (),

        // The Beast Incarnate / Brock Lesnar
        // Approximation: Here Comes the Pain needs 30F less. Face-down cards and the Unique reversal text are not
        // supported yet.
        "The Conqueror": (
            not_with: ["Interviewed by Mean Gene Okerlund"],
            backstage_abilities: [CardFortitude(title: "Here Comes the Pain", delta: -30)],
        ),
        // Approximation: every German Suplex is -30F; Brock Lesnar-specific Events are Superstar-specific Pre-match
        // cards. Cannot be blanked and its own -5F are not supported yet.
        "Suplex City": (
            frees_slots: Some(All([SuperstarSpecific, Not(AnyOf([Maneuver, Action, Reversal, Antic]))])),
            while_in_ring: [
                (applies_to: Title("German Suplex"), fortitude: -30),
                (applies_to: All([All([Title("German Suplex"), Not(Keyword("Throwback"))]), Not(EarlierThisTurn(filter: All([Title("German Suplex"), Not(Keyword("Throwback"))]), n: 1))]), multi: true),
            ],
            ring_ability: Some((
                requires: Some(Not(InYourRing(Title("Collegiate Champions")))),
                cost: [Mill(who: You, n: 3)],
                effects: [RingsideToHand(who: You, n: 1, filter: Some(Title("German Suplex")))],
            )),
        ),
        // The Corner and D:15+ texts are not supported yet.
        "Brock's Stretch Muffler": (
            bonuses: [(per: Some(AnyOf([TitleContains("leg"), TitleContains("knee"), TitleContains("suplex")])), damage: 1)],
        ),
        // Playing the chosen Ringside maneuvers is not supported yet; the turn still ends.
        "Beatdown by The Beast": (on_play: [EndTurn]),
        // The ACE (playing it later from your Ring) is not supported yet.
        "The Kimura": (
            on_play: [
                Boost((applies_to: Title("Maintain Hold"), duration: NextCard, ignore_play_after: true, irreversible: true)),
            ],
            reverses: Some((
                targets: AnyOf([ManeuverType(Strike), Not(Maneuver)]),
                effects: [Discard(who: Opponent, n: 2, pick: Random)],
            )),
        ),
        "Eat-Sleep-Conquer-Repeat": (
            on_play: [
                Dig(n: 4, take: 1),
                ThisToArsenal(bottom: true),
                RingsideToArsenalBottom(who: You, n: 3),
                Mill(who: Opponent, n: 2),
                HandToArsenalBottom(who: Opponent, n: 1),
            ],
        ),
        // The F-5 texts are not supported yet.
        "The One ... in 21-1": (
            on_play: [
                RingsideToArsenal(who: You, n: 10, up_to: true),
                MoveCards(who: You, from: Removed, to: Arsenal, n: 2, up_to: true, bottom: true),
                Draw(who: You, n: 1),
            ],
        ),

        // The Viper / Randy Orton
        // Approximation: the Viper choice happens on every maneuver the opponent plays (not once per turn).
        "The Apex Predator": (
            backstage_abilities: [
                OnYouReverse([
                    If(
                        condition: YouReversedFrom([Hand, Backlash]),
                        effects: [Boost((applies_to: Maneuver, duration: NextTurn, damage: 2))],
                    ),
                ]),
                OnOpponentPlayMatching(
                    filter: Maneuver,
                    effects: [
                        If(
                            condition: Superstar("The Viper"),
                            effects: [
                                Choice([
                                    [Draw(who: You, n: 1)],
                                    [RemoveFromGame(who: Opponent, from: Arsenal, n: 1)],
                                    [RingsideToArsenal(who: You, n: 1, filter: Some(All([Not(Reversal), SuperstarSpecific])))],
                                ]),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        // The extra titles and the Ringside texts are not supported yet. Approximation: the ACE is a Ring trigger
        // (it cannot be reversed).
        "I Hear Voices In My Head": (
            while_in_ring: [
                (applies_to: Title("The Viper Strikes"), fortitude: -30),
                (applies_to: Title("Battling The Voices"), fortitude: -6, multi: true),
            ],
            in_ring_on_play: [
                (
                    whose: Some(Opponent),
                    filter: Maneuver,
                    effects: [Optional([SacrificeThis, ShuffleHandAndRedraw(who: You), Draw(who: You, n: 2)])],
                    owner_controls: true,
                    on_attempt: true,
                ),
            ],
        ),
        // Cannot be blanked and the ACE are not supported yet.
        "The New Face of The WWE": (
            no_slot: true,
            while_in_ring: [
                (
                    applies_to: All([
                        Title("The Legend Killer"),
                        Holds(AnyOf([OpponentIs("Legend"), OpponentSuperstarValueAtLeast(5)])),
                    ]),
                    irreversible: true,
                ),
                (
                    applies_to: All([Maneuver, Holds(All([Superstar("The Viper"), FortitudeBelowOpponent]))]),
                    fortitude: -1,
                    count: Some(SuperstarValue),
                ),
            ],
        ),
        // Approximation: the RKO card cannot be reversed from the Arsenal at all; removed cards are not searched;
        // "cannot be played as reversals" is not supported yet.
        "Pounding the Mat, Preparing to Strike": (
            reversals_needed: 3,
            on_play: [
                Search(filter: TitleContains("RKO"), ringside: true),
                Boost((applies_to: TitleContains("RKO"), duration: NextCard, no_arsenal_reversal: true)),
            ],
            while_in_ring: [(applies_to: TitleContains("RKO"), fortitude: -5, ignore_play_after: true)],
        ),
        // Approximation: no Superstar-specific Reversal at all can reverse it; the Between the Ropes text is not
        // supported yet.
        "Orton's Hanging DDT": (
            not_packed_by: ["Rated RKO"],
            play_after: Some(AnyOf([Trait(SetUp), SuperstarSpecific, All([Maneuver, DamageAtLeast(8)])])),
            not_reversed_by: Some(Not(SuperstarSpecific)),
            on_play: [Counted(count: HalfOpponentHand, effect: Discard(who: Opponent, n: 0, pick: Chosen))],
        ),
        // Approximation: for The Viper it is -5F but still reverses only Unique maneuvers; the Apex Predator text is
        // not supported yet.
        "They Talk To Me": (
            reverses: Some((
                targets: All([Maneuver, Trait(Unique)]),
                fortitude_when: Some((Superstar("The Viper"), 10)),
                effects: [DrawUpTo(who: You, n: 1)],
            )),
        ),
        // Approximation: the opponent discards 1 Superstar-specific card even if you did not bury one.
        "They Counsel Me, They Understand": (
            bonuses: [(when: Superstar("The Viper"), fortitude: -10)],
            reversal_limits: [(by: Some(Hybrid), when: Superstar("The Viper"))],
            on_play: [
                Optional([
                    MoveCards(who: You, from: Hand, to: Arsenal, n: 1, filter: Some(SuperstarSpecific), bottom: true),
                    LookAtHand(who: Opponent),
                    DiscardMatching(who: Opponent, n: 1, filter: SuperstarSpecific, pick: Controller),
                ]),
                If(condition: Superstar("The Viper"), effects: [RingsideToArsenal(who: You, n: 4, up_to: true)]),
            ],
        ),

        // Bray Wyatt / Wyatt Family
        // The opponent's +F per removed card and the overturn exchange are not supported yet.
        "The Lantern": (not_with: ["Denville, New Jersey", "Dallas, Texas"]),
        // Blocking the opponent's prevent effects and the removal replacement are not supported yet.
        "The Eater of Worlds": (),
        // Blanking titles and the Pre-match protection are not supported yet.
        "We're Here": (),
        "Bray's Sambo Suplex": (
            on_play: [
                Optional([
                    RemoveFromGame(who: You, from: Arsenal, n: 1),
                    MoveCards(who: You, from: Removed, to: Hand, n: 1, up_to: true),
                ]),
            ],
        ),
        // It is printed Multi, so it always needs 2 Reversals.
        "Bray's Corner Avalanche": (
            play_after: Some(AnyOf([Maneuver, Title("Throw Into the Corner Turnbuckle")])),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
        ),
        // The Bray Wyatt reversal and the return from the removed pile are not supported yet.
        "Sister Abigail": (
            reversal_limits: [(from: [Hand, Backlash, Ringside, Ring, Under], when: YouAre("Bray Wyatt"))],
            reverses: Some((targets: All([Maneuver, Not(SuperstarSpecific), Trait(Unique)]))),
        ),
        "Do Not Fear The Wolves Led by a Sheep": (
            reverses: Some((
                targets: SuperstarSpecific,
                from_hand_only: true,
                on_reverse: [
                    MillUntil(who: Opponent, filter: SuperstarSpecific),
                    Search(filter: Title("Fear the Sheep Led by a Wolf"), ringside: true),
                ],
            )),
        ),
        // Approximation: Sister Abigail is not searched among the removed cards.
        "The World Eater Crawl": (
            reverses: Some((targets: Not(Any))),
            after_success: Some((
                filter: Maneuver,
                at: BeforeEffects,
                cancel: true,
                effects: [Search(filter: Title("Sister Abigail"), ringside: true)],
            )),
        ),
        // Approximation: the opponent discards 1 chosen Superstar-specific card (not all copies).
        "Fear the Sheep Led by a Wolf": (
            bonuses: [(when: InYourRing(Title("Do Not Fear The Wolves Led by a Sheep")), fortitude: -8)],
            on_play: [
                DrawUpTo(who: You, n: 3),
                LookAtHand(who: Opponent),
                DiscardMatching(who: Opponent, n: 1, filter: SuperstarSpecific, pick: Controller),
            ],
            reverses: Some((targets: SuperstarSpecific, from_hand_only: true, on_reverse: [Draw(who: You, n: 1)])),
            in_ring_on_play: [(whose: Some(You), filter: SuperstarSpecific, effects: [Draw(who: You, n: 1)])],
        ),
        // The Sister Abigail texts are not supported yet.
        "He's Got the Whole World in His Hands": (
            on_play: [
                Counted(count: YourRemoved, effect: RingsideToArsenal(who: You, n: 0, up_to: true)),
                RingsideToArsenal(who: Opponent, n: 2),
            ],
        ),

        // Cesaro
        // Approximation: only the Bury 2 ability; the Set-up packing, the first Draw Segment and the hide texts are
        // not supported yet.
        "The King of Swing": (
            backstage_ability: Some((
                requires: Some(HandAtLeast(2)),
                cost: [HandToArsenalBottom(who: You, n: 2)],
