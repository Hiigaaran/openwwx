        "Stretching is Good for the Groin!": (on_play: [Draw(who: You, n: 2), RingsideToArsenalBottom(who: You, n: 1)]),
        // Approximation: your next card cannot be reversed if it is non-unique, whichever card it is.
        "I've Had Many Partners ... But You're My Favorite": (
            on_play: [
                RingsideToHand(who: You, n: 1, filter: Some(Not(Trait(Unique)))),
