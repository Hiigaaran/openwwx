        // Billy and Chuck
        "Rico Enters!": (reverses: Some((targets: All([Maneuver, Not(ManeuverType(TrademarkFinisher))])))),
        // Looking at the opponent's Backlash deck is not supported yet.
        "Oh, Baby, You Look So ... Good to Me": (end_of_prematch: [Search(filter: Any)]),
