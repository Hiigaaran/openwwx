        ),
        "Ham-and-Egger!": (
            reverses: Some((
                targets: AnyOf([
                    Title("Don't Mess with the Champ!"),
                    Title("Fully Loaded!"),
                    Title("Second Wind"),
                    Title("Test of Strength"),
                    Title("I'm Not Outta It Yet!"),
                ]),
            )),
        ),
        // Approximation: it reverses any card, whether or not it could be reversed.
        "Not According to the Fine Print!": (
            reverses: Some((
                targets: Any,
                ignores_irreversible: true,
                requires: Some(
                    AnyOf([
                        InYourRing(Title("Signed Contract with Linda McMahon")),
                        InYourRing(Title("Backed by Mr. McMahon")),
                    ]),
                ),
            )),
        ),
        "The Squared Circle is No Place for a Woman!": (
            requires: Some(OpponentFemale),
