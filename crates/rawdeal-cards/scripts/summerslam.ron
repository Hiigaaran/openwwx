// Hand-written scripts for Summerslam cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
(
    abilities: {
        // "No Sell Maneuver" is already packable by him through its own packing list.
        "Hollywood Hulk Hogan": [
            CannotPackMatching(
                All([
                    Maneuver,
                    Not(ManeuverType(Strike)),
                    Not(Trait(Unique)),
                    Not(
                        AnyOf([
                            Title("Body Slam"),
                            Title("Elbow Drop"),
                            Title("Headlock Takedown"),
                            Title("Press Slam"),
                            Title("Scoop Slam"),
                            Title("Standing Side Headlock"),
                        ]),
                    ),
                ]),
            ),
        ],
        // The extra effects when the removed card is a maneuver and the Figure Four Leg Lock part are not
        // supported yet. Approximation: 'Reading' and 'Graceful' cards are read as titles with those words.
        "Ric Flair": [
            Activated(cost: [Discard(who: You, n: 1, pick: Chosen)], effects: [RemoveFromRing(who: Opponent, n: 1, filter: Any)]),
            OpponentCannotPlay("Ric Flair Interferes"),
            CannotPackMatching(AnyOf([TitleContains("Reading"), TitleContains("Graceful")])),
        ],
        // The Big Show part and Title Belts are not supported yet.
        "Hall and Nash": [
            FortitudeFor(
                filter: All([Maneuver, AnyOf([TitleContains("Bomb"), TitleContains("Power"), TitleContains("Slam")])]),
                delta: -3,
            ),
            DamageFor(
                filter: All([Maneuver, AnyOf([TitleContains("Bomb"), TitleContains("Power"), TitleContains("Slam")])]),
                delta: 3,
            ),
            CannotPackMatching(ManeuverType(HighRisk)),
        ],
        "Trish Stratus": [
            CannotPackTrait(SetUp),
            CannotPackMatching(All([Maneuver, DamageAtLeast(4), Not(TitleContains("bulldog"))])),
            FortitudeFor(filter: Action, delta: -3),
            OpponentCannotPlay("Enter the Stratus-phere"),
        ],
        // The Title Belt part is not supported yet.
        "Billy and Chuck": [
            OnOpponentReverses([If(condition: OpponentReversedFrom([Hand]), effects: [DrawUpTo(who: You, n: 1)])]),
        ],
        // The No Sell Maneuver part is not supported yet; getting Head back from the Ringside pile is on Head.
        "Al Snow": [Activated(cost: [Discard(who: You, n: 1, pick: Chosen)], effects: [LookAtHand(who: Opponent)])],
        "Tajiri": [
            Activated(
                cost: [],
                effects: [
                    Choice([
                        [
                            If(
                                condition: HandHas(TitleContains("kick")),
                                effects: [
                                    DiscardMatching(who: You, n: 1, filter: TitleContains("kick"), pick: Chosen),
                                    RingToHand(who: You, n: 1, filter: Trait(SetUp)),
                                ],
                            ),
                        ],
                        [
                            If(
                                condition: HandHas(Action),
                                effects: [
                                    DiscardMatching(who: You, n: 1, filter: Action, pick: Chosen),
                                    RingToHand(who: You, n: 1, filter: TitleContains("kick")),
                                ],
                            ),
                        ],
                    ]),
                ],
            ),
            DamageFor(filter: All([Maneuver, TitleContains("kick")]), delta: 1),
        ],
        // Approximation: used in the Main Segment, right after the maneuver succeeds.
        "Hurricane": [
            Activated(
                cost: [],
                requires: Some(After(Maneuver)),
                effects: [
                    If(
                        condition: After(ManeuverType(Strike)),
                        effects: [Optional([Search(filter: All([ManeuverType(Strike), Not(Trait(Unique))]))])],
                    ),
                    If(
                        condition: After(ManeuverType(Grapple)),
                        effects: [Optional([Search(filter: All([ManeuverType(Grapple), Not(Trait(Unique))]))])],
                    ),
                    If(
                        condition: After(ManeuverType(Submission)),
                        effects: [Optional([Search(filter: All([ManeuverType(Submission), Not(Trait(Unique))]))])],
                    ),
                    If(
                        condition: After(ManeuverType(HighRisk)),
                        effects: [Optional([Search(filter: All([ManeuverType(HighRisk), Not(Trait(Unique))]))])],
                    ),
                    If(
                        condition: After(ManeuverType(TrademarkFinisher)),
                        effects: [
                            Optional([Search(filter: All([ManeuverType(TrademarkFinisher), Not(Trait(Unique))]))]),
                        ],
                    ),
                ],
            ),
        ],
    },
    scripts: {
        // High Risk
        "Head Butt Drop": (play_after: Some(All([Maneuver, DamageAtLeast(5)]))),
        // Reversing cards that would remove cards from your Ring is not supported yet.
        "Inverted Body Block": (
            play_after: Some(All([Maneuver, DamageAtLeast(4)])),
            on_play: [CannotPlay(who: Opponent, filter: Action, turns: 1)],
            reverses: Some((targets: Not(Any))),
        ),
        "Back Splash": (play_after: Some(Title("From the Top Rope")), no_arsenal_reversal: true, no_backlash_reversal: true),

        // Strikes
        // The Irish Whip reversal limit is not supported yet.
        "Knife-Edge Chop": (
            on_play: [If(condition: Superstar("Ric Flair"), effects: [Optional([Search(filter: TitleContains("chop"))])])],
        ),
        "Spinning Back Fist": (on_play: [Boost((applies_to: Action, duration: NextCard, reversal_fortitude: 10))]),
        // Approximation: the Reversals that reverse maneuvers played after Irish Whip are listed by title;
        // Reversals that name Back Body Drop cannot reverse it.
        "Atomic Back Body Drop": (
            play_after: Some(Title("Irish Whip")),
            not_reversed_by: Some(
                Not(
                    AnyOf([
                        Trait(Unique),
                        Title("Shoulder Block"),
                        Title("Cross Body Block"),
                        Title("Spear"),
                        Title("Lou Thesz Press"),
                        Title("Facebuster"),
                        Title("Crucifix Rollup"),
                        Title("Stun Gun"),
                        Title("Spinning Elbow"),
                        Title("Tilt-a-Whirl Powerslam"),
                        Title("Hall's Fall-Away Slam"),
                    ]),
                ),
            ),
        ),
        "Back Rake": (
            requires: Some(Not(InYourRing(Title("First to Tap Out Match")))),
            on_play: [
                Boost((
                    applies_to: AnyOf([ManeuverType(Strike), ManeuverType(Submission)]),
                    duration: NextCard,
                    irreversible: true,
                )),
            ],
            reverses: Some((
                targets: ManeuverType(Strike),
                requires: Some(Not(InYourRing(Title("First to Tap Out Match")))),
                effects: [
                    Boost((
                        applies_to: AnyOf([ManeuverType(Strike), ManeuverType(Submission)]),
                        duration: NextTurnFirstCard,
                        irreversible: true,
                    )),
                ],
            )),
        ),
        "Brass 'Nuks' Shot": (
            reverses: Some((targets: ManeuverType(HighRisk))),
            while_in_ring: [
                (
                    applies_to: All([
                        Maneuver,
                        AnyOf([Title("Haymaker"), Title("European Uppercut"), TitleContains("punch")]),
                    ]),
                    damage: 2,
                    no_arsenal_reversal: true,
                ),
            ],
        ),
        "Short Arm Clothesline": (
            not_reversed_by: Some(Title("Elbow to the Face")),
            on_play: [Search(filter: Title("Clothesline"))],
        ),
        "Kangaroo Kick": (play_after: Some(All([Maneuver, TitleContains("kick")])), no_backlash_reversal: true),
        "360-Degree Clothesline": (
            on_play: [RingsideToArsenal(who: You, n: 3, up_to: true)],
            reverses: Some((targets: All([Maneuver, TitleContains("kick")]))),
        ),

        // Grapples
        "Up and At 'em": (
            as_action: Some((on_play: [DiscardThis, Boost((applies_to: Any, duration: NextCard, fortitude: -3))])),
        ),
        "Double Underhook Back Breaker": (requires: Some(HandAtLeast(3)), on_play: [HandToArsenalTop(who: You, n: 2)]),
        "Snap Suplex": (
            not_reversed_by: Some(AnyOf([Title("Elbow to the Face"), Title("Clumsy Opponent")])),
            on_play: [
                Boost((
                    applies_to: All([Maneuver, TitleContains("suplex")]),
                    duration: NextCard,
                    no_backlash_reversal: true,
                )),
            ],
        ),
        "Bulldog Lariat": (
            play_after: Some(Trait(SetUp)),
            reverses: Some((targets: All([Maneuver, AnyOf([TitleContains("bulldog"), TitleContains("lariat")])]))),
        ),
        "Face-buster Suplex": (
            on_play: [
                Optional([
                    RingsideToHand(who: You, n: 1, filter: Some(ManeuverType(HighRisk))),
                    HandToArsenalTop(who: You, n: 1),
                ]),
            ],
        ),
        // Approximation: the Reversals that reverse maneuvers played after Irish Whip are listed by title.
        "Tilt-a-Whirl Powerslam": (
            play_after: Some(AnyOf([Title("Irish Whip"), Title("Gut Wrench")])),
            not_reversed_by: Some(
                Not(
                    AnyOf([
                        Trait(Unique),
                        Title("Shoulder Block"),
                        Title("Cross Body Block"),
                        Title("Spear"),
                        Title("Lou Thesz Press"),
                        Title("Facebuster"),
                        Title("Crucifix Rollup"),
                        Title("Stun Gun"),
                        Title("Spinning Elbow"),
                        Title("Tilt-a-Whirl Powerslam"),
                        Title("Hall's Fall-Away Slam"),
                    ]),
                ),
            ),
            reverses: Some((targets: All([Maneuver, After(Title("Irish Whip"))]))),
        ),
        "Back Breaker Torture Rack": (
            not_packed_by: ["Female"],
            requires: Some(FortitudeAboveOpponent),
            after_damage: [EndTurn],
        ),

        // Submissions
        "Arm Wringer": (on_play: [If(condition: FortitudeAboveOpponent, effects: [RevealHand(who: You)])]),
        "Nerve Hold": (
            requires: Some(Not(InYourRing(Title("First to Tap Out Match")))),
            on_play: [
                Boost((
                    applies_to: All([ManeuverType(Submission), DamageAtLeast(6)]),
                    duration: NextCard,
                    no_hand_reversal: true,
                )),
            ],
            reverses: Some((
                targets: AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]),
                requires: Some(Not(InYourRing(Title("First to Tap Out Match")))),
            )),
        ),
        "Knee Lock": (on_play: [Optional([Search(filter: All([Maneuver, TitleContains("knee")]))])]),
        "Half Crab": (
            requires: Some(Not(InYourRing(Title("First to Tap Out Match")))),
            on_play: [
                Choice([
                    [Search(filter: Title("Boston Crab"))],
                    [Boost((applies_to: Title("Boston Crab"), duration: NextCard, irreversible: true))],
                ]),
            ],
        ),
        "Dragon Sleeper": (on_play: [Optional([Search(filter: AnyOf([Title("Claw"), Title("Maintain Hold")]))])]),

        // Actions
        // Reversing cards that let the opponent look at your hand is not supported yet.
        "Booby Trap": (
            on_play: [
                RingsideToHand(who: You, n: 1, filter: Some(All([Reversal, Not(Maneuver), Not(Action)]))),
                EndTurn,
            ],
            reverses: Some((targets: Not(Any))),
        ),
        "Grab the Mic!": (
            on_play: [Draw(who: You, n: 1), RevealHand(who: You), EndTurn],
            ring_ability: Some((
                sacrifice: true,
                effects: [Boost((applies_to: Action, duration: NextCard, irreversible: true))],
            )),
        ),
        // Checking whether the opponent attempted to play a card is not supported yet.
        "Use 'em or Lose 'em": (requires: Some(Never)),
        "You Feeling Lucky?": (
            on_play: [
                OpponentChooses(
                    n: 1,
                    options: [
                        [Boost((applies_to: ManeuverType(Strike), duration: NextCard, irreversible: true))],
                        [Boost((applies_to: ManeuverType(Grapple), duration: NextCard, irreversible: true))],
                        [Boost((applies_to: ManeuverType(Submission), duration: NextCard, irreversible: true))],
                    ],
                ),
            ],
        ),
        // Searching for a copy of a card in your Ringside pile is not supported yet.
        "I'm Gonna Try That Again": (requires: Some(Never)),
        // Approximation: the other revealed cards go to the bottom of the Arsenal instead of the Ringside pile.
        "Battling the Voices": (
            bonuses: [
                (when: AnyOf([Superstar("Mankind"), Superstar("Cactus Jack"), Superstar("Dude Love")]), fortitude: -5),
            ],
            on_play: [Dig(n: 5, take: 2)],
        ),
        // Turning a Strike into a High Risk maneuver is not supported yet.
        "Springboard": (
            play_after: Some(AnyOf([Maneuver, Title("Irish Whip")])),
            on_play: [Discard(who: You, n: 1, pick: Chosen)],
        ),
        // Changing the text of Hey! That's Cheap Heat! is not supported yet.
        "Let's Pick Up the Pace": (
            on_play: [
                Search(filter: All([Maneuver, Not(Trait(Unique))])),
                AsOpponent([Optional([Search(filter: All([Maneuver, Not(Trait(Unique))]))])]),
            ],
        ),
        "Filthy, Disgusting, Brutal, Bottom-Feeding, Trash-bag Ho!": (
            irreversible_when: Some(Superstar("Chris Jericho")),
            on_play: [
                Search(
                    filter: AnyOf([
                        Title("Backed by Stephanie McMahon"),
                        Title("Billion Dollar Princess"),
                        Title("Daddy's Little Girl"),
                        Title("Keibler's Cookies"),
                        Title("Ring Rats"),
                        Title("Torrie Wilson, On It!"),
                    ]),
                ),
            ],
            reverses: Some((
                targets: AnyOf([
                    Title("Backed by Stephanie McMahon"),
                    Title("Billion Dollar Princess"),
                    Title("Daddy's Little Girl"),
                    Title("Keibler's Cookies"),
                    Title("Ring Rats"),
                    Title("Torrie Wilson, On It!"),
                ]),
                from_hand_only: true,
                requires: Some(OpponentFemale),
            )),
        ),
        "Energy Burst": (
            on_play: [
                Choice([
                    [RingsideToArsenal(who: You, n: 4)],
                    [Boost((applies_to: Maneuver, duration: ThisTurn, damage: 2))],
                ]),
            ],
        ),
        // Putting every copy of the chosen card from the Arsenal into the Ringside pile is not supported yet.
        "Mind Games": (
            irreversible_when: Some(AnyOf([Superstar("Mankind"), Superstar("Cactus Jack"), Superstar("Dude Love")])),
            on_play: [LookAtHand(who: Opponent), DiscardMatching(who: Opponent, n: 1, filter: Maneuver, pick: Controller)],
        ),
        "Play the Game!": (
            bonuses: [(when: Superstar("Triple H"), fortitude: -3)],
            on_opponent_reverses: [If(condition: OpponentReversedFrom([Hand]), effects: [Mill(who: Opponent, n: 1)])],
        ),
        // Approximation: every Maneuver card in your hand counts (at most 4), without being shown.
        "Give It All I Got": (
            on_play: [
                Counted(
                    count: AtMost(YourHandMatching(Maneuver), 4),
                    effect: Boost((applies_to: Maneuver, duration: NextMatching, damage: 1)),
                ),
            ],
        ),
        // Letting "cannot be reversed" maneuvers be reversed is not supported yet.
        "Beating the Odds": (on_play: [Draw(who: You, n: 1)], on_removed_by_opponent: [EndTurn]),
        // Copying the opponent's Ringside-to-Arsenal shuffles is not supported yet.
        "Smart Mark": (requires: Some(Never)),
        // Title Belts are not supported yet.
        "Hardcore 'Til the End": (
            irreversible: true,
            on_play: [
                Search(filter: Keyword("Foreign Object")),
                Boost((applies_to: Keyword("Foreign Object"), duration: NextCard, fortitude: -4)),
            ],
        ),
        // Ignoring J.R. Style Slobber-knocker is not supported yet.
        "Simply The Best": (
            on_play: [
                If(
                    condition: InYourRing(ManeuverType(Strike)),
                    effects: [Optional([RemoveFromRing(who: Opponent, n: 1, filter: Any)])],
                ),
                If(
                    condition: InYourRing(ManeuverType(Grapple)),
                    effects: [Optional([RemoveFromRing(who: Opponent, n: 1, filter: Any)])],
                ),
                If(
                    condition: InYourRing(ManeuverType(Submission)),
                    effects: [Optional([RemoveFromRing(who: Opponent, n: 1, filter: Any)])],
                ),
                If(
                    condition: InYourRing(ManeuverType(HighRisk)),
                    effects: [Optional([RemoveFromRing(who: Opponent, n: 1, filter: Any)])],
                ),
            ],
        ),
        "Pencil-Necked Geek": (
            requires: Some(Not(SuperstarValueAtMostOpponent)),
            on_play: [Boost((applies_to: All([Maneuver, DamageAtLeast(8)]), duration: NextCard, irreversible: true))],
        ),
        // The Kick Out! escape is not supported yet.
        "Go For the Cover!": (
            play_after: Some(All([Maneuver, DamageAtLeast(12)])),
            irreversible: true,
            on_play: [
                MillUntil(who: Opponent, filter: Reversal),
                MillUntil(who: Opponent, filter: Reversal),
                MillUntil(who: Opponent, filter: Reversal),
                EndTurn,
            ],
        ),
        "Don't Hate da Playa, Hate da Game!": (
            irreversible_when: Some(
                AnyOf([OpponentSuperstar("Triple H"), InYourRing(Title("Managed by Theodore Long"))]),
            ),
            on_play: [Discard(who: You, n: 3, pick: Chosen), RingsideToHand(who: You, n: 3)],
            reverses: Some((targets: ForcesDiscard)),
        ),

        // Reversals
        "That's Enough Out of You!": (
            reverses: Some((targets: EarlierThisTurn(filter: Any, n: 2), requires: Some(FortitudeBelowOpponent))),
        ),
        // As the opponent's effect, OpponentReversedFortitude is the printed F of the Action this card reversed.
        "There Are Two Things You Can Do: Nothing, and Like It": (
            reverses: Some((
                targets: Action,
                effects: [AsOpponent([Counted(count: OpponentReversedFortitude, effect: DrawUpTo(who: You, n: 0))])],
            )),
        ),
        "...I Change the Questions": (
            reverses: Some((
                targets: All([Maneuver, Not(ManeuverType(TrademarkFinisher))]),
                effects: [Search(filter: ManeuverType(TrademarkFinisher))],
            )),
            restricts_opponent: Some((filter: Title("When You Thought You Had All the Answers ..."))),
        ),

        // Pre-match
        // Approximation: the opponent still draws before the turn ends.
        "It's Showtime!": (
            in_ring_opponent_start_of_turn: [
                If(
                    condition: FirstTurnOfGame,
                    effects: [AsOpponent([Optional([RevealHand(who: You), Mill(who: You, n: 2), EndTurn])])],
                ),
            ],
        ),
        "J.R. Style Clubberin'": (
            ring_ability: Some((
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [RingsideToArsenal(who: You, n: 2, filter: Some(Maneuver))],
            )),
        ),
        // Approximation: the boosts last for the rest of the match, even if the card leaves the Ring.
        "Pick Your Spots": (
            requires: Some(Not(InYourRing(Title("First to Tap Out Match")))),
            on_play: [
                Choice([
                    [
                        Boost((applies_to: ManeuverType(Strike), duration: Turns(255), damage: 1)),
                        Boost((
                            applies_to: AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]),
                            duration: Turns(255),
                            damage: -1,
                        )),
                    ],
                    [
                        Boost((applies_to: ManeuverType(Grapple), duration: Turns(255), damage: 1)),
                        Boost((
                            applies_to: AnyOf([ManeuverType(Strike), ManeuverType(Submission)]),
                            duration: Turns(255),
                            damage: -1,
                        )),
                    ],
                    [
                        Boost((applies_to: ManeuverType(Submission), duration: Turns(255), damage: 1)),
                        Boost((
                            applies_to: AnyOf([ManeuverType(Strike), ManeuverType(Grapple)]),
                            duration: Turns(255),
                            damage: -1,
                        )),
                    ],
                ]),
            ],
        ),
        // Stopping cards from raising a Superstar Value is not supported yet.
        "Glass Ceiling": (),
        "In the Interest of Fairness...": (
            end_of_prematch: [
                LookAtHand(who: Opponent),
                MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Controller),
                Draw(who: Opponent, n: 2),
            ],
        ),
        // Approximation: you draw 1 more card, but your own ability is not replaced.
        "Do You Know What My Watch Says?": (
            requires: Some(
                All([
                    Not(Superstar("Two-Man Power Trip")),
                    AnyOf([
                        OpponentSuperstar("The Rock"),
                        OpponentSuperstar("Triple H"),
                        OpponentSuperstar("Chris Jericho"),
                        OpponentSuperstar("Undertaker"),
                        OpponentSuperstar("Deadman Inc"),
                        OpponentSuperstar("Rob Van Dam"),
                    ]),
                ]),
            ),
            extra_draw: 1,
        ),
        // Approximation: the new ability is added, but your own ability is not replaced.
        "I'm the Biggest Dog on This Block!": (
            requires: Some(
                All([
                    Not(Superstar("Brothers of Destruction")),
                    AnyOf([
                        OpponentSuperstar("Stone Cold Steve Austin"),
                        OpponentSuperstar("Triple H"),
                        OpponentSuperstar("Kane"),
                        OpponentSuperstar("Mankind"),
                        OpponentSuperstar("Cactus Jack"),
                        OpponentSuperstar("Ric Flair"),
                    ]),
                ]),
            ),
            ring_ability: Some((cost: [Discard(who: You, n: 1, pick: Chosen)], effects: [RingsideToHand(who: You, n: 1)])),
        ),
        "Just Who in the Blue Hell Do You Think You Are?": (
            requires: Some(
                AnyOf([
                    OpponentSuperstar("Stone Cold Steve Austin"),
                    OpponentSuperstar("Triple H"),
                    OpponentSuperstar("Chris Jericho"),
                    OpponentSuperstar("Undertaker"),
                    OpponentSuperstar("Deadman Inc"),
                    OpponentSuperstar("Booker T"),
                ]),
            ),
            opponent_mid_match_limit: -3,
        ),
        // Approximation: your opponent shuffles 3 cards of his choice back at the end of the Pre-match phase.
        "The Game Is Back, and The Game Is Here to Stay!": (
            requires: Some(
                All([
                    Not(Superstar("Two-Man Power Trip")),
                    AnyOf([
                        OpponentSuperstar("The Rock"),
                        OpponentSuperstar("Stone Cold Steve Austin"),
                        OpponentSuperstar("Chris Jericho"),
                        OpponentSuperstar("Undertaker"),
                        OpponentSuperstar("Deadman Inc"),
                        OpponentSuperstar("Hollywood Hulk Hogan"),
                    ]),
                ]),
            ),
            end_of_prematch: [HandToArsenal(who: Opponent, n: 3)],
        ),
        "I'm Better Than You!": (
            requires: Some(
                AnyOf([
                    OpponentSuperstar("The Rock"),
                    OpponentSuperstar("Stone Cold Steve Austin"),
                    OpponentSuperstar("Triple H"),
                    OpponentSuperstar("Chris Benoit"),
                    OpponentSuperstar("Edge"),
                ]),
            ),
            while_in_ring: [(applies_to: Maneuver, damage: 2)],
        ),
        // Blanking a Stipulation card is not supported yet.
        "Bra and Panties Match": (only_packed_by: ["Female"], requires: Some(Never)),
        // Putting it into the Ringside pile when you end a turn without attempting a maneuver is not supported yet.
        "Lethal nWo Poison": (
            requires: Some(AnyOf([InYourRing(Keyword("nWo")), YouAre("nWo")])),
            in_ring_opponent_start_of_turn: [RemoveFromGame(who: You, from: Ringside, n: 2)],
            on_removed_by_opponent: [Discard(who: Opponent, n: 3, pick: Chosen)],
        ),
        "Living Legend": (requires: Some(InYourRing(Trait(Face))), value_bonus: 2),
        // Blanking a Stipulation card is not supported yet.
        "Managed by Stephanie McMahon-Helmsley": (
            extra_traits: [UniversallyUnique],
            pre_match_limit: -1,
            mid_match_limit: 1,
        ),
        // Approximation: the extra starting card is drawn at the end of the Pre-match phase.
        // Reversing cards that let the opponent look at your hand is not supported yet.
        "Managed by Torrie Wilson": (extra_traits: [UniversallyUnique], end_of_prematch: [Draw(who: You, n: 1)]),
        "Managed by Stacy Keibler": (
            extra_traits: [UniversallyUnique],
            pre_match_limit: -1,
            ring_ability: Some((
                sacrifice: true,
                effects: [Optional([LookAtHand(who: Opponent)]), Search(filter: Any), EndTurn],
            )),
        ),
        // Approximation: your opponent shuffles 1 card of his choice back at the end of the Pre-match phase.
        // Reversing cards that let the opponent search his Arsenal is not supported yet.
        "Managed by Terri Runnels": (extra_traits: [UniversallyUnique], end_of_prematch: [HandToArsenal(who: Opponent, n: 1)]),

        // Mid-match
        "I'm Not Outta It Yet!": (
            requires: Some(CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 10)),
            on_play: [RingsideToArsenal(who: You, n: 5)],
        ),
        "Shove": (
            on_play: [
                Choice([
                    [Draw(who: You, n: 1), Discard(who: Opponent, n: 1, pick: Chosen)],
                    [Draw(who: You, n: 1), LookAtHand(who: Opponent)],
                    [Draw(who: You, n: 1), Boost((applies_to: Maneuver, duration: NextCard, damage: 2))],
                    [Discard(who: Opponent, n: 1, pick: Chosen), LookAtHand(who: Opponent)],
                    [Discard(who: Opponent, n: 1, pick: Chosen), Boost((applies_to: Maneuver, duration: NextCard, damage: 2))],
                    [LookAtHand(who: Opponent), Boost((applies_to: Maneuver, duration: NextCard, damage: 2))],
                ]),
            ],
        ),
        "Business Is About to Pick Up": (
            ring_ability: Some((cost: [Discard(who: You, n: 1, pick: Chosen)], effects: [Search(filter: Trait(SetUp))])),
        ),
        // Approximation: you reveal your whole hand.
        "Get What You're Expectin'": (
            requires: Some(CountAtLeast(count: YourHandMatching(Maneuver), n: 3)),
            on_play: [
                RevealHand(who: You),
                Boost((applies_to: All([Maneuver, DamageAtMost(7)]), duration: NextCard, irreversible: true)),
                Boost((applies_to: Any, duration: NextCard, end_turn: true)),
            ],
        ),
        "Silent, But Violent": (
            on_play: [RingsideToHand(who: You, n: 1, filter: Some(Maneuver)), EndTurn],
            reverses: Some((
                targets: AnyOf([ManeuverType(Strike), ManeuverType(Grapple), ManeuverType(Submission)]),
                requires: Some(FortitudeAboveOpponent),
                effects: [
                    RevealHand(who: You),
                    Counted(
                        count: YourHandMatching(Action),
                        effect: MoveCards(who: You, from: Hand, to: Arsenal, n: 0, filter: Some(Action), bottom: true),
                    ),
                ],
            )),
        ),
        // Half rounded up = hand minus half rounded down.
        "My God! He's Broken in Half!": (
            play_after: Some(All([Maneuver, DamageAtLeast(10)])),
            on_play: [
                Counted(
                    count: Minus(OpponentHandSize, HalfOpponentHand),
                    effect: Discard(who: Opponent, n: 0, pick: Chosen),
                ),
            ],
        ),
        "Tag Out": (requires: Some(Never)),
        "It's All in the Teamwork!": (requires: Some(Never)),
        "Save da Drama fo' yo' Mama": (
            mid_match_limit: 1,
            reverses: Some((targets: All([ManeuverType(HighRisk), EarlierThisTurn(filter: ManeuverType(HighRisk), n: 1)]))),
        ),
        "Turn Up the Heat": (
            on_play: [
                If(
                    condition: HandHas(Reversal),
                    effects: [
                        Optional([
                            DiscardMatching(who: You, n: 1, filter: Reversal, pick: Chosen),
                            Boost((
                                applies_to: All([Maneuver, DamageAtMost(5)]),
                                duration: NextCard,
                                irreversible: true,
                                end_turn: true,
                            )),
                        ]),
                    ],
                ),
            ],
        ),
        "Greco-Roman Holiday!": (not_reversed_by: Some(Title("Backlash!")), play_after: Some(ManeuverType(Grapple))),
        // Ending the opponent's turn after taking a whole maneuver's damage is not supported yet.
        "That's a Near Fall!": (requires: Some(Never)),
        "You Suck! ... You Suck!": (
            irreversible_when: Some(OpponentSuperstar("Kurt Angle")),
