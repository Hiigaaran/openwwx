        "Whassupwitdat?!?!?": (reverses: Some((targets: Action, effects: [Discard(who: You, n: 1, pick: Chosen)]))),

        // Cards for earlier Superstars
        "In the Presence of the Kanenites": (on_play: [RingsideToArsenalCount(who: You, count: HalfYourFortitude)]),
        "I'm a Bad Man...": (
