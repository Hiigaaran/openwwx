        ),
        // Matching titles in your own Ring is not supported yet.
        "Been There, Done That": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        "Human Highlight Reel": (
            play_after: Some(ManeuverType(HighRisk)),
            irreversible_when: Some(AnyOf([Superstar("Jeff Hardy"), Superstar("Rob Van Dam")])),
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: ManeuverType(HighRisk),
                    effects: [Optional([Search(filter: All([ManeuverType(HighRisk), Not(Trait(Unique))]))])],
