        // Approximation: the 2 cards go to the bottom of the Arsenal before the Draw Segment.
        "Ring General": (
            requires: Some(AnyOf([Not(SuperstarValueAtMostOpponent), HandLargerBy(1)])),
            extra_draw: 2,
            in_ring_start_of_turn: [HandToArsenalBottom(who: You, n: 2)],
