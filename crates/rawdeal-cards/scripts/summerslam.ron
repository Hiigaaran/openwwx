                    Boost((applies_to: All([Maneuver, DamageAtMost(7)]), duration: NextCards(2), no_hand_reversal: true)),
                    NextPlayWatch(filter: Any, on_success: [Boost((applies_to: Any, duration: NextCard, end_turn: true))]),
                ],
