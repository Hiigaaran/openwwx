        "Too Sweet!": (end_of_prematch: [Search(filter: All([ManeuverType(Grapple), Not(Trait(Unique))]), n: 2)]),
        "Jack-knife": (not_reversed_by: Some(Title("When You Thought You Had All the Answers ..."))),
        "nWo Black and White": (
            on_play: [
