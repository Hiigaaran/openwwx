// Hand-written scripts for Summerslam Tin cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// The SummerSlam Pay-Per-View Event is skipped by the importer (unknown card type).
(
    abilities: {
        // The 45-card Arsenal is not supported yet.
        "The Fabulous Moolah": [
            CannotPackMatching(All([Maneuver, DamageAtLeast(3)])),
            Activated(
                cost: [],
                effects: [RemoveFromGame(who: Opponent, from: Arsenal, n: 1, filter: Some(Any), pick: Controller)],
            ),
        ],
    },
    scripts: {
        // The Feud and Stipulation requirement, the forced Stipulation and blanking a Stipulation are not
        // supported yet.
        "SummerSlam": (),
        // Actions
        // Filtering cards by their printed set logo (Survivor Series) is not supported yet.
        "That Won't Make the Cut!": (requires: Some(Never)),

        // Mae Young and The Fabulous Moolah
        "The Older the Berry...": (
            on_play: [
                Optional([RingsideToHand(who: You, n: 1)]),
                Optional([RingsideToBacklash(who: You, n: 1)]),
                MoveCards(who: You, from: Ring, to: Backlash, n: 1, up_to: true, filter: Some(Trait(MidMatch))),
            ],
        ),
    },
)
