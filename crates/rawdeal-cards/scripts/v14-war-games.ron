        // The removed-card lock and opponent ACE texts are not supported yet.
        "Breakker's Press Powerslam": (reversal_limits: [(from: [Hand, Backlash, Ringside, Ring, Under], when: All([ReversedLastTurn(Any), FirstCardThisTurn]))]),
