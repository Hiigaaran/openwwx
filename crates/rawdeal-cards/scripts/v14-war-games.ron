        // Being an action with lower Fortitude is not supported yet.
        "Macro Aggression Side Slam": (not_reversed_by: Some(Hybrid)),
        // Approximation: you draw 2 cards instead of taking the bottom 2 cards of your Arsenal. The 'completely'
