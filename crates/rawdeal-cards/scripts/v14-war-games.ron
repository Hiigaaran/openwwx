        // The Charlotte TMF text is not supported yet.
        "Best Boot In The Business": (multi_when: Some(Superstar("Rhea Ripley")), as_action: Some((on_play: [DiscardThis, RingsideToBacklash(who: You, n: 1), EndTurn]))),
        // The second ACE is not supported yet.
        "Profits Are Up": (
