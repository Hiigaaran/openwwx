// Hand-written scripts for V14: War Games (Raw Deal Virtual set 49) cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// "Counter" = you reversed a card to end your opponent's last turn and this is your first card this turn.
// "Promo: N" is approximated as `Dig`: you keep 1 of the top N cards and the rest go on the bottom of the Arsenal.
// "Bury" puts cards on the bottom of the Arsenal; "Stack" on top; "RFG" removes them from the game; "Recover"
// shuffles cards into the Arsenal. "Arsenal Search N" = `Search`; "Ringside Search N" = `RingsideToHand`.
// "Reversal: Special" cards: "Reverse any X" is the reversal target. Reversals after a card was successfully
// played use `after_success`, of Activated Card Effects `reverses_ace` / `ring_reverses_ace`; of other card effects
// they are not supported (`targets: Not(Any)`).
// ACE (Activated Card Effects) are ring abilities used during your own turn. Not supported: face-down (Flip)
// cards, conditional TMF, 'completely', "cannot be blanked",
// "reveal this card when ..." Backstage cards (they start hidden), cards played from the Backstage Area or the
// removed pile, and packing permissions (only other Superstars' logos, with `PacksLogos`).
// "N+ lower Fortitude" = `CountBelow(a: Plus(YourFortitude, Const(N - 1)), b: OpponentFortitude)`.
// 'Textbook' cards: "Can be reversed as if non-Unique" is not supported. Approximation: the reversal Fortitude
// bonus counts the 'Textbook' cards in your Ring instead of your Ringside pile.
// Skipped by the importer: The Giant's Handlers (Handler Deck).
(
    abilities: {
        // The Arsenal maneuvers are packed as other Superstars' logos; the named cards and "they are not Volley"
        // are not supported yet.
        "The Bloodline": [PacksLogos(["Roman Reigns", "The Tribal Chief", "The Usos"])],
        // Playing removed 'Samoan' maneuvers, the damage-reduction restriction and the packing permissions are
        // not supported yet.
        "Solo Sikoa": [
            OnOpponentReverses([
                If(
                    condition: OpponentReversed(All([Maneuver, Not(Trait(Chain))])),
                    effects: [Optional([ReversedCardTo(to: Removed), RingsideToArsenal(who: You, n: 3, up_to: true)])],
                ),
            ]),
        ],
        // The BASH search restriction and the Face / Heel trigger are not supported yet. Approximation: every
        // card with these logos may be packed, not only maneuvers.
        "The Judgment Day": [
            PacksLogos(["Finn Balor", "Rhea Ripley", "Damian Priest", "Dominik Mysterio"]),
            CannotPack("Newcastle, England"),
        ],
        // His F: 0 'Precision' maneuvers are Multi. The 'Precision' / 'Shoot' title texts, moving more cards,
        // ignoring 'completely' and the always-revealed Pinpoint Precision Offense are not supported yet.
        "Damian Priest": [StartOfTurn([Boost((applies_to: All([Maneuver, TitleContains("Precision"), FortitudeAtMost(0)]), duration: ThisTurn, multi: true))])],
        // Revealing a reversal to make the opponent's maneuver successful and the packing permissions are not
        // supported yet.
        "Dominik Mysterio": [CannotPack("No Matching Tights")],
        // Removing the cards overturned for damage and the packing permissions (other than logos) are not
        // supported yet.
        "Damage CTRL": [PacksLogos(["Bayley", "Dakota Kai", "Iyo Sky"]), CannotPack("Baghdad, Iraq")],
        // Approximation: every successful action may Promo: 2 (not only twice per turn). The Cheater / Fan
        // Favorite texts and burying the cards not chosen are not supported yet.
        "The Role Model": [
            OnPlayMatching(filter: Action, effects: [Optional([Dig(n: 2, take: 1)])]),
            PacksLogos(["Bayley"]),
        ],
        // Approximation: the other revealed cards go on the bottom (Dig). The Multi 'Kick' packing permission is
        // not supported yet.
        "Dakota Kai": [
            Activated(requires: Some(CountBelow(a: YourFaceDown, b: YourRingSize)), cost: [FlipDown(who: You, n: 1)], effects: [Dig(n: 5, take: 1)]),
            CannotPack("Baghdad, Iraq"),
        ],
        // The logo cards print "Iyo Sky". Her Double Underhook Back Breaker cards are Multi. The flip protection
        // and the High Risk part are not supported yet.
        "IYO SKY": [
            PacksLogos(["Iyo Sky"]),
            CannotPack("Lumberjack Match"),
            CannotPack("Falls Count Anywhere Match"),
            StartOfTurn([Boost((applies_to: TitleContains("Double Underhook Back Breaker"), duration: ThisTurn, multi: true))]),
            Activated(
                requires: Some(CountBelow(a: YourFaceDown, b: YourRingSize)),
                cost: [FlipDown(who: You, n: 1)],
                effects: [Boost((applies_to: Trait(SetUp), duration: NextMatching, ignore_play_after: true))],
            ),
        ],
        // The end-of-turn removal, the overturn trigger and the other Old School Beating texts are not supported yet.
        "The Brawling Brutes": [PacksLogos(["Sheamus", "Pete Dunne"]), NoSlotFor(Title("Old School Beating"))],
        // Revealing the opponent's hand and Backlash, choosing a card in it and the Manager restriction are not
        // supported yet.
        "The Visionary": [PacksLogos(["Seth Rollins"])],
        // Recovering the flipped card, the 'Rolling' Stun and the Standing Moonsault permission are not supported
        // yet.
        "Austin Theory": [
            Activated(cost: [], effects: [Choice([[FlipDown(who: You, n: 1)], [FlipUp(who: You, n: 1), DrawUpTo(who: You, n: 1)]])]),
            CannotPack("Baghdad, Iraq"),
        ],
        // Approximation: any reversal you play (not only Unique ones, not only once per turn). The packing
        // permissions and the Unique title restriction are not supported yet.
        "Karrion Kross": [
            CannotPack("Egomaniacal"),
            OnYouReverse([
                Optional([MoveCards(who: You, from: Removed, to: Arsenal, n: 1, filter: Some(Not(TitleContains("Divine"))), bottom: true)]),
            ]),
        ],
        // The +1 Stun and the packing permissions are not supported yet.
        "Bron Breakker": [
            DamageFor(filter: ManeuverType(Grapple), delta: 3),
            OnPlayMatching(filter: Keyword("NXT"), effects: [Optional([Dig(n: 2, take: 1)])]),
        ],
    },
    scripts: {
        // Backstage cards
        // "Reveal this card when ..." is not supported (it starts hidden). The packing and Feud texts are not
        // supported yet.
        "Bitter Rivals": (starts_hidden: true, not_packed_by: ["Doink"]),
        // "Reveal this card when ..." is not supported (it starts hidden). The Springboard texts are not
        // supported yet.
        "Lucha Style Action": (starts_hidden: true, not_packed_by: ["Doink"]),
        // Approximation: at the end of the Pre-match phase you search 1 non-Unique 'Precision' maneuver (no cards
        // go under this card). The unsuccessful 'Precision' text is not supported yet.
        "Pinpoint Precision Offense": (
            not_packed_by: ["Doink"],
            backstage_abilities: [EndOfPrematch([Search(filter: All([Maneuver, TitleContains("Precision"), Not(Trait(Unique))]))])],
        ),
        // Packing 'Textbook' maneuvers as if not Multi, the reversal-restriction texts and the RMS reversal cost
        // are not supported yet.
        "Textbook Offense": (not_packed_by: ["Doink"]),

        // Pre-match
        // The ACE is not supported yet.
        "BASH at the Beach": (frees_slots: Some(All([TitleContains("BASH"), Not(Trait(MidMatch))]))),
        // Approximation: Calgary, Alberta, Canada is ignored; your successful Chain maneuvers Bury 1- Ringside
        // card. The other Chain texts, Flawless Transition and the packing restriction are not supported yet.
        "Catch-as-Catch-Can": (
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: All([Maneuver, Trait(Chain)]),
                    effects: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, bottom: true)],
                ),
            ],
        ),
        // The packing texts and the reversal restriction are not supported yet.
        "Crown Jewel": (requires: Some(BackstageRevealed(who: You, filter: Title("Blaze of Glory")))),
        // Approximation: +1 Pre-match capacity. The Volley texts are not supported yet.
        "Strong Style": (pre_match_limit: 1),
        // The Run-in / removed-card restrictions and the Sustained damage cap are not supported yet.
        "War Games": (),
        // Approximation: Allegiance: Heat is any Heat card in your Ring. The texts about other cards are not
        // supported yet.
        "Nuclear Heat": (
            requires: Some(InYourRing(Keyword("Heat"))),
            while_in_ring: [(applies_to: All([Maneuver, Keyword("Heat")]), damage: 2)],
        ),
        // Playing 'Precision' Backlash cards from the Ringside pile and the Hybrid restriction are not supported yet.
        "Almost Only Counts in Horseshoes and Hand Grenades": (
            requires: Some(BackstageRevealed(who: You, filter: Title("Pinpoint Precision Offense"))),
            frees_slots: Some(All([TitleContains("Precision"), Trait(MidMatch)])),
            while_in_ring: [(applies_to: All([Maneuver, TitleContains("Precision")]), damage: 2)],
            in_ring_on_play: [
                (whose: Some(You), filter: All([Maneuver, TitleContains("Precision")]), effects: [RingsideToBacklash(who: You, n: 1)]),
            ],
        ),
        // Approximation: the Bury happens at the end of the Pre-match phase. The "cannot be prevented" text is
        // not supported yet.
        "NXT Womens Tag Team Title Belts": (
            only_packed_by: ["Female"],
            mid_match_limit: 1,
            end_of_prematch: [Optional([HandToArsenalBottom(who: You, n: 2), Draw(who: You, n: 2)])],
        ),
        // The conditional Hand Size and the 'ECW' belt packing restriction are not supported yet.
        "ECW Tag Team Title Belts": (while_in_ring: [(applies_to: Maneuver, damage: 1)]),
        // The Wrestlemania, Hybrid reversal and win restrictions are not supported yet.
        "The Authority of Adam Pearce": (pre_match_limit: 1, not_with: ["Precision Haymaker"]),
        // Playing it during the Venue step, the School Boy texts and the ACE are not supported yet.
        "Chase University": (while_in_ring: [(applies_to: Title("Team Spirit"), irreversible: true)]),

        // Mid-match
        // The Backlash discount and the TMF text are not supported yet.
        "Precision Flurry": (
            requires: Some(BackstageRevealed(who: You, filter: Title("Pinpoint Precision Offense"))),
            multi_when: Some(All([CountBelow(a: Plus(YourFortitude, Const(14)), b: OpponentFortitude), Not(InYourRing(Maneuver))])),
            reversal_limits: [
                (
                    when: All([CountBelow(a: Plus(YourFortitude, Const(14)), b: OpponentFortitude), Not(InYourRing(Maneuver))]),
                    by: Some(Not(All([SuperstarSpecific, DamageAtMost(0)]))),
                ),
            ],
        ),
        "Now You're Going to School!": (
            requires: Some(InYourRing(Title("Chase University"))),
            on_play: [
                Search(filter: Not(Trait(Unique)), n: 6, up_to: true),
                MoveCards(who: You, from: Hand, to: Arsenal, n: 3, pick: Random, bottom: true),
            ],
        ),

        // Textbook maneuvers
        "Textbook Foot Stomp": (
            play_after: Some(Maneuver),
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("The Rock"), effects: [SkipNextTurn(who: Opponent)])],
        ),
        "Textbook Knee Smash": (
            play_after: Some(Maneuver),
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Harley Race"), effects: [Mill(who: You, n: 2), Discard(who: Opponent, n: 4, pick: Chosen)])],
        ),
        // Approximation: you choose the Backlash card.
        "Textbook Punch": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Michael Tarver"), effects: [BacklashToRingside(who: Opponent, n: 1)])],
        ),
        "Textbook Chop": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [
                If(
                    condition: YouAre("The Nature Boy"),
                    effects: [RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Maneuver, Not(Trait(Unique))])))],
                ),
            ],
        ),
        "Textbook Kick": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Tajiri"), effects: [Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -5))])],
        ),
        "Textbook Running Forearm": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Lex Luger"), effects: [Mill(who: Opponent, n: 2)])],
        ),
        "Textbook Drop Kick": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Lita"), effects: [HandToArsenalBottom(who: Opponent, n: 2)])],
        ),
        "Textbook Uppercut": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Raw Guest Host"), effects: [DrawUpTo(who: You, n: 2)])],
        ),
        "Textbook Big Boot": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("The Immortal One"), effects: [Discard(who: Opponent, n: 3, pick: Chosen)])],
        ),
        "Textbook Clothesline": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Hacksaw Jim Duggan"), effects: [RingsideToBacklash(who: You, n: 3)])],
        ),
        "Textbook Superkick": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Shawn Michaels"), effects: [Search(filter: ManeuverType(TrademarkFinisher))])],
        ),
        "Textbook Arm Drag": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [
                If(
                    condition: YouAre("Ricky 'The Dragon' Steamboat"),
                    effects: [RemoveFromGame(who: Opponent, from: Ringside, n: 1, up_to: true, pick: Controller)],
                ),
            ],
        ),
        "Textbook Hip Toss": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Santino Marella"), effects: [Search(filter: All([Not(Trait(Unique)), Not(Maneuver)]))])],
        ),
        "Textbook Vertical Suplex": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [
                If(
                    condition: YouAre("The British Bulldog"),
                    effects: [MoveCards(who: You, from: Removed, to: Backlash, n: 1, up_to: true, filter: Some(Trait(MidMatch)))],
                ),
            ],
        ),
        "Textbook Spinebuster": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Batista"), effects: [RingsideToArsenal(who: You, n: 2, up_to: true)])],
        ),
        "Textbook Neck Breaker": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Rick Rude"), effects: [RemoveFromGame(who: Opponent, from: Hand, n: 1)])],
        ),
        // The +1 Stun for Diesel is not supported yet.
        "Textbook Sidewalk Slam": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
        ),
        "Textbook Back Breaker": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Roderick Strong"), effects: [Dig(n: 2, take: 1)])],
        ),
        "Textbook Beal Toss": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Keith Lee"), effects: [RemoveFromRing(who: Opponent, n: 1, filter: Not(Trait(Unique)))])],
        ),
        "Textbook German Suplex": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("The Beast Incarnate"), effects: [Mill(who: Opponent, n: 3)])],
        ),
        // Approximation: the Backlash card is discarded at random without being revealed first.
        "Textbook Arm Bar": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [
                If(
                    condition: All([YouAre("The Lionheart"), HandAtLeast(2)]),
                    effects: [Optional([RemoveFromGame(who: You, from: Hand, n: 1), BacklashToRingside(who: Opponent, n: 1, random: true)])],
                ),
            ],
        ),
        "Textbook Hammer Lock": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Bret 'The Hitman' Hart"), effects: [CannotPlay(who: Opponent, filter: Not(Maneuver), turns: 1)])],
        ),
        "Textbook Head Vise": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("The Great Khali"), effects: [DrawUpTo(who: You, n: 1), Discard(who: Opponent, n: 1, pick: Chosen)])],
        ),
        "Textbook Sleeper": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("The Rowdy One"), effects: [DrawUpTo(who: You, n: 2), RingsideToArsenal(who: You, n: 2, up_to: true)])],
        ),
        "Textbook Crossface": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [
                If(
                    condition: YouAre("Daniel Bryan"),
                    effects: [MoveCards(who: You, from: Removed, to: Arsenal, n: 2, up_to: true, filter: Some(Not(TitleContains("Divine"))), bottom: true)],
                ),
            ],
        ),
        "Textbook Chicken Wing": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [
                If(
                    condition: YouAre("Darren Young"),
                    effects: [RingsideToArsenal(who: You, n: 3, up_to: true), RemoveFromGame(who: Opponent, from: Ringside, n: 3, pick: Random)],
                ),
            ],
        ),
        "Textbook Bear Hug": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Andre the Giant"), effects: [MoveCards(who: You, from: Removed, to: Hand, n: 2, up_to: true)])],
        ),
        // Approximation: the opponent discards 1 random Backlash card.
        "Textbook Crab": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("The Highlight of the Night"), effects: [BacklashToRingside(who: Opponent, n: 1, random: true)])],
        ),
        "Textbook Abdominal Stretch": (
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
            on_play: [If(condition: YouAre("Razor Ramon"), effects: [Discard(who: Opponent, n: 2, pick: Chosen), Mill(who: Opponent, n: 4)])],
        ),
        "Textbook Finisher": (
            requires: Some(CountAtLeast(count: YourRingMatching(All([Maneuver, TitleContains("Textbook")])), n: 5)),
            bonuses: [(when: FortitudeBelowOpponent, per: Some(TitleContains("Textbook")), reversal_fortitude: 1)],
        ),
        // The packing permission with The Era of the Superstar and the Gail Kim-specific / SmackDown / TMF texts
        // are not supported yet.
        "Eat Defeat": (
            only_packed_by: ["Gail Kim"],
            bonuses: [(when: Superstar("Gail Kim"), fortitude: 7, damage: 7)],
            on_play: [Counted(count: YourRingMatching(TitleContains("Era of the Superstar")), effect: Discard(who: Opponent, n: 0, pick: Chosen))],
        ),

        // Reversals
        "You Couldn't Hit the Broad Side of a Barn!": (
            reverses: Some((
                targets: Not(Trait(Unique)),
                from_hand_only: true,
                requires: Some(BackstageRevealed(who: You, filter: Title("Pinpoint Precision Offense"))),
                effects: [MoveCards(who: You, from: Removed, to: Arsenal, n: 1, up_to: true, bottom: true)],
            )),
        ),
        // Approximation: Multi cards and cards whose title is already in their Ring, also when overturned. The
        // 'Text' and 'completely' texts are not supported yet.
        "Sophomore Slump": (
            reverses: Some((
                targets: AnyOf([Trait(Multi), SameTitleInRing]),
                requires: Some(InYourRing(Title("Chase University"))),
            )),
        ),
        // Approximation: any non-Unique maneuver (not only those with a reversal restriction). The Hybrid text and
        // the packing restriction are not supported yet.
        "Textbook Defense": (reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]), ignores_irreversible: true, ignores_limits: true))),
        // The Superstar-specific and Arsenal texts are not supported yet.
        "Knees Up!": (),
        // Putting it into the Ring from the Arsenal and the ACE are not supported yet.
        "False Finish": (
            reverses: Some((targets: ManeuverType(TrademarkFinisher), on_reverse: [RingsideToArsenal(who: You, n: 5, up_to: true)])),
        ),
        // Reversing card effects is not supported yet.
        "Veer Mahaan is Coming": (
            as_action: Some((
                on_play: [ShuffleThisIntoArsenal, MoveCards(who: You, from: Removed, to: Arsenal, n: 1, filter: Some(Not(Trait(Unique))))],
            )),
            reverses: Some((targets: Not(Any))),
        ),

        // Actions
        // Burying removed 'Precision' cards and "without 'reversed' in the text" are not supported yet.
        "With Military Precision": (
            on_play: [Search(filter: All([Maneuver, TitleContains("Precision")]))],
            ring_ability: Some((
                requires: Some(CountAtLeast(count: YourRingMatching(All([Maneuver, TitleContains("Precision")])), n: 10)),
                effects: [WinByPin],
            )),
        ),
        // Approximation: NXT Superstars do not choose 2.
        "Teacher's Pet": (
            requires: Some(InYourRing(Title("Chase University"))),
            on_play: [
                Search(filter: All([Maneuver, Not(SuperstarSpecific)])),
                Choice([
                    [Boost((applies_to: Maneuver, duration: NextCard, multi: true))],
                    [Boost((applies_to: Maneuver, duration: NextCard, chain: true))],
                    [Boost((applies_to: Maneuver, duration: NextCard, no_backlash_reversal: true))],
                ]),
            ],
        ),

        // The Bloodline
        // Universally Unique swaps, resolution order and the unsuccessful-maneuver text are not supported yet.
        "G.O.D. Mode": (),
        // "Only reversed by 1 reversal", returning it to hand and doubling for The Usos are not supported yet.
        "We The Ones": (
            on_play: [
                DrawUpTo(who: You, n: 1),
                MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, top: true),
                MoveCards(who: You, from: Removed, to: Arsenal, n: 1, up_to: true, bottom: true),
                Discard(who: Opponent, n: 1, pick: Chosen),
                HandToArsenalBottom(who: Opponent, n: 1),
                HandToArsenalTop(who: Opponent, n: 1),
                RemoveFromGame(who: Opponent, from: Ringside, n: 1),
                Mill(who: Opponent, n: 1),
            ],
        ),
        // Approximation: # is his current Superstar Value. The Paul Heyman / Enforcer blank is not supported yet.
        "The Wiseman": (reveals_opponent_hand: true, bonuses: [(count: Some(OpponentValueTimes(1)), fortitude: 1)]),

        // Solo Sikoa
        // Resolving an unsuccessful maneuver as successful and revealing it later are not supported yet.
        "Backed by The Honorary Uce": (),
        // The Hand Size protection and the hide ACE are not supported yet.
        "Sikoa's Towel": (backstage_abilities: [DamageFor(filter: Maneuver, delta: 3)]),
        // The 1D reversal cap and the 'Samoan' title text are not supported yet.
        "The Street Champion": (
            ring_ability: Some((
                effects: [
                    ReturnThis(to: Removed),
                    Boost((applies_to: All([Maneuver, TitleContains("Samoan")]), duration: NextMatching, irreversible: true)),
                ],
            )),
        ),
        // The Ring trigger when the opponent's maneuver is unsuccessful is not supported yet.
        "The Problem": (
            reverses: Some((targets: Any, fortitude_when: Some((CountBelow(a: Plus(YourFortitude, Const(9)), b: OpponentFortitude), 0)))),
        ),
        // Being a High Risk with lower Fortitude is not supported yet.
        "Samoan Spinning Heel Kick": (on_play: [Discard(who: Opponent, n: 3, pick: Chosen)]),
        "Samoan Wrecking Ball": (
            play_after: Some(Any),
