        "So F### Your Rules, Man!": (only_packed_by: ["Lita"], backstage_abilities: [NoSlotFor(All([SuperstarSpecific, Trait(MidMatch)]))]),
        // The Stratusfaction texts and the lower-Fortitude text are not supported yet.
        "Canada's Greatest Export": (only_packed_by: ["Trish Stratus"], backstage_abilities: [NoSlotFor(All([SuperstarSpecific, Trait(MidMatch)]))]),
        // The ACE texts are not supported yet.
