        "Dogfaced Gremlin Mentality": (reverses: Some((targets: Maneuver, effects: [DrawUpTo(who: You, n: 2)]))),
        // The ACE tax is not supported yet.
        "You Want A Friend? Get A Dog!": (reverses: Some((targets: All([Not(SuperstarSpecific), Not(Maneuver)]))), reverses_ace: Some(())),
        "Do You Want The Bark or The Bite": (
            on_play: [
                OpponentChooses(
                    n: 1,
                    options: [
                        [
                            Counted(count: YourRingMatching(ManeuverType(Grapple)), effect: Discard(who: Opponent, n: 0, pick: Chosen)),
                            Counted(count: YourRingMatching(ManeuverType(Grapple)), effect: Mill(who: Opponent, n: 0)),
                        ],
                        [
                            Counted(
                                count: YourRingMatching(ManeuverType(Grapple)),
                                effect: MoveCards(who: You, from: Ringside, to: Arsenal, n: 0, up_to: true, bottom: true),
