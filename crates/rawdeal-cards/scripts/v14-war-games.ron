        "From Deepest Darkest Africa": (
            opponent_hand_size_bonus: -3,
            ring_ability: Some((effects: [ReturnThis(to: Removed), Boost((applies_to: Maneuver, duration: NextMatching, stun_value: 3))])),
        ),
        // Putting it into the Ring and the ACE are not supported yet.
        "The Twin Towers": (reverses: Some((targets: Any, requires: Some(Superstar("Akeem"))))),
        // Playing it from the removed pile and the Stun text are not supported yet.
        "Gang's Clubbing Blows": (),
        // The Stun-draw replacement is not supported yet.
        "The African Dream": (
            irreversible_when: Some(Not(BackstageRevealed(who: You, filter: Title("One Man Gang")))),
            on_play: [Counted(count: Plus(YourRingStun, OpponentRingStun), effect: RingsideToArsenal(who: You, n: 0, up_to: true))],
        ),
        // Effects during the opponent's turn are not supported yet.
        "African Tribal Mask": (),
        // The ACE during the opponent's turn is not supported yet.
        "Managed by Kim Chee": (
            while_in_ring_opponent: [(applies_to: Maneuver, stun_value: -1)],
            ringside_ability: Some((effects: [ReturnThis(to: Removed), RingsideToArsenal(who: You, n: 5)])),
        ),
        // The Ring trigger is not supported yet.
        "The Ugandan Headhunter": (reverses: Some((targets: Not(Maneuver), effects: [RingsideToArsenal(who: You, n: 4, up_to: true)]))),
        // Approximation: # is the maneuver's damage (max. 8).
        "Inclusivity, Acceptance, Resilience": (
            reverses: Some((targets: Not(Any))),
            after_success: Some((effects: [Counted(count: AtMost(InPlayDamage, 8), effect: Mill(who: Opponent, n: 0))])),
            ring_ability: Some((effects: [RingsideToArsenal(who: You, n: 8, up_to: true), ReturnThis(to: Removed)])),
