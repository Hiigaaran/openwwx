                    Title("Revolution Heartbreaker"),
                    Title("Revolution H-Line"),
                    Title("Revolution Burn Out Attitude"),
                    Title("Revolution Candy-A%$ Attitude"),
                    Title("Revolution Undying Attitude"),
                    Title("Revolution Whoop-Ass Attitude"),
                    Title("Revolution Even Good Guys Do Bad Things"),
                    Title("Revolution Live Fast-Fight Hard"),
                    Title("Revolution Caution: You're Entering the O-Zone"),
