                            Title("Revolution The Conscience of the WWE"),
                            Title("Revolution I Walk Alone"),
                            Title("Revolution Doctor of Thuganomics"),
                            Title("Revolution From Cruiserweight to Heavyweight Champ"),
                            Title("Revolution Ten Time World Champion"),
                            Title("Revolution I'm Not Your Damn Role Model"),
                            Title("Revolution A WWE X-Treme Original"),
                            Title("Revolution The Big Red Monster"),
                            Title("Revolution I Am the Legend Killer"),
                        ]),
                    ),
                ),
            )),
        ),

        // Reversals
        "Revolution Never Think Twice": (
            reverses: Some((
                targets: All([Maneuver, EarlierThisTurn(filter: Any, n: 1)]),
                requires: Some(FortitudeBelowOpponent),
                overturned_only: true,
            )),
        ),
        "Revolution Outmaneuver": (
            reverses: Some((
                targets: All([Not(Trait(Colossal)), ManeuverType(Extreme)]),
                effects: [
                    If(
                        condition: OpponentIs("Extremist"),
                        effects: [
                            RingsideToHand(
                                who: You,
                                n: 1,
                                up_to: true,
                                filter: Some(All([Not(Trait(Unique)), Not(ManeuverType(Extreme)), Maneuver])),
                            ),
                        ],
                    ),
                ],
            )),
        ),
        // The packing restriction (no F:0 Maneuver / Reversal hybrids) is not supported yet.
        "Revolution The Second Solution": (
            reverses: Some((
                targets: All([DamageAtLeast(1), DamageAtMost(7), AnyOf([ManeuverType(Assault), ManeuverType(Hold), ManeuverType(Throw)])]),
                effects: [DrawUpTo(who: You, n: 2)],
            )),
        ),
        "Revolution Off Your Mark": (
            reverses: Some((
                targets: Trait(Unique),
                effects: [
                    If(condition: FortitudeBelowOpponent, effects: [RemoveFromRing(who: Opponent, n: 1, filter: Maneuver)]),
                    If(condition: OpponentHandLarger, effects: [RingsideToHand(who: You, n: 2, up_to: true, filter: Some(Antic))]),
                ],
            )),
        ),
        // Putting the reversed card into the opponent's Ring (blanked) and returning this card to hand when
        // overturned are not supported yet.
        "Revolution My Way": (),

        // Pre-match
        // Approximation: the Target is chosen for the search only; the card does not get that Target.
        "Revolution WWE Tribute to the Troops": (
            on_play: [
                Choice([
                    [Search(filter: All([Not(Trait(Unique)), Target("head")]), up_to: true)],
                    [Search(filter: All([Not(Trait(Unique)), Target("neck")]), up_to: true)],
                    [Search(filter: All([Not(Trait(Unique)), Target("chest")]), up_to: true)],
                    [Search(filter: All([Not(Trait(Unique)), Target("back")]), up_to: true)],
                    [Search(filter: All([Not(Trait(Unique)), Target("arm")]), up_to: true)],
                    [Search(filter: All([Not(Trait(Unique)), Target("leg")]), up_to: true)],
                ]),
                DrawUpTo(who: Opponent, n: 1),
            ],
        ),
        "Revolution Man of 1000 Moves": (
            requires: Some(CountAtLeast(count: YourRingMatching(TitleContains("Ring Psychology")), n: 2)),
            on_play: [Search(filter: All([ManeuverType(Hold), FortitudeAtMost(0)]), up_to: true)],
            pre_match_limit: 2,
        ),
        // Changing a maneuver's type (Core or Colossal to Mean) is not supported yet.
        "Revolution A Major Impact": (requires: Some(Never)),
        "Revolution Torrie! Torrie! Torrie!": (
            on_play: [RingsideToArsenal(who: You, n: 1, up_to: true)],
            while_in_ring: [
                (applies_to: All([Not(Trait(Unique)), Not(ManeuverType(Extreme)), Trait(Mean), FortitudeAtLeast(10)]), fortitude: -2),
                (applies_to: All([Not(Trait(Unique)), Trait(Colossal), FortitudeAtLeast(17)]), fortitude: -2),
            ],
        ),
        "Revolution Have a Look at Brooke": (
            on_play: [
                RevealHand(who: You),
                If(
                    condition: CountAtMost(count: YourHandMatching(Reversal), n: 2),
                    effects: [Search(filter: All([Not(Trait(Unique)), Trait(Core), Reversal]), up_to: true)],
                ),
            ],
