        // Overturning 2 fewer cards at the end of a turn without a Maneuver is not supported yet. Approximation:
        // "a Pre-match: Storyline in your Ring" means one of the Revolution Storylines, by title.
        "Revolution Hail to the Chairman": (
            on_play: [ShuffleHandAndRedraw(who: You), ShuffleHandAndRedraw(who: Opponent)],
            reverses: Some((
                targets: All([Not(Trait(Unique)), Antic]),
                requires: Some(
                    InYourRing(
                        AnyOf([
                            Title("Revolution The Founder of the Four Horsemen"),
                            Title("Revolution For Many Are Called But Few Are Chosen"),
                            Title("Revolution The Texas Rattlesnake"),
                            Title("Revolution Tiger Tamer"),
