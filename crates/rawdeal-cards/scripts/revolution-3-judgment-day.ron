        "Revolution Batista is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution John Cena is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Rey Mysterio is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Triple H is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Edge is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Jeff Hardy is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Kane is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Randy Orton is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Ric Flair is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Shawn Michaels is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Stone Cold Steve Austin is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution The Great Khali is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Umaga is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Undertaker is In My Corner!": (restricts_self: Some((filter: TitleContains("In My Corner")))),
        "Revolution Theodore Long is In My Corner!": (
            on_play: [Search(filter: Title("Revolution You're Fired, Playa!"), up_to: true)],
            reverses_from_ring: Some((targets: Trait(Momentum), damage: None)),
        ),
        // Approximation: "a card with Requirement: Less Fortitude" means this set's cards with that Requirement, by title.
        "Revolution Mr. McMahon is In My Corner!": (
            on_play: [Search(filter: Title("Revolution No, You're FIIIIIRRRRRED!"), up_to: true)],
            reverses_from_ring: Some((
