// Hand-written scripts for revolution-3-judgment-day cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// Every title starts with "Revolution ": text naming a card means the Revolution card.
// Maneuver / Antic hybrids: the Antic part is in `as_action`, which the engine will use when the card is
// played as an Antic (engine change pending; until then an Antic play of a hybrid uses `on_play`, which is empty).
// "Search for a card with Fortitude equal to or less than your Fortitude" ignores the Fortitude limit (approximation).
// "3 or more Superstar-specifics from <Faction> Members and/or cards with <Faction> in the text in your Ring" is
// approximated as 3 or more Superstar-specific cards or cards of that Faction (by title) in your Ring.
(
    abilities: {
        "Revolution Ric Flair": [
            Activated(
                cost: [],
                effects: [
                    RingsideToHand(
                        who: You,
                        n: 1,
                        up_to: true,
                        filter: Some(All([Maneuver, AnyOf([TitleContains("chop"), TitleContains("punch"), Target("leg")])])),
                    ),
                ],
            ),
        ],
        "Revolution Shawn Michaels": [
            Activated(cost: [DiscardMatching(who: You, n: 1, filter: Antic, pick: Chosen)], effects: [Dig(n: 7, take: 1)]),
        ],
        // Approximation: the cards are shuffled into the Arsenal instead of going on the bottom.
        "Revolution Stone Cold Steve Austin": [
            Activated(
                cost: [],
                effects: [
                    Mulligan(n: 6),
                    Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -3, damage: 1)),
                ],
            ),
        ],
        "Revolution The Great Khali": [
            Activated(
                cost: [],
                effects: [
                    Search(filter: All([Not(Trait(Unique)), Not(Hybrid), Maneuver]), up_to: true),
                    DrawUpTo(who: Opponent, n: 1),
                ],
            ),
        ],
        "Revolution Umaga": [
            OnPlayMatching(
                filter: Maneuver,
                effects: [
                    Optional([
                        Mill(who: You, n: 1),
                        RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Maneuver, Not(Trait(Core))]))),
                    ]),
                ],
            ),
            OnPlayMatching(filter: TitleContains("Samoa"), effects: [RingsideToArsenalBottom(who: You, n: 3)]),
        ],
        // Having his opponent's Fortitude during the opponent's turn is not supported yet.
        "Revolution Undertaker": [
            OnOpponentReverses([
                If(
                    condition: OpponentReversedFrom([Hand]),
                    effects: [
                        RingsideToHand(
                            who: You,
                            n: 1,
                            up_to: true,
                            filter: Some(All([Not(Trait(Unique)), Not(Hybrid), Not(ManeuverType(Extreme)), Maneuver])),
                        ),
                    ],
                ),
            ]),
        ],
    },
    scripts: {
        // Assaults
        "Revolution Poke": (
            as_action: Some((
                on_play: [
                    DiscardThis,
                    RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Not(Trait(Unique)), Not(Hybrid), Target("head")]))),
                ],
            )),
        ),
        "Revolution Chop Block": (
            ringside_ability: Some((cost: [DiscardMatching(who: You, n: 2, filter: Reversal, pick: Chosen)], effects: [ReturnThis(to: Hand)])),
        ),
        "Revolution Wallop": (as_action: Some((on_play: [DiscardThis, DrawUpTo(who: You, n: 1)]))),
        "Revolution Pump Kick": (
            as_action: Some((
                on_play: [
                    DiscardThis,
                    RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Not(Trait(Unique)), Not(Hybrid), Target("chest")]))),
                ],
            )),
        ),
        "Revolution Elbow Smash": (
            ringside_ability: Some((requires: Some(OpponentHandLarger), cost: [Mill(who: You, n: 2)], effects: [ReturnThis(to: Hand)])),
        ),
        "Revolution Uppercut": (as_action: Some((on_play: [DiscardThis, Discard(who: Opponent, n: 1, pick: Chosen)]))),
        "Revolution Back Rake": (on_play: [Search(filter: All([Not(Trait(Unique)), ManeuverType(Hold)]), up_to: true)]),
        "Revolution Open-handed Chop": (
            on_play: [RemoveFromRing(who: Opponent, n: 1, filter: All([Not(Trait(Unique)), Maneuver, Target("chest")]))],
        ),
        "Revolution Back Fist": (on_play: [Search(filter: All([Not(Trait(Unique)), Target("head")]), up_to: true)]),
        "Revolution Short-Arm Clothesline": (on_play: [Search(filter: All([Not(Trait(Unique)), Target("neck")]), up_to: true)]),
        "Revolution Standing Drop Kick": (
            on_play: [RemoveFromRing(who: Opponent, n: 1, filter: All([Not(Trait(Unique)), Maneuver, Target("head")]))],
        ),
        "Revolution Lariat": (on_play: [Search(filter: All([Not(Trait(Unique)), ManeuverType(Throw)]), up_to: true)]),
        "Revolution Bionic Elbow": (
            on_play: [Boost((applies_to: All([Maneuver, Target("leg")]), duration: NextCard, momentum: true))],
        ),
        "Revolution Bulldog Lariat": (
            on_play: [
                Choice([
                    [],
                    [If(condition: CountAtLeast(count: YourHandMatching(Trait(Core)), n: 1), effects: [DiscardMatching(who: You, n: 1, filter: Trait(Core), pick: Chosen), Discard(who: Opponent, n: 1, pick: Chosen)])],
                    [If(condition: CountAtLeast(count: YourHandMatching(Trait(Core)), n: 2), effects: [DiscardMatching(who: You, n: 2, filter: Trait(Core), pick: Chosen), Discard(who: Opponent, n: 2, pick: Chosen)])],
                    [If(condition: CountAtLeast(count: YourHandMatching(Trait(Core)), n: 3), effects: [DiscardMatching(who: You, n: 3, filter: Trait(Core), pick: Chosen), Discard(who: Opponent, n: 3, pick: Chosen)])],
                    [If(condition: CountAtLeast(count: YourHandMatching(Trait(Core)), n: 4), effects: [DiscardMatching(who: You, n: 4, filter: Trait(Core), pick: Chosen), Discard(who: Opponent, n: 4, pick: Chosen)])],
                ]),
            ],
        ),
        "Revolution Short-Arm Rib Breaker": (
            on_play: [
                If(
                    condition: HandHas(ManeuverType(Hold)),
                    effects: [Optional([DiscardMatching(who: You, n: 1, filter: ManeuverType(Hold), pick: Chosen), DrawUpTo(who: You, n: 4)])],
                ),
            ],
        ),
        "Revolution Rapid-Fire Punches": (
            on_play: [RingToHand(who: You, n: 2, filter: All([Not(Trait(Unique)), Target("head")]), up_to: true)],
        ),
        "Revolution 360-Degree Clothesline": (
            on_play: [
                Counted(
                    count: YourRingMatching(Target("neck")),
                    effect: MoveCards(
                        who: Opponent,
                        from: Arsenal,
                        to: Ringside,
                        n: 0,
                        up_to: true,
                        filter: Some(All([Not(Trait(Unique)), Hybrid])),
                        pick: Controller,
                    ),
                ),
            ],
        ),

        // Holds
        "Revolution Waist Lock": (
            as_action: Some((
                on_play: [
                    DiscardThis,
                    MoveCards(who: You, from: Ringside, to: Backlash, n: 1, up_to: true, filter: Some(All([Not(Trait(Unique)), Trait(MidMatch), Maneuver]))),
                ],
            )),
        ),
        "Revolution Lock-up": (
            as_action: Some((
                on_play: [
                    DiscardThis,
                    RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Not(Trait(Unique)), Not(Hybrid), Target("arm")]))),
                ],
            )),
        ),
        "Revolution Strangle Hold": (
            ringside_ability: Some((cost: [DiscardMatching(who: You, n: 2, filter: Antic, pick: Chosen)], effects: [ReturnThis(to: Hand)])),
        ),
        "Revolution Arm Wringer": (as_action: Some((on_play: [DiscardThis, BacklashToRingside(who: Opponent, n: 1, random: true)]))),
        "Revolution Chancery": (
            as_action: Some((
                on_play: [
                    DiscardThis,
                    RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Not(Trait(Unique)), Not(Hybrid), Target("leg")]))),
                ],
            )),
        ),
        "Revolution Scissors Hold": (
            ringside_ability: Some((
                requires: Some(FortitudeBelowOpponent),
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [ReturnThis(to: Hand)],
            )),
        ),
        "Revolution Split Finger Lock": (on_play: [Search(filter: All([Not(Trait(Unique)), Target("arm")]), up_to: true)]),
        "Revolution Neck Wrencher": (on_play: [Search(filter: All([Not(Trait(Unique)), ManeuverType(Throw)]), up_to: true)]),
        "Revolution Unorthodox Wrist Lock": (
            on_play: [RemoveFromRing(who: Opponent, n: 1, filter: All([Not(Trait(Unique)), Maneuver, Target("arm")]))],
        ),
        "Revolution Cobra Clutch": (
            on_play: [RemoveFromRing(who: Opponent, n: 1, filter: All([Not(Trait(Unique)), Maneuver, Target("neck")]))],
        ),
        "Revolution Knee Lock": (on_play: [Optional([Search(filter: All([Maneuver, TitleContains("knee")]))])]),
        "Revolution Body Vise": (on_play: [Search(filter: All([Not(Trait(Unique)), Target("chest")]), up_to: true)]),
        "Revolution Arm Breaker": (
            on_play: [Boost((applies_to: All([Maneuver, Target("back")]), duration: NextCard, momentum: true))],
        ),
        "Revolution Ankle Torque": (
            on_play: [
                Choice([
                    [],
                    [If(condition: CountAtLeast(count: YourHandMatching(Reversal), n: 1), effects: [DiscardMatching(who: You, n: 1, filter: Reversal, pick: Chosen), Discard(who: Opponent, n: 1, pick: Chosen)])],
                    [If(condition: CountAtLeast(count: YourHandMatching(Reversal), n: 2), effects: [DiscardMatching(who: You, n: 2, filter: Reversal, pick: Chosen), Discard(who: Opponent, n: 2, pick: Chosen)])],
                    [If(condition: CountAtLeast(count: YourHandMatching(Reversal), n: 3), effects: [DiscardMatching(who: You, n: 3, filter: Reversal, pick: Chosen), Discard(who: Opponent, n: 3, pick: Chosen)])],
                    [If(condition: CountAtLeast(count: YourHandMatching(Reversal), n: 4), effects: [DiscardMatching(who: You, n: 4, filter: Reversal, pick: Chosen), Discard(who: Opponent, n: 4, pick: Chosen)])],
                ]),
            ],
        ),
        "Revolution Standing Dragon Sleeper": (
            on_play: [
                If(
                    condition: HandHas(ManeuverType(Throw)),
                    effects: [Optional([DiscardMatching(who: You, n: 1, filter: ManeuverType(Throw), pick: Chosen), DrawUpTo(who: You, n: 4)])],
                ),
            ],
        ),
        "Revolution Leg Lock": (
            on_play: [
                Counted(
                    count: YourRingMatching(Target("leg")),
                    effect: RingsideToHand(who: You, n: 0, up_to: true, filter: Some(All([Not(Trait(Unique)), Antic]))),
                ),
            ],
        ),
        "Revolution Super Hold": (bonuses: [(per: Some(Target("arm")), damage: 3)]),

        // Throws
        "Revolution Pretzel Jerk": (
            ringside_ability: Some((cost: [DiscardMatching(who: You, n: 1, filter: Maneuver, pick: Chosen)], effects: [ReturnThis(to: Hand)])),
        ),
        "Revolution Takedown": (
            as_action: Some((
                on_play: [DiscardThis, Boost((applies_to: Not(Trait(Unique)), duration: NextMatching, fortitude: -3))],
            )),
        ),
        "Revolution Slam": (
            as_action: Some((
                on_play: [
                    DiscardThis,
                    RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Not(Trait(Unique)), Not(Hybrid), Target("back")]))),
                ],
            )),
        ),
        "Revolution Snap Bulldog": (
            ringside_ability: Some((
                requires: Some(CountBelow(a: OpponentRingsideSize, b: YourRingsideSize)),
                effects: [ReturnThis(to: Hand), DrawUpTo(who: Opponent, n: 1)],
            )),
        ),
        "Revolution Suplex": (
            as_action: Some((
                on_play: [
                    DiscardThis,
                    MoveCards(who: You, from: Ringside, to: Arsenal, n: 2, up_to: true, filter: Some(Not(Trait(Unique))), bottom: true),
                ],
            )),
        ),
        "Revolution Neck Breaker": (
            as_action: Some((
                on_play: [
                    DiscardThis,
                    RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Not(Trait(Unique)), Not(Hybrid), Target("neck")]))),
                ],
            )),
        ),
        "Revolution Single Leg Takedown": (
            on_play: [RemoveFromRing(who: Opponent, n: 1, filter: All([Not(Trait(Unique)), Maneuver, Target("leg")]))],
        ),
        "Revolution Snap Slam": (on_play: [Search(filter: All([Not(Trait(Unique)), Target("back")]), up_to: true)]),
        "Revolution Flung Over the Ropes": (on_play: [Search(filter: All([Not(Trait(Unique)), ManeuverType(Assault)]), up_to: true)]),
        "Revolution Modified Monkey Flip": (on_play: [Search(filter: All([Not(Trait(Unique)), ManeuverType(Hold)]), up_to: true)]),
        "Revolution Knee Breaker": (on_play: [Search(filter: All([Not(Trait(Unique)), Target("leg")]), up_to: true)]),
        "Revolution Snap Suplex": (
            on_play: [RemoveFromRing(who: Opponent, n: 1, filter: All([Not(Trait(Unique)), Maneuver, Target("back")]))],
        ),
        "Revolution Rib Breaker": (
            on_play: [Boost((applies_to: All([Maneuver, Target("neck")]), duration: NextCard, momentum: true))],
        ),
        "Revolution Airplane Spin": (
            on_play: [
                Choice([
                    [],
                    [If(condition: CountAtLeast(count: YourHandMatching(Antic), n: 1), effects: [DiscardMatching(who: You, n: 1, filter: Antic, pick: Chosen), Discard(who: Opponent, n: 1, pick: Chosen)])],
                    [If(condition: CountAtLeast(count: YourHandMatching(Antic), n: 2), effects: [DiscardMatching(who: You, n: 2, filter: Antic, pick: Chosen), Discard(who: Opponent, n: 2, pick: Chosen)])],
                    [If(condition: CountAtLeast(count: YourHandMatching(Antic), n: 3), effects: [DiscardMatching(who: You, n: 3, filter: Antic, pick: Chosen), Discard(who: Opponent, n: 3, pick: Chosen)])],
                    [If(condition: CountAtLeast(count: YourHandMatching(Antic), n: 4), effects: [DiscardMatching(who: You, n: 4, filter: Antic, pick: Chosen), Discard(who: Opponent, n: 4, pick: Chosen)])],
                ]),
            ],
        ),
        "Revolution Brainbuster": (
            on_play: [
                If(
                    condition: HandHas(ManeuverType(Assault)),
                    effects: [Optional([DiscardMatching(who: You, n: 1, filter: ManeuverType(Assault), pick: Chosen), DrawUpTo(who: You, n: 4)])],
                ),
            ],
        ),
        "Revolution Sit Out Powerbomb": (
            bonuses: [(when: After(AnyOf([ManeuverType(Assault), ManeuverType(Hold)])), fortitude: -6)],
        ),
        "Revolution Face Driver": (
            on_play: [
                Counted(
                    count: YourRingMatching(Target("neck")),
                    effect: RingsideToHand(who: You, n: 0, up_to: true, filter: Some(All([Not(Trait(Unique)), Trait(Colossal)]))),
                ),
            ],
        ),

        // Extremes
        "Revolution Hand Smash": (bonuses: [(when: YouAre("Extremist"), damage: 2)]),
        "Revolution Toe Smash": (on_play: [NextCardMustBe(Not(All([Maneuver, Trait(FollowUp)])))]),
        "Revolution Homicidal Lunge": (requires: Some(All([YouAre("Extremist"), FirstCardThisTurn]))),
        "Revolution Flying Clothesline": (on_play: [If(condition: YouAre("Extremist"), effects: [Discard(who: Opponent, n: 1, pick: Chosen)])]),
        "Revolution Leaping Neck Snap": (on_play: [If(condition: YouAre("Extremist"), effects: [DrawUpTo(who: You, n: 2)])]),
        "Revolution Inverted Body Block": (
            on_play: [If(condition: YouAre("Extremist"), effects: [RingsideToArsenal(who: You, n: 3, up_to: true)])],
        ),
        "Revolution Missile Drop Kick": (bonuses: [(when: YouAre("Extremist"), fortitude: -2)]),
        "Revolution Suicide Dive": (bonuses: [(when: YouAre("Extremist"), fortitude: -3)]),
        "Revolution Hurricanrana": (bonuses: [(when: YouAre("Extremist"), fortitude: -4)]),
        // Drawing when it is reversed from the Backlash deck or the Arsenal is not supported yet.
        "Revolution Struck by an Unknown Foreign Object": (bonuses: [(when: YouAre("Extremist"), fortitude: -2)]),
        // The Backlash-deck part of "if reversed" is not supported yet.
        "Revolution Steel Chain Shot": (
            bonuses: [(when: YouAre("Extremist"), fortitude: -3)],
            on_reversed_from_hand: [Discard(who: Opponent, n: 2, pick: Chosen)],
        ),
        // The Arsenal part of "if reversed" is not supported yet.
        "Revolution The Unforgiving Ladder": (
            on_reversed_from_hand: [Optional([Mill(who: You, n: 8), Search(filter: Trait(Unique), up_to: true)])],
        ),

        // Antics
        "Revolution I Want It All": (on_play: [DrawUpTo(who: You, n: 3), HandToArsenalBottom(who: You, n: 2)]),
        // Approximation: the next Extreme: Follow-up: Maneuver may ignore its Follow-up text.
        "Revolution Run the Ropes": (
            on_play: [
                RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([ManeuverType(Extreme), Trait(FollowUp)]))),
                Boost((applies_to: All([ManeuverType(Extreme), Trait(FollowUp)]), duration: NextCard, ignore_play_after: true)),
            ],
        ),
        "Revolution Trap Opponent in The Corner": (on_play: [CannotPlay(who: Opponent, filter: Any, turns: 1), EndTurn]),
        "Revolution Maintain the Hold": (on_play: [CannotPlay(who: Opponent, filter: Any, turns: 1), EndTurn]),
        "Revolution Leverage Opponent": (on_play: [CannotPlay(who: Opponent, filter: Any, turns: 1), EndTurn]),
        "Revolution Measure Him": (
            on_play: [
                DrawUpTo(who: Opponent, n: 1),
                Boost((
                    applies_to: AnyOf([ManeuverType(Assault), ManeuverType(Hold), ManeuverType(Throw)]),
                    duration: NextCard,
                    momentum: true,
                )),
            ],
        ),
        "Revolution Cade and Murdoch: Staunchest Rednecks": (
            requires: Some(
                All([
                    CountAtLeast(count: YourRingMatching(Target("chest")), n: 3),
                    CountAtLeast(count: YourRingMatching(Target("neck")), n: 3),
                ]),
            ),
            on_play: [Discard(who: Opponent, n: 3, pick: Chosen), DrawUpTo(who: You, n: 4)],
        ),
        "Revolution Montel Vontavious Porter: Privileged Warhead": (
            requires: Some(
                All([
                    CountAtLeast(count: YourRingMatching(Target("head")), n: 5),
                    CountAtLeast(count: YourRingMatching(Target("leg")), n: 1),
                ]),
            ),
            on_play: [
                LookAtHand(who: Opponent),
                Discard(who: Opponent, n: 1, pick: Controller),
                Search(filter: Target("head"), n: 2, up_to: true),
            ],
        ),
        "Revolution 'Hacksaw' Jim Duggan: Harmful Flashback": (
            requires: Some(
                All([
                    CountAtLeast(count: YourRingMatching(Target("arm")), n: 2),
                    CountAtLeast(count: YourRingMatching(Target("back")), n: 4),
                ]),
            ),
            on_play: [
                RemoveFromRing(who: Opponent, n: 2, filter: Any),
                RingsideToHand(who: You, n: 3, up_to: true, filter: Some(Target("back"))),
            ],
        ),
        "Revolution You're Fired, Playa!": (
            on_play: [ThisToArsenal(bottom: true), RingsideToArsenalBottom(who: You, n: 1), DrawUpTo(who: You, n: 1)],
        ),
        "Revolution Melina's Shoot Stretch": (
            requires: Some(CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 3)),
        ),
        "Revolution Ashley's an Awesome Asset": (
            on_play: [Mill(who: Opponent, n: 3)],
            in_ring_on_play: [(whose: Some(You), filter: Antic, effects: [Mill(who: Opponent, n: 1)])],
        ),
        "Revolution Go Candice, Come to Daddy": (
            on_play: [
                HandToArsenalTop(who: You, n: 2),
                MoveCards(who: You, from: Ringside, to: Arsenal, n: 8, up_to: true, top: true),
                Search(filter: Any, n: 2, up_to: true),
            ],
        ),

        // Antic / Reversal and Antic / other hybrids (the Antic part is in `on_play`).
        // Approximation: the Antic part keeps the printed F:8.
        "Revolution Standing Switch": (
            on_play: [
                DiscardThis,
                RingsideToHand(
                    who: You,
                    n: 1,
                    up_to: true,
                    filter: Some(All([Trait(Core), AnyOf([ManeuverType(Assault), ManeuverType(Hold), ManeuverType(Throw)])])),
                ),
            ],
            reverses: Some((
                targets: All([Trait(FollowUp), Antic]),
                effects: [Boost((applies_to: All([Antic, Trait(FollowUp)]), duration: NextTurnFirstCard, ignore_play_after: true))],
            )),
        ),
        // The Antic part's -7F is in `as_action` (engine change pending); until then the Antic play needs the
        // printed F:7.
        "Revolution Head-to-Toe Defense": (
            after_success: Some((filter: ManeuverType(Trademark), to: Some(Ringside))),
            on_play: [
                RingsideToArsenal(who: You, n: 2, up_to: true, filter: Some(AnyOf([Target("head"), Target("leg")]))),
            ],
            as_action: Some((
                fortitude: Some(0),
                on_play: [RingsideToArsenal(who: You, n: 2, up_to: true, filter: Some(AnyOf([Target("head"), Target("leg")])))],
            )),
            reverses: Some((targets: All([Maneuver, AnyOf([Target("head"), Target("leg")])]))),
        ),
        // The Antic part's -7F is in `as_action` (engine change pending).
        "Revolution Centered Defense": (
            after_success: Some((filter: All([Maneuver, Trait(Colossal), Not(Trait(Unique))]), to: Some(Ringside))),
            on_play: [
                RingsideToArsenal(who: You, n: 2, up_to: true, filter: Some(AnyOf([Target("chest"), Target("neck")]))),
            ],
            as_action: Some((
                fortitude: Some(0),
                on_play: [RingsideToArsenal(who: You, n: 2, up_to: true, filter: Some(AnyOf([Target("chest"), Target("neck")])))],
            )),
            reverses: Some((targets: All([Maneuver, AnyOf([Target("chest"), Target("neck")])]))),
        ),
        // The Antic part's -7F is in `as_action` (engine change pending).
        "Revolution Lateral Flank Defense": (
            after_success: Some((filter: All([Maneuver, Trait(Mean), Not(Trait(Unique))]), to: Some(Ringside))),
            on_play: [
                RingsideToArsenal(who: You, n: 2, up_to: true, filter: Some(AnyOf([Target("arm"), Target("back")]))),
            ],
            as_action: Some((
                fortitude: Some(0),
                on_play: [RingsideToArsenal(who: You, n: 2, up_to: true, filter: Some(AnyOf([Target("arm"), Target("back")])))],
            )),
            reverses: Some((targets: All([Maneuver, AnyOf([Target("arm"), Target("back")])]))),
        ),
        // Approximation: "cards with a Faction Requirement" are this set's cards that require a Faction, by title.
        "Revolution No, You're FIIIIIRRRRRED!": (
            on_play: [
                RingsideToHand(
                    who: You,
                    n: 2,
                    up_to: true,
                    filter: Some(
                        AnyOf([
                            Title("Revolution Death-Defying Maniac"),
                            Title("Revolution Enter the Sandman"),
                            Title("Revolution Innovative Violence"),
                            Title("Revolution Worth the Price of Admission"),
                            Title("Revolution A Bloody Nightmare"),
                            Title("Revolution Here's a Lesson Plan"),
                            Title("Revolution Prepare for the POUNCE"),
                            Title("Revolution The Elijah Experience"),
                            Title("Revolution Eat Spit"),
                            Title("Revolution Assisted by the Dirtiest Player in the Game"),
                            Title("Revolution Heartbreaker"),
                            Title("Revolution H-Line"),
                            Title("Revolution Burn Out Attitude"),
                            Title("Revolution Candy-A%$ Attitude"),
                            Title("Revolution Undying Attitude"),
                            Title("Revolution Whoop-Ass Attitude"),
                            Title("Revolution Even Good Guys Do Bad Things"),
