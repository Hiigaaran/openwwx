        // Saving a pinfall by a non-Trademark card is not supported yet.
        "Revolution I've Trained for This Day All My Life": (mid_match_limit: 1),
        "Revolution See Kristal Clear": (
            requires: Some(HandHas(Reversal)),
            on_play: [
                DiscardMatching(who: You, n: 1, filter: Reversal, pick: Chosen),
                LookAtHand(who: Opponent),
                Optional([BuryHand(who: Opponent, then: Draw)]),
            ],
        ),
        // Skipping the end-of-turn overturn when no Maneuver was played is not supported yet.
        "Revolution Taunt You All I Want!": (on_play: [Search(filter: Title("Revolution Pacing My Match"), up_to: true)]),
        // Packing another Superstar's Antics and Maneuvers (and their Requirement) and "Your Storyline is Permanent"
