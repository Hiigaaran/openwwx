        // Mid-match
        "Revolution Arm Drag": (requires: Some(FortitudeBelowOpponent), on_play: [Mill(who: You, n: 3)]),
        "Revolution Body Lock": (requires: Some(FortitudeBelowOpponent), on_play: [Mill(who: You, n: 3)]),
        "Revolution Spinning Kick": (requires: Some(FortitudeBelowOpponent), on_play: [Mill(who: You, n: 3)]),
