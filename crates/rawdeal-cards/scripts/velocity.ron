// Hand-written scripts for Velocity cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
(
    abilities: {
        // Approximation: his first 2 cards are the first 2 non-Reversal cards of his first turn
        // (not reversible from the Backlash deck either).
        "Big Freak'n Machine": [
            PacksLogos(["Kane"]),
            EndOfPrematch([
                Boost((applies_to: Not(Reversal), duration: NextTurnCards(2), no_hand_reversal: true)),
            ]),
        ],
        "The Game": [
            StartOfTurn([Arrange(who: You, n: 3)]),
            OpponentCannotPlay("The Game Interferes!"),
            PacksLogos(["Triple H"]),
        ],
        "Goldust": [OnPlayMatching(filter: Maneuver, effects: [Discard(who: Opponent, n: 1, pick: Chosen)])],
        // No Sell Maneuver already lists Brock Lesnar among the Superstars who may pack it.
        "Brock Lesnar": [OpponentDamageCap(filter: ManeuverType(Strike), max: 3)],
        "The People's Champ": [
            StartOfTurn([Boost((applies_to: Maneuver, duration: ThisTurn, no_backlash_reversal: true))]),
            PacksLogos(["The Rock"]),
        ],
        "Rey Mysterio": [
            OnOpponentReverses([
                If(
                    condition: OpponentReversedFrom([Hand, Backlash]),
                    effects: [Optional([Discard(who: You, n: 2, pick: Chosen), ContinueTurn])],
                ),
            ]),
            CardFortitude(title: "From the Top Rope", delta: -5),
            CardFortitude(title: "Springboard", delta: -5),
        ],
        // Approximation: burying is putting up to 3 Ringside cards on the bottom of the Arsenal.
        // The Did I Just Say ... Three Minutes? and Rico Enters! parts are not supported yet.
        "3 Minute Warning": [
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
            Activated(cost: [], effects: [Draw(who: You, n: 3), Discard(who: You, n: 3, pick: Chosen)]),
            OnPlayMatching(filter: Trait(Raw), effects: [Optional([RingsideToArsenalBottom(who: You, n: 3)])]),
        ],
        // The "not Heel" part is not supported yet.
        "Jamie Noble": [
            OnOpponentPlayMatching(
                filter: Maneuver,
                effects: [
                    RingsideToHand(
                        who: You,
                        n: 1,
                        filter: Some(AnyOf([Not(Trait(Unique)), Holds(InYourRing(Title("Cruiserweight Title Belt")))])),
                    ),
                ],
            ),
        ],
    },
    scripts: {
        // High Risk
        "Flying Mare": (
            play_after: Some(All([Maneuver, StunValueAtLeast(1)])),
            on_removed_by_opponent: [RingsideToHand(who: You, n: 1)],
        ),
        "Diving Takedown": (
            play_after: Some(Maneuver),
            as_action: Some((
                fortitude: Some(5),
                on_play: [DiscardThis, Draw(who: You, n: 1), Discard(who: Opponent, n: 1, pick: Chosen)],
            )),
        ),
        "Quick Follow Through": (
            play_after: Some(Maneuver),
            ring_ability: Some((sacrifice: true, effects: [Draw(who: You, n: 1)])),
        ),
        // The Over Sell Maneuver part needs nothing: that card cannot be played yet.
        "Shoot Aerial 360-Degree Kick": (
            play_after: Some(All([Maneuver, DamageAtLeast(4)])),
            not_reversed_by: Some(Title("Roll Out of the Way")),
        ),
        "Missile Shoulder Block": (play_after: Some(Title("Irish Whip"))),
        // The Reversal part cannot be used: the card is not typed as a Reversal.
        "Roll Up": (
            play_after: Some(All([Maneuver, DamageAtLeast(4)])),
            on_play: [If(condition: AnyOf([FortitudeLeadAtLeast(20), HandLargerBy(5)]), effects: [WinByPin])],
        ),
        "Standing Drop Kick": (
            requires: Some(AnyOf([Superstar("Jeff Hardy"), Superstar("Lita"), Superstar("Tajiri"), FirstCardThisTurn])),
        ),

        // Strikes
        "Abdominal Rake": (
            requires: Some(Not(InYourRing(Title("First to Tap Out Match")))),
            on_play: [
                Boost((
                    applies_to: AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]),
                    duration: NextCard,
                    irreversible: true,
                )),
            ],
            reverses: Some((
                targets: ManeuverType(Submission),
                requires: Some(Not(InYourRing(Title("First to Tap Out Match")))),
                effects: [
                    Boost((
                        applies_to: AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]),
                        duration: NextTurnFirstCard,
                        irreversible: true,
                    )),
                ],
            )),
        ),
        "Shoot Punch": (
            not_reversed_by: Some(Title("Step Aside")),
            on_removed_by_opponent: [Draw(who: You, n: 1), EndTurn],
        ),
        "Rapid-Fire Punches": (
            on_play: [Counted(count: YourRingMatching(TitleContains("punch")), effect: Mill(who: Opponent, n: 0))],
            reverses: Some((targets: All([Maneuver, TitleContains("suplex")]))),
        ),
        // Approximation: 3 random Backlash cards go to the Ringside pile.
        "Lariat Takedown": (
            not_packed_by: ["Female"],
            requires: Some(CountAtLeast(count: YourBacklashSize, n: 4)),
            on_play: [BacklashToRingside(who: You, n: 3, random: true), EndTurn],
        ),
        "Bionic Elbow": (
            play_after: Some(ManeuverType(Strike)),
            no_backlash_reversal: true,
            bonuses: [(when: Superstar("Buh-Buh Ray Dudley"), reversal_fortitude: 10)],
        ),

        // Grapples
        "Lock-up": (ring_ability: Some((sacrifice: true, effects: [Discard(who: Opponent, n: 1, pick: Chosen)]))),
        "Oklahoma Roll": (
            play_after: Some(Maneuver),
            reverses: Some((
                targets: All([
                    Maneuver,
                    AnyOf([After(Title("Throw Into the Corner Turnbuckle")), Title("Superplex")]),
                ]),
                from_hand_only: true,
            )),
        ),
        "Fall-Away Suplex": (while_in_ring: [(applies_to: All([Maneuver, TitleContains("suplex")]), damage: 1)]),
        "Single Leg Takedown": (
            on_play: [Search(filter: TitleContains("takedown"))],
            reverses: Some((targets: All([Maneuver, TitleContains("punch")]))),
        ),
        "Shoot Slam": (
            not_reversed_by: Some(Title("Escape Move")),
            on_removed_by_opponent: [LookAtHand(who: Opponent), Discard(who: Opponent, n: 1, pick: Controller)],
        ),
        "Corkscrew DDT": (reverses: Some((targets: All([Maneuver, After(Title("Irish Whip"))])))),
        "Bulldog Takedown": (
            play_after: Some(AnyOf([Title("Jockeying for Position"), Title("Gut Wrench")])),
            play_after_unless: Some(Superstar("Trish Stratus")),
            on_play: [RingsideToHand(who: You, n: 1)],
        ),
        "Rolling Headlock Vise": (not_packed_by: ["Female"]),
        "Slam Bomb": (on_play: [Discard(who: You, n: 1, pick: Chosen), Mill(who: You, n: 2)]),

        // Submissions
        "Body Scissors": (
            play_after: Some(Maneuver),
            not_reversed_by: Some(Title("Backlash!")),
            ring_ability: Some((sacrifice: true, effects: [LookAtHand(who: Opponent), EndTurn])),
        ),
        // Approximation: you play your cards as if you had your opponent's Fortitude, not 1 less.
        "Breather Hold": (on_play: [Boost((applies_to: Any, duration: ThisTurn, use_opponent_fortitude: true))]),
        // Blanking a chosen card in the opponent's Ring is not supported yet.
        "Waist Lock": (on_play: [NextCardMustBe(Not(Title("Maintain Hold")))]),
        "Shoot Headlock": (
            not_reversed_by: Some(Title("Break the Hold")),
            ringside_ability: Some((cost: [Discard(who: You, n: 2, pick: Chosen)], effects: [ReturnThis(to: Hand)])),
        ),
        "Sleeper Bomb": (
            play_after: Some(AnyOf([Title("Sleeper"), Title("Jockeying for Position"), Title("Gut Wrench")])),
            on_play: [EndTurn],
        ),
        "Flying Body Lock": (
            play_after: Some(All([Maneuver, DamageAtLeast(5)])),
            reverses: Some((targets: After(Trait(SetUp)))),
        ),

        // Reversals
        "Cartwheel": (reverses: Some((targets: Trait(SetUp), effects: [Mill(who: Opponent, n: 3)]))),
        // Telling hybrid cards apart while they are played is not supported yet.
        "Hold the Phone!": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // Completely reversing a Multi card with one Reversal is not supported yet.
        "Get the 'F' Out!": (
            reverses: Some((
                targets: AnyOf([
                    All([Maneuver, Trait(Unique), Not(ManeuverType(TrademarkFinisher))]),
                    Trait(Multi),
                ]),
            )),
        ),

        // Actions
        // Approximation: reverses cards that make the opponent discard; overturning cards is not checked.
        "He's as Crazy as a Pet Raccoon": (
            on_play: [DiscardAll(who: You, filter: Any)],
            reverses: Some((targets: ForcesDiscard)),
        ),
        "I'm Sorry, But You're Boring Me": (
            on_play: [RingsideToHand(who: You, n: 1, filter: Some(All([Maneuver, AnyOf([Action, Reversal])]))), EndTurn],
            reverses: Some((targets: Trait(SmackDown))),
        ),
        "Measure Him": (
            on_play: [Boost((applies_to: Maneuver, duration: NextCard, damage: 2))],
            in_ring_start_of_turn: [
                If(
                    condition: All([ReversedLastTurn(Any), YouReversedFrom([Hand])]),
                    effects: [Boost((applies_to: Maneuver, duration: NextCard, damage: 2))],
                ),
            ],
        ),
        "Not on My Broadcast!": (
            on_play: [RingsideToHand(who: You, n: 1, filter: Some(All([Maneuver, AnyOf([Action, Reversal])]))), EndTurn],
            reverses: Some((targets: Trait(Raw))),
        ),
        "Wanna Know What I'm Gonna Do?": (
            on_play: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 2, up_to: true, top: true)],
        ),
        // Tag Team symbol card: for 2-on-2 Tag Team format matches, which this game does not have.
        "Hot Tag!": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // The Stun Value Fortitude discount while in the Ring is not supported yet.
        "Back-and-Forth Action": (
            on_play: [RingsideToArsenal(who: You, n: 1, filter: Some(StunValueAtLeast(1))), Draw(who: You, n: 1)],
        ),
        "Fire Extinguisher": (
            play_after: Some(Title("Roll Out of the Ring")),
            on_play: [Search(filter: All([ManeuverType(Grapple), Not(Trait(Unique))]))],
            while_in_ring_all: [(applies_to: ManeuverType(Grapple), damage: 3)],
        ),
        "Caught Red-handed": (
            on_play: [
                OpponentChooses(
                    n: 1,
                    options: [
                        [
                            If(
                                condition: OpponentHandHas(Reversal),
                                effects: [DiscardMatching(who: Opponent, n: 1, filter: Reversal, pick: Chosen)],
                            ),
                            If(
                                condition: Not(OpponentHandHas(Reversal)),
                                effects: [Discard(who: Opponent, n: 3, pick: Random)],
                            ),
                        ],
                        [Discard(who: Opponent, n: 3, pick: Random)],
                    ],
                ),
            ],
        ),
        // Repeating the maneuver's damage, and being reversed as that maneuver, are not supported yet.
        "Gettin' Beat Like a Government Mule": (
            play_after: Some(All([AnyOf([ManeuverType(Strike), ManeuverType(Grapple)]), Not(Trait(Multi))])),
            on_play: [RepeatPreviousEffects],
        ),
        "Good Things Sometimes Happen": (
            while_in_ring: [
                (
                    applies_to: AnyOf([
                        Title("Flash in the Pan"),
                        Title("Pat and Gerry"),
                        Title("Call to the Crowd"),
                        Title("Referee Finally Catches Something"),
                        Title("Referee Finally Catches Something!"),
                        Title("Seeing Stars"),
                        Title("Give It All I Got"),
                        Title("Let's Pick Up the Pace"),
                    ]),
                    fortitude: -100,
                    irreversible: true,
                ),
            ],
        ),
        "It Pays to be Evil": (
            while_in_ring: [
                (
                    applies_to: AnyOf([
                        Title("Distract the Ref"),
                        Title("View of Villainy"),
                        Title("Deluding Yourself"),
                        Title("Bait Opponent"),
                        Title("Drawing Extra Heat"),
                        Title("Giving Away the Business"),
                        Title("Remove Corner Turnbuckle"),
                    ]),
                    fortitude: -100,
                    irreversible: true,
                ),
            ],
        ),
        "Here's a Ratings Booster!": (
            on_play: [
                Counted(count: OpponentFortitude, effect: Boost((applies_to: Any, duration: NextCard, fortitude: -1))),
            ],
        ),
        "Did I Just Say ... Three Minutes?": (
            on_play: [RemoveFromGame(who: Opponent, from: Ringside, n: 3, up_to: true, pick: Controller)],
        ),
        "One of a Kind": (
            on_play: [
                If(condition: Superstar("Rob Van Dam"), effects: [Search(filter: Any)]),
                If(condition: Not(Superstar("Rob Van Dam")), effects: [Search(filter: Trait(Unique))]),
            ],
        ),
        // Approximation: the -2D lasts for the rest of the match, even if the card leaves the Ring.
        // The Mid-match reversal part is not supported yet.
        "Defensive Stance": (
            on_play: [
                Choice([
                    [BoostOpponent((applies_to: ManeuverType(Strike), duration: Turns(50), damage: -2))],
                    [BoostOpponent((applies_to: ManeuverType(Grapple), duration: Turns(50), damage: -2))],
                    [BoostOpponent((applies_to: ManeuverType(Submission), duration: Turns(50), damage: -2))],
                    [BoostOpponent((applies_to: ManeuverType(HighRisk), duration: Turns(50), damage: -2))],
                ]),
            ],
        ),
        // Ending the opponent's turn when they move cards from their Ringside pile is not supported yet.
        "He's Runnin' Like a Scalded Dawg": (play_after: Some(Maneuver), requires: Some(FortitudeAboveOpponent)),
        // Approximation: the opponent's first 2 cards next turn are D: 0 if they are maneuvers.
        // Blanking their text is not supported yet.
        "Singapore Cane": (
            play_after: Some(Maneuver),
            on_play: [BoostOpponent((applies_to: Maneuver, duration: NextTurnCards(2), damage: -100))],
        ),

        // Pre-match
        "Don't You Usually Wrestle in Dark Matches?": (
            requires: Some(OpponentSuperstarValueAtMost(2)),
            restricts_opponent: Some((filter: AnyOf([TitleContains("McMahon"), Title("Here's a Ratings Booster!")]))),
        ),
        "Educated Feet": (while_in_ring: [(applies_to: All([Maneuver, TitleContains("kick")]), damage: 2)]),
        // Only the 6-card part; the discard to play Grapple or High Risk maneuvers is not supported yet.
        "Ring Psychology: Back": (
            restricts_opponent: Some((
                filter: All([
                    AnyOf([ManeuverType(Grapple), ManeuverType(HighRisk)]),
                    Holds(
                        OpponentRingHas(
                            filter: All([
                                AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]),
                                AnyOf([TitleContains("back"), TitleContains("power"), TitleContains("slam")]),
                            ]),
                            n: 6,
                        ),
                    ),
                ]),
            )),
        ),
        // Reversing by discarding a card from hand is not supported yet for a Ring card.
        "Ring Psychology: Neck": (requires: Some(Never)),
        // Approximation: it cannot be reversed from the Backlash deck either.
        "Unorthodox Style of Wrestling": (
            while_in_ring: [
                (applies_to: All([ManeuverType(HighRisk), After(ManeuverType(Submission))]), no_hand_reversal: true),
            ],
        ),
        "Lumberjack Match": (
            in_ring_on_play: [
                (
                    filter: AnyOf([
                        Title("Throw Opponent Out of the Ring"),
                        Title("Baseball Slide"),
                        Title("Giant Swing"),
                        Title("Over the Top Rope"),
                        All([Maneuver, After(Title("Irish Whip"))]),
                    ]),
                    effects: [Choice([[Discard(who: Opponent, n: 2, pick: Chosen)], [Mill(who: Opponent, n: 5)]])],
                ),
            ],
        ),
        // Drawing when the opponent moves cards from your Ring and stopping a coming pinfall are not
        // supported yet (only the Superstar Value part could be scripted).
        "Pay-Per-View Main Event": (requires: Some(Never)),
        // Adding text to the opponent's cards is not supported yet.
        "Raw or Smackdown - Pick a Brand!": (requires: Some(Never)),
        "Velocity": (
            ring_ability: Some((
                sacrifice: true,
                effects: [
                    If(
                        condition: CountAtMost(count: YourRingMatching(AnyOf([Trait(Raw), Trait(SmackDown)])), n: 5),
                        effects: [
                            Counted(
                                count: YourRingMatching(AnyOf([Trait(Raw), Trait(SmackDown)])),
                                effect: DrawUpTo(who: You, n: 0),
                            ),
                        ],
                    ),
                    If(
                        condition: CountAtLeast(count: YourRingMatching(AnyOf([Trait(Raw), Trait(SmackDown)])), n: 6),
                        effects: [DrawUpTo(who: You, n: 5)],
                    ),
                ],
            )),
        ),
        "Proper Conditioning": (
            ring_ability: Some((
                sacrifice: true,
                effects: [RingsideToHand(who: You, n: 3, up_to: true, filter: Some(Trait(SetUp)))],
            )),
        ),
        // Approximation: you pick the Backlash card from the whole Backlash deck.
        "I Aims ta be Startin' Sump'tin'": (
            on_play: [RemoveFromGame(who: Opponent, from: Arsenal, n: 1), BacklashToRingside(who: Opponent, n: 1)],
        ),
        // Blanking cards with McMahon in the title is not supported yet.
        "Managed by Eric Bischoff": (end_of_prematch: [Search(filter: Title("Did I Just Say ... Three Minutes?"))]),
        "Managed by Shane O'Mac": (
            requires: Some(Not(Superstar("Brothers of Destruction"))),
            in_ring_start_of_turn: [
                If(
                    condition: OpponentIs("Brothers of Destruction"),
                    effects: [RemoveFromGame(who: Opponent, from: Ringside, n: 2, up_to: true, pick: Controller)],
                ),
                If(
                    condition: Not(OpponentIs("Brothers of Destruction")),
                    effects: [
                        RemoveFromGame(
                            who: Opponent,
                            from: Ringside,
                            n: 2,
                            up_to: true,
                            filter: Some(AnyOf([Trait(Face), Trait(Heel)])),
                            pick: Controller,
                        ),
                    ],
                ),
            ],
        ),
        // Making your Title Belts Permanent is not supported yet.
        "I'm the Champ - Nothin's Gonna Change That!": (
            requires: Some(InYourRing(TitleBelt)),
            hand_size_bonus: 1,
        ),
        // A Pre-match card is in your Ring when its effects resolve, so the copies counted include this one;
        // each counted copy removes 4 cards.
        "My Sacrifice": (
            pre_match_limit: 2,
            on_play: [
                Counted(count: YourRingMatching(Title("My Sacrifice")), effect: RemoveFromGame(who: You, from: Arsenal, n: 0)),
                Counted(count: YourRingMatching(Title("My Sacrifice")), effect: RemoveFromGame(who: You, from: Arsenal, n: 0)),
                Counted(count: YourRingMatching(Title("My Sacrifice")), effect: RemoveFromGame(who: You, from: Arsenal, n: 0)),
                Counted(count: YourRingMatching(Title("My Sacrifice")), effect: RemoveFromGame(who: You, from: Arsenal, n: 0)),
                Counted(count: OpponentRingMatching(Title("My Sacrifice")), effect: RemoveFromGame(who: You, from: Arsenal, n: 0)),
                Counted(count: OpponentRingMatching(Title("My Sacrifice")), effect: RemoveFromGame(who: You, from: Arsenal, n: 0)),
                Counted(count: OpponentRingMatching(Title("My Sacrifice")), effect: RemoveFromGame(who: You, from: Arsenal, n: 0)),
                Counted(count: OpponentRingMatching(Title("My Sacrifice")), effect: RemoveFromGame(who: You, from: Arsenal, n: 0)),
            ],
        ),

        // Mid-match
        "You Can't Spell 'Furniture' Without F-U-N": (
            while_in_ring: [
                (applies_to: Title("Table! Table! Table!"), fortitude: -3, ignore_play_after: true),
                (applies_to: Title("Ladder in the Ring"), fortitude: -5, ignore_play_after: true),
                (applies_to: Title("Chair Shot"), reversal_fortitude: 4),
            ],
        ),
        // Approximation: the searched card may share a title with a card in your hand.
        "Check This Out!": (on_play: [RevealHand(who: You), Search(filter: Not(Trait(Unique)))]),
        "Desire": (
            on_play: [Discard(who: You, n: 1, pick: Chosen), Mill(who: You, n: 2)],
            ring_ability: Some((
                effects: [
                    Choice([
                        [
                            If(
                                condition: HandHas(ManeuverType(Strike)),
                                effects: [
                                    DiscardMatching(who: You, n: 1, filter: ManeuverType(Strike), pick: Chosen),
                                    RingsideToHand(who: You, n: 1, filter: Some(ManeuverType(Strike))),
                                ],
                            ),
                        ],
                        [
                            If(
                                condition: HandHas(ManeuverType(Grapple)),
                                effects: [
                                    DiscardMatching(who: You, n: 1, filter: ManeuverType(Grapple), pick: Chosen),
                                    RingsideToHand(who: You, n: 1, filter: Some(ManeuverType(Grapple))),
                                ],
                            ),
                        ],
                        [
                            If(
                                condition: HandHas(ManeuverType(Submission)),
                                effects: [
                                    DiscardMatching(who: You, n: 1, filter: ManeuverType(Submission), pick: Chosen),
                                    RingsideToHand(who: You, n: 1, filter: Some(ManeuverType(Submission))),
                                ],
                            ),
                        ],
                        [
                            If(
                                condition: HandHas(ManeuverType(HighRisk)),
                                effects: [
                                    DiscardMatching(who: You, n: 1, filter: ManeuverType(HighRisk), pick: Chosen),
                                    RingsideToHand(who: You, n: 1, filter: Some(ManeuverType(HighRisk))),
                                ],
                            ),
                        ],
                    ]),
                ],
            )),
        ),
        // Stopping Apply Illegal Leverage after the next card is not supported yet.
        "Dragged to the Center of the Ring": (
            on_play: [Boost((applies_to: ManeuverType(Submission), duration: NextCard, reversal_fortitude: 15))],
        ),
        // Playing the opponent's Trademark Finisher is not supported yet.
        "See How It Feels": (requires: Some(Never)),
        "Reap the Rewards": (
            requires: Some(Not(OpponentSuperstar("Kurt Angle"))),
            in_ring_on_play: [
                (whose: Some(Opponent), filter: AnyOf([Trait(Face), Trait(Heel)]), effects: [Draw(who: Opponent, n: 1)]),
                (
                    whose: Some(You),
                    filter: All([AnyOf([Trait(Face), Trait(Heel)]), Holds(Superstar("Kurt Angle"))]),
                    effects: [Draw(who: You, n: 1)],
                ),
            ],
        ),
        // Telling which cards remove cards from the Ring is not supported yet.
        "The Ref Got in the Way!": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // Playing before the Draw Segment is not supported yet.
        "Hold On! It's Not Time to Show Yet!": (requires: Some(Never)),
        "Human Suplex Machine": (
            play_after: Some(All([Maneuver, TitleContains("suplex")])),
            not_reversed_by: Some(Title("Backlash!")),
            on_play: [Search(filter: TitleContains("suplex"))],
        ),
        // Capping the opponent's damage from a Ring card is not supported yet.
        "Beg For Mercy": (requires: Some(Never)),
        "Justice for All": (
            requires: Some(AnyOf([Superstar("Kurt Angle"), All([SuperstarValueAtLeast(3), SuperstarValueAtMost(3)])])),
            on_play: [
                RingsideToArsenal(who: You, n: 3, up_to: true),
                DrawUpTo(who: You, n: 3),
                If(condition: Not(Superstar("Kurt Angle")), effects: [Discard(who: You, n: 3, pick: Chosen)]),
                Boost((applies_to: Maneuver, duration: NextCard, fortitude: -3, damage: 3)),
            ],
        ),
        "The King Interferes!": (
            reverses: Some((
                targets: AnyOf([
                    Keyword("Foreign Object"),
                    All([Maneuver, DamageAtLeast(10)]),
                    All([Maneuver, DamageAtLeast(6), Holds(OpponentIs("Female"))]),
                ]),
            )),
        ),
        "That's J.R.'s Animal Hat Trick, Folks!": (
            requires: Some(
                All([
                    InYourRing(Title("He's as Crazy as a Pet Raccoon")),
                    InYourRing(Title("Gettin' Beat Like a Government Mule")),
                    InYourRing(Title("He's Runnin' Like a Scalded Dawg")),
                ]),
            ),
            on_play: [WinByPin],
        ),
        // "Can only be reversed by cards that reverse Roll Out of the Ring or a card played after it" is not
        // supported yet.
        "Title Belt Clubberin'": (
            requires: Some(AnyOf([InYourRing(TitleBelt), CountAtLeast(count: OpponentRingMatching(TitleBelt), n: 1)])),
            play_after: Some(Title("Roll Out of the Ring")),
            on_play: [Discard(who: Opponent, n: 4, pick: Chosen)],
            reverses: Some((
                targets: After(Title("Roll Out of the Ring")),
                requires: Some(AnyOf([InYourRing(TitleBelt), CountAtLeast(count: OpponentRingMatching(TitleBelt), n: 1)])),
            )),
        ),

        // Big Freak'n Machine (Kane)
        "Freaks Are Cool!": (
            on_play: [
                Counted(
                    count: SuperstarValue,
                    effect: Boost((applies_to: All([Maneuver, Not(Trait(Unique))]), duration: ThisTurn, fortitude: -1)),
