// Hand-written scripts for Wrestlemania Tin cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// The WrestleMania Pay-Per-View Event is skipped by the importer (unknown card type).
(
    abilities: {
        // Superstar Value equal to the opponent's is not supported yet.
        // Approximation: the 3 extra cards of the Starting Hand are drawn at the end of the Pre-match phase.
        "Jerry Lawler": [
            EndOfPrematch([If(condition: OpponentFemale, effects: [Draw(who: You, n: 3)])]),
            Activated(
                cost: [],
                effects: [
                    Search(filter: AnyOf([Title("Piledriver"), Title("Puppies! Puppies!"), Title("Falling Fist")])),
                ],
            ),
            StartOfTurn([Boost((applies_to: Title("Puppies! Puppies!"), duration: ThisTurn, multi: true))]),
            CannotPlayMatching(Title("The King Interferes!")),
            OpponentCannotPlay("The King Interferes!"),
        ],
    },
    scripts: {
        // The Feud requirement, Pre-match Capacity, the Ringside trigger and the ACE save are not supported yet.
        "WrestleMania": (),
        // Actions
        "Absolutely Raw": (on_play: [Search(filter: All([Trait(Raw), Not(Trait(Unique))]), n: 2, up_to: true)]),
        // Approximation: the Ringside pile part is an ability used in your Main Segment right after you
        // successfully play a SmackDown card, instead of a trigger.
        "Ultimate Smackdown!": (
            on_play: [MoveCards(who: You, from: Removed, to: Hand, n: 1)],
            ringside_ability: Some((requires: Some(After(Trait(SmackDown))), effects: [ReturnThis(to: Hand)])),
        ),
    },
)
