// Hand-written scripts for V11: Undisputed (Raw Deal Virtual set 43) cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// "Counter" = you reversed a card to end your opponent's last turn and this is your first card this turn.
// "Promo: N" is approximated as `Dig`: you keep 1 of the top N cards and the rest go on the bottom of the Arsenal.
// "Bury" puts cards on the bottom of the Arsenal; "Stack" on top; "RFG" removes them from the game; "Recover"
// shuffles Ringside cards into the Arsenal.
// "Requirement: Allegiance: X" is approximated as being an X Superstar or having an X card in your Ring (for
// NXT: We Are Not Your Kind in your Ring).
// Not supported: face-down (Flipped) cards, cards put under Superstar or Backstage cards, Superstar cards packed
// in the Backstage Area (revealed / hidden Superstars), putting cards into the opponent's Backstage, Title Belt
// Superstar lists, Starting Hand Size, "cannot be blanked" and packing permissions printed on Superstar cards.
// Reversals of Activated Card Effects use `reverses_ace`, of cards after they were successfully played
// `after_success`. Trait names ("Rookie", "NXT") are not used in `not_packed_by` (they break auto decks).
(
    abilities: {
        // Playing RFG cards as if from hand, the 8D- damage replacement and the RFG limit are not supported yet.
        // Approximation: he may pack every Bray Wyatt card (not only maneuvers).
        "The Fiend": [
            PacksLogos(["Bray Wyatt"]),
            CannotPack("Counterproductive Ambitions"),
            CannotPack("Wrestlemania"),
        ],
        // Playing 'Choke' maneuvers from Ringside, the packing permissions and the flip protection are not
        // supported yet.
        "Shayna Baszler": [
            StartOfTurn([
                Choice([
                    [Boost((applies_to: ManeuverType(Submission), duration: ThisTurn, fortitude: -3))],
                    [Boost((applies_to: ManeuverType(Submission), duration: ThisTurn, damage: 3))],
                ]),
            ]),
        ],
        // The Spectacular Ring Entrance! Backstage texts are not supported yet.
        "Robert Roode": [
            Activated(
                requires: Some(CountAtLeast(count: YourRingMatching(TitleContains("Glorious")), n: 1)),
                cost: [],
                effects: [
                    Choice([
                        [
                            Counted(
                                count: Half(Plus(YourRingMatching(TitleContains("Glorious")), Const(1))),
                                effect: RemoveFromGame(who: Opponent, from: Ringside, n: 0),
                            ),
                        ],
                        [Counted(count: Half(Plus(YourRingMatching(TitleContains("Glorious")), Const(1))), effect: Draw(who: You, n: 0))],
                    ]),
                ],
            ),
            CannotPack("Thrust Knee Lift"),
            CannotPack("Lethal nWo Poison"),
        ],
        // Sit Right Here and Bide My Time changes and the Backstage-only packing are not supported yet.
        "Aleister Black": [
            StartOfTurn([Boost((applies_to: SuperstarSpecific, duration: ThisTurn, reversal_fortitude: 6))]),
            CannotPack("Wrestlemania"),
        ],
        // Ending the turn after the opponent's 11D+ card is not supported yet.
        "The Iiconics": [
            Activated(
                once_per_game: true,
                cost: [Mill(who: You, n: 11)],
                effects: [RingsideToArsenal(who: You, n: 11, up_to: true)],
            ),
            CannotPackMatching(DamageAtLeast(11)),
        ],
        // Hidden Superstar cards in the Backstage are not supported yet. Approximation: Undisputed Era counts as
        // all four members (as if they were revealed); "completely reverse" is any reversal.
        "Undisputed Era": [
            CountsAs(["Adam Cole", "Roderick Strong", "Kyle O'Reilly", "Bobby Fish"]),
            OnYouReverse([
                If(
                    condition: YouReversedFrom([Hand, Backlash]),
                    effects: [Optional([Discard(who: You, n: 1, pick: Chosen), Dig(n: 3, take: 1)])],
                ),
            ]),
        ],
        // Playing reversals as if hybrid / Unique / from Backlash and the Redemption blank are not supported yet
        // (Promo already puts the cards not chosen on the bottom of the Arsenal).
        "Adam Cole": [],
        // Putting 0 cards into hand for a Ringside Search is not supported yet.
        "Roderick Strong": [
            OnYouReverse([If(condition: YouReversedFrom([Hand]), effects: [Optional([Dig(n: 2, take: 1)])])]),
        ],
        // The logo cards print "Kyle O'Reilly".
        "Kyle O' Reilly": [
            CountsAs(["Kyle O'Reilly"]),
            Activated(
                requires: Some(HandHas(AnyOf([ManeuverType(Strike), ManeuverType(Submission)]))),
                cost: [DiscardMatching(who: You, n: 1, filter: AnyOf([ManeuverType(Strike), ManeuverType(Submission)]), pick: Chosen)],
                effects: [
                    Dig(n: 3, take: 1),
                    MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, bottom: true),
                ],
            ),
        ],
        // Changing his Promo results is not supported yet.
        "Bobby Fish": [],
    },
    scripts: {
        // ================================================================ Pre-match
        // Packing it in the Backstage, cards under it and its ACE are not supported yet.
        "Sit Right Here and Bide My Time": (requires: Some(Never)),
        // Choosing a brand for your cards is not supported yet.
        "Raw or SmackDown! - Pick a Brand!": (requires: Some(Never)),
        // The brand packing ban and the ACE are not supported yet.
        "We Are Not Your Kind": (
            not_with: ["From NXT to WWE", "NXT Arrival"],
            frees_slots: Some(AnyOf([All([Keyword("NXT"), Trait(MidMatch)]), All([Keyword("NXT"), Not(Trait(MidMatch)), Not(Keyword("Object"))])])),
        ),
        // The Rookie packing ban, the protection from opponent effects, the Venue condition and the ACE are not
        // supported yet. Approximation: shuffle up to 3 cards from your hand and draw that many +1.
        "NXT Takeover": (
            requires: Some(AnyOf([YouAre("NXT"), InYourRing(Title("We Are Not Your Kind"))])),
            end_of_prematch: [Mulligan(n: 3), Draw(who: You, n: 1)],
        ),
        // The Rookie packing ban and the printed D:10+ reversal part are not supported yet.
        "Mauro Ranallo: The Voice of NXT": (
            requires: Some(AnyOf([YouAre("NXT"), InYourRing(Title("We Are Not Your Kind"))])),
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: All([Maneuver, DamageAtLeast(10)]),
                    effects: [
                        RingsideToArsenal(who: You, n: 2, up_to: true),
                        If(condition: InYourRing(Title("NXT Takeover")), effects: [Optional([Dig(n: 2, take: 1)])]),
                    ],
                ),
                (whose: Some(You), filter: All([ManeuverType(HighRisk), DamageAtLeast(10)]), effects: [RingsideToArsenal(who: You, n: 1, up_to: true)]),
            ],
        ),
        // The You're Just Developmental packing rule: NXT Superstars are not excluded (trait names break auto
        // decks). Approximation: the discard happens at the end of the Pre-match phase. The ACE is not supported yet.
        "You're Just Developmental": (
            not_with: ["I'm Gonna Break You"],
            end_of_prematch: [
                Counted(
                    count: Half(OpponentRingMatching(All([Keyword("NXT"), Not(SuperstarSpecific)]))),
                    effect: Discard(who: Opponent, n: 0, pick: Chosen),
                ),
            ],
        ),
        // Smackdown Allegiance changes and the This is Just the Beginning texts are not supported yet.
        "Are You Ready For a Good Time?": (
            requires: Some(Never),
            not_packed_by: ["Eddie Guerrero"],
            not_with: ["Boston, Massachusetts", "Backed by Smackdown GM Vickie Guerrero"],
        ),
        // "Can only be packed when packing The Era of the Superstar" and the Counter bonus are not supported yet.
        "Raw Women’s Championship Belt": (
            value_bonus: 1,
            on_you_reverse: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, filter: Some(Maneuver), bottom: true)],
            while_in_ring: [(applies_to: Title("Everyone Wants to Watch Women Wrestle"), multi: true)],
        ),
        // "Can only be packed when packing The Era of the Superstar" is not supported yet.
        "Smackdown Women’s Championship Belt": (
            value_bonus: 1,
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: Maneuver,
                    effects: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, filter: Some(Action), bottom: true)],
                ),
                (whose: Some(You), filter: Trait(SetUp), effects: [Boost((applies_to: Maneuver, duration: NextCard, damage: 2))]),
            ],
            while_in_ring: [(applies_to: Title("Everyone Wants to Watch Women, Period"), multi: true)],
        ),
        // Approximation: the named Superstars draw 1 more card (up to 2 in all).
        "WWE Women's Tag Team Title Belts": (
            only_packed_by: ["Female"],
            end_of_prematch: [
                Draw(who: You, n: 1),
                If(
                    condition: AnyOf([
                        Superstar("Alexa Bliss"),
                        Superstar("Asuka"),
                        Superstar("Bayley"),
                        Superstar("Nikki Cross"),
                        Superstar("Kairi Sane"),
                        Superstar("Sasha Banks"),
                        Superstar("The Iiconics"),
                    ]),
                    effects: [DrawUpTo(who: You, n: 1)],
                ),
                HandToArsenalBottom(who: You, n: 1),
                MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, bottom: true),
            ],
        ),
        // Packing as if not Heat and the I Want to Play the Game / In The Interest of Fairness texts are not
        // supported yet.
        "You Don't Want to Play Me": (
            ring_ability: Some((
                sacrifice: true,
                effects: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, filter: Some(All([Maneuver, Not(Hybrid)])), bottom: true)],
            )),
        ),
        // Letting the opponent overturn 0 for your other effects is not supported yet.
        "A Puncher's Chance": (
            not_with: ["Very European", "Brass 'Nuks' Shot"],
            on_opponent_reverses: [
                If(
                    condition: OpponentReversed(All([
                        ManeuverType(Strike),
                        Not(Trait(Chain)),
                        Not(Keyword("Volley")),
                        Not(Keyword("RMS")),
                        AnyOf([TitleContains("Punch"), TitleContains("Fist"), TitleContains("Hook"), TitleContains("Uppercut"), TitleContains("Haymaker"), TitleContains("Jab")]),
                    ])),
                    effects: [
                        Counted(
                            count: AtMost(
                                YourRingsideMatching(AnyOf([TitleContains("Punch"), TitleContains("Fist"), TitleContains("Hook"), TitleContains("Uppercut"), TitleContains("Haymaker"), TitleContains("Jab")])),
                                3,
                            ),
                            effect: Mill(who: Opponent, n: 0),
                        ),
                    ],
                ),
            ],
        ),
        // Extra Heat maneuvers from Ringside, the Active / Permanent changes and the Volley texts are not supported yet.
        "Heated Exchange": (requires: Some(Never)),
        // The Unique packing change and protecting I Have a Major Announcement's Activated Card Effect are not
        // supported yet.
        "And the Crowd goes Wild!": (
            requires: Some(InYourRing(Title("I Have a Major Announcement"))),
            on_opponent_reverses: [
                If(
                    condition: OpponentReversed(All([Maneuver, Not(Trait(Unique)), Not(SuperstarSpecific)])),
                    effects: [Optional([ReversedCardTo(to: Arsenal, bottom: true)])],
                ),
            ],
        ),
        // The Venue / Feud packing bans, Title Belt texts and the Fan Favorite / Cheater changes are not supported yet.

        // ================================================================ Mid-match
        // Approximation: the Unique maneuver may go to the hand of an NXT Superstar. "Can only be packed when
        // packing We Are Not Your Kind" and playing it from Ringside are not supported yet.
        "THIS IS AWESOME!": (
            not_with: ["Wrestlemania"],
            requires: Some(All([FortitudeAtLeast(25), CountAtLeast(count: OpponentFortitude, n: 25)])),
            on_play: [
                RingsideToArsenal(who: You, n: 5, up_to: true, filter: Some(Trait(Unique))),
                RingsideToArsenal(who: Opponent, n: 5, up_to: true, filter: Some(Trait(Unique))),
                If(condition: YouAre("NXT"), effects: [RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Maneuver, Trait(Unique)])))]),
                If(condition: OpponentIs("NXT"), effects: [RingsideToHand(who: Opponent, n: 1, up_to: true, filter: Some(All([Maneuver, Trait(Unique)])))]),
            ],
        ),
        "Topé Suicida": (
            requires: Some(AnyOf([YouAre("NXT"), InYourRing(Title("We Are Not Your Kind"))])),
            from_ringside: Some(InYourRing(Title("High-Flying Style"))),
            play_after: Some(AnyOf([All([Maneuver, DamageAtLeast(2)]), Holds(InYourRing(Title("High-Flying Style")))])),
            on_play: [
                Counted(
                    count: Half(YourRingMatching(Keyword("NXT"))),
                    effect: MoveCards(who: You, from: Removed, to: Arsenal, n: 0, up_to: true, bottom: true),
                ),
            ],
        ),
        // Playing it from hand after your maneuver's damage is not supported yet.
        "Mamma Mia!": (requires: Some(Never)),
        // The Raw discard to make it irreversible is not supported yet.
        "Everyday I'll Fight to Be Legendary": (
            requires: Some(AnyOf([YouAre("Raw"), InYourRing(Trait(Raw))])),
            on_play: [MoveCards(who: You, from: Removed, to: Arsenal, n: 20, up_to: true, filter: Some(TitleContains("Coach")))],
            on_opponent_reverses: [If(condition: OpponentReversed(Maneuver), effects: [Optional([SacrificeThis, ContinueTurn])])],
        ),
        // Reversal restrictions from cards and the Heat Ringside texts are not supported yet.
        "Heated Defense": (
            reverses: Some((
                targets: All([Maneuver, AnyOf([Trait(Chain), Keyword("Volley")])]),
                requires: Some(InYourRing(Keyword("Heat"))),
            )),
        ),
        // Feuds are not supported yet.
        "Cole Calls it Right!": (requires: Some(Never)),
        // Cards listed on I Have a Major Announcement, reversing by maneuver type in your Ring and the Pinfall
        // win are not supported yet.
        "Sending the Crowd Home Happy": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // Approximation: F: 0 when your opponent has F: 12+; "a card has been put into any Ring this turn" is
        // read as always true. Choosing D: 0 / +3D for your reversals and the overturn cost are not supported yet.
        "No I Won't Give In, I Won't Give In": (
            reverses: Some((targets: Any, fortitude_when: Some((CountAtLeast(count: OpponentFortitude, n: 12), 0)))),
            while_in_ring: [(applies_to: Maneuver, damage: 3)],
        ),

        // ================================================================ Strikes, Grapples, Submissions, High Risk
        // Being a Trademark Finisher is not supported yet.
        "Superkick": (
            bonuses: [(when: BackstageRevealed(who: You, filter: All([SuperstarSpecific, TitleContains("Kick")])), fortitude: 10, damage: 10)],
        ),
        // "Can be reversed as if non-Unique" is not supported yet.
        "Classic Judo Chop": (
            on_play: [
                Choice([
                    [BacklashToRingside(who: Opponent, n: 1, random: true)],
                    [CannotPlay(who: Opponent, filter: All([Maneuver, Not(Trait(Unique))]), turns: 1)],
                ]),
            ],
        ),
        // "Can be reversed as if non-Unique" and the Heat text are not supported yet.
        "Classic Snap Suplex": (
            on_play: [Search(filter: AnyOf([TitleContains("Classic"), TitleContains("Suplex")]))],
            ringside_ability: Some((
                requires: Some(HandHas(All([Maneuver, AnyOf([TitleContains("Classic"), TitleContains("plex")])]))),
                cost: [DiscardMatching(who: You, n: 1, filter: All([Maneuver, AnyOf([TitleContains("Classic"), TitleContains("plex")])]), pick: Chosen)],
                effects: [ReturnThis(to: Hand)],
            )),
        ),
        // "Can be reversed as if non-Unique" and counting as Press Slam are not supported yet.
        "Classic Gorilla Press Slam": (
            on_play: [Choice([[RemoveFromRing(who: Opponent, n: 1, filter: Any)], [RemoveFromRing(who: You, n: 1, filter: Any)]])],
        ),
        // Approximation: the top 3 cards of his Arsenal are removed (not the bottom 3). The Pinfall text is not
        // supported yet.
        "School Boy": (
            on_play: [RemoveFromGame(who: Opponent, from: Arsenal, n: 3)],
            reverses: Some((targets: AnyOf([ManeuverType(Submission), All([Maneuver, Trait(SmackDown), Not(SuperstarSpecific)])]))),
        ),
        "Suplex on the Apron": (
            play_after: Some(All([Maneuver, DamageAtLeast(5)])),
            play_after_unless: Some(AnyOf([InYourRing(Title("Roll Out of the Ring")), OpponentRingHas(filter: Title("Roll Out of the Ring"), n: 1)])),
            reversal_limits: [
                (from: [Hand, Backlash, Ringside, Ring, Under], when: CountAtLeast(count: Plus(YourRingMatching(Maneuver), OpponentRingMatching(Maneuver)), n: 10)),
            ],
        ),
        // Being a Trademark Finisher is not supported yet.
        "Apron Bomb": (
            requires: Some(AnyOf([
                All([ReversedLastTurn(Any), FirstCardThisTurn, YouReversedFrom([Arsenal])]),
                InYourRing(Title("Roll Out of the Ring")),
                OpponentRingHas(filter: Title("Roll Out of the Ring"), n: 1),
            ])),
            on_play: [Discard(who: You, n: 2, pick: Chosen), Discard(who: Opponent, n: 5, pick: Chosen)],
        ),
        // Approximation: the Grapple's damage is doubled and your turn ends (counting as Roll Out of the Ring and
        // removing this card are not supported yet).
        "Remove the Padding": (
            not_packed_by: ["Shinsuke Nakamura"],
            on_play: [Boost((applies_to: ManeuverType(Grapple), duration: NextMatching, double_damage: true, end_turn: true))],
        ),
        // Playing it with Blindside maneuvers and the 'Blindside' texts are not supported yet.
        "Blindside Aggression": (requires: Some(Never)),
        // Approximation: any non-Unique card while That's Value! is in your Ring (the card counts and the
        // searches are not supported yet).
        "Your Trash is My Treasure": (reverses: Some((targets: Not(Trait(Unique)), requires: Some(InYourRing(Title("That's Value!")))))),
        // Reversing as if D: 0 and counting as 2 reversals are not supported yet.
        "Counter Hold": (
            not_with: ["A Revolution of the Mind", "Legendary Defense"],
            reverses: Some((targets: AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]))),
        ),
        "Counter Assault": (
            not_with: ["A Revolution of the Mind", "Legendary Defense"],
            reverses: Some((targets: AnyOf([ManeuverType(Strike), ManeuverType(Submission)]))),
        ),
        "Counter Throw": (
            not_with: ["A Revolution of the Mind", "Legendary Defense"],
            reverses: Some((targets: AnyOf([ManeuverType(Strike), ManeuverType(Grapple)]))),
        ),

        // ================================================================ Raw / Smackdown
        // No reversal target is printed. Not supported yet.
        "Interrupted by the Anonymous Raw GM": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // Counting as non-Unique for Raw effects is not supported yet.
        "Through the Raw Announce Table": (
            requires: Some(AnyOf([YouAre("Raw"), InYourRing(Trait(Raw))])),
            play_after: Some(Maneuver),
            play_after_unless: Some(AnyOf([InYourRing(Title("Roll Out of the Ring")), OpponentRingHas(filter: Title("Roll Out of the Ring"), n: 1)])),
        ),
        // The Allegiance activation texts are not supported yet. Approximation: the bonus is for your next High Risk.
        "Smack You Down": (
            requires: Some(AnyOf([YouAre("Smackdown"), InYourRing(Trait(SmackDown))])),
            on_play: [
                NextPlayWatch(
                    filter: ManeuverType(HighRisk),
                    on_success: [Counted(count: YourRingMatching(All([Trait(SmackDown), Not(Trait(SetUp))])), effect: Mill(who: Opponent, n: 0))],
                ),
            ],
        ),

        // ================================================================ The Fiend
        // Cards under this card and removing Multi are not supported yet.
        "The Fiend’s Lantern": (),
        // The Backstage Pinfall, the Promo for the opponent and revealing your hand are not supported yet.
        "Let Me In": (),
        // The Starting Hand Size, the RFG replacement and the overturn cost are not supported yet.
        "The Firefly Fun House": (requires: Some(Never)),
        // Putting cards into the opponent's Backstage is not supported yet.
        "We're Really Glad That You're Our Friend!": (requires: Some(Never)),
        // RFG Ring cards for effects and the Mandible Claw restriction are not supported yet.
        "Hurt / Heal": (reverses: Some((targets: Any, effects: [Search(filter: Title("Mandible Claw"))]))),
        // Putting it into the opponent's Backstage and the unsuccessful text are not supported yet.
        "Rambling Rabbit": (on_play: [MoveCards(who: You, from: Removed, to: Arsenal, n: 6, up_to: true)]),
        // Putting cards into the opponent's Backstage is not supported yet.
        "Abby the Witch": (requires: Some(Never)),
        // Approximation: the opponent's Ability is blank while this card is in your Ring. The ACE is not
        // supported yet.
        "Vince McBossman": (blanks_opponent_ability: true),
        // Putting cards into the opponent's Backstage is not supported yet.
        "Huskus the Pig Boy": (requires: Some(Never)),
        // Putting cards into the opponent's Backstage is not supported yet.
        "Mercy the Buzzard": (requires: Some(Never)),
        // An action that reverses and putting it into the opponent's Backstage are not supported yet.
        "Yowie Wowie!": (requires: Some(Never)),

        // ================================================================ Shayna Baszler
        // Missing: the next maneuver being a Submission with blank text, the unsuccessful text and the Title Belt
        // text.
        "The Submission Magician": (
            backstage_ability: Some((
                requires: Some(CountAtLeast(count: YourRingMatching(ManeuverType(Submission)), n: 1)),
                cost: [FlipDown(who: You, n: 1, filter: Some(ManeuverType(Submission)))],
                effects: [Boost((applies_to: Maneuver, duration: NextCard, end_turn: true))],
            )),
        ),
        "The Queen of Spades": (
            no_slot: true,
            end_of_prematch: [MoveCards(who: You, from: Backlash, to: Ring, n: 1, up_to: true, filter: Some(Title("Drawing a Blank")))],
            // The second ACE (flip face-down to blank his card) is not supported yet.
            ring_ability: Some((
                requires: Some(CountAtMost(count: YourFortitude, n: 12)),
                effects: [Search(filter: ManeuverType(Submission), n: 2, up_to: true), ReturnThis(to: Removed)],
            )),
        ),
        // The Asuka F: 0, the unsuccessful text, the Backstage-listed maneuvers and the Ringside text are not
        // supported yet.
        "The Most Dominant Woman in NXT": (
            irreversible: true,
            while_in_ring: [(applies_to: All([Maneuver, TitleContains("Choke")]), damage: 3, stun_value: 1)],
        ),
        // "Only reversed by 'completely' cards" for the next Maintain Hold is not supported yet.
        "Kirifuda Clutch": (
            reversal_limits: [(from: [Arsenal], when: CountAtLeast(count: YourRingMatching(All([Maneuver, TitleContains("Choke")])), n: 5))],
            after_damage: [Boost((applies_to: Title("Maintain Hold"), duration: NextCard, ignore_play_after: true))],
        ),
        // "Your opponent cannot prevent you from playing this card" is not supported yet.
        "Shayna's Cross-Arm Breaker": (
            after_damage: [If(condition: CountAtLeast(count: YourRingMatching(All([Maneuver, TitleContains("Arm")])), n: 6), effects: [WinByPin])],
        ),
        // Playing it from Ringside when you have not played an action this turn is not supported yet.
        "Shayna's Leg Bar": (as_action: Some((on_play: [RingsideToHand(who: You, n: 1, filter: Some(Maneuver)), DiscardThis]))),
        // Approximation: it is always Multi as a maneuver (blanking is not checked).
        "Shayna's Shoot Kick to the Face": (bonuses: [(damage: 3)], multi_when: Some(Always)),
        "Twisted Arm Stomp": (
            reversal_limits: [(from: [Hand, Backlash], when: After(All([Maneuver, AnyOf([TitleContains("Choke"), TitleContains("Finger")])])))],
            on_play: [Counted(count: YourRingMatching(All([Maneuver, TitleContains("Arm")])), effect: Discard(who: Opponent, n: 0, pick: Chosen))],
        ),
        // The unsuccessful text is not supported yet.
        "The Queen's Army": (
            on_play: [
                Counted(
                    count: AtMost(Plus(YourRingMatching(ManeuverType(Submission)), YourFaceDown), 8),
                    effect: Discard(who: Opponent, n: 0, pick: Chosen),
                ),
            ],
        ),
        "Tap, Nap or Snap?": (
            on_play: [
                Search(filter: ManeuverType(Submission), ringside: true),
                Boost((applies_to: ManeuverType(Submission), duration: NextCard, no_reversal_from: [Hand, Backlash, Ringside, Ring, Under])),
                Counted(
                    count: Plus(YourRingMatching(ManeuverType(Submission)), YourFaceDown),
                    effect: MoveCards(who: You, from: Ringside, to: Arsenal, n: 0, up_to: true, pick: Random, bottom: true),
                ),
            ],
            reverses: Some((targets: Not(Maneuver))),
        ),
        // Counting as two reversals is not supported yet.
        "The Four Horsewomen of MMA": (),

        // ================================================================ Robert Roode
        // Moving this card between zones is not supported yet.
        "GLORIOUS!": (),
        // The Chain discard texts and using it as a reversal are not supported yet.
        "Off the Chain": (),
        // Approximation: once per turn you may put up to 2 Hand cards under this card (not only when revealing
        // your hand); you may play them as if from hand. Starting the game, the Spectacular Ring Entrance! text
        // and the ACE are not supported yet.
