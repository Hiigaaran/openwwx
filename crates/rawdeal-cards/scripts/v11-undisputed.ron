        "Sassy Bronco Buster": (
            play_after: Some(AnyOf([All([Maneuver, DamageAtLeast(5)]), Title("Throw Into the Corner Turnbuckle")])),
            play_after_unless: Some(All([ReversedLastTurn(Maneuver), FirstCardThisTurn])),
            reversal_limits: [(from: [Hand]), (from: [Backlash], when: After(Maneuver))],
            bonuses: [(when: All([ReversedLastTurn(Maneuver), FirstCardThisTurn]), fortitude: -3)],
            on_play: [Discard(who: Opponent, n: 3, pick: Chosen)],
        ),

        // Yokozuna
        // The packing permissions and the Managed by Mr. Fuji texts are not supported yet.
        "The Salt Ceremony": (),
        // The Ability change, the Samoan Drop title and the reversal discard cost are not supported yet.
        "Victorious Villany": (
            backstage_abilities: [
                DamageFor(filter: Maneuver, delta: 2),
                OnOpponentReverses([
                    If(
                        condition: OpponentReversed(All([Maneuver, Trait(Unique)])),
                        effects: [RingsideToHand(who: You, n: 1, up_to: true, filter: Some(Trait(Unique)))],
                    ),
                ]),
            ],
        ),
        "Yokozuna's Nerve Hold": (
            reversal_limits: [(from: [Hand], when: All([ReversedLastTurn(Any), FirstCardThisTurn]))],
            after_damage: [Discard(who: Opponent, n: 1, pick: Random), Boost((applies_to: Maneuver, duration: NextMatching, irreversible: true))],
            reverses: Some((
                targets: AnyOf([ManeuverType(Strike), ManeuverType(Grapple)]),
                effects: [Discard(who: Opponent, n: 1, pick: Random), Boost((applies_to: Maneuver, duration: NextTurnFirstCard, irreversible: true))],
            )),
        ),
        "Yokozuna's Savate Kick": (
            on_play: [DrawUpTo(who: You, n: 2), Discard(who: Opponent, n: 2, pick: Chosen)],
            after_damage: [Search(filter: Any)],
            as_action: Some((
                fortitude: Some(5),
                on_play: [
                    ThisToArsenal(bottom: true),
                    MoveCards(who: You, from: Ringside, to: Arsenal, n: 2, up_to: true, bottom: true),
                    Search(filter: Any),
                ],
            )),
            reverses: Some((targets: AnyOf([Action, ManeuverType(Grapple)]), effects: [Search(filter: Any)])),
        ),

        // Camp Cornette (British Bulldog, Owen Hart, Vader, Yokozuna, Jim Cornette)
        // The WWF Classic trait and ignoring play-after texts are not supported yet.
        "Camp Cornette": (
            not_with: ["The Hart Family", "Strength of Allied Powers", "Managed by Harley Race"],
            in_ring_on_play: [
                (whose: Some(You), filter: TitleContains("Interfere"), effects: [DrawUpTo(who: You, n: 1), Discard(who: Opponent, n: 1, pick: Random)]),
            ],
        ),
        // The Starting Hand Sizes, the Activated reversal cost, the 'Classic' titles and Classic Distraction are
        // not supported yet.
        "Managed by Jim Cornette": (pre_match_limit: 2),
        // Returning it to the Backlash is not supported yet.
        "Cornette's Ringside Support": (
            requires: Some(InYourRing(Title("Camp Cornette"))),
            on_play: [
                RingsideToHand(who: You, n: 2, up_to: true, filter: Some(All([Maneuver, Not(Hybrid)]))),
                MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 2, pick: Random, bottom: true),
                Draw(who: Opponent, n: 1),
            ],
        ),
        // The -7F with Camp Cornette is not supported for the action.
        "Cornette's Motivational Speech": (
            requires: Some(AnyOf([Superstar("Jim Cornette"), Superstar("Yokozuna"), InYourRing(Title("Camp Cornette"))])),
            reversal_limits: [(when: InYourRing(Title("Camp Cornette")), by: Some(Not(Trait(Unique))))],
            on_play: [RingsideToArsenal(who: You, n: 4, up_to: true), DrawUpTo(who: You, n: 3), RingsideToHand(who: You, n: 1)],
            reverses: Some((
                targets: Action,
                requires: Some(AnyOf([Superstar("Jim Cornette"), Superstar("Yokozuna"), InYourRing(Title("Camp Cornette"))])),
                fortitude_when: Some((InYourRing(Title("Camp Cornette")), 5)),
                effects: [RingsideToHand(who: You, n: 1)],
            )),
        ),
        "Cornette Interferes": (
            reverses: Some((
                targets: Not(SuperstarSpecific),
                requires: Some(AnyOf([Superstar("Jim Cornette"), Superstar("Yokozuna"), InYourRing(Title("Camp Cornette"))])),
                fortitude_when: Some((InYourRing(Title("Camp Cornette")), 8)),
                effects: [Mill(who: Opponent, n: 2)],
            )),
        ),

        // Shelton Benjamin
        // Approximation: only when your opponent makes you discard it (the random Ringside card is not supported).
        "Paydirt": (
            bonuses: [(when: All([ReversedLastTurn(Any), FirstCardThisTurn]), fortitude: -5)],
            on_forced_discard: [Optional([ThisToArsenal(bottom: true)])],
        ),

        // Charlotte
        // Becoming a Trademark Finisher at 40F+ is not supported yet.
        "Charlotte's Spear": (
            bonuses: [(fortitude: -20, damage: 5)],
            not_reversed_by: Some(Hybrid),
            on_play: [Discard(who: Opponent, n: 2, pick: Random)],
            reverses: Some((
                targets: AnyOf([All([Maneuver, Not(Trait(Unique))]), All([Action, Not(SuperstarSpecific)])]),
                effects: [Discard(who: Opponent, n: 2, pick: Random)],
            )),
        ),

        // Kevin Owens
        // The Ringside bury is not supported yet.
        "KO's Stunner": (bonuses: [(when: After(Maneuver), fortitude: -5, damage: 5)]),

        // Bam Bam Bigelow
        // The ECW / WCW / Allegiance texts are not supported yet.
        "A Triple Threat": (),
        // Returning it to the Ring and the Ability texts are not supported yet.
        "The Flamed Wonder": (
            reverses: Some((targets: AnyOf([All([Maneuver, Not(Trait(Unique))]), All([Action, Trait(Unique)])]))),
            while_in_ring: [(applies_to: All([Maneuver, TitleContains("Classic")]), stun_value: 1)],
        ),
        // Counting as a Foreign Object and the Greetings From Asbury Park text are not supported yet.
        "Bigelow's Double Underhook Backbreaker": (on_play: [HandToArsenalBottom(who: Opponent, n: 2)]),
        "Backed by Luna Vachon": (
            bonuses: [(count: Some(YourRingStun), fortitude: -1)],
            on_play: [
                Counted(count: YourRingStun, effect: RingsideToArsenal(who: You, n: 0, up_to: true)),
                MoveCards(who: You, from: Removed, to: Arsenal, n: 3, up_to: true),
                DrawUpTo(who: You, n: 2),
            ],
            ring_ability: Some((effects: [Counted(count: AtMost(YourRingStun, 8), effect: Mill(who: Opponent, n: 0)), ReturnThis(to: Removed)])),
        ),

        // Viscera
        // The first-turn reveal and hiding this card are not supported yet.
        "The Quarter-Ton Titan": (
            backstage_abilities: [EndOfPrematch([Search(filter: All([Maneuver, Not(Trait(Unique)), Not(Hybrid)]), n: 2, up_to: true)])],
        ),
        // Playing it from Ringside and the Ring texts are not supported yet.
        "Eviscerating Chop": (
            not_reversed_by: Some(Title("Elbow to the Face")),
            on_play: [Draw(who: You, n: 2), HandToArsenal(who: Opponent, n: 1)],
        ),
        // Becoming a Trademark Finisher is not supported yet.
        "Big Daddy V Drop": (
            bonuses: [(when: FortitudeAtLeast(30), damage: 10)],
            on_play: [RemoveFromGame(who: Opponent, from: Hand, n: 2, pick: Random), RemoveFromGame(who: Opponent, from: Arsenal, n: 2)],
            ringside_ability: Some((
                effects: [
                    ReturnThis(to: Arsenal),
                    RingsideToArsenal(who: You, n: 1, up_to: true),
                    RingsideToHand(who: You, n: 1, up_to: true, filter: Some(Trait(SetUp))),
                ],
            )),
        ),
        "The Ghetto Drop": (
            bonuses: [(fortitude: -6)],
            reversal_limits: [(when: After(Trait(SetUp)), by: Some(Not(Trait(Unique))))],
            reverses: Some((
                targets: AnyOf([All([ManeuverType(Strike), Not(Trait(Unique))]), All([ManeuverType(Grapple), Not(Trait(Unique))])]),
            )),
        ),

        // Fandango / Tyler Breeze
        // Cards under this card are not supported yet.
        "The Fashion Files": (),
        // Putting cards under The Fashion Files, NXT packing and the Starting Hand Sizes are not supported yet.
        // Approximation: the random card goes on the bottom at the end of the Pre-match phase.
        "Breezango": (end_of_prematch: [MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Random, bottom: true)]),
        // The -10F / -5F reductions are not supported for the action.
        "Book 'em, Dango!": (
            irreversible_when: Some(CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 5)),
            as_action: Some((
                fortitude: Some(15),
                on_play: [
                    DrawUpTo(who: You, n: 3),
                    Boost((applies_to: Maneuver, duration: NextMatching, no_hand_reversal: true)),
                    MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Random, bottom: true),
                    If(condition: Superstar("Fandango"), effects: [MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Random, bottom: true)]),
                ],
            )),
            reverses: Some((
                targets: All([Maneuver, Not(ManeuverType(TrademarkFinisher))]),
                fortitude_when: Some((Superstar("Fandango"), 10)),
                effects: [
                    MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Random, bottom: true),
                    If(condition: Superstar("Fandango"), effects: [MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Random, bottom: true)]),
                ],
            )),
        ),
        // His Promo and the Ring texts are not supported yet.
        "The Fashion Police": (on_play: [MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 2, pick: Random, bottom: true), Draw(who: Opponent, n: 1)]),
        // The Promo text is not supported yet.
        "Chic and Destroy": (
            on_play: [
                Optional([RemoveFromRing(who: Opponent, n: 1, filter: Any)]),
                If(condition: InYourRing(Title("Breezango")), effects: [DrawUpTo(who: You, n: 1)]),
            ],
            reverses: Some((targets: Not(SuperstarSpecific), effects: [Discard(who: Opponent, n: 1, pick: Random)])),
        ),
        // Approximation: shuffle up to 6 Hand cards and draw as many, and shuffle up to 3 Ringside cards. Playing
        // it from under another card is not supported yet.
        "You Have The Right to Remain Stylish": (
            no_hand_reversal: true,
            on_play: [
                Mulligan(n: 6),
                RingsideToArsenal(who: You, n: 3, up_to: true),
                If(condition: InYourRing(Title("Breezango")), effects: [Draw(who: You, n: 1)]),
            ],
        ),

        // Tommaso Ciampa / Johnny Gargano
        // The Hand Size and Johnny Gargano texts are not supported yet.
        "From Bracket Busters to Champions": (),
        // Hiding Backstage cards, counting as The Sicilian Psychopath and the reveal are not supported yet.
        "DIY": (
            on_opponent_reverses: [
                If(condition: OpponentReversed(Maneuver), effects: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, bottom: true)]),
            ],
        ),
        // Approximation: the unsuccessful text only applies when it is reversed from hand.
        "Corner Charge Strike": (
            bonuses: [(when: Not(InYourRing(Title("DIY"))), fortitude: -4)],
            on_reversed_from_hand: [
                If(
                    condition: Not(InYourRing(Title("DIY"))),
                    effects: [Discard(who: You, n: 1, pick: Chosen), RingsideToHand(who: You, n: 2, up_to: true, filter: Some(Maneuver))],
                ),
            ],
        ),
        "Meet in the Middle": (
            requires: Some(InYourRing(Title("DIY"))),
            bonuses: [(when: AnyOf([After(Maneuver), All([ReversedLastTurn(Any), FirstCardThisTurn])]), fortitude: -5)],
            on_play: [Counted(count: YourRingMatching(Maneuver), effect: Mill(who: Opponent, n: 0))],
        ),
        // Reversing other card effects and the shuffle are not supported yet.
        "Nobody Will Do It For You": (reverses: Some((targets: Not(Maneuver))), reverses_ace: Some(())),
        // Continuing the turn is not supported yet.
        "Do It Yourself": (
            on_play: [
                Search(filter: All([Maneuver, Not(Trait(Unique)), Not(Reversal)]), ringside: true, n: 2, up_to: true),
                Search(filter: Title("Nobody Will Do It For You"), ringside: true, up_to: true),
                If(condition: InYourRing(Title("DIY")), effects: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, bottom: true)]),
            ],
        ),
        // Becoming a Trademark Finisher, the 'Completely' restriction and the Ability text are not supported yet.
        "One Final Beat": (
            bonuses: [(fortitude: -10), (when: FortitudeAtLeast(30), damage: 10)],
            on_play: [Discard(who: Opponent, n: 2, pick: Chosen)],
            as_action: Some((
                fortitude: Some(5),
                on_play: [ShuffleThisIntoArsenal, RingsideToArsenal(who: You, n: 2, up_to: true), Discard(who: Opponent, n: 2, pick: Chosen)],
            )),
        ),
        // Approximation: cards with 'Ringside' in the title. Becoming a Trademark Finisher and The Sicilian
        // Psychopath text are not supported yet.
        "Willow's Bell": (
            bonuses: [(fortitude: -5), (when: FortitudeAtLeast(30), damage: 5)],
            on_play: [Counted(count: HalfOpponentHand, effect: Discard(who: Opponent, n: 0, pick: Chosen))],
            reverses: Some((
                targets: TitleContains("Ringside"),
                effects: [Counted(count: HalfOpponentHand, effect: Discard(who: Opponent, n: 0, pick: Chosen))],
            )),
        ),

        // Lex Luger
        // Reversing cards that would move a card from your Ring and the No Sell Maneuver text are not supported yet.
        "Flexy Lexy": (
            reverses: Some((
                targets: All([Maneuver, Not(ManeuverType(TrademarkFinisher)), Holds(Not(OpponentRingHas(filter: TitleContains("Striker"), n: 1)))]),
            )),
        ),

        // Ultimate Warrior
        // The #F- target (cards in your Ringside) and the Back to Basics texts are not supported yet.
        "Load the Spaceship with the Rocket Fuel!": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
    },
)
