// Hand-written scripts for Unforgiven cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// Backstage cards are skipped by the importer: they are not supported yet. Enforcer cards go in the Backstage Area.
// Volley cards are matched by the "Volley" keyword; Female, Diva, Legend, GM and Chairman Superstars by their
// printed traits.
// "Card with the word 'diva' or 'female' in the text" is a list of the known titles with that text.
(
    abilities: {
        // Approximation: Batista's Spinebuster and Running Spinebuster are found by title.
        // Making the opponent's Reversals deal no damage is not supported yet.
        "Batista": [
            Activated(
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [Search(filter: AnyOf([TitleContains("spine buster"), TitleContains("spinebuster")]))],
            ),
            FortitudeFor(filter: AnyOf([TitleContains("spine buster"), TitleContains("spinebuster")]), delta: -10),
        ],
        // "The Leader of the Peepulation" is the logo printed on Never Forgive - Never Forget, which does not match
        // his name.
        "Leader of the Peepulation": [
            Activated(
                cost: [],
                requires: Some(OpponentRingHas(filter: DamageAtMost(0), n: 1)),
                effects: [
                    RemoveFromRing(who: Opponent, n: 1, filter: DamageAtMost(0)),
                    RemoveFromRing(who: You, n: 1, filter: Not(Trait(Unique))),
                ],
            ),
            PacksLogos(["Christian", "The Leader of the Peepulation"]),
        ],
        // Approximation: the once-per-turn limit is not checked.
        "Christy": [
            CannotPackMatching(All([Maneuver, DamageAtLeast(3)])),
            OnPlayMatching(filter: Action, effects: [Optional([RingsideToArsenalBottom(who: You, n: 3)])]),
        ],
        // Packing No Sell Maneuver is not supported yet.
        "The Immortal One": [
            PacksLogos(["Hollywood Hulk Hogan"]),
            OnOpponentReverses([
                If(condition: OpponentReversedFrom([Hand, Backlash, Ringside]), effects: [Optional([Draw(who: You, n: 1)])]),
            ]),
            OnYouReverse([
                If(
                    condition: YouReversedFrom([Hand, Backlash, Ringside]),
                    effects: [Discard(who: You, n: 1, pick: Chosen)],
                ),
            ]),
        ],
        // Checking a card's text for the word 'reverse' is not supported yet.
        "Rowdy Roddy Piper": [],
        // The 50-card Arsenal and blocking Stipulation cards are not supported yet.
        "SmackDown! GM Theodore Long": [
            RevealEnforcers(
                AnyOf([
                    Trait(SmackDown),
                    Title("Mankind / Cactus Jack, or ... Dude Love?"),
                    Title("The People's Champ, The Big Freak'n Machine, or The Game?"),
                    Title("The Hurricane, Hardcore Holly, or Umaga?"),
                ]),
            ),
            Activated(
                cost: [],
                requires: Some(HandAtLeast(2)),
                effects: [HandToArsenalTop(who: You, n: 2), Search(filter: Reversal)],
            ),
        ],
        "Heidenreich": [
            Activated(
                cost: [Discard(who: You, n: 2, pick: Chosen)],
                effects: [Search(filter: AnyOf([Keyword("Foreign Object"), All([Maneuver, TitleContains("punch")])]))],
            ),
            OnPlayMatching(
                filter: All([Maneuver, AnyOf([Keyword("Foreign Object"), TitleContains("punch")])]),
                effects: [
                    Optional([
                        LookAtHand(who: Opponent),
                        MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Controller, bottom: true),
                    ]),
                ],
            ),
        ],
        // Keeping his Heat cards when he moves cards from his Ringside pile (a change to the Heat rule) is not
        // supported yet.
        "Gene Snitsky": [],
        // Approximation: the ability can be used with an empty Backlash deck. The 10 extra Pre-match cards are not
        // supported yet.
        "MNM": [
            CannotPackTrait(MidMatch),
            Activated(
                cost: [],
                effects: [
                    RemoveFromGame(who: You, from: Backlash, n: 1),
                    RingsideToHand(
                        who: You,
                        n: 1,
                        filter: Some(
                            AnyOf([
                                All([Maneuver, Not(Trait(Unique)), Not(Action), Not(Reversal)]),
                                Title("Melina: Naughty Manager"),
                            ]),
                        ),
                    ),
                ],
            ),
        ],
        // Approximation: the once-per-turn limit is not checked.
        "The HurriFriends": [
            OnPlayMatching(
                filter: Maneuver,
                effects: [
                    If(
                        condition: HandHas(Trait(Unique)),
                        effects: [
                            Optional([
                                DiscardMatching(who: You, n: 1, filter: Trait(Unique), pick: Chosen),
                                Search(filter: AnyOf([SuperstarSpecific, Title("Diversion")])),
                            ]),
                        ],
                    ),
                ],
            ),
            OnPlayMatching(
                filter: AnyOf([SuperstarSpecific, Title("Diversion")]),
                effects: [Optional([RingsideToArsenalBottom(who: You, n: 2)])],
            ),
            PacksLogos(["Hurricane", "Stacy Keibler"]),
        ],
    },
    scripts: {
        // Hiding it during the opponent's turn to blank a card is not supported yet.
        "Feathered Boa": (),
        // Blanking the opponent's hand-looking cards is not supported yet.
        "Super Masks and Super Capes": (
            backstage_ability: Some((sacrifice: true, effects: [ShuffleHandAndRedraw(who: You)])),
        ),
        // Packing 3 copies is not supported yet.
        "World Tour '05": (
            backstage_abilities: [
                OnPlayMatching(filter: Trait(Unique), effects: [Optional([RingsideToArsenalBottom(who: You, n: 1)])]),
            ],
        ),
        // High Risk
        "Counter Slash": (
            requires: Some(All([FirstCardThisTurn, ReversedLastTurn(Any)])),
            not_reversed_by: Some(Title("Elbow to the Face")),
            on_play: [Discard(who: Opponent, n: 1, pick: Random)],
        ),
        "Corkscrew Elbow": (
            play_after: Some(All([Maneuver, DamageAtLeast(3)])),
            on_play: [
                AsOpponent([Optional([RemoveFromRing(who: You, n: 1, filter: All([Reversal, Not(Trait(Unique))]))])]),
            ],
        ),
        "Body Block": (
            play_after: Some(All([Maneuver, DamageAtLeast(3)])),
            no_arsenal_reversal: true,
            no_backlash_reversal: true,
            reverses: Some((
                targets: All([Maneuver, AnyOf([TitleContains("atomic"), After(Title("Irish Whip"))])]),
                fortitude: Some(0),
            )),
        ),
        // Letting The Big Show pack it is not supported yet.
        "Spinning Leg Drop": (
            play_after: Some(All([Maneuver, DamageAtLeast(2)])),
            bonuses: [(when: FortitudeBelowOpponent, fortitude: -2)],
        ),
        // The Tag Team format is not supported yet.
        "Missile Dropkick": (
            play_after: Some(All([Maneuver, DamageAtLeast(3)])),
            as_action: Some((
                fortitude: Some(0),
                on_play: [ThisToArsenal(bottom: true), RingsideToHand(who: You, n: 1, filter: Some(All([Maneuver, Keyword("Volley")])))],
            )),
        ),
        "Shooting Star Press": (
            play_after: Some(All([Maneuver, DamageAtLeast(8)])),
            no_arsenal_reversal: true,
            no_backlash_reversal: true,
            on_play: [Draw(who: You, n: 1)],
        ),

        // Strikes
        // Over Sell Maneuver cannot be played yet, so its restriction needs nothing.
        // Approximation: the cards with 'diva' or 'female' in the text are a list of titles.
        "Girly Slap": (
            only_packed_by: ["Female"],
            not_reversed_by: Some(DamageAtMost(0)),
            on_play: [Search(filter: AnyOf([Title("2004 Diva Search Winner"), Title("Back Breaker Torture Rack"), Title("Bra and Panties Match"), Title("Busted Wide Open"), Title("Caution: Dangerous Curves Ahead"), Title("Divas! Divas! Divas!"), Title("Filthy, Disgusting, Brutal, Bottom-Feeding, Trash-bag Ho!"), Title("Gentlemen's Establishment"), Title("Girly Grab"), Title("Girly Slap"), Title("Hello, Ladies!"), Title("I Can't Be Reading This Right..."), Title("Lariat Takedown"), Title("Lock, Stock, and Barrel"), Title("Man of 1000 Holds"), Title("No One Wants to Watch Women Wrestle"), Title("Ovicular Fortitude"), Title("Puppies! Puppies!"), Title("Real Predictable..."), Title("Rolling Headlock Vise"), Title("Stratusfaction Bulldog"), Title("The King Interferes!"), Title("The Squared Circle is No Place for a Woman!"), Title("There Can Only Be One Dominant Female in WWE"), Title("Viva Las Divas"), Title("WWE Divas Rule!"), Title("WWE Divas: The Next Generation"), Title("Workin' on the Knee")]))],
        ),
        "Shoulder Block": (on_play: [RingsideToArsenal(who: You, n: 3, up_to: true)]),
        "Running Elbow Smash": (
            on_play: [
                AsOpponent([
                    Optional([
                        LookAtHand(who: Opponent),
                        MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Controller, top: true),
                    ]),
                ]),
            ],
        ),
        // Approximation: other copies of it cannot be removed.
        "Kidney Punch": (
            ringside_ability: Some((
                cost: [RemoveFromGame(who: You, from: Ringside, n: 4, filter: Some(Not(Title("Kidney Punch"))))],
                effects: [ReturnThis(to: Hand)],
            )),
        ),
        "Standing Drop Kick": (
            bonuses: [(when: FortitudeBelowOpponent, fortitude: -3)],
            on_play: [Discard(who: Opponent, n: 3, pick: Chosen)],
        ),
        "Knee Breaker": (
            play_after: Some(Any),
            play_after_unless: Some(All([FirstCardThisTurn, ReversedLastTurn(Any)])),
            while_in_ring: [(applies_to: TitleContains("leg"), damage: 1)],
        ),
        "Back Fist": (
            bonuses: [(fortitude: -6), (when: FirstCardThisTurn, damage: 4)],
            reverses: Some((targets: All([Maneuver, DamageAtMost(3)]))),
        ),
        "Back Body Drop": (
            bonuses: [(fortitude: -5)],
            play_after: Some(AnyOf([Title("Irish Whip"), Title("Throw Into the Corner Turnbuckle")])),
            reverses: Some((targets: AnyOf([TitleContains("atomic"), TitleContains("bomb"), TitleContains("driver")]))),
            ringside_ability: Some((
                effects: [ThisToArsenal(bottom: true), RingsideToHand(who: You, n: 1, filter: Some(Trait(SetUp)))],
            )),
        ),
        "Reverse Clothesline": (
            bonuses: [(fortitude: -6)],
            reverses: Some((targets: All([Maneuver, AnyOf([Trait(Chain), Keyword("Heat")])]))),
        ),
        // Playing cards from the Ringside pile is not supported yet.
        "Everything and the Kitchen Sink": (requires: Some(Never)),
        "Ap Chaki Kick": (
            bonuses: [(when: FortitudeAtMostOpponent, fortitude: -5)],
            on_play: [Discard(who: Opponent, n: 2, pick: Chosen)],
            reverses: Some((
                targets: EarlierThisTurn(filter: Any, n: 3),
                fortitude_when: Some((FortitudeAtMostOpponent, 0)),
            )),
        ),
        "Precision Clothesline": (
            fortitude_discount: Some((per: 2, max: 5, overturn: true)),
            on_play: [RingsideToArsenal(who: You, n: 1)],
        ),
        // Approximation: Pre-match Managers are the cards with "Managed by" in the title.
        "Baseball Slide": (
            play_after: Some(Any),
            play_after_unless: Some(All([FirstCardThisTurn, ReversedLastTurn(Any)])),
            on_play: [
                RemoveFromRing(
                    who: Opponent,
                    n: 1,
                    filter: AnyOf([TitleContains("managed by"), TitleContains("guest ringside announcer")]),
                ),
            ],
            reverses: Some((targets: Keyword("Run-in"))),
        ),
        "Lock, Stock, and Barrel": (
            not_packed_by: ["Female"],
            on_play: [
                If(
                    condition: All([
                        InYourRing(Title("Irish Whip")),
                        InYourRing(Title("Throw Into the Corner Turnbuckle")),
                        InYourRing(Title("Springboard")),
                    ]),
                    effects: [WinByPin],
                ),
            ],
            as_action: Some((
                fortitude: Some(5),
                on_play: [
                    DiscardThis,
                    Search(
                        filter: AnyOf([Title("Irish Whip"), Title("Throw Into the Corner Turnbuckle"), Title("Springboard")]),
                    ),
                ],
            )),
        ),

        // Grapples
        "Rolling Hip Toss": (
            ringside_ability: Some((
                cost: [DiscardMatching(who: You, n: 1, filter: Maneuver, pick: Chosen)],
                effects: [ReturnThis(to: Hand)],
            )),
        ),
        "Japanese Arm Drag": (
            on_play: [Search(filter: TitleContains("arm drag"))],
            while_in_ring: [(applies_to: All([Maneuver, TitleContains("arm drag"), Not(Keyword("Throwback"))]), damage: 2)],
        ),
        // Approximation: cards that cannot be reversed are the ones with the Irreversible trait.
        "Sidewalk Slam": (
            reverses: Some((targets: AnyOf([Trait(Irreversible), Keyword("Foreign Object")]), ignores_irreversible: true)),
        ),
        "Flip": (on_play: [Search(filter: Maneuver)]),
        "Running Spinebuster": (
            ring_ability: Some((sacrifice: true, effects: [RingsideToArsenal(who: You, n: 2, up_to: true)])),
        ),
        "Shoot Suplex": (on_play: [Dig(n: 4, take: 1)]),
        "Snap Suplex": (before_reversal: [Discard(who: You, n: 1, pick: Random), Discard(who: Opponent, n: 1, pick: Random)]),
        "Headlock Takedown": (
            ring_ability: Some((
                sacrifice: true,
                effects: [Boost((applies_to: Not(Trait(Unique)), duration: NextCard, fortitude: -10))],
            )),
        ),
        // The Chain discard is still asked. The card being played counts as one of the 5 in the Ring.
        "Small Package": (
            bonuses: [(fortitude: -3)],
            on_play: [
                CannotPlay(who: You, filter: Title("Small Package"), turns: 1),
                If(
                    condition: All([
                        FortitudeAboveOpponent,
                        CountAtLeast(count: YourRingMatching(Title("Small Package")), n: 4),
                    ]),
                    effects: [WinByPin],
                ),
            ],
            reverses: Some((targets: All([Maneuver, Trait(Chain), DamageAtMost(4)]))),
        ),
        "Swinging Neck Breaker": (
            bonuses: [(fortitude: -4)],
            reverses: Some((targets: All([Maneuver, TitleContains("suplex")]))),
        ),
        "Pendulum Back Breaker": (bonuses: [(when: FortitudeBelowOpponent, fortitude: -5)]),
        "Powerbomb": (
            on_play: [LookAtHand(who: Opponent), MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Controller, bottom: true)],
        ),
        // Approximation: you always remove as many cards as you can (up to 2).
        "Full Nelson Slam": (
            bonuses: [(when: Not(HandAtLeast(2)), damage: -2), (when: Not(HandAtLeast(3)), damage: -2)],
            before_reversal: [RemoveFromGame(who: You, from: Hand, n: 2)],
        ),
        "Shoot Russian Leg Sweep": (on_play: [Mill(who: You, n: 2)]),
        // Allowing only Backlash and Arsenal reversals under a condition is not supported yet.
        "German Suplex": (),
        // Burying your hand to make it -7F is not supported yet.
        "Sit Out Powerbomb": (),
        // Counting as a High Risk maneuver outside the Ring and the reversal limit after From the Middle
        // Turnbuckle or From the Top Rope are not supported yet.
        "Tornado DDT": (
            play_after: Some(Any),
            reverses: Some((
                targets: All([
                    Maneuver,
                    AnyOf([After(Title("Irish Whip")), After(Title("Throw Into the Corner Turnbuckle"))]),
                ]),
            )),
        ),
        "Workin' on the Knee": (
            not_packed_by: ["Female"],
            play_after: Some(AnyOf([ManeuverType(Strike), ManeuverType(Grapple), TitleContains("knee")])),
            not_reversed_by: Some(AnyOf([Trait(Unique), All([Reversal, AnyOf([Maneuver, Action])])])),
        ),
        "Precision Power Slam": (
            fortitude_discount: Some((per: 2, max: 5)),
            on_play: [DrawUpTo(who: You, n: 2)],
        ),

        // Submissions
        "Side Headlock": (no_arsenal_reversal: true, no_backlash_reversal: true),
        // Approximation: the cards all go back on top of the Arsenal.
        "Bear Hug": (on_play: [Arrange(who: Opponent, n: 5)]),
        "Full Nelson": (on_play: [Optional([RingsideToArsenal(who: You, n: 1)])]),
        "Bow and Arrow": (
            on_play: [Draw(who: You, n: 1)],
            while_in_ring: [(applies_to: ManeuverType(Submission), damage: 2)],
        ),
        // Approximation: usable once you have played any card this turn (even a reversed one).
        "Guillotine Stretch": (
            ringside_ability: Some((
                requires: Some(Not(FirstCardThisTurn)),
                cost: [Mill(who: You, n: 3)],
                effects: [ReturnThis(to: Hand)],
            )),
        ),
        // Looking at the Backlash deck is not supported yet.
        "Wrist Breaker": (on_play: [Optional([LookAtHand(who: Opponent)])]),
        "Arm Stretch": (
            play_after: Some(Any),
            ringside_ability: Some((
                cost: [DiscardMatching(who: You, n: 2, filter: Maneuver, pick: Chosen)],
                effects: [ReturnThis(to: Hand)],
            )),
        ),
        "Sleeper": (on_play: [Optional([Search(filter: Action)])]),
        "Side Chinlock": (
            requires: Some(All([FirstCardThisTurn, ReversedLastTurn(Any)])),
            while_in_ring: [(applies_to: ManeuverType(Grapple), damage: 2)],
        ),
        "Camel Clutch": (
            on_play: [
                If(
                    condition: HandHas(Trait(MidMatch)),
                    effects: [
                        Optional([
                            DiscardMatching(who: You, n: 1, filter: Trait(MidMatch), pick: Chosen),
                            BacklashToRingside(who: Opponent, n: 1),
                        ]),
                    ],
                ),
            ],
        ),
        "Spinning Toe Hold": (play_after: Some(All([Maneuver, DamageAtLeast(4)])), no_hand_reversal: true),
        // Allowing only Arsenal reversals after a 4D or greater maneuver is not supported yet.
        "Boston Crab": (),
        // Overturning as many cards as were discarded is not supported yet.
        "Precision Leg Lock": (
            fortitude_discount: Some((per: 2, max: 5)),
            on_play: [RingsideToArsenal(who: You, n: 1), Draw(who: You, n: 1)],
        ),
        "Torture Rack": (
            play_after: Some(Any),
            as_action: Some((
                fortitude: Some(0),
                on_play: [ThisToArsenal(bottom: true), RingsideToHand(who: You, n: 1, filter: Some(All([Maneuver, FortitudeAtMost(0)])))],
            )),
        ),
        "Choke Hold": (before_reversal: [RemoveFromGame(who: You, from: Arsenal, n: 1)]),

        // Reversals
        "Lift a Boot": (
            reverses: Some((
                targets: ManeuverType(HighRisk),
                requires: Some(FortitudeAtMostOpponent),
                effects: [Discard(who: Opponent, n: 3, pick: Chosen)],
            )),
        ),
        "Spot Adjustment": (
            reverses: Some((
                targets: All([Maneuver, Not(Trait(Unique))]),
                from_hand_only: true,
                requires: Some(FortitudeBelowOpponent),
                // Counted as the opponent (the Fortitude of his reversed maneuver); the boost is yours.
                effects: [
                    AsOpponent([
                        Counted(
                            count: OpponentReversedFortitude,
                            effect: BoostOpponent((applies_to: Any, duration: NextTurnFirstCard, fortitude: -1)),
                        ),
                    ]),
                ],
            )),
        ),
        // Removing it from the game when it reverses while overturned is not supported yet.
        "A Revolution of the Mind": (
            not_with: [
                "Escape Move",
                "No Sell Maneuver",
                "Over Sell Maneuver",
                "Raw and Ready",
                "Reach For the Ropes",
                "Step Aside",
                "Strangle Hold",
            ],
            reverses: Some((
                targets: AnyOf([ManeuverType(Strike), ManeuverType(Grapple), ManeuverType(Submission)]),
                effects: [Optional([Draw(who: You, n: 1)])],
            )),
        ),

        // Actions
        "Build Momentum": (
            on_play: [
                RingsideToArsenal(who: You, n: 1),
                Search(filter: All([Maneuver, Keyword("Volley")])),
                Counted(
                    count: YourRingMatching(Title("Build Momentum")),
                    effect: Boost((applies_to: Maneuver, duration: NextMatching, damage: 2)),
                ),
            ],
        ),
        // Approximation: the cards with 'diva' or 'female' in the text are a list of titles.
        "Viva Las Divas": (
            only_packed_by: ["Diva"],
            on_play: [
                RingsideToArsenal(who: You, n: 1, filter: Some(AnyOf([Title("2004 Diva Search Winner"), Title("Back Breaker Torture Rack"), Title("Bra and Panties Match"), Title("Busted Wide Open"), Title("Caution: Dangerous Curves Ahead"), Title("Divas! Divas! Divas!"), Title("Filthy, Disgusting, Brutal, Bottom-Feeding, Trash-bag Ho!"), Title("Gentlemen's Establishment"), Title("Girly Grab"), Title("Girly Slap"), Title("Hello, Ladies!"), Title("I Can't Be Reading This Right..."), Title("Lariat Takedown"), Title("Lock, Stock, and Barrel"), Title("Man of 1000 Holds"), Title("No One Wants to Watch Women Wrestle"), Title("Ovicular Fortitude"), Title("Puppies! Puppies!"), Title("Real Predictable..."), Title("Rolling Headlock Vise"), Title("Stratusfaction Bulldog"), Title("The King Interferes!"), Title("The Squared Circle is No Place for a Woman!"), Title("There Can Only Be One Dominant Female in WWE"), Title("Viva Las Divas"), Title("WWE Divas Rule!"), Title("WWE Divas: The Next Generation"), Title("Workin' on the Knee")]))),
                Search(filter: All([Not(Trait(Unique)), AnyOf([Title("2004 Diva Search Winner"), Title("Back Breaker Torture Rack"), Title("Bra and Panties Match"), Title("Busted Wide Open"), Title("Caution: Dangerous Curves Ahead"), Title("Divas! Divas! Divas!"), Title("Filthy, Disgusting, Brutal, Bottom-Feeding, Trash-bag Ho!"), Title("Gentlemen's Establishment"), Title("Girly Grab"), Title("Girly Slap"), Title("Hello, Ladies!"), Title("I Can't Be Reading This Right..."), Title("Lariat Takedown"), Title("Lock, Stock, and Barrel"), Title("Man of 1000 Holds"), Title("No One Wants to Watch Women Wrestle"), Title("Ovicular Fortitude"), Title("Puppies! Puppies!"), Title("Real Predictable..."), Title("Rolling Headlock Vise"), Title("Stratusfaction Bulldog"), Title("The King Interferes!"), Title("The Squared Circle is No Place for a Woman!"), Title("There Can Only Be One Dominant Female in WWE"), Title("Viva Las Divas"), Title("WWE Divas Rule!"), Title("WWE Divas: The Next Generation"), Title("Workin' on the Knee")])])),
            ],
        ),
        "Shake It Off": (
            requires: Some(
                AnyOf([
                    FortitudeBelowOpponent,
                    InYourRing(All([Maneuver, Keyword("Volley")])),
                    CountAtLeast(count: YourRingsideMatching(All([Maneuver, Keyword("Volley")])), n: 1),
                ]),
            ),
            on_play: [RemoveFromRing(who: Opponent, n: 1, filter: Any)],
        ),
        "Listen Loud and Clear": (
            on_play: [Draw(who: You, n: 1), Boost((applies_to: Any, duration: NextCard, fortitude: -7))],
        ),
        "Hardcore Timekeeper's Bell": (
            play_after: Some(Any),
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: Maneuver,
                    effects: [Optional([SacrificeThis, Discard(who: Opponent, n: 5, pick: Chosen)])],
                ),
            ],
        ),
        "Not Yet": (on_play: [HandToArsenalBottom(who: You, n: 1), Dig(n: 10, take: 2)]),
        "Afterburn": (
            on_play: [Choice([[Draw(who: You, n: 1)], [Discard(who: You, n: 1, pick: Chosen)]])],
            ring_ability: Some((
                cost: [DiscardMatching(who: You, n: 1, filter: Keyword("Heat"), pick: Chosen)],
                effects: [Counted(count: YourRemovedMatching(Keyword("Heat")), effect: Mill(who: Opponent, n: 0))],
                not_turn_played: true,
            )),
        ),
        "Stagger": (
            play_after: Some(Maneuver),
            on_play: [
                Draw(who: You, n: 1),
                Boost((applies_to: All([Maneuver, DamageAtMost(9)]), duration: NextCard, irreversible: true)),
            ],
        ),
        "Kickin' It Old School": (
            bonuses: [(per: Some(TitleContains("old school")), fortitude: -1)],
            on_play: [
                Counted(count: YourRingMatching(TitleContains("old school")), effect: RingsideToArsenal(who: You, n: 0)),
                Choice([
                    [RemoveFromGame(who: Opponent, from: Ring, n: 3, filter: Some(Trait(Chain)), pick: Controller)],
                    [RemoveFromGame(who: Opponent, from: Ring, n: 2, filter: Some(Keyword("Heat")), pick: Controller)],
                    [RemoveFromGame(who: Opponent, from: Ring, n: 1, filter: Some(Keyword("Volley")), pick: Controller)],
                ]),
            ],
        ),
        "That's It!": (
            requires: Some(CountAtLeast(count: YourRingMatching(TitleContains("that's")), n: 7)),
            on_play: [WinByPin],
        ),
