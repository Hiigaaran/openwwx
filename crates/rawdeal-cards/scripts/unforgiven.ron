        // Approximation: Legends are The Immortal One and Rowdy Roddy Piper; up to 2 maneuvers go to your hand and
        // none is shuffled back. Hybrid maneuvers cannot be told apart while played, and a Multi maneuver is
        // not completely reversed by one card.
        "In My Day, a Maneuver Was a Maneuver": (
            only_packed_by: ["The Immortal One", "Rowdy Roddy Piper"],
            on_play: [
                RingsideToHand(
                    who: You,
                    n: 2,
                    up_to: true,
                    filter: Some(All([Maneuver, Not(Action), Not(Reversal), Not(Trait(Multi))])),
                ),
            ],
            reverses: Some((targets: All([Maneuver, Trait(Multi)]))),
        ),

        // Rowdy Roddy Piper
        // Starting the match regardless of Superstar Value is not supported yet.
        "Bagpipe Introduction": (
            extra_traits: [UniversallyUnique],
            end_of_prematch: [
                Choice([[Discard(who: Opponent, n: 1, pick: Random)], [BacklashToRingside(who: Opponent, n: 1, random: true)]]),
            ],
        ),
        // Blanking a chosen card and removing reversed cards from the game are not supported yet.
        "Piper's Pit": (requires: Some(Never)),
        // Blanking a maneuver's text after it was played is not supported yet.
        "Over Sell: Hot Rod Style": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // Approximation: the overturned Maneuver goes to the Ringside pile and then any Maneuver from there to your
        // hand; your next card, if a maneuver, is F:0 and may ignore its "can only be played after" text.
        "Hot Rod": (
            on_play: [
                MillUntil(who: You, filter: Maneuver),
                RingsideToHand(who: You, n: 1, filter: Some(Maneuver)),
                Boost((applies_to: Maneuver, duration: NextCard, fortitude: -100, ignore_play_after: true)),
            ],
        ),
        // Approximation: Legends are The Immortal One and Rowdy Roddy Piper.
        "Cowboy Bob Orton Interferes": (
            only_packed_by: ["Randy Orton", "The Immortal One", "Rowdy Roddy Piper"],
            reverses: Some((targets: Not(Trait(Unique)))),
        ),

        // SmackDown! GM Theodore Long
        // Approximation: always as many cards as you choose from 1 to 3; the opponent chooses his cards.
        "Haterade": (
            ring_ability: Some((
                sacrifice: true,
                effects: [
                    Choice([
                        [HandToArsenalBottom(who: You, n: 1), LookAtHand(who: Opponent), HandToArsenalBottom(who: Opponent, n: 1)],
                        [HandToArsenalBottom(who: You, n: 2), LookAtHand(who: Opponent), HandToArsenalBottom(who: Opponent, n: 2)],
                        [HandToArsenalBottom(who: You, n: 3), LookAtHand(who: Opponent), HandToArsenalBottom(who: Opponent, n: 3)],
                    ]),
                ],
            )),
        ),
        "Holla! Holla! Holla!": (play_after: Some(Any), on_play: [HandToArsenalBottom(who: Opponent, n: 5)]),
        // Approximation: the card goes to the Ringside pile and then 2 cards from there to the bottom of the Arsenal.
        "Thuggin' and Buggin'": (
            on_play: [Boost((applies_to: Maneuver, duration: NextMatching, damage: 5))],
            ring_ability: Some((sacrifice: true, effects: [RingsideToArsenalBottom(who: You, n: 2)])),
        ),
        // Shuffling in cards removed from the game is not supported yet.
        "The Mack Militant": (on_play: [DrawUpTo(who: You, n: 5)]),

        // Heidenreich
        "Disasterpiece": (
            while_in_ring: [
                (applies_to: All([Maneuver, AnyOf([Keyword("Foreign Object"), TitleContains("punch")])]), fortitude: -4),
            ],
        ),
        "Heidenreich's Elbow Drop": (play_after: Some(Maneuver), on_play: [DrawUpTo(who: You, n: 4)]),
        "Who Wants to be My Friend?": (
            play_after: Some(Maneuver),
            on_play: [HandToArsenalBottom(who: Opponent, n: 100)],
            reverses: Some((targets: AnyOf([ManeuverType(Submission), ManeuverType(HighRisk)]), fortitude: Some(7))),
        ),
        "A Friendly Boot": (on_play: [RingsideToArsenal(who: You, n: 4, up_to: true)]),
        "Running Shoulder Block": (
            bonuses: [(when: After(Title("Irish Whip")), fortitude: -15)],
            reverses: Some((targets: AnyOf([ManeuverType(Submission), ManeuverType(HighRisk)]))),
        ),

        // Gene Snitsky
        // Coming back into the Ring from the Ringside pile is not supported yet.
        "Baby Carriage": (
            ring_ability: Some((
                effects: [
                    RingsideToArsenal(who: You, n: 1),
                    Draw(who: You, n: 1),
                    Discard(who: You, n: 1, pick: Chosen),
                    Mill(who: Opponent, n: 1),
                ],
            )),
        ),
        // Approximation: up to 10 cards are always chosen.
        "You Have Tasty Toes": (
            on_play: [
                OpponentChooses(
                    n: 1,
                    options: [
                        [Mill(who: Opponent, n: 10)],
                        [RingsideToArsenal(who: You, n: 10, up_to: true), Draw(who: You, n: 2)],
                    ],
                ),
            ],
        ),
        "It's Not My Fault": (
            on_play: [RevealHand(who: You), Boost((applies_to: Any, duration: NextCards(2), irreversible: true))],
        ),
        // Getting it back from the Ringside pile is not supported yet.
        "No Fault Clothesline": (),
        "No Fault Pump Handle Slam": (reverses: Some((targets: ManeuverType(Strike)))),

        // MNM
        // Getting it back from the Ringside pile is not supported yet.
        "The Snapshot": (
            play_after: Some(Any),
            play_after_unless: Some(All([FirstCardThisTurn, ReversedLastTurn(Any)])),
        ),
        // Approximation: the next card need not come from your hand.
        "Managed by Melina": (
            ring_ability: Some((sacrifice: true, effects: [Boost((applies_to: Any, duration: NextCard, irreversible: true))])),
        ),
        "There's Nothing Sweeter": (
            on_play: [RingsideToArsenal(who: You, n: 4, up_to: true)],
            reverses_from_ring: Some((targets: All([Maneuver, Not(Trait(Unique))]), requires: Some(FortitudeBelowOpponent))),
        ),
        // Approximation: up to 3 cards.
        "A-List Attack": (
            play_after: Some(Maneuver),
            on_play: [
                Optional([
                    Choice([
                        [Discard(who: You, n: 1, pick: Chosen), RingsideToArsenal(who: You, n: 2)],
                        [Discard(who: You, n: 2, pick: Chosen), RingsideToArsenal(who: You, n: 4)],
                        [Discard(who: You, n: 3, pick: Chosen), RingsideToArsenal(who: You, n: 6)],
                    ]),
                ]),
            ],
        ),
        "Melina Interferes": (reverses: Some((targets: Any, effects: [Search(filter: Any)]))),

        // The HurriFriends
        // Cards under another card are not supported yet.
        "The Hurri-Friends' Armory": (requires: Some(Never)),
        // Approximation: any Reversal that ended the opponent's last turn counts.
        "The Super Storm Front": (
            play_after: Some(All([Maneuver, SuperstarSpecific])),
            play_after_unless: Some(All([FirstCardThisTurn, ReversedLastTurn(Any)])),
        ),

        // Other logos
        "Greetings, Citizen": (
            on_play: [
                RingsideToArsenal(who: You, n: 1, filter: Some(Maneuver)),
                Search(filter: All([Maneuver, Not(Trait(Unique)), Not(Action), Not(Reversal)])),
                Search(filter: Title("Greetings, Citizen")),
                CannotPlay(who: You, filter: Title("Greetings, Citizen"), turns: 1),
            ],
        ),
        "Stacy's Roundhouse Kick": (
            on_play: [RingsideToArsenal(who: You, n: 3, up_to: true)],
            reverses: Some((targets: ManeuverType(Strike))),
        ),
        // Approximation: you draw double the cards put on top, even if fewer were shuffled in.
        "Unleash Hell": (
            bonuses: [(when: FortitudeBelowOpponent, fortitude: -13)],
            on_play: [
                Choice([
                    [HandToArsenalTop(who: You, n: 1), RingsideToArsenal(who: You, n: 2), Draw(who: You, n: 2)],
                    [HandToArsenalTop(who: You, n: 2), RingsideToArsenal(who: You, n: 4), Draw(who: You, n: 4)],
                    [HandToArsenalTop(who: You, n: 3), RingsideToArsenal(who: You, n: 6), Draw(who: You, n: 6)],
                    [HandToArsenalTop(who: You, n: 4), RingsideToArsenal(who: You, n: 8), Draw(who: You, n: 8)],
                    [HandToArsenalTop(who: You, n: 5), RingsideToArsenal(who: You, n: 10), Draw(who: You, n: 10)],
                ]),
            ],
        ),
        // Approximation: the card goes to the Ringside pile instead of being removed from the game, and Pre-match
        // cards can be chosen too.
        "Nobody's Safe": (on_play: [RemoveFromRing(who: Opponent, n: 1, filter: Not(Trait(MidMatch)))]),
        "Making The Game": (
            on_play: [Search(filter: Action), Search(filter: Maneuver), Search(filter: Reversal), EndTurn],
        ),
        // Approximation: only Pay-Per-View Events are checked, not Venues.
        "Finally... The Rock Has Come Back To...": (
            on_play: [
                If(
                    condition: AnyOf([InYourRing(Trait(PayPerView)), OpponentRingHas(filter: Trait(PayPerView), n: 1)]),
                    effects: [Search(filter: Trait(Unique))],
                ),
                If(
                    condition: Not(AnyOf([InYourRing(Trait(PayPerView)), OpponentRingHas(filter: Trait(PayPerView), n: 1)])),
                    effects: [DiscardThis, RingsideToArsenal(who: You, n: 1)],
                ),
            ],
        ),
        // Packing 6 copies and getting it back from the Ringside pile are not supported yet.
        "Another Big Freak'n Hellfire Boot": (),
        "The Wolverine's Sharpshooter": (
            on_play: [
                RemoveFromRing(who: Opponent, n: 2, filter: Any),
                Search(filter: Title("Maintain Hold")),
                If(condition: Superstar("Chris Benoit"), effects: [Optional([RingsideToArsenalBottom(who: You, n: 2)])]),
            ],
            as_action: Some((fortitude: Some(0), on_play: [ShuffleThisIntoArsenal, Draw(who: You, n: 1)])),
        ),
        // Approximation: the cards are shuffled into the Arsenal instead of put on the bottom.
        "Addicted to the Heat": (
            reverses: Some((
                targets: AnyOf([All([Not(Trait(Unique)), EarlierThisTurn(filter: Any, n: 1)]), Keyword("Heat")]),
                effects: [Mulligan(n: 10)],
            )),
        ),
        // Putting it into the Ring from the Backlash deck is not supported yet.
        "The Kurt Angle Invitational": (
            ring_ability: Some((
                effects: [
                    AsOpponent([RingsideToArsenal(who: You, n: 1), Draw(who: You, n: 1)]),
                    Optional([
                        Choice([
                            [Search(filter: Trait(Face))],
                            [Search(filter: Trait(Heel))],
                            [Search(filter: Trait(Chain))],
                        ]),
                    ]),
                ],
            )),
        ),
        "Edge's Running Spear": (bonuses: [(fortitude: -30)], reverses: Some((targets: Any))),
        "Big Show's F5": (
            bonuses: [(fortitude: -15)],
            play_after: Some(Any),
            reverses: Some((targets: ManeuverType(Strike))),
        ),
        "When I Get You Alone": (
            irreversible: true,
            on_play: [
                RingsideToArsenal(who: You, n: 3, up_to: true, filter: Some(TitleContains("kick"))),
                DrawUpTo(who: You, n: 2),
            ],
        ),
        "The Hidden Dragon: Balance": (
            ring_ability: Some((
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [Search(filter: All([Maneuver, Not(Action), Not(Reversal)]))],
            )),
        ),
        // Approximation: the opponent reveals his whole hand. Packing 5 copies and getting it back from the
        // Ringside pile are not supported yet.
        "Booker's Thrust Kick": (on_play: [RevealHand(who: Opponent)]),
        // Extra Mid-match slots are not supported yet.
        "The Power of the Punch": (on_play: [Search(filter: TitleContains("punch"))]),
        // Packing 4 copies is not supported yet.
        "Flair's Chop Block": (),
        "The MaTrish Move": (
            not_with: ["Step Aside"],
            reverses: Some((
                targets: ManeuverType(Strike),
                effects: [Boost((applies_to: Any, duration: NextTurnFirstCard, irreversible: true))],
            )),
        ),
        // Approximation: any card from the Ringside pile can go to the bottom of the Arsenal.
        "Educated Hands": (
            while_in_ring: [(applies_to: All([Maneuver, TitleContains("chop")]), damage: 1)],
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: All([Maneuver, TitleContains("chop")]),
                    effects: [Optional([Choice([[Draw(who: You, n: 1)], [RingsideToArsenalBottom(who: You, n: 1)]])])],
                ),
            ],
        ),
        // Disregarding modifications is not supported yet.
        "Restricted Use in This Area": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // Putting it into your hand after it reverses is not supported yet.
        "Forever": (
            on_play: [ShuffleThisIntoArsenal, LookAtHand(who: Opponent), Discard(who: Opponent, n: 1, pick: Controller)],
            reverses: Some((targets: All([Maneuver, Not(ManeuverType(TrademarkFinisher))]), overturned_only: true)),
        ),
        // Approximation: Backlash deck reversals are the Mid-match ones.
        "Flying Forearm": (
            play_after: Some(AnyOf([All([Maneuver, DamageAtLeast(3)]), Title("Irish Whip")])),
            no_arsenal_reversal: true,
            not_reversed_by: Some(Trait(MidMatch)),
            reverses: Some((targets: All([Maneuver, After(Title("Irish Whip"))]))),
        ),
        // Enforcers are not supported yet.
        "Uncle Eric's Karate Kick": (
            bonuses: [(fortitude: -5)],
            on_play: [Optional([RingsideToHand(who: You, n: 1, filter: Some(Not(Trait(Unique))))])],
            reverses: Some((targets: All([Not(Trait(Unique)), Trait(MidMatch)]))),
        ),
        // Only the Superstar Value part: counting the cards in the opponent's hand is not supported yet.
        "Daddy's Little Girl": (
            requires: Some(
                Not(AnyOf([OpponentSuperstar("Vince McMahon"), OpponentSuperstar("Triple H"), OpponentSuperstar("The Game")])),
            ),
            on_play: [Counted(count: OpponentValueTimes(1), effect: Mill(who: Opponent, n: 0))],
        ),
        // Packing 5 copies is not supported yet.
        "Five Knuckle Shuffle": (play_after: Some(Maneuver), on_play: [RingsideToArsenal(who: You, n: 5, up_to: true)]),
        // The Pre-match slot change and coming in from the Backlash deck are not supported yet.
        "Managed by Stacy Keibler": (
            extra_traits: [UniversallyUnique],
            ring_ability: Some((sacrifice: true, effects: [Search(filter: Not(Trait(Unique)))])),
        ),
        // What happens after his first card next turn is not supported yet.
        "Want to Take My Test?": (
            on_play: [
                RevealHand(who: You),
                EndTurn,
                BoostOpponent((applies_to: Any, duration: NextTurnFirstCard, fortitude: -6, reversal_fortitude: 15)),
            ],
        ),
        // Approximation: the card is shuffled into the Arsenal instead of put on the bottom. The Managed by Stevie
        // Richards option is not supported yet.
        "Spider Web Moonsault": (
            play_after: Some(Any),
            as_action: Some((on_play: [ShuffleThisIntoArsenal, Draw(who: You, n: 2)])),
        ),
        // Over Sell Maneuver cannot be played yet, so its restriction needs nothing.
        "Girly Grab": (
            only_packed_by: [
                "A.J. Lee", "Alexa Bliss", "Asuka", "Babe of the Year", "Bayley", "Becky Lynch", "Beth Phoenix",
                "Bianca Belair", "Brie Bella", "Carmella", "Charlotte", "Christy", "Chyna", "Chyna Doll",
                "Crimson Goddess", "Dakota Kai", "Damage CTRL", "Ember Moon", "Emma", "Eve", "Gail Kim",
                "Gail Kim and Molly Holly", "IYO SKY", "Jacqueline", "Kairi Sane", "Lacey Evans", "Lay-Cool",
                "Lita", "Liv Morgan", "Mae Young", "Mandy Rose", "Maryse", "Melina", "Mickie James", "Molly Holly",
                "Naomi", "Natalya", "Nia Jax", "Nidia", "Nikki Bella", "Paige", "Rhea Ripley", "Ronda Rousey",
                "Sable", "Sasha Banks", "Shayna Baszler", "Sherri Martel", "Stacy Keibler", "Stephanie McMahon",
                "Summer Rae", "The Bella Twins", "The Fabulous Moolah", "The Iiconics", "The Legit Boss",
                "The Man", "Tiffany Stratton", "Torrie Wilson", "Toxic Attraction", "Trish Stratus",
                "Vickie Guerrero", "Victoria", "X-treme Diva",
            ],
            not_reversed_by: Some(Not(Title("Elbow to the Face"))),
            on_play: [Optional([Draw(who: You, n: 1)])],
        ),
        // Approximation: GM and Chairman Superstars are the ones named here.
        "When You Run the Show, You Make the Rules": (
            only_packed_by: ["SmackDown! GM Theodore Long", "Eric Bischoff", "Stephanie McMahon", "Vince McMahon"],
            on_play: [
                Boost((applies_to: Any, duration: Turns(2), no_backlash_reversal: true)),
                SkipNextTurn(who: Opponent),
            ],
        ),
        "Never Forgive - Never Forget": (
            on_play: [RingsideToArsenal(who: You, n: 6, up_to: true)],
            reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]))),
        ),
        // Reversing Activated Card Effects and continuing the turn are not supported yet.
        "McMahon-us Interrupt-us": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // Approximation: the opponent's draw happens at the start of his turn.
        "Gentlemen's Establishment": (
            ring_ability: Some((effects: [Choice([[Draw(who: You, n: 1)], [RingsideToArsenalBottom(who: You, n: 1)]])])),
            in_ring_start_of_turn: [If(condition: OpponentFemale, effects: [Mill(who: Opponent, n: 1)])],
            in_ring_opponent_start_of_turn: [
                AsOpponent([If(condition: Not(OpponentFemale), effects: [AsOpponent([Optional([Draw(who: You, n: 1)])])])]),
            ],
        ),
        // Approximation: the opponent chooses his card instead of at random. Title Belts are not supported yet.
        "Hardcore Originator of ECW": (
            in_ring_on_play: [
                (whose: Some(You), filter: Maneuver, effects: [HandToArsenalBottom(who: Opponent, n: 1)]),
                (whose: Some(Opponent), filter: Maneuver, effects: [HandToArsenalBottom(who: Opponent, n: 1)]),
            ],
        ),
        // Taking back reversed cards and coming back from the Ringside pile are not supported yet.
        "Orlando Jordan: Chief of Staff": (requires: Some(Never)),
        // Coming back from the Ringside pile is not supported yet.
        "Destiny": (requires: Some(Never)),
        "Here Comes the Money!": (
            on_play: [Draw(who: You, n: 2), Boost((applies_to: Any, duration: NextCard, fortitude: -4))],
            reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]))),
        ),
        "Incredible Athleticism": (
            on_play: [RingsideToHand(who: You, n: 1, filter: Some(Maneuver)), RemoveFromRing(who: Opponent, n: 1, filter: Any)],
            while_in_ring: [(applies_to: All([Maneuver, Title("Shelton's Spinning Heel Kick")]), fortitude: -5, damage: 3)],
        ),
        // Approximation: the card goes to the Ringside pile instead of the bottom of the Arsenal.
        "Hello, My Name is Eugene": (
            on_play: [Search(filter: Not(Trait(Unique)))],
            ring_ability: Some((sacrifice: true, effects: [Draw(who: You, n: 1)])),
        ),
        // Approximation: the card is shuffled into the Arsenal instead of put on the bottom.
        "Le Bonsoir": (
            reverses: Some((targets: AnyOf([ManeuverType(Strike), ManeuverType(Grapple)]))),
            as_action: Some((fortitude: Some(0), on_play: [ShuffleThisIntoArsenal, RingsideToHand(who: You, n: 1)])),
        ),
    },
)
