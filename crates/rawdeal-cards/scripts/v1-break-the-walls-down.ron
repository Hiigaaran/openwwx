// Hand-written scripts for V1: Break the Walls Down cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// Raw Deal Virtual (fan-made) set. Vocabulary: Bury = bottom of the Arsenal, Recover = shuffle into the Arsenal,
// RFG/Eliminate = remove from the game, Counter = first card after reversing to end the opponent's turn.
// ACE (Activated Card Effects) of Ring cards are `ring_ability`; ACEs used during the opponent's turn are not supported.
// "Revolution card" is approximated as a card with "Revolution" in the title; "Pre-match card" in a filter as a card
// that is not a maneuver, action, Reversal or Antic. Making cards Multi, Chain, Heat or Volley, changing card types,
// packing rules and changing the Starting Hand Size are not supported unless scripted. Superstar abilities and
// Backstage cards make other cards Multi or Chain with a start-of-turn Boost for that turn (so not during the
// opponent's turn). "X-specific" in a filter is approximated as Superstar-specific.
(
    abilities: {
        // Revealing A Technical Shoot and Technically Sound and Brutal with the Superstar card and the "technical" and
        // "precision" title rule are not supported yet.
        "Bret 'The Hitman' Hart": [
            CountsAs(["Bret Hart"]),
            CannotPackMatching(All([Maneuver, TitleContains("Revolution")])),
        ],
        // Approximation: every non-Unique non-Multi maneuver is Chain ('reverse' in the text, "from hand" and the
        // Arsenal-search part are not checked).
        "Owen Hart": [
            StartOfTurn([Boost((applies_to: All([Maneuver, Not(Trait(Unique)), Not(Trait(Multi))]), duration: ThisTurn, chain: true))]),
        ],
        // Approximation: the first Action: Movie each turn cannot be reversed, even when it is not the first card.
        // Packing both Cheater and Fan Favorite cards is not supported yet.
        "Dwayne 'The Rock' Johnson": [
            FirstOfTurnIrreversible(All([Action, Keyword("Movie")])),
            PacksLogos(["The Rock"]),
        ],
        // I Have a Major Announcement in the Backstage Area and resolving last at the end of Pre-match are not supported yet.
        "The Sexy Beast": [PacksLogos(["Chris Jericho"])],
        // The Master Lock's +1 Stun Value is not supported yet.
        "Chris Masters": [
            OnOpponentReverses([
                If(
                    condition: All([OpponentReversedFrom([Hand]), OpponentReversed(Maneuver)]),
                    effects: [Optional([RemoveFromGame(who: Opponent, from: Hand, n: 1, pick: Controller)])],
                ),
            ]),
            Activated(cost: [Discard(who: You, n: 1, pick: Chosen)], effects: [Search(filter: TitleContains("maintain"))]),
        ],
        // Naming a Reversal that cannot be played is not supported yet.
        "CM Punk": [
            StartOfTurn([Boost((applies_to: Title("Double Underhook Back Breaker"), duration: ThisTurn, multi: true))]),
            DamageFor(filter: Title("Double Underhook Back Breaker"), delta: 1),
            OnPlay(title: "Double Underhook Back Breaker", effects: [DrawUpTo(who: You, n: 2)]),
        ],
        // That's Value, Argue With Tony Chimel and Mr. Kennedy's Mic changes are not supported yet.
        "The Future of Sports Entertainment": [
            NoSlotFor(Not(AnyOf([Maneuver, Action, Reversal, Antic]))),
            PacksLogos(["Ken Kennedy"]),
            OpponentCannotPlay("I'm Gonna Break You"),
            CannotPack("Who's Cooler than Michelle McCool?"),
        ],
        // Copying the opponent's Ability and the Backstage 'Stevie' cards are not supported yet.
        "Stevie Richards": [
            StartOfTurn([
                MoveCards(who: You, from: Removed, to: Arsenal, n: 2, up_to: true, filter: Some(All([Not(Reversal), Not(TitleContains("Odds"))]))),
            ]),
            CannotPackMatching(TitleContains("BASH")),
        ],
        // Approximation: the Maximum Hand Size is checked at the start of your turn only, and the extra cards always
        // go on the bottom of the Arsenal.
        "Finlay": [
            OnOpponentPlayMatching(filter: Any, effects: [Optional([Draw(who: You, n: 1)])]),
            StartOfTurn([
                Counted(
                    count: Minus(HandSize, Plus(Const(5), YourRingMatching(All([Maneuver, Not(Reversal)])))),
                    effect: HandToArsenalBottom(who: You, n: 0),
                ),
            ]),
        ],
        // Blanking the next maneuver is not supported yet.
        // Packing restrictions on Corners are not supported yet.
        "New Age Outlaws": [
            Activated(
                cost: [RemoveFromGame(who: You, from: Hand, n: 4)],
                effects: [
                    Boost((
                        applies_to: All([Maneuver, Not(Trait(Unique))]),
                        duration: NextCard,
                        no_reversal_from: [Hand, Backlash, Ringside, Ring, Under],
                    )),
                ],
            ),
            PacksLogos(["B.A. Billy Gunn", "Billy Gunn", "Road Dogg"]),
            CannotPackMatching(
                AnyOf([
                    All([TitleBelt, Not(TitleContains("Tag Team"))]),
                    TitleContains("blank"),
                    TitleContains("brass"),
                    TitleContains("parts"),
                    TitleContains("ring psychology"),
                ]),
            ),
        ],
        // Approximation: the opponent discards 1 random card instead of 1 of 3 revealed random cards.
        // Stopping him from playing 'Melina' cards is not supported yet.
        "Melina": [
            Activated(cost: [Discard(who: You, n: 1, pick: Chosen)], effects: [Discard(who: Opponent, n: 1, pick: Random)]),
            CannotPackMatching(All([Maneuver, DamageAtLeast(6), Not(TitleContains("choke")), Not(TitleContains("kick"))])),
        ],
        // Playing a maneuver along with an action is not supported yet.
        "Cryme Tyme": [CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))]))],
        // Approximation: you choose the Superstar-specific Pre-match card to remove, and "without 'reverse' in the
        // text" is ignored. The Tick Tock of the Clock in the Backstage Area is not supported yet.
        "MVP": [
            OnPlayMatching(filter: All([Maneuver, FortitudeAtMost(0)]), effects: [Optional([Search(filter: All([Maneuver, FortitudeAtMost(0)]))])]),
            OnPlayMatching(
                filter: Maneuver,
                effects: [RemoveFromRing(who: You, n: 1, filter: All([SuperstarSpecific, Not(AnyOf([Maneuver, Action, Reversal, Antic]))]))],
            ),
            CannotPackMatching(All([Maneuver, Not(Trait(Unique)), Not(FortitudeAtMost(0)), Not(Title("Sidewalk Slam"))])),
        ],
        // Counters ignoring "Can only be played", the extra logo cards put into the Backlash deck and being a Tag Team
        // are not supported yet.
        "The Radicalz": [],
        // Playing two 'Dynamic' maneuvers together and the Arsenal and Corner packing rules are not supported yet.
        "Chyna Doll": [
            PacksLogos(["Chyna"]),
            StartOfTurn([Boost((applies_to: All([Maneuver, TitleContains("Dynamic"), Holds(FortitudeAboveOpponent)]), duration: ThisTurn, multi: true))]),
        ],
        // Armageddon Is Upon Us is not supported yet.
        "Latino Cheat": [
            DrawSegment(0),
            StartOfTurn([Search(filter: Any)]),
            CannotPlayMatching(SameTitleInRing),
            PacksLogos(["Eddie Guerrero"]),
            CannotPack("Redemption"),
        ],
        // Blanking Storylines, removing Momentum and the Revolution logo are not supported yet.
        "Rated RKO": [PacksLogos(["Edge", "Randy Orton"])],
        // Packing 'psychology' and '1000' cards in the Backstage Area is not supported yet.
        "Dean Malenko": [],
        // Turning maneuvers into Volley maneuvers is not supported yet.
        "The Blue Blazer": [PacksLogos(["Owen Hart"])],
        // Approximation: the opponent shuffles 1 card of his choice back after redrawing.
        // The Big Splash in the Corner and Death Valley Driver changes are not supported yet.
        "The Godfather": [
            Activated(
                cost: [],
                effects: [ShuffleHandAndRedraw(who: You), ShuffleHandAndRedraw(who: Opponent), HandToArsenal(who: Opponent, n: 1)],
            ),
        ],
        // Counting the first High Risk as played after the reversed card is not supported yet.
        "Johnny Nitro": [
            FortitudeFor(filter: Title("Melina: Naughty Manager"), delta: -30),
            PacksLogos(["MNM"]),
        ],
        // Approximation: the first From the Top Rope each turn cannot be reversed, even when it is not the first card.
        "Macho Man Randy Savage": [
            CountsAs(["Macho Man"]),
            DamageFor(filter: TitleContains("elbow"), delta: 4),
            FirstOfTurnIrreversible(Title("From the Top Rope")),
        ],
        // Ignoring 'completely' is not supported yet. Approximation: Managers are cards with "Managed by" in the title.
        "The Ultimate Warrior": [
            StartOfTurn([Boost((applies_to: All([Maneuver, Holds(InYourRing(Title("Back to Basics")))]), duration: ThisTurn, multi: true))]),
            CannotPlayMatching(All([Maneuver, EarlierThisTurn(filter: Maneuver, n: 2)])),
            CannotPack("Dallas, Texas"),
            CannotPackMatching(TitleContains("Managed by")),
        ],
        // Playing first in Pre-match, the "not Heel" rule and being a Tag Team are not supported yet.
        "The Road Warriors": [CannotPackMatching(All([Action, Trait(Face)]))],
        // The opponent's discard to play Face or Heel cards, reversing Trademark Finishers by discarding 4 Reversals and
        // starting the game are not supported yet.
        "The Legion of Doom": [PacksLogos(["The Road Warriors"])],
        // Approximation: remove 1 maneuver; your next maneuver cannot be reversed from the Backlash deck or the
        // Ringside pile, even by Unique reversals (blanking it, the same-type check and the 2-maneuver option are not
        // supported).
        "Mr. Perfect": [
            Activated(
                cost: [RemoveFromGame(who: You, from: Hand, n: 1, filter: Some(Maneuver))],
                effects: [Boost((applies_to: Maneuver, duration: NextCard, no_reversal_from: [Backlash, Ringside]))],
            ),
            CannotPackMatching(All([Maneuver, TitleContains("Revolution")])),
        ],
        // Approximation: the 4 extra cards are drawn just before the Draw Segment.
        "The Four Horsemen": [
            StartOfTurn([Draw(who: You, n: 4), HandToArsenalBottom(who: You, n: 4)]),
            NoSlotFor(TitleBelt),
            PackBothAlignments,
        ],
        // Looking at a random card of the opponent's hand is not supported yet.
        "The Brain Busters": [StartOfTurn([Optional([Shuffle(who: You)])])],
    },
    scripts: {
        // Strikes
        "Whirlwind Kick": (
            bonuses: [(when: InYourRing(TitleContains("Revolution")), damage: 4)],
            reversal_limits: [(by: Some(DamageAtLeast(3)), when: InYourRing(TitleContains("Revolution")))],
            on_play: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 2, up_to: true, bottom: true)],
        ),
        // Not being Multi for women and lowering the Volley: # are not supported yet.
        "Sucker Punch": (
            on_play: [If(condition: YouAre("Male"), effects: [RemoveFromGame(who: You, from: Ringside, n: 3, up_to: true, pick: Random)])],
        ),
        // Choosing new maneuver types is not supported yet.
        "Double Team": (only_packed_by: ["Tag Team"]),
        "Spraypainted by the nWo": (
            requires: Some(AnyOf([InYourRing(Keyword("nWo")), BackstageRevealed(who: You, filter: Keyword("nWo"))])),
            play_after: Some(Any),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            on_play: [
                If(condition: Not(InYourRing(Title("Ref Takes a Bump"))), effects: [Discard(who: Opponent, n: 1, pick: Chosen)]),
                If(
                    condition: InYourRing(Title("Ref Takes a Bump")),
                    effects: [
                        Discard(who: Opponent, n: 1, pick: Random),
                        RemoveFromGame(who: Opponent, from: Ringside, n: 2, pick: Controller),
                    ],
                ),
                RemoveFromGame(who: Opponent, from: Arsenal, n: 1),
            ],
        ),
        // Its other title and choosing it to boost another maneuver (ACE) are not supported yet.
        "Table": (
            not_reversed_by: Some(AnyOf([Title("Elbow to the Face"), Title("A Revolution of the Mind"), Title("Sidewalk Slam")])),
        ),
        // Its other title and choosing it to boost another maneuver (ACE) are not supported yet.
        "Chair": (),
        // Choosing it to boost another maneuver (ACE) is not supported yet.
        "Ladder": (),
        "nWo Beatdown": (
            requires: Some(AnyOf([InYourRing(Keyword("nWo")), BackstageRevealed(who: You, filter: Keyword("nWo"))])),
            play_after: Some(Any),
            play_after_unless: Some(AnyOf([InYourRing(Title("Ref Takes a Bump")), OpponentRingHas(filter: Title("Ref Takes a Bump"), n: 1)])),
            reversals_needed: 2,
        ),
        // Becoming Heat or BASH is not supported yet.
        "Spinning Wrist Lock Hammerlock Headlock Takedown Armbar of Doom": (
            chain_when: Some(InYourRing(All([Maneuver, Trait(Chain)]))),
            on_play: [
                RingsideToArsenal(
                    who: You,
                    n: 4,
                    up_to: true,
                    filter: Some(AnyOf([Trait(Chain), Keyword("Heat"), TitleContains("BASH"), Trait(Multi), Trait(Unique)])),
                ),
            ],
        ),
        // Reducing its damage to 0 to resolve it and protect the next Strike is not supported yet.
        "Trash Can": (),

        // Grapples
        "Quick Snap Power Bomb": (
            reverses: Some((targets: AnyOf([TitleContains("rana"), Title("The West Coast Pop")]))),
            on_play: [
                Counted(
                    count: YourRingMatching(All([Maneuver, AnyOf([TitleContains("bomb"), TitleContains("power"), TitleContains("slam")])])),
                    effect: DrawUpTo(who: You, n: 0),
                ),
            ],
        ),
        "Spiral Bomb": (
            bonuses: [(when: InYourRing(TitleContains("Revolution")), fortitude: -4)],
            on_play: [
                Discard(who: Opponent, n: 3, pick: Chosen),
                If(condition: InYourRing(TitleContains("Revolution")), effects: [DrawUpTo(who: You, n: 3)]),
            ],
        ),
        // Approximation: the Revolution part searches the opponent's Arsenal for any non-Reversal card.
        "Spinning Arm Lock": (
            on_play: [
                DrawUpTo(who: You, n: 1),
                If(
                    condition: InYourRing(TitleContains("Revolution")),
                    effects: [Optional([MillChosen(who: Opponent, n: 1, filter: Some(Not(Reversal)))])],
                ),
            ],
        ),

        // High Risk
        // Searching for it instead of Falling Fist and King's Crown are not supported yet.
        "Fist Drop": (
            play_after: Some(All([Maneuver, DamageAtLeast(2)])),
            multi_when: Some(YouAre("Jerry Lawler")),
            on_play: [
                RingsideToHand(who: You, n: 1, up_to: true),
                If(
                    condition: Not(AnyOf([YouAre("Jerry Lawler"), YouAre("'The Million Dollar Man' Ted DiBiase"), YouAre("The Million Dollar Man")])),
                    effects: [EndTurn],
                ),
            ],
        ),
        // Becoming an Extreme is not supported yet.
        "X-treme Dive Over the Ropes": (play_after: Some(Any)),
        // The High-Flying Style choice is not supported yet.
        "Perfectly-Executed Moonsault": (
            play_after: Some(AnyOf([All([Maneuver, DamageAtLeast(6)]), Title("From the Top Rope"), Title("From the Middle Turnbuckle")])),
            bonuses: [(when: After(AnyOf([Title("From the Top Rope"), Title("From the Middle Turnbuckle")])), damage: 3)],
            multi_when: Some(After(AnyOf([Title("From the Top Rope"), Title("From the Middle Turnbuckle")]))),
            on_play: [Search(filter: All([Trait(SmackDown), Not(Trait(Unique))]))],
        ),
        "High-Flying Hurricanrana": (
            play_after: Some(Any),
            bonuses: [(when: AnyOf([Superstar("Funaki"), After(Title("Springboard"))]), fortitude: -6)],
            reverses: Some((targets: All([ManeuverType(Grapple), Not(Trait(Unique))]), fortitude: Some(13), damage: Fixed(7))),
        ),

        // Trademark Finishers
        // Becoming Superstar-specific is not supported yet.
        "Old School Piledriver": (
            multi_when: Some(YouAre("Jerry Lawler")),
            bonuses: [
                (when: InYourRing(Title("Back to Basics")), damage: 5),
                (when: YouAre("Jerry Lawler"), fortitude: -5, damage: 10),
            ],
            on_play: [Discard(who: Opponent, n: 2, pick: Chosen)],
        ),
        // Approximation: the opponent shuffles cards back only when he reverses it from his hand.
        // The packing rule is not supported yet.
        "Con-Chair-To": (
            play_after: Some(Any),
            requires: Some(
                AnyOf([
                    HandHas(All([TitleContains("chair"), Not(Title("Con-Chair-To"))])),
                    CountAtLeast(count: YourRingMatching(TitleContains("chair")), n: 2),
                ]),
            ),
            before_reversal: [
                If(
                    condition: CountAtMost(count: YourRingMatching(TitleContains("chair")), n: 1),
                    effects: [DiscardMatching(who: You, n: 1, filter: All([TitleContains("chair"), Not(Title("Con-Chair-To"))]), pick: Chosen)],
                ),
            ],
            no_backlash_reversal: true,
            on_play: [Discard(who: Opponent, n: 3, pick: Random)],
            on_reversed_from_hand: [RingsideToArsenal(who: Opponent, n: 5, up_to: true)],
        ),

        // Actions
        "Total Teamwork": (
            only_packed_by: ["Tag Team"],
            not_packed_by: ["The Home Team", "The Heat Seekers"],
            requires: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            on_play: [Boost((applies_to: Maneuver, duration: NextCard, no_hand_reversal: true))],
            reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]), effects: [DrawUpTo(who: You, n: 2)])),
        ),
        // Approximation: answers any non-Unique D: 0 Reversal from hand; the reversed card does not go to the Ring.
        "Ref Takes a Bump": (
            requires: Some(Never),
            answers_reversal: Some(All([Reversal, Not(Trait(Unique)), DamageAtMost(0)])),
        ),
        // The Revolution part (his Reversals use your Fortitude) is not supported yet.
        "Turn the Match Around": (on_play: [Boost((duration: NextCard, use_opponent_fortitude: true))]),
        // The ACE (removing cards the opponent moves from his Ringside pile) is not supported yet.
        "Paul Heyman's Shoot Promo": (on_play: [DrawUpTo(who: You, n: 2)]),
        // Removing it by putting a maneuver into the Ringside pile or discarding 4 cards is not supported yet.
        "nWo Comes to Ringside": (
            requires: Some(AnyOf([InYourRing(Keyword("nWo")), BackstageRevealed(who: You, filter: Keyword("nWo"))])),
            restricts_opponent: Some((filter: EarlierThisTurn(filter: Any, n: 2))),
        ),
        // Approximation: searches for any maneuver (sharing a title word is not supported); the "not played" part is not supported yet.
        "Maintained Offensive": (play_after: Some(Maneuver), on_play: [Search(filter: Maneuver)]),
        // Its packing rule (not by Stables or Superstars who can pack Tag Team Title Belts) and the opponent's part when
        // he can pack Tag Team Title Belts are not supported yet.
        "Here Comes the Cavalry!": (
            on_play: [
                RingsideToArsenal(who: You, n: 8, up_to: true),
                DrawUpTo(who: You, n: 2),
                If(condition: HasEnforcer(You), effects: [Optional([ChooseEnforcer(who: You)])]),
            ],
        ),
        // Approximation: Jerry Lawler's version cannot be reversed whether or not the opponent has an ECW card.
        "I'm Sick of This 'Extremely Crappy Wrestling'": (
            irreversible_when: Some(YouAre("Jerry Lawler")),
            multi_when: Some(OpponentRingHas(filter: Keyword("ECW"), n: 1)),
            on_play: [
                RemoveFromGame(who: Opponent, from: Ringside, n: 1, up_to: true, filter: Some(Keyword("Foreign Object")), pick: Controller),
                RemoveFromGame(who: Opponent, from: Ringside, n: 20, up_to: true, filter: Some(Title("Steel Chain Shot")), pick: Controller),
                RemoveFromGame(who: Opponent, from: Ring, n: 1, up_to: true, filter: Some(Keyword("Foreign Object")), pick: Controller),
                Search(
                    filter: All([Maneuver, Not(Trait(Unique)), Not(Keyword("Foreign Object")), Not(ManeuverType(Extreme))]),
                    up_to: true,
                ),
            ],
        ),
        // Blanking the opponent's Reversals from hand for 3 turns is not supported yet.
        "Unstoppable Force": (
            on_play: [If(condition: AnyOf([YouAre("Brock Lesnar"), YouAre("Rhyno"), YouAre("Lashley")]), effects: [DrawUpTo(who: You, n: 2)])],
        ),
        // Choosing it to boost a maneuver (ACE) and reversing High Risks from hand are not supported yet.
        "Stop Sign": (),

        // Reversals
        // Telling which cards have a printed reversal restriction is not supported yet.
        "Carlito Says 'That's Not Cool!'": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // Approximation: it is F: 0 when the opponent has 15 or more Fortitude, F: 15 otherwise.
        "Stop Trying To Hit Me and Hit Me!": (
            reverses: Some((
                targets: All([Not(SuperstarSpecific), Not(Maneuver)]),
                fortitude_when: Some((CountAtLeast(count: OpponentFortitude, n: 15), 0)),
                effects: [CannotPlay(who: Opponent, filter: All([Not(SuperstarSpecific), Not(Maneuver)]), turns: 1)],
            )),
        ),

        // Pre-match Events
        // Requiring an ECW Backstage card and the ACE are not supported yet.
        "Backed by Paul Heyman": (
            end_of_prematch: [MoveCards(who: You, from: Backlash, to: Ring, n: 1, filter: Some(Title("Managed by Paul Heyman")))],
        ),
        // Blocking the opponent's Reversals to your first SmackDown maneuver and the Pre-match Capacity text are not
        // supported yet.
        "Backed by Smackdown GM Vickie Guerrero": (
            not_packed_by: ["Legend", "Chris Benoit", "Eddie Guerrero", "Latino Cheat", "Rey Mysterio", "Shane O'Mac", "The People's Champ"],
        ),
        // The packing rule, ECW One Night Stand and the Ability text changes are not supported yet.
        "ECW on Sci-Fi": (only_packed_by: ["Extremist"], on_play: [Draw(who: You, n: 2)]),
        // Turning 'rana' Strikes into High Risks and the no-damage Reversals are not supported yet.
        "High-Flying Style": (
            only_packed_by: [
                "X-Pac", "Jeff Hardy", "Matt Hardy", "Lita", "Tajiri", "Hurricane", "Rey Mysterio", "MNM", "X-treme Diva",
                "Mexicools", "Chavo Guerrero", "Funaki", "Kenny", "Revolution Sabu", "Owen Hart", "The Blue Blazer",
                "Latino Cheat", "Johnny Nitro",
            ],
            while_in_ring: [(applies_to: AnyOf([Title("From the Top Rope"), Title("From the Middle Turnbuckle")]), irreversible: true)],
        ),
        "I'll Taunt You, Then I'll BASH You!": (
            end_of_prematch: [Optional([Search(filter: Not(Trait(Unique)))])],
            ring_after_success: Some((filter: Trait(Unique), effects: [Mill(who: Opponent, n: 6)], end_turn: false)),
            while_in_ring: [(applies_to: All([Maneuver, Holds(OpponentRingHas(filter: Title("Yo! Kill da Beat!"), n: 1))]), fortitude: -3)],
        ),
        // Approximation: done at the end of the Pre-match phase; the Back to Basics option is not supported yet.
        "Old School Donnybrook": (
            end_of_prematch: [Optional([BuryHand(who: You, then: Draw), BuryHand(who: Opponent, then: Draw)])],
        ),
        // The packing rule and A No Show are not supported yet.
        "Playing By the Rules": (
            pre_match_limit: 1,
            while_in_ring: [(applies_to: All([Reversal, Trait(Face)]), fortitude: -5)],
            while_in_ring_opponent: [(applies_to: All([Reversal, AnyOf([Trait(Heel), Keyword("Run-in")])]), fortitude: 5)],
        ),
        "Premiere WWF Superstar": (
            only_packed_by: [
                "Stone Cold Steve Austin", "The Rattlesnake", "Undertaker", "Dead Man Inc", "The Phenom", "Mankind",
                "Cactus Jack", "Dude Love", "The Mystery Wrestler", "Triple H", "The Game", "Chris Jericho",
                "Highlight Of The Night", "The Sexy Beast", "Kane", "Big Freak'n Machine", "Two-Man Power Trip",
                "Brothers of Destruction",
            ],
            pre_match_limit: 3,
            restricts_opponent: Some((filter: Title("I'm Gonna Break You"))),
        ),
        // The Starting Hand Size against Legends and the ACE are not supported yet.
        "Ruthless Aggression": (pre_match_limit: 1),
        // Approximation: the 2 other cards go on the bottom of the Arsenal; the ACE discards a random Reversal from his hand.
        // The Starting Hand Size part is not supported yet.
        "Taunted by Chanting Fans": (
            on_play: [Dig(n: 3, take: 1)],
            ring_ability: Some((sacrifice: true, effects: [DiscardMatching(who: Opponent, n: 1, filter: Reversal, pick: Random)])),
        ),
        // Changing Volley: # and the Reversal limits are not supported yet.
        "The Opening Volley": (),
        // Its Reversal protection and counting cards as Trademark Finishers are not supported yet.
        "The Revolution Will Not Be Verified...": (),
        // Approximation: only a Legend can play it. Its Reversal protection is not supported yet; Eliminate removes it
        // from the game.
        "The Marquee Says 'Wrestling!'": (
            requires: Some(YouAre("Legend")),
            ring_ability: Some((
                requires: Some(FortitudeAtLeast(7)),
                effects: [
                    ReturnThis(to: Removed),
                    Search(filter: All([AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]), Not(Trait(Unique))])),
                ],
            )),
        ),
        // Approximation: at the end of the Pre-match phase all players shuffle; the rest of its text is not supported yet.
        "Dallas, Texas": (),

        // Pre-match Objects, Storylines, Managers, Stipulations, Feuds
