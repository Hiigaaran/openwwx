        // Approximation: any Superstar-specific card counts, not only Eugene's.
        "Inspiration for a New Generation": (
            on_play: [Search(filter: SuperstarSpecific)],
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: SuperstarSpecific,
                    effects: [Choice([[Discard(who: Opponent, n: 1, pick: Random)], [RingsideToArsenalBottom(who: You, n: 3)]])],
                ),
            ],
        ),
        "Blindside Spinebuster": (
            from_ringside: Some(Always),
            before_reversal: [
                If(
                    condition: PlayedFromRingside,
                    effects: [
                        RemoveFromGame(
                            who: You,
                            from: Ringside,
                            n: 1,
                            filter: Some(AnyOf([TitleContains("spine buster"), TitleContains("spinebuster")])),
                        ),
                    ],
                ),
            ],
            reverses: Some((
                targets: Action,
                ringside_only: true,
                effects: [
                    RemoveFromGame(
                        who: You,
                        from: Ringside,
                        n: 1,
                        filter: Some(AnyOf([TitleContains("spine buster"), TitleContains("spinebuster")])),
                    ),
                ],
            )),
        ),
        "Seen the Glory - Told the Story": (
            on_play: [Search(filter: TitleContains("sleeper"))],
            while_in_ring: [(applies_to: All([Maneuver, TitleContains("sleeper")]), damage: 2)],
        ),
        "Never Bet Against Me, Playa": (
            reverses: Some((
                targets: Any,
                from_hand_only: true,
                on_reverse: [
                    Choice([[RingsideToHand(who: You, n: 1, filter: Some(Trait(Unique)))], [Search(filter: Trait(Unique))]]),
                ],
            )),
        ),
        "Ground and Pound": (
            from_ringside: Some(CountAtLeast(count: YourRingsideMatching(All([Keyword("Heat"), Not(Title("Ground and Pound"))])), n: 5)),
            reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]), ringside_only: true)),
        ),
        // Approximation: at most 5 cards.
        "I Wish Monsoon Was Here": (
            on_play: [
                Choice([
                    [],
                    [If(condition: CountAtLeast(count: YourRingsideSize, n: 1), effects: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, top: true), RemoveFromGame(who: You, from: Arsenal, n: 1, filter: Some(Any))])],
                    [If(condition: CountAtLeast(count: YourRingsideSize, n: 2), effects: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 2, top: true), RemoveFromGame(who: You, from: Arsenal, n: 2, filter: Some(Any))])],
                    [If(condition: CountAtLeast(count: YourRingsideSize, n: 3), effects: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 3, top: true), RemoveFromGame(who: You, from: Arsenal, n: 3, filter: Some(Any))])],
                    [If(condition: CountAtLeast(count: YourRingsideSize, n: 4), effects: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 4, top: true), RemoveFromGame(who: You, from: Arsenal, n: 4, filter: Some(Any))])],
                    [If(condition: CountAtLeast(count: YourRingsideSize, n: 5), effects: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 5, top: true), RemoveFromGame(who: You, from: Arsenal, n: 5, filter: Some(Any))])],
                ]),
                Search(filter: Any),
            ],
        ),
        // Permanent cards are not supported yet.
        "JYD's Chain": (
            ringside_ability: Some((
                effects: [ReturnThis(to: Hand), RingsideToHand(who: You, n: 1, filter: Some(ManeuverType(Grapple)))],
            )),
            on_play: [Choice([[DiscardAll(who: Opponent, filter: Any)], [BacklashToRingside(who: Opponent, n: 60)]])],
            in_ring_start_of_turn: [Discard(who: Opponent, n: 1, pick: Chosen), Mill(who: Opponent, n: 1)],
        ),
        // Approximation: as a Chain card the opponent discards 2 cards to reverse it, not 3.
        "Cobra Clutch": (
            on_play: [
                Search(filter: Title("Maintain Hold")),
                Boost((applies_to: Title("Maintain Hold"), duration: NextCard, fortitude: -4)),
            ],
        ),
        "United We Stand": (on_play: [Optional([RingsideToBacklash(who: You, n: 1)])]),
        // Halving the opponent's Fortitude is not supported yet.
        "Divided You Fall": (on_play: [Draw(who: You, n: 1)]),
        // Approximation: each part is optional (you may skip it).
        "Who's Under the Paint?": (
            on_play: [
                Counted(count: OpponentHandExcess, effect: Optional([Discard(who: Opponent, n: 0, pick: Chosen), Draw(who: You, n: 0)])),
                Counted(
                    count: Minus(OpponentArsenalSize, YourArsenalSize),
                    effect: Optional([Mill(who: Opponent, n: 0), RingsideToArsenal(who: You, n: 0)]),
                ),
            ],
        ),
        "Carlito's Cool Carribean Neck Breaker": (
            ringside_ability: Some((cost: [Discard(who: You, n: 3, pick: Chosen)], effects: [ReturnThis(to: Hand)])),
        ),
        // Hand-only reversals after a DDT are not supported yet.
        "The Snakeline": (
            play_after: Some(Any),
            bonuses: [(fortitude: -20)],
            reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]), from_hand_only: true)),
        ),
        // Arsenal-only reversals for the first maneuvers of the game are not supported yet.
        // Approximation: at most 5 cards.
        "Backed by Virgil": (
            ring_ability: Some((
                sacrifice: true,
                effects: [
                    Choice([
                            [],
                            [If(condition: CountAtLeast(count: YourRingsideSize, n: 1), effects: [RemoveFromGame(who: You, from: Ringside, n: 1), MoveCards(who: You, from: Removed, to: Arsenal, n: 1, bottom: true)])],
                            [If(condition: CountAtLeast(count: YourRingsideSize, n: 2), effects: [RemoveFromGame(who: You, from: Ringside, n: 2), MoveCards(who: You, from: Removed, to: Arsenal, n: 2, bottom: true)])],
                            [If(condition: CountAtLeast(count: YourRingsideSize, n: 3), effects: [RemoveFromGame(who: You, from: Ringside, n: 3), MoveCards(who: You, from: Removed, to: Arsenal, n: 3, bottom: true)])],
                            [If(condition: CountAtLeast(count: YourRingsideSize, n: 4), effects: [RemoveFromGame(who: You, from: Ringside, n: 4), MoveCards(who: You, from: Removed, to: Arsenal, n: 4, bottom: true)])],
                            [If(condition: CountAtLeast(count: YourRingsideSize, n: 5), effects: [RemoveFromGame(who: You, from: Ringside, n: 5), MoveCards(who: You, from: Removed, to: Arsenal, n: 5, bottom: true)])],
                    ]),
                ],
            )),
        ),
        // Needing 3 Reversals is not supported yet.
        "The Three Amigos": (play_after: Some(Any)),
        // Approximation: the extra damage per card in his Ring is dealt as separate damage.
        "Funaki's Ensugiri": (
            on_play: [Counted(count: OpponentRingMatching(Any), effect: Damage(who: Opponent, n: 0))],
            while_in_ring: [(applies_to: Title("Springboard"), ignore_play_after: true)],
        ),
        // Keeping cards under it is not supported yet.
        "Size Matters": (
            ring_ability: Some((
                sacrifice: true,
                effects: [
                    RingsideToHand(
                        who: You,
                        n: 3,
                        up_to: true,
                        filter: Some(AnyOf([Title("Irish Whip"), Title("Throw Into the Corner Turnbuckle"), Title("Gut Wrench")])),
                    ),
                ],
            )),
        ),
    },
)
