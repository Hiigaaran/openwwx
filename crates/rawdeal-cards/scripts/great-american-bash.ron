// Hand-written scripts for Great American Bash cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// Backstage, "Trademark Finisher: Run-In" and "Action: Movie" cards are skipped by the importer.
// Keeping cards under other cards and the Volley rules are not supported yet.
(
    abilities: {
        // Burying a card at the end of the opponent's turn and the 40 extra Arsenal cards are not supported yet.
        "Andre the Giant": [
            CannotPlayMatching(All([Trait(SetUp), EarlierThisTurn(filter: Trait(SetUp), n: 1)])),
            CannotPackMatching(
                All([
                    Not(SuperstarSpecific),
                    AnyOf([ManeuverType(HighRisk), Trait(MidMatch), Not(AnyOf([Maneuver, Action, Reversal]))]),
                ]),
            ),
        ],
        // Stopping Arsenal reversals to his maneuvers is not supported yet.
        "Lashley": [],
        "Ken Kennedy": [],
        // The opponent's part of the Draw Segment rule and taking the bottom card of the Arsenal are not supported yet.
        "Mickie James": [
            StartOfTurn([MoveCards(who: You, from: Hand, to: Arsenal, n: 1, pick: Random, bottom: true), Draw(who: You, n: 1)]),
            DamageFor(filter: All([Maneuver, Holds(OpponentIs("Diva"))]), delta: 3),
        ],
        // Discarding to ignore "Can only be played" text and the Arsenal-only reversals are not supported yet.
        "Mr. Pay-Per-View": [
            OnPlayMatching(filter: ManeuverType(HighRisk), effects: [EndTurn]),
            PacksLogos(["Rob Van Dam"]),
        ],
        // Enforcer opponents are not recognised.
        "The Ultimate Survivor": [
            EndOfPrematch([
                If(
                    condition: Not(
                        AnyOf([
                            OpponentSuperstar("Edge"),
                            OpponentSuperstar("Leader of the Edge Army"),
                            OpponentIs("Legend"),
                            OpponentIs("Tag Team"),
                        ]),
                    ),
                    effects: [Counted(count: OpponentValueTimes(1), effect: MoveCards(who: You, from: Hand, to: Arsenal, n: 0, bottom: true))],
                ),
            ]),
            Activated(cost: [], effects: [Search(filter: All([SuperstarSpecific, Not(Reversal)]))]),
            PacksLogos(["Matt Hardy"]),
            CannotPack("Version 1.0"),
        ],
        // Blocking Pre-match cards by their text is not supported yet.
        "The Boogeyman": [
            Activated(
                cost: [],
                effects: [RemoveFromGame(who: Opponent, from: Ringside, n: 1, filter: Some(Reversal), pick: Controller)],
            ),
            CannotPackMatching(All([AnyOf([Maneuver, Action]), Not(Reversal), Not(TitleContains("BASH"))])),
        ],
        // Revealing and hiding Superstars and the Set-up part are not supported yet.
        "The Spirit Squad": [FortitudeFor(filter: TitleContains("Give me"), delta: -5)],
        // Playing a Strike as a High Risk maneuver is not supported yet.
        "Johnny": [PacksLogos(["The Spirit Squad"])],
        // Extra Stun Value and making maneuvers Multi are not supported yet.
        "Kenny": [PacksLogos(["The Spirit Squad"])],
        "Mikey": [
            Activated(
                requires: Some(HandHas(Reversal)),
                cost: [RemoveFromGame(who: You, from: Hand, n: 1, filter: Some(Reversal))],
                effects: [RingsideToHand(who: You, n: 1, filter: Some(Action))],
            ),
            PacksLogos(["The Spirit Squad"]),
        ],
        "Mitch": [
            Activated(
                cost: [DiscardMatching(who: You, n: 1, filter: Action, pick: Chosen), Mill(who: You, n: 1)],
                effects: [MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 2, pick: Random, bottom: true)],
            ),
            PacksLogos(["The Spirit Squad"]),
        ],
        // Comparing the damage of the removed card with the maneuver's is not supported yet.
        "Nicky": [PacksLogos(["The Spirit Squad"])],
    },
    scripts: {
        // High Risk
        // Approximation: the +3D from the Ringside pile is extra damage that does not count as the card's D.
        "Blindside Elbow Drop": (
            play_after: Some(AnyOf([Maneuver, SuperstarSpecific])),
            from_ringside: Some(Always),
            before_reversal: [If(condition: PlayedFromRingside, effects: [Discard(who: You, n: 2, pick: Chosen)])],
            on_play: [If(condition: PlayedFromRingside, effects: [Damage(who: Opponent, n: 3)])],
        ),
        "BASH Drop Kick": (play_after: Some(TitleContains("BASH"))),
        "Technical Splash in the Corner": (
            play_after: Some(Any),
            on_play: [Optional([Search(filter: TitleContains("technical"))])],
            as_action: Some((
                fortitude: Some(4),
                on_play: [
                    ThisToArsenal(bottom: true),
                    RemoveFromGame(who: Opponent, from: Ringside, n: 2, up_to: true, pick: Controller),
                ],
            )),
        ),
        "BASH Aerial Clothesline": (
            not_packed_by: ["Female"],
            play_after: Some(TitleContains("BASH")),
            on_play: [Counted(count: YourRingMatching(TitleContains("BASH")), effect: Discard(who: Opponent, n: 0, pick: Chosen))],
        ),
        "Corkscrew Somersault": (
            play_after: Some(All([Maneuver, Trait(Chain)])),
            on_play: [
                Counted(
                    count: YourRingMatching(All([Action, Trait(Chain)])),
                    effect: RemoveFromRing(who: Opponent, n: 0, filter: Not(Maneuver)),
                ),
            ],
        ),
        "Dynamic Flying Body Press": (
            play_after: Some(TitleContains("dynamic")),
            on_play: [Search(filter: Any)],
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),

        // Strikes
        "BASH Punch": (
            not_packed_by: ["Female"],
        ),
        // The Volley +2 is not supported yet.
        "Straight Head Butt": (bonuses: [(per: Some(Keyword("Volley")), damage: 2)]),
        "Shoot Kicker Hold": (
            not_packed_by: ["Female"],
            bonuses: [(when: After(TitleContains("shoot")), damage: 5)],
            not_reversed_by: Some(Title("A Revolution of the Mind")),
        ),
        // Effects from the Ringside pile and making maneuvers Multi are not supported yet.
        "Sizzling Clothesline": (),
        "Blindside Hook": (
            from_ringside: Some(Always),
            before_reversal: [If(condition: PlayedFromRingside, effects: [RemoveFromGame(who: You, from: Hand, n: 1)])],
            on_play: [Draw(who: Opponent, n: 1)],
        ),
        "BASH Kick": (),
        // Approximation: you put 1 of the top 3 cards into his Ringside pile, and the other 2 stay on top in
        // the order you choose instead of going to the bottom.
        "Shoot Forearm": (
            bonuses: [(when: FortitudeBelowOpponent, fortitude: -6)],
            not_reversed_by: Some(Title("A Revolution of the Mind")),
            on_play: [Arrange(who: Opponent, n: 3), Mill(who: Opponent, n: 1)],
        ),
        // Its Volley +1 for each Volley card in your Ringside pile is not supported yet.
        "The Ol' Straight-Arm Shot": (
            bonuses: [
                (when: CountAtLeast(count: YourRingsideMatching(Keyword("Volley")), n: 1), fortitude: -1),
                (when: CountAtLeast(count: YourRingsideMatching(Keyword("Volley")), n: 2), fortitude: -1),
                (when: CountAtLeast(count: YourRingsideMatching(Keyword("Volley")), n: 3), fortitude: -1),
                (when: CountAtLeast(count: YourRingsideMatching(Keyword("Volley")), n: 4), fortitude: -1),
                (when: CountAtLeast(count: YourRingsideMatching(Keyword("Volley")), n: 5), fortitude: -1),
                (when: CountAtLeast(count: YourRingsideMatching(Keyword("Volley")), n: 6), fortitude: -1),
                (when: CountAtLeast(count: YourRingsideMatching(Keyword("Volley")), n: 7), fortitude: -1),
                (when: CountAtLeast(count: YourRingsideMatching(Keyword("Volley")), n: 8), fortitude: -1),
            ],
        ),
        "Thrust Knee Lift": (
            ringside_ability: Some((
                effects: [ThisToArsenal(bottom: true), RemoveFromGame(who: Opponent, from: Ringside, n: 2, pick: Random)],
            )),
        ),
        "Technical Lunging Lariat": (
            on_play: [Optional([Search(filter: TitleContains("technical"))])],
            as_action: Some((
                fortitude: Some(6),
                on_play: [ThisToArsenal(bottom: true), RemoveFromRing(who: Opponent, n: 1, filter: Not(All([Maneuver, FortitudeAtMost(0)])))],
            )),
        ),
        "Dynamic Gut Stomp": (
            on_play: [Counted(count: YourRingMatching(TitleContains("dynamic")), effect: Draw(who: You, n: 0))],
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        // Choosing a number to lower its F and the hybrid-only hand reversals are not supported yet.
        "Precision Haymaker": (),

        // Grapples
        "BASH Suplex": (
            not_packed_by: ["Female"],
        ),
        "Blindside Drop Toe Hold": (
            from_ringside: Some(Always),
            before_reversal: [
                If(
                    condition: PlayedFromRingside,
                    effects: [
                        AsOpponent([
                            Optional([
                                MoveCards(
                                    who: Opponent,
                                    from: Ring,
                                    to: Ringside,
                                    n: 1,
                                    filter: Some(
                                        All([
                                            AnyOf([Trait(MidMatch), Not(AnyOf([Maneuver, Action, Reversal]))]),
                                            Not(TitleContains("blindside")),
                                        ]),
                                    ),
                                    pick: Controller,
                                ),
                            ]),
                        ]),
                    ],
                ),
            ],
        ),
        // Approximation: it is used in your Main Segment while a maneuver is the last card you successfully played.
        "Leaping DDT": (ringside_ability: Some((requires: Some(After(Maneuver)), effects: [ThisToArsenal(bottom: true)]))),
        // Making the next maneuver Multi is not supported yet.
        "Technical Monkey Flip": (
            on_play: [Optional([Search(filter: TitleContains("technical"))])],
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    ThisToArsenal(bottom: true),
                    Boost((applies_to: All([Maneuver, TitleContains("technical")]), duration: NextCard, stun_value: 1)),
                ],
            )),
        ),
        "BASH Slam": (),
        // Approximation: at most 3 Heat cards each way.
        "Quick Snap Suplex": (
            on_play: [
                Choice([
                    [],
                    [If(condition: CountAtLeast(count: YourRingsideMatching(Keyword("Heat")), n: 1), effects: [RemoveFromGame(who: You, from: Ringside, n: 1, filter: Some(Keyword("Heat"))), MoveCards(who: You, from: Arsenal, to: Ringside, n: 1, filter: Some(Keyword("Heat")))])],
                    [If(condition: CountAtLeast(count: YourRingsideMatching(Keyword("Heat")), n: 2), effects: [RemoveFromGame(who: You, from: Ringside, n: 2, filter: Some(Keyword("Heat"))), MoveCards(who: You, from: Arsenal, to: Ringside, n: 2, filter: Some(Keyword("Heat")))])],
                    [If(condition: CountAtLeast(count: YourRingsideMatching(Keyword("Heat")), n: 3), effects: [RemoveFromGame(who: You, from: Ringside, n: 3, filter: Some(Keyword("Heat"))), MoveCards(who: You, from: Arsenal, to: Ringside, n: 3, filter: Some(Keyword("Heat")))])],
                    [If(condition: CountAtLeast(count: YourHandMatching(Keyword("Heat")), n: 1), effects: [DiscardMatching(who: You, n: 1, filter: Keyword("Heat"), pick: Chosen), RemoveFromGame(who: You, from: Arsenal, n: 1, filter: Some(Keyword("Heat")))])],
                    [If(condition: CountAtLeast(count: YourHandMatching(Keyword("Heat")), n: 2), effects: [DiscardMatching(who: You, n: 2, filter: Keyword("Heat"), pick: Chosen), RemoveFromGame(who: You, from: Arsenal, n: 2, filter: Some(Keyword("Heat")))])],
                    [If(condition: CountAtLeast(count: YourHandMatching(Keyword("Heat")), n: 3), effects: [DiscardMatching(who: You, n: 3, filter: Keyword("Heat"), pick: Chosen), RemoveFromGame(who: You, from: Arsenal, n: 3, filter: Some(Keyword("Heat")))])],
                ]),
            ],
        ),
        // Approximation: the cards overturned for less F go to the Ringside pile instead of leaving the game.
        "Precision Reverse Neck Breaker": (fortitude_discount: Some((per: 2, max: 5, overturn: true))),
        "BASH Drop Over the Ropes": (
            on_play: [Counted(count: YourRingMatching(All([Maneuver, TitleContains("BASH")])), effect: Draw(who: You, n: 0))],
        ),
        "Dynamic Back Breaker": (
            on_play: [
                Counted(count: YourRingMatching(TitleContains("dynamic")), effect: Discard(who: Opponent, n: 0, pick: Chosen)),
            ],
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),

        // Submissions
        "BASH Headlock": (
            not_packed_by: ["Female"],
            on_play: [Discard(who: Opponent, n: 1, pick: Chosen)],
        ),
        // Approximation: Female Superstars are the ones named at the top of this file, and only Heel cards
        // count for the extra damage (not cards with 'female' or 'Diva' in the text).
        "Diva Lock": (
            only_packed_by: ["Female"],
            bonuses: [(per: Some(Trait(Heel)), damage: 1)],
            ring_ability: Some((sacrifice: true, effects: [RingsideToArsenalBottom(who: You, n: 2)])),
        ),
        "Shoot Double Arm Lock": (
            not_reversed_by: Some(Title("A Revolution of the Mind")),
            on_play: [Counted(count: YourRingMatching(TitleContains("shoot")), effect: DrawUpTo(who: You, n: 0))],
        ),
        "Stretch Opponent": (
            on_play: [RingsideToHand(who: You, n: 2, up_to: true, filter: Some(All([Action, Trait(Chain)])))],
        ),
        "BASH Vice": (bonuses: [(per_hand: true, damage: 1)]),
        "Blindside Sleeper": (
            from_ringside: Some(Always),
            before_reversal: [
                If(
                    condition: PlayedFromRingside,
                    effects: [
                        AsOpponent([
                            Optional([
                                RemoveFromGame(
                                    who: Opponent,
                                    from: Ring,
                                    n: 1,
                                    filter: Some(All([Not(SuperstarSpecific), Not(Maneuver)])),
                                    pick: Controller,
                                ),
                            ]),
                        ]),
                    ],
                ),
            ],
        ),
        "Technical Bear Hug": (
            on_play: [Optional([Search(filter: TitleContains("technical"))])],
            as_action: Some((
                fortitude: Some(10),
                on_play: [ThisToArsenal(bottom: true), MoveCards(who: You, from: Removed, to: Arsenal, n: 2, up_to: true, bottom: true)],
            )),
        ),
        // Approximation: the cards for less F are discarded instead of shuffled into the Arsenal.
        "Precision Figure Four": (fortitude_discount: Some((per: 2, max: 5))),
        // Making it Multi and its Ring effect are not supported yet.
        "Shoot Lock-up": (not_reversed_by: Some(TitleContains("Counter"))),
        "Neck Torque": (
            before_reversal: [DiscardAll(who: You, filter: Any)],
            on_play: [RingsideToArsenal(who: You, n: 5, up_to: true), Search(filter: Any), EndTurn],
        ),
        // Looking at a counted number of cards is not supported yet.
        "BASH Pin Hold": (on_play: [Draw(who: You, n: 1)]),
        "Dynamic Torture Rack": (
            on_play: [Counted(count: YourRingMatching(TitleContains("dynamic")), effect: RingsideToArsenal(who: You, n: 0))],
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),

        // Reversals
        // Reversing cards that move cards from your Ring is not supported yet.
        "BASH Evader": (
            reverses: Some((
                targets: ManeuverType(Submission),
                effects: [RingsideToHand(who: You, n: 1, filter: Some(Not(SuperstarSpecific)))],
            )),
        ),
        "Me Llamo ... Armando Alejandro Estrrrrrada": (
            reverses: Some((
                targets: Not(Trait(Unique)),
                from_hand_only: true,
                requires: Some(
                    InYourRing(
                        All([
                            Maneuver,
                            AnyOf([
                                TitleContains("BASH"),
                                TitleContains("blindside"),
                                TitleContains("dynamic"),
                                TitleContains("precision"),
                                TitleContains("shoot"),
                            ]),
                        ]),
                    ),
                ),
            )),
        ),
        // Reversing cards by what they let the opponent do is not supported yet.
        "Get Back in the Ring": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        "The Return BASH for Scotty's WORM": (
            reverses: Some((
                targets: All([
                    Not(Trait(Unique)),
                    Not(
                        AnyOf([
                            TitleContains("BASH"),
                            TitleContains("blindside"),
                            TitleContains("dynamic"),
                            TitleContains("precision"),
                            TitleContains("shoot"),
                        ]),
                    ),
                ]),
                effects: [Search(filter: All([Maneuver, TitleContains("BASH")]))],
            )),
        ),
        // Reversing when overturned by an Action or Pre-match card and the hand-reveal trigger are not supported yet.
        "Booby Trap": (
            on_forced_discard: [Discard(who: Opponent, n: 1, pick: Chosen)],
            reverses: Some((targets: Not(Any))),
        ),
        "Volleyed Beyond the Edge": (
            reverses: Some((
                targets: All([Maneuver, Not(Trait(Unique)), Not(AnyOf([Trait(Chain), Keyword("Heat")]))]),
                requires: Some(InYourRing(All([Maneuver, Keyword("Volley")]))),
            )),
            ring_ability: Some((
                effects: [
                    RemoveFromGame(who: You, from: Ring, n: 1, filter: Some(Title("Volleyed Beyond the Edge"))),
                    RemoveFromGame(who: Opponent, from: Ringside, n: 4, up_to: true, pick: Controller),
                ],
            )),
        ),

        // Actions
        "Takin' a BASH": (
            on_play: [
                AsOpponent([
                    MoveCards(
                        who: Opponent,
                        from: Ringside,
                        to: Hand,
                        n: 1,
                        filter: Some(All([TitleContains("BASH"), Not(Trait(MidMatch)), AnyOf([Maneuver, Action, Reversal])])),
                        pick: Controller,
                    ),
                ]),
                RingsideToArsenal(who: You, n: 60, up_to: true, filter: Some(TitleContains("BASH"))),
            ],
        ),
        // Stacking, Headstrong and Eliminating cards are not supported yet.
        "Stay Away from Daivari": (requires: Some(Never)),
        // Approximation: the other cards (up to 5) may be of any type.
        "Give me an S ... Give me a P ... Give me an I ... Give me an R ... Give me an I ... Give me a T...": (
            on_play: [
                RingsideToHand(who: You, n: 1, filter: Some(Not(Trait(Unique)))),
                MoveCards(who: You, from: Ringside, to: Arsenal, n: 5, up_to: true, filter: Some(Not(Trait(Unique))), bottom: true),
            ],
        ),
        // Keeping cards under it is not supported yet.
        "Hide and Seek": (requires: Some(Never)),
        "Blindsided by the Dangerous Divas": (
            requires: Some(CountAtLeast(count: YourRingMatching(TitleContains("blindside")), n: 2)),
            from_ringside: Some(Always),
            before_reversal: [If(condition: PlayedFromRingside, effects: [Discard(who: You, n: 1, pick: Chosen)])],
            on_play: [
                RemoveFromGame(who: You, from: Arsenal, n: 5),
                MoveCards(who: You, from: Removed, to: Arsenal, n: 10, up_to: true),
            ],
        ),
        "Shane O'Mac Delivers the BASH": (
            on_play: [Counted(count: AtMost(YourRingMatching(TitleContains("BASH")), 10), effect: Mill(who: Opponent, n: 0))],
        ),
        // Its Ring effect is not supported yet.
        "Give and Take": (
            on_play: [
                Optional([RingsideToArsenalBottom(who: You, n: 2)]),
                AsOpponent([Optional([RingsideToArsenalBottom(who: You, n: 2)])]),
            ],
        ),
        // Reversing from the Ring into your hand and the Divas card lists are not supported yet.
        "Jillian: Foxy Fixer": (requires: Some(Never)),
        // Replacing cards listed on WWE Divas: The Next Generation or WWE Divas Rule! is not supported yet.
        "Kristal: Broadcast Beauty": (on_play: [MoveCards(who: You, from: Removed, to: Arsenal, n: 7)]),

        // Pre-match
        "Don't BASH the Star": (
            end_of_prematch: [
                Optional([MoveCards(who: You, from: Hand, to: Arsenal, n: 1, filter: Some(All([Maneuver, TitleContains("BASH")])), top: true)]),
                Search(filter: All([Reversal, Not(Trait(Unique))])),
            ],
            while_in_ring: [(applies_to: All([Maneuver, TitleContains("BASH")]), damage: 1)],
        ),
        // Making Dynamic Actions Multi and changing maneuver types are not supported yet.
        "Find Out How to Fight From Finlay": (
            restricts_opponent: Some((
                filter: All([
                    Not(AnyOf([Maneuver, Action, Reversal])),
                    Not(SuperstarSpecific),
                    TitleContains("Old"),
                    AnyOf([Trait(Active), Trait(Unique)]),
                ]),
            )),
        ),
        "Straight-Shootin' Interview": (
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: All([Maneuver, TitleContains("shoot")]),
                    effects: [RemoveFromGame(who: You, from: Arsenal, n: 1), RemoveFromGame(who: Opponent, from: Arsenal, n: 2)],
                ),
            ],
            ring_ability: Some((
                sacrifice: true,
                effects: [
                    Counted(count: YourRingMatching(All([Maneuver, TitleContains("shoot")])), effect: Mill(who: Opponent, n: 0)),
                ],
            )),
        ),
        // Reversing from the Ring is not supported yet.
        "The Luck of the Draw": (
            ring_ability: Some((
                requires: Some(
                    AnyOf([
                        CountAtLeast(count: YourHandMatching(All([Maneuver, Keyword("Heat")])), n: 1),
                        CountAtLeast(count: YourHandMatching(All([Maneuver, TitleContains("dynamic")])), n: 1),
                    ]),
                ),
                effects: [
                    Choice([
                        [
                            If(
                                condition: CountAtLeast(count: YourHandMatching(All([Maneuver, Keyword("Heat")])), n: 1),
                                effects: [
                                    DiscardMatching(who: You, n: 1, filter: All([Maneuver, Keyword("Heat")]), pick: Chosen),
                                    Draw(who: You, n: 1),
                                    RingsideToArsenalBottom(who: You, n: 1),
                                ],
                            ),
                        ],
                        [
                            If(
                                condition: CountAtLeast(count: YourHandMatching(All([Maneuver, TitleContains("dynamic")])), n: 1),
                                effects: [
                                    MoveCards(who: You, from: Hand, to: Arsenal, n: 1, filter: Some(All([Maneuver, TitleContains("dynamic")])), bottom: true),
                                    Draw(who: You, n: 1),
                                    RingsideToArsenalBottom(who: You, n: 1),
                                ],
                            ),
                        ],
                    ]),
                ],
            )),
        ),
        // Deck construction rules and Ring slots are not supported yet.
        "All Together Now": (requires: Some(Never)),
        // Playing removed cards is not supported yet.
        "It's Time for a Great American BASH": (requires: Some(Never)),
        // Drawing up to the printed Starting Hand Size is not supported yet.
        "The Best Laid Plans...": (requires: Some(Never)),
        // Approximation: the removed card may be the one just played.
        "Not On My Broadcast": (
            in_ring_on_play: [
                (
                    filter: All([
                        AnyOf([Action, SuperstarSpecific]),
                        EarlierThisTurn(filter: AnyOf([Action, SuperstarSpecific]), n: 1),
                    ]),
                    effects: [AsOpponent([Optional([RemoveFromGame(who: Opponent, from: Ring, n: 1, pick: Controller)])])],
                ),
            ],
            restricts_self: Some((filter: All([Action, Not(SuperstarSpecific), Not(Trait(SetUp)), SameTitleInRing]))),
            restricts_opponent: Some((filter: All([Action, Not(SuperstarSpecific), Not(Trait(SetUp)), SameTitleInRing]))),
        ),
        // Keeping cards under it is not supported yet.
        "A No Show": (requires: Some(Never)),
        "First of All": (),
        // Its Pre-match side (Title Belts) is not supported yet; it is played as the Mid-match Action.
        "For the Love of The Game": (
            requires: Some(FortitudeBelowOpponent),
            not_reversed_by: Some(All([Reversal, AnyOf([Maneuver, Action])])),
            on_play: [Boost((applies_to: All([Maneuver, FortitudeAtMost(0)]), duration: NextCard, irreversible: true))],
            on_forced_discard: [Draw(who: You, n: 2)],
        ),
        // Approximation: it also triggers when he reverses with a card overturned from his Arsenal.
        "Managed by Shane O'Mac": (
            extra_traits: [UniversallyUnique],
