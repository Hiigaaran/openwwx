            reverses: Some((
                targets: All([Maneuver, Not(Trait(Unique))]),
                effects: [Discard(who: You, n: 1, pick: Chosen), Search(filter: All([Maneuver, Not(Trait(Unique))]))],
            )),
        ),
        // Approximation: the 2 cards are not revealed first. Putting it from Ringside into the Backlash deck is not
        // supported yet.
        "Outsmarting the Competition": (
            ring_ability: Some((
                effects: [
                    Choice([
                        [Mulligan(n: 1)],
                        [MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Random), Draw(who: Opponent, n: 1)],
                    ]),
                ],
            )),
        ),
        // Discarding down to the printed Starting Hand Size is not supported yet.
        "Armageddon Is Upon Us": (
            reverses_from_ring: Some((targets: AnyOf([Trait(Chain), Keyword("Heat"), Keyword("Volley")]))),
        ),
        "Never Forgive - Never Forget": (
            on_play: [RingsideToArsenal(who: You, n: 5, up_to: true)],
            reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]))),
        ),

        // Backstage cards
        "The Extreme Chairman": (
            backstage_ability: Some((
                effects: [
                    Choice([
                        [Search(filter: All([Keyword("Foreign Object"), Not(Trait(Unique))]), n: 2)],
                        [Search(filter: All([Keyword("Foreign Object"), Trait(Unique), Not(SuperstarSpecific)]))],
                    ]),
                ],
                sacrifice: true,
            )),
        ),
        // Blanking a Legend's Pre-match card is not supported yet.
        "Sons of Legends": (backstage_ability: Some((effects: [Search(filter: Not(SuperstarSpecific))], sacrifice: true))),
        // Approximation: the reveal is at the start of the match. Starting the game is not supported yet.
        "No One's Home Until the Bell is Rung!": (
            backstage_abilities: [
                StartOfTurn([
                    Choice([
                        [Boost((applies_to: Maneuver, duration: ThisTurn, damage: 3))],
                        [Boost((applies_to: Maneuver, duration: NextMatching, no_backlash_reversal: true))],
                    ]),
                ]),
            ],
        ),
        // The Title Belt parts are not supported yet.
        "The First Unified Champions": (
            backstage_ability: Some((
                effects: [RingsideToArsenalCount(who: You, count: Plus(SuperstarValue, OpponentValueTimes(1)))],
                sacrifice: true,
            )),
        ),
        // Changing Roll Out of the Ring, hidden Superstar cards and Momentum are not supported yet.
        "Ringside Shenanigans": (requires: Some(Never)),
        // Being always revealed and blanking your Ability are not supported yet; the Multi and Stun Value parts too.
        "The Whole F'n Show": (
            backstage_abilities: [
                FortitudeFor(filter: AnyOf([All([Action, SuperstarSpecific]), Title("One of a Kind")]), delta: -4),
                DamageFor(filter: All([Maneuver, TitleContains("kick")]), delta: 1),
            ],
        ),
        // The Fan Favorite and F: 0 parts are not supported yet.
        "On Your Knees, Dog": (
            backstage_ability: Some((
                cost: [Discard(who: You, n: 2, pick: Chosen)],
                effects: [RingsideToHand(who: You, n: 2, up_to: true, filter: Some(All([Action, SuperstarSpecific])))],
            )),
        ),
        // Revealing it when Collegiate Champions is reversed is not supported yet.
        "Brock's Massive Physique": (requires: Some(Never), starts_hidden: true),
        // Hiding it to overturn for -4F each is not supported yet.
        "Chain Mail Coif": (
            not_with: ["There Is No Escape"],
            backstage_abilities: [CannotBeReversedBy(played: All([Action, SuperstarSpecific]), reversal: Any)],
        ),
        // Revealing Superstars and the McMahonism changes are not supported yet.
        "Prophet of McMahonism": (requires: Some(Never), backstage_abilities: [OpponentCannotPlay("Backstage Shenanigans")]),
        // The packing changes and playing Pre-match Events during the match are not supported yet.
        "Always Bet on Black": (requires: Some(Never)),
        // Changing other cards and needing 3 reversals are not supported yet.
        "Too Big to Slow Down": (requires: Some(Never)),
        // Putting a Backstage card into the Ringside pile is not supported yet.
        "Lil' Boogey": (requires: Some(Never)),
        // The Ability part is not supported yet.
        "Johnny's Pom-Pom": (
            backstage_ability: Some((
                requires: Some(After(ManeuverType(HighRisk))),
                effects: [RingsideToArsenal(who: You, n: 3, up_to: true), DrawUpTo(who: You, n: 2)],
                sacrifice: true,
            )),
        ),
        // Burying a hand maneuver to make him bury a reversal is not supported yet.
        "Kenny's Headband": (
            backstage_ability: Some((
                effects: [
                    RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Maneuver, Not(Trait(Unique)), SuperstarSpecific]))),
                ],
            )),
        ),
        // Playing the same maneuver again is not supported yet.
        "Nicky's New Name": (requires: Some(Never)),
        // The Pre-match Capacity part is not supported yet.
        "Bret's Trademark Sunglasses": (
            backstage_abilities: [EndOfPrematch([Optional([Discard(who: You, n: 1, pick: Chosen), Draw(who: You, n: 3)])])],
        ),
        // Cards under a Backstage card are not supported yet.
        "Walking the Red Carpet": (requires: Some(Never)),
        // A Backstage Starting Hand Size bonus is not supported yet.
        "I've Got Three Words For Ya!": (requires: Some(Never)),
        // Making Pre-match cards Permanent and the Heat part are not supported yet.
        "Shamrocks and Shenanigans": (
            backstage_abilities: [EndOfPrematch([Search(filter: All([Maneuver, Not(Trait(Unique)), Not(Hybrid)]))])],
        ),
        // Naming a word is not supported yet.
        "Word Up": (requires: Some(Never)),
        // The 'wager' is not supported yet.
        "Don't Treat Me Like You Know Me": (requires: Some(Never)),
        // Changing the Face / Heel traits and the win replacement are not supported yet.
        "Be a Man!": (requires: Some(Never)),
    },
)
