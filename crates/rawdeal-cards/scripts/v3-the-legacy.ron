// Hand-written scripts for V3: The Legacy cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// Raw Deal Virtual (fan-made) set: there is no official rule sheet.
// "ACE" (Activated Card Effect) texts are Ring abilities; reversing an ACE, "completely" reversing, blanking text,
// changing card traits ("is Multi", "is Chain"), Pre-match slots and Capacity on Superstars and the Backstage Area
// as a place to put cards are not supported yet.
// "Recover N" is read as shuffling N cards from your Ringside pile into your Arsenal.
// "When you are a Revolution Superstar" is approximated as being the card's Revolution Superstar.
(
    abilities: {
        // Revealing 5 random Ringside cards after his 5D+ maneuvers, the Ringside-to-Arsenal ban, packing Cena cards as
        // not Cheater / Fan Favorite and the 50-card Arsenal are not supported yet.
        "The Champ": [
            PacksLogos(["John Cena"]),
            CannotPack("Yo! Kill Da Beat!"),
            CannotPack("Hell in a Cell Match"),
            OpponentCannotPlay("The Champ Is Here!"),
        ],
        // Blanking his cards with 'reverse' in the text and banning cards with 'Vince' or 'Mr. McMahon' in the title
        // are not supported yet.
        "The Genetic Jackhammer": [PacksLogos(["Vince McMahon"])],
        // Revealing the top 3 cards to stop his maneuver is not supported yet.
        "The Legacy": [],
        // Removing a Ring card for -3F times its damage and the D: 0 reversals are not supported yet.
        "Priceless": [
            OnPlayMatching(
                filter: All([Maneuver, Not(EarlierThisTurn(filter: Maneuver, n: 1))]),
                effects: [Discard(who: Opponent, n: 1, pick: Chosen)],
            ),
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
        ],
        // The reversal limits on his first Raw Action, packing as a Legend and Skirt the Issue are not supported yet.
        "Raw Guest Host": [
            CannotPackMatching(All([Maneuver, Not(SuperstarSpecific), Not(Trait(Raw)), Not(Trait(Unique))])),
        ],
        "The Great Khali": [],
        // Approximation: "his maneuvers are -3D" reduces the damage of all his cards. The Storyline adding to the
        // Ability and the 'powerhouse' exception (and No Sell Maneuver) are not supported yet.
        "Umaga": [
            ReduceDamage(3),
            CannotPackMatching(AnyOf([All([Action, Not(Hybrid)]), All([Antic, Not(Hybrid)])])),
        ],
        // Making cards Heat, Unique Actions becoming Antics and the Heat-reversal changes are not supported yet.
        "Muhammad Hassan": [FortitudeFor(filter: TitleContains("Camel Clutch"), delta: -3)],
        // Packing as a Diva and the Antic packing limit are not supported yet.
        "Santino Marella": [
            Activated(
                cost: [DiscardMatching(who: You, n: 1, filter: Antic, pick: Chosen)],
                effects: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 2, up_to: true, bottom: true)],
            ),
            Activated(cost: [Mill(who: You, n: 4)], effects: [RingsideToHand(who: You, n: 1, filter: Some(Antic))]),
        ],
        // The follow-ups depending on the removed card's type and protecting his Pre-match cards are not supported yet.
        "Jack Swagger": [OnPlayMatching(filter: Maneuver, effects: [RemoveFromGame(who: Opponent, from: Arsenal, n: 1)])],
        // The +1D for each of those maneuvers in your Ring and the BASH packing permission are not supported yet.
        "Vladimir Kozlov": [
            Activated(
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [
                    Search(
                        filter: All([
                            Maneuver,
                            Not(Keyword("Throwback")),
                            AnyOf([TitleContains("head butt"), TitleContains("headbutt"), TitleContains("judo")]),
                        ]),
                    ),
                ],
            ),
        ],
        // Approximation: it can be used on every reversed maneuver (not once per turn). The +1 Stun Value and
        // High-Flying Style are not supported yet.
        "Kofi Kingston": [
            OnOpponentReverses([
                If(
                    condition: OpponentReversed(Maneuver),
                    effects: [
                        Optional([
                            Discard(who: You, n: 1, pick: Chosen),
                            Mill(who: You, n: 2),
                            ContinueTurn,
                            NextCardMustBe(ManeuverType(HighRisk)),
                            NextPlayWatch(filter: ManeuverType(HighRisk), on_success: [EndTurn]),
                        ]),
                    ],
                ),
            ]),
        ],
        // Approximation: the extra cards are drawn before the Draw Segment. Playing his Pre-match cards in any phase,
        // the slots, High-Flying Style and Hurricanrana being Superstar-specific are not supported yet.
        "Evan Bourne": [
            EndOfPrematch([
                MoveCards(who: You, from: Backlash, to: Ring, n: 3, up_to: true, filter: Some(Title("It's Hard Being This Original"))),
            ]),
            StartOfTurn([
                Counted(
                    count: YourRingMatching(All([SuperstarSpecific, AnyOf([Maneuver, Action, Reversal]), Not(Trait(MidMatch))])),
                    effect: Draw(who: You, n: 0),
                ),
            ]),
        ],
        // The ban on Pre-match Events and packing Catatonic Stare / No Sell Maneuver are not supported yet.
        "Festus": [
            EndOfPrematch([Draw(who: You, n: 9), Optional([ShuffleHandAndRedraw(who: Opponent)])]),
            CannotPack("First of All"),
        ],
        "Miz and Morrison": [
            Activated(
                cost: [RemoveFromGame(who: You, from: Hand, n: 1)],
                effects: [
                    MoveCards(
                        who: You,
                        from: Removed,
                        to: Hand,
                        n: 1,
                        filter: Some(All([Not(Trait(Unique)), Not(All([Reversal, Not(Hybrid)]))])),
                    ),
                ],
            ),
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
        ],
        // Putting an unsuccessful maneuver into the Ring for overturning # + 5 and High-Flying Style are not supported yet.
        "Carlito and Primo Colon": [
            PacksLogos(["Carlito"]),
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
        ],
        // Reducing his removals to 0 and High-Flying Style are not supported yet.
        "Kaientai": [
            Activated(
                cost: [Discard(who: You, n: 2, pick: Chosen), Mill(who: You, n: 2)],
                effects: [Search(filter: All([Maneuver, Trait(Multi), Not(Hybrid), Not(Keyword("Run-in"))]))],
            ),
            CannotPackMatching(All([Maneuver, Not(Trait(Unique)), Not(SuperstarSpecific)])),
            PacksLogos(["Funaki"]),
        ],
        // Approximation: after any Reversal you may discard 1 to search for any card (not one of the same type).
        // The A Phoenix Rising and packing parts are not supported yet.
        "Beth Phoenix": [OnYouReverse([Optional([Discard(who: You, n: 1, pick: Chosen), Search(filter: Any)])])],
        // Approximation: she searches for any Superstar-specific card. Ignoring 'Cannot be played', the reversal limit,
        // making Raw cards Smackdown and High-Flying Style are not supported yet.
        "Gail Kim": [
            Activated(cost: [Discard(who: You, n: 1, pick: Chosen)], effects: [Search(filter: SuperstarSpecific)]),
            CannotPack("Deadly Diva Duo"),
        ],
        // Making her 'Diva' cards Multi, Nikki Bella in the Backstage Area and the D: 1+ Pre-match ban are not
        // supported yet.
        "Brie Bella": [PacksLogos(["The Bella Twins"]), CannotPackMatching(All([Maneuver, Keyword("Foreign Object")]))],
        "Nikki Bella": [PacksLogos(["The Bella Twins"]), CannotPackMatching(All([Maneuver, Keyword("Foreign Object")]))],
        // Approximation: any Stephanie McMahon, Vince McMahon and Shane O'Mac cards can be packed. Making 'McMahon'
        // cards Multi, ignoring their play restrictions and banning his McMahon cards are not supported yet.
        "The McMahon Dynasty": [PacksLogos(["Stephanie McMahon", "Vince McMahon", "Shane O' Mac"])],
        // Ignoring 'Can only be played' on his maneuvers and packing Raw and Smackdown cards are not supported yet.
        "JeriShow": [
            OnPlayMatching(
                filter: All([SuperstarSpecific, Not(TitleContains("Faction"))]),
                effects: [
                    Discard(who: Opponent, n: 1, pick: Chosen),
                    MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, bottom: true),
                ],
            ),
            FortitudeFor(filter: All([Reversal, SuperstarSpecific, Not(Hybrid)]), delta: -60),
            PacksLogos(["Chris Jericho", "Big Show"]),
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
        ],
        // Switching chosen cards and removing another Ring card instead are not supported yet.
        "The Nature Boy": [PacksLogos(["Ric Flair"])],
        // Approximation: "look at the top 2 cards of his Arsenal and put them back in any order" (putting 1 on the
        // bottom and revealing more Enforcer cards are not supported yet). The Enforcer cards are the unbranded ones
        // (their titles end in '?').
        "Sheriff Austin": [
            RevealEnforcers(All([TitleContains("?"), Not(SuperstarSpecific)])),
            StartOfTurn([Arrange(who: Opponent, n: 2)]),
            CannotPackMatching(AnyOf([Keyword("ECW"), Keyword("nWo")])),
        ],
        // Ignoring 'completely' and the Roll Out of the Ring discards are not supported yet.
        "The Bella Twins": [
            Activated(cost: [Discard(who: You, n: 1, pick: Chosen)], effects: [Search(filter: Trait(Multi))]),
            CannotPackMatching(All([Maneuver, Keyword("Foreign Object")])),
        ],
        // Making the opponent discard to reverse Throws and Extremes is not supported yet.
        "Revolution Kurt Angle": [],
        // Letting 2D- cards reverse his 15D+ maneuvers is not supported yet.
        "Revolution The Big Show": [CannotBeReversedBy(played: TitleContains("Mountain of a Man"), reversal: Any)],
        // Playing Antics from the Ringside pile and the same-title ban are not supported yet.
        "Revolution Christian": [FortitudeFor(filter: All([Antic, SuperstarSpecific]), delta: -4)],
        // Knee Lift reversing is not supported yet.
        "Revolution William Regal": [
            OnOpponentReverses([
                If(
                    condition: All([
                        OpponentReversedFrom([Hand, Backlash]),
                        OpponentReversed(
                            AnyOf([
                                All([ManeuverType(Strike), TitleContains("knee")]),
                                ManeuverType(Hold),
                                ManeuverType(Assault),
                            ]),
                        ),
                    ]),
                    effects: [Discard(who: Opponent, n: 1, pick: Chosen), Mill(who: Opponent, n: 2)],
                ),
            ]),
            CannotPack("Revolution 4ever: No Mercy"),
        ],
    },
    scripts: {
        // Strikes
        // Approximation: Backhand Slap and Sidewalk Slam can never share a deck (also for The Godfather).
        "Backhand Slap": (
            not_with: ["Sidewalk Slam"],
            on_play: [DrawUpTo(who: You, n: 2), HandToArsenalBottom(who: Opponent, n: 1)],
            reverses: Some((
                targets: AnyOf([
                    Trait(Irreversible),
                    All([Action, Not(Trait(Unique)), Holds(OpponentSuperstar("Godfather"))]),
                ]),
                ignores_irreversible: true,
            )),
        ),
        // "Can only be reversed from Backlash or Arsenal" with 5 lower Fortitude is not supported yet.
        "Back Throw": (
            bonuses: [(fortitude: -5, damage: 5)],
            reverses: Some((
                targets: Keyword("Throwback"),
                effects: [
                    Counted(
                        count: OpponentRingMatching(All([Keyword("Throwback"), AnyOf([Maneuver, Action, Reversal])])),
                        effect: Mill(who: Opponent, n: 0),
                    ),
                    Discard(who: Opponent, n: 1, pick: Chosen),
                ],
            )),
        ),
        // Revealing it from the Arsenal on a search, the -3F to Cheater cards and the Ringside lock are not supported yet.
        "Blindside Takedown": (
            not_packed_by: ["Test"],
            from_ringside: Some(Always),
            before_reversal: [
                If(
                    condition: PlayedFromRingside,
                    effects: [
                        AsOpponent([
                            Optional([
                                RemoveFromGame(
                                    who: Opponent,
                                    from: Ring,
                                    n: 1,
                                    filter: Some(All([Not(Trait(Unique)), AnyOf([Action, Reversal]), Not(Trait(MidMatch))])),
                                    pick: Controller,
                                ),
                            ]),
                        ]),
                    ],
                ),
            ],
        ),
        // Ignoring Mr. Pay-Per-View's Ability and reversing card effects when overturned are not supported yet.
        "You Missed Your Chance": (
            reverses: Some((
                targets: AnyOf([
                    ManeuverType(HighRisk),
                    All([ManeuverType(Trademark), Holds(CountAtMost(count: OpponentFortitude, n: 4))]),
                ]),
            )),
        ),
        "You Won't BASH Me!": (
            reverses: Some((targets: Maneuver, effects: [DrawUpTo(who: You, n: 1)])),
            in_ring_on_play: [
                (whose: Some(You), filter: All([Maneuver, TitleContains("BASH")]), effects: [Optional([ThisToArsenal(bottom: true)])]),
            ],
        ),
        "The Horsemen Have My Back": (
            reverses: Some((
                targets: AnyOf([
                    All([Maneuver, Not(Trait(Unique)), Not(Hybrid)]),
                    All([
                        Maneuver,
                        Not(Hybrid),
                        Holds(OpponentRingHas(filter: Title("Once a Horseman, Always a Horseman"), n: 1)),
                    ]),
                ]),
                fortitude_when: Some((InYourRing(Title("Once a Horseman, Always a Horseman")), 12)),
                effects: [
                    If(
                        condition: InYourRing(Title("Once a Horseman, Always a Horseman")),
                        effects: [RingsideToArsenalBottom(who: You, n: 4)],
                    ),
                ],
            )),
        ),

        // Actions
        // The F: 0 for Goldberg / WCW Superstars is not supported yet (Actions get no Fortitude bonuses).
        "Ready to Rumble": (
            irreversible_when: Some(AnyOf([YouAre("Goldberg"), YouAre("WCW")])),
            on_play: [
                Discard(who: You, n: 1, pick: Chosen),
                RingsideToArsenal(who: You, n: 5),
                Boost((applies_to: Any, duration: NextCard, irreversible: true)),
            ],
            while_in_ring: [(applies_to: Title("The King Interferes!"), fortitude: -15)],
        ),
        // Approximation: up to 1 BASH maneuver (any title); "you cannot play cards" is left out (the turn ends).
        "BASH Down The Walls!": (
            on_opponent_reverses: [
                If(
                    condition: OpponentReversed(All([Maneuver, TitleContains("BASH")])),
                    effects: [Search(filter: All([Maneuver, TitleContains("BASH")]), up_to: true)],
                ),
            ],
        ),

        // Pre-match
        // The 'Fairness' packing rule and the ACE are not supported yet.
        "Cheat To Win": (opponent_hand_size_bonus: -1),
        // Blanking 'psychology' cards and the blank-text rules are not supported yet.
        "Drawing a Blank": (requires: Some(Never), not_packed_by: ["Cryme Tyme", "JBL", "MVP", "Stevie Richards"]),
        // Pre-match restrictions on all players and burying hand cards are not supported yet.
        "Flanked by Arena Security": (requires: Some(Never)),
        // The packing rule, overturning 10-, blanking I'm Gonna Break You and the Pyrotechnic Volley are not
        // supported yet.
        "Forming a United Front": (
            while_in_ring: [
                (
                    applies_to: All([Maneuver, Keyword("Volley"), Holds(CountAtMost(count: YourRingMatching(Maneuver), n: 0))]),
                    fortitude: -4,
                ),
            ],
        ),
        // Approximation: printed and current Superstar Values are not told apart. Blanking his It's Showtime! and the
        // ECW Originals part are not supported yet.
        "Hold On! Its Not Time to Show Yet!": (
            requires: Some(Not(SuperstarValueAtMostOpponent)),
            ring_ability: Some((
                requires: Some(FortitudeBelowOpponent),
                effects: [
                    RingsideToArsenalCount(who: You, count: SuperstarValue),
                    Draw(who: You, n: 2),
                    ReturnThis(to: Removed),
                ],
            )),
        ),
        // Cards under it face-up / face-down and their damage are not supported yet.
        "Mouths Writing Checks Bodies Can't Cash": (requires: Some(Never), not_with: ["Wrestlemania"]),
        // Not taking a Pre-match slot and the changes to I'm Gonna Break You / Fans Love an Underdog are not supported yet.
        "Night of Champions": (hand_size_bonus: 1),
        // The Extremist parts, the first Heel Action being Multi and the +10F to his Once is Enough are not supported yet.
        "The Abraham Washington Show": (
            not_packed_by: ["The Heat Seekers"],
            end_of_prematch: [Search(filter: All([Action, Trait(Heel)]))],
        ),
        // The +2 Starting Hand Size with an nWo card and the changes to Backed by Eric Bischoff are not supported yet.
        "Managed by Eric Bischoff": (opponent_hand_size_bonus: -1),
        // Approximation: you discard 1 card per card under it (also with It's Hard Being This Original), at the end
        // of the Pre-match phase; the opponent always draws 2.
        "Allentown, Pennsylvania": (
            not_packed_by: ["Chris Benoit", "Big Freak'n Machine"],
            end_of_prematch: [
                PutUnder(
                    from: Arsenal,
                    n: 8,
                    up_to: true,
                    filter: Some(
                        AnyOf([
                            Title("Clutch onto Opponent"),
                            Title("Precision Haymaker"),
                            Title("Revolution Double Leg Lock Crab"),
                            Title("Revolution Scissors Hold"),
                        ]),
                    ),
                ),
                Counted(count: YourUnderSize, effect: Discard(who: You, n: 0, pick: Chosen)),
            ],
            ring_ability: Some((cost: [Draw(who: Opponent, n: 2)], effects: [TakeFromUnder(to: Hand, n: 1)])),
        ),
        // Doubling Title Belt numbers and hiding The House that Hardcore Built are not supported yet.
        "Don't Question the Fire That Burns Inside": (requires: Some(Never)),
        // The packing ban on nWo / ECW / WCW cards, the conditional Hand Size and Superstar Value and the ACE are not
        // supported yet.
        "I Know Who Pays My Salary!": (requires: Some(Never), not_packed_by: ["Los Guerreros"]),
        // The packing bans are not supported yet.
        "I'm Always On the Winning Side - MY Side!": (
            hand_size_bonus: 1,
            pre_match_limit: 1,
            mid_match_limit: 1,
            end_of_prematch: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, bottom: true)],
            ring_ability: Some((
                cost: [RemoveFromGame(who: You, from: Ringside, n: 1, pick: Random), Discard(who: You, n: 2, pick: Random)],
                effects: [Search(filter: All([Maneuver, Not(Trait(Unique))]))],
            )),
        ),
        // Looking at cards before drawing is not supported yet.
        "McMahonism": (requires: Some(Never)),
        // The reversal limit on nWo Actions, the slots, Controversy Creates Cash and Lethal nWo Poison are not supported yet.
        "nWo T-Shirt": (
            while_in_ring: [
                (applies_to: Keyword("Run-in"), fortitude: -3),
                (applies_to: All([Maneuver, SuperstarSpecific, Keyword("nWo")]), ignore_play_after: true),
            ],
        ),
        // Faction texts and the packing rule are not supported yet.
        "There Is No 'I' in Team": (requires: Some(Never)),
        // Approximation: the discard happens when you successfully play a WCW card. Putting the bottom card of the
        // Arsenal under it and the ACE are not supported yet.
        "Where the Big Boys Play": (
            in_ring_on_play: [(whose: Some(You), filter: Keyword("WCW"), effects: [Discard(who: Opponent, n: 1, pick: Chosen)])],
            end_of_prematch: [If(condition: YouAre("WCW"), effects: [Optional([PutUnder(from: Arsenal, n: 2, filter: Some(Any))])])],
        ),
        // Approximation: as a reversal it reverses a card whose title is already in the player's Ring, and the copies
        // go to the Ringside pile instead of out of the game. The Event part is not supported yet.
        "Again With This Crap?!?!?": (
            pre_match_limit: 1,
            reverses: Some((targets: SameTitleInRing, ignores_irreversible: true, effects: [PurgeReversedTitle])),
        ),
        // Approximation: only the Multi Volley maneuver part (comparing printed F with his Fortitude is not supported
        // yet); returning the reversed card to his hand and the ACE are not supported yet.
        "Your Reach Exceeds Your Grasp": (reverses: Some((targets: All([Maneuver, Trait(Multi), Keyword("Volley")])))),
        // Its rule changes for all players are not supported yet.
        "Really, That's Enough Shenanigans": (requires: Some(Never)),

        // Revolution and Faction cards
        // The Faction Member part is not supported yet.
        "Revolution Tomorrow's Legends Shine Today": (
            reverses: Some((
                targets: AnyOf([ManeuverType(Trademark), Antic]),
                fortitude_when: Some((InYourRing(Not(TitleContains("Revolution"))), 15)),
                effects: [Discard(who: You, n: 1, pick: Chosen)],
            )),
        ),
        // The Faction Member part is not supported yet.
        "Revolution Keeping It Original": (
            on_play: [
                MoveCards(
                    who: You,
                    from: Ring,
                    to: Arsenal,
                    n: 1,
                    up_to: true,
                    filter: Some(All([Not(Trait(Unique)), Not(Reversal)])),
                    bottom: true,
                ),
                MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, bottom: true),
                Counted(count: YourRingMatching(TitleContains("original")), effect: DrawUpTo(who: You, n: 0)),
            ],
        ),
        // The Faction Member part is not supported yet.
        "Revolution Bow to the Masters": (
            on_play: [DrawUpTo(who: You, n: 1), Boost((applies_to: Any, duration: NextCard, fortitude: -4, reversal_fortitude: 6))],
        ),
        // Ignoring the Requirement and the Faction Member part are not supported yet.
        "Revolution Don't Take This A$%-Whuppin' Personally": (
            requires: Some(InYourRing(Title("Revolution Attitude Adjusters"))),
            pre_match_limit: 1,
            while_in_ring: [(applies_to: All([Not(Reversal), TitleContains("attitude")]), fortitude: -4)],
        ),
        // Approximation: it searches for a card with 'New Breed' in the title (not the text). The Faction Member part
        // is not supported yet.
        "Revolution The Alpha Males of Extreme": (
            pre_match_limit: 1,
            end_of_prematch: [Search(filter: TitleContains("New Breed"), up_to: true)],
        ),
        // The Corner packing permissions and making the Storyline Permanent are not supported yet.
        "Revolution Christian is In My Corner!": (requires: Some(Never)),
        "Revolution Kurt Angle is In My Corner!": (requires: Some(Never)),
        "Revolution William Regal is In My Corner!": (requires: Some(Never)),

        // Generic Throwback cards
        "Dynamic Finisher": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        // Locking your removed cards is not supported yet.
        "The Finisher": (only_packed_by: ["Male"]),
        // Approximation: the copies go to his Ringside pile from his hand and Arsenal (no shuffle choice).
        "Master Manipulator": (
            only_packed_by: ["GM", "Chairman"],
            on_play: [LookAtHand(who: Opponent), Discard(who: Opponent, n: 1, pick: Controller)],
            reverses: Some((targets: Not(Trait(Unique)), effects: [PurgeReversedTitle])),
        ),
        "The Inmates Aren't Running My Asylum": (
            only_packed_by: ["GM", "Chairman"],
            requires: Some(FortitudeBelowOpponent),
            on_play: [RemoveFromRing(who: Opponent, n: 20, filter: Not(Maneuver)), Mill(who: You, n: 2)],
        ),
        // Using it when about to lose by pinfall is not supported yet.
        "Through All of These Years": (
            only_packed_by: ["Legend"],
            pre_match_limit: 1,
            ring_ability: Some((effects: [RingsideToArsenal(who: You, n: 8, up_to: true), EndTurn], sacrifice: true)),
        ),
        "When You Run the Show, You Make the Rules": (
            only_packed_by: ["GM", "Chairman"],
            on_play: [
                Boost((applies_to: Any, duration: ThisTurn, no_backlash_reversal: true)),
                Boost((applies_to: Any, duration: NextTurn, no_backlash_reversal: true)),
                SkipNextTurn(who: Opponent),
            ],
        ),
        // Approximation: you take up to as many cards from your Ringside pile as you have in hand, then put half your
        // hand on the bottom of your Arsenal.
        "Living the Good Life": (
            only_packed_by: ["Legend"],
            on_play: [
                Counted(count: HandSize, effect: RingsideToHand(who: You, n: 0, up_to: true)),
                Counted(count: HalfYourHand, effect: HandToArsenalBottom(who: You, n: 0)),
            ],
        ),
        // Giving Faction cards your logo is not supported yet.
        "Revolution You're Drafted": (end_of_prematch: [Draw(who: Opponent, n: 1)]),
        // Removing it after it reverses from the Arsenal is not supported yet.
        "A Revolution of the Mind": (
            not_with: [
                "Escape Move",
                "No Sell Maneuver",
                "Over Sell Maneuver",
                "Raw and Ready",
                "Reach For the Ropes",
                "Step Aside",
                "Strangle Hold",
            ],
        ),
        "Get the 'F' Out!": (
            reverses: Some((
                targets: AnyOf([Trait(Multi), All([Maneuver, Trait(Unique), Not(ManeuverType(TrademarkFinisher))])]),
            )),
        ),
        // Reversing an Activated Card Effect is not supported yet.
        "Don't Try This at Home": (
            on_play: [Search(filter: Title("From the Top Rope"))],
            reverses: Some((targets: Not(Any))),
        ),
