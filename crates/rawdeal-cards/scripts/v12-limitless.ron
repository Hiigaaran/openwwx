// Hand-written scripts for V12: Limitless (Raw Deal Virtual set 45) cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// "Counter" = you reversed a card to end your opponent's last turn and this is your first card this turn.
// "Promo: N" is approximated as `Dig`: you keep 1 of the top N cards and the rest go on the bottom of the Arsenal.
// "Bury" puts cards on the bottom of the Arsenal; "RFG" removes them from the game; "Recover" shuffles removed
// cards into the Arsenal.
// "Reversal: Special" cards: "Reverse any X" is the reversal target. Reversals after a card was successfully
// played use `after_success`, of Activated Card Effects `reverses_ace` / `ring_reverses_ace`; of other card effects
// they are not supported (`targets: Not(Any)`).
// ACE (Activated Card Effects) are ring abilities used during your own turn. Packing permissions printed on
// Superstar cards ("You can pack X") are not supported unless they are other Superstars' logos (`PacksLogos`).
// Not supported: face-down (Flipped) cards, cards put under Superstar, Backstage or other cards (205 Live,
// Moonrise, Man of 1,004 Holds), the player's Backstage as a zone (Alexa Bliss), hiding Backstage cards during
// the opponent's turn, "is a Trademark Finisher / High Risk instead", "cannot be blanked", "your opponent cannot
// respond" (except as "cannot be reversed"), "ignore 'completely'" and playing cards in response to an
// unsuccessful maneuver.
// "Requirement: Allegiance: X" is approximated as being an X Superstar or having an X card in your Ring.
// Skipped by the importer: Shut It Down! ("Pre-match Event / Mid-match Maneuver: Special").
(
    abilities: {
        // Approximation: any non-Multi maneuver reversed from the Arsenal (not only the first one); afterwards only
        // the next card must be a maneuver. The packing permissions are not supported yet.
        "Keith Lee": [
            OnOpponentReverses([
                If(
                    condition: All([OpponentReversedFrom([Arsenal]), OpponentReversed(All([Maneuver, Not(Trait(Multi))]))]),
                    effects: [ContinueTurn, NextCardMustBe(Maneuver)],
                ),
            ]),
            CannotPack("Cruiserweight-Style Action"),
            CannotPackMatching(All([Maneuver, Keyword("RMS"), Not(SuperstarSpecific)])),
        ],
        // The Arsenal reversal restriction and the "ignore can only be played after" permission are not supported
        // yet. Approximation: he may pack every Lashley, Shelton Benjamin and MVP card (not only Unique ones).
        "The Hurt Business": [
            OnOpponentReverses([
                If(
                    condition: OpponentReversed(All([Maneuver, Not(Trait(Unique)), FortitudeAtMost(0)])),
                    effects: [RingsideToArsenal(who: You, n: 1, up_to: true)],
                ),
            ]),
            CannotPlayMatching(All([Maneuver, EarlierThisTurn(filter: Maneuver, n: 2)])),
            PacksLogos(["Lashley", "Shelton Benjamin", "MVP"]),
        ],
        // Cards under 205 Live are not supported yet.
        "Cedric Alexander": [],
        // Her Press Slam and Simply The Best are Multi. Ignoring 'completely', the rest of the Press Slam / Simply The
        // Best texts and packing other Multi maneuvers (a Female Superstar cannot play printed Multi in the engine)
        // are not supported yet.
        "Bianca Belair": [
            CannotPack("Baghdad, Iraq"),
            StartOfTurn([Boost((applies_to: AnyOf([Title("Press Slam"), Title("Simply The Best")]), duration: ThisTurn, multi: true))]),
        ],
        // The Promo and Drop Kick texts are not supported yet.
        "Street Profits": [CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))]))],
        // Its Ability (moving cards to any Area, Backlash cards in hand, drawing from the bottom, Arsenal Size 48,
        // Backlash cards in the Backstage) is not supported yet.
        "RETRIBUTION": [],
        // Backstage Chop cards, playing two maneuvers at once and cards under the Superstar are not supported yet.
        "WALTER": [],
        // Approximation: every maneuver under the Superstar card can be played (not only Superstar-specific ones
        // and ones without a printed reversal restriction), and the maneuver put under it may be the removed card.
        "IMPERIUM": [
            Activated(
                cost: [
                    Choice([
                        [RemoveFromGame(who: You, from: Hand, n: 1, filter: Some(AnyOf([Not(Maneuver), SuperstarSpecific])))],
                        [RemoveFromGame(who: You, from: Ringside, n: 1, filter: Some(AnyOf([Not(Maneuver), SuperstarSpecific])))],
                    ]),
                ],
                effects: [
                    Choice([
                        [PutUnder(from: Ringside, n: 1, filter: Some(Maneuver), superstar: true)],
                        [PutUnder(from: Removed, n: 1, filter: Some(Maneuver), superstar: true)],
                    ]),
                ],
            ),
            PlayFromUnder(Maneuver),
        ],
        // Approximation: Bury 1 card from hand and 1 Ringside card to draw up to 1.
        "Rhea Ripley": [
            Activated(
                requires: Some(All([HandAtLeast(1), CountAtLeast(count: YourRingsideSize, n: 1)])),
                cost: [HandToArsenalBottom(who: You, n: 1), RingsideToArsenalBottom(who: You, n: 1)],
                effects: [DrawUpTo(who: You, n: 1)],
            ),
            CannotPack("From NXT to WWE"),
        ],
        // The damage-reduction and overturn texts are not supported yet. Approximation: he may pack every Pete
        // Dunne card; Corners are cards with "In My Corner" in the title.
        "British Strong Style": [
            PacksLogos(["Pete Dunne"]),
            OpponentCannotPlay("Beg for Mercy"),
            CannotPack("Everything and the Kitchen Sink"),
            CannotPack("A Puncher's Chance"),
            CannotPack("There Is No Escape"),
            CannotPackMatching(TitleContains("In My Corner")),
        ],
        // The -4D answer to the opponent's cards and the Fiend packing limits are not supported yet.
        "Bray Wyatt": [
            PacksLogos(["The Fiend"]),
            CannotPack("Ring Psychology: Arm"),
            CannotPack("Beg for Mercy"),
            CannotPlayMatching(All([Action, SuperstarSpecific, EarlierThisTurn(filter: All([Action, SuperstarSpecific]), n: 1)])),
        ],
    },
    scripts: {
        // Backstage cards
        // Only the Heat search at the end of the Pre-match phase and The Luck of the Draw slot text are scripted.
        "Blaze of Glory": (
            not_packed_by: ["Doink"],
            not_with: ["Dynamically Inclined"],
            backstage_abilities: [
                EndOfPrematch([
                    MoveCards(who: You, from: Arsenal, to: Ringside, n: 6, up_to: true, filter: Some(All([Keyword("Heat"), Not(SuperstarSpecific)]))),
                ]),
                NoSlotFor(Title("The Luck of the Draw")),
            ],
        ),
        // Approximation: at the end of the Pre-match phase, Arsenal Search 1 non-Unique 'Technical' maneuver. The
        // other texts are not supported yet.
        "Great Technical Prowess": (
            not_packed_by: ["Doink"],
            not_with: ["Back to Basics"],
            backstage_abilities: [EndOfPrematch([Search(filter: All([Maneuver, Not(Trait(Unique)), TitleContains("Technical")]))])],
        ),
        // The card has no text in the data.
        "Fans Love Shenanigans": (),

        // Pre-match
        // Its ACEs, blanking and Hometown Hero texts are not supported yet.
        "A Hero's Welcome": (requires: Some(InYourRing(Title("WWE Homecoming"))), no_slot: true, frees_slots: Some(Title("WWE Homecoming"))),
        // The damage and ACE texts are not supported yet.
        "He's on Fire!": (
            on_opponent_reverses: [
                If(
                    condition: OpponentReversed(All([Action, Keyword("Heat"), Not(SuperstarSpecific)])),
                    effects: [
                        RemoveFromGame(who: Opponent, from: Ringside, n: 1, pick: Random),
                        Search(filter: All([Action, Keyword("Heat"), Not(SuperstarSpecific)]), up_to: true),
                    ],
                ),
            ],
        ),
        // Cards under it are not supported yet; only the ACE is scripted.
        "Empress Ballrom, Blackpool": (
            only_packed_by: ["NXT UK", "Pete Dunne"],
            not_with: ["NXT Arrival"],
            ring_ability: Some((
                effects: [ReturnThis(to: Removed), RingsideToArsenal(who: You, n: 7, up_to: true, filter: Some(All([Maneuver, Not(Reversal)])))],
            )),
        ),
        // Cards under it are not supported yet.
        "Nigel McGuinness: NXT's Artful Dodger": (
            requires: Some(AnyOf([YouAre("NXT"), InYourRing(Title("We Are Not Your Kind"))])),
            not_with: ["A Puncher's Chance"],
        ),
        // The Sustained Damage text is not supported yet.
        "NXT UK Championship Title Belt": (
            only_packed_by: ["NXT"],
            value_bonus: 1,
            while_in_ring: [(applies_to: All([ManeuverType(Strike), Not(Trait(Multi))]), fortitude: -2, damage: 1)],
        ),
        // Approximation: any Tag Team may pack it, and the +2D goes to your first card each turn if it is a Strike.
        // The Sustained Damage texts are not supported yet.
        "NXT UK Tag Team Title Belts": (
            only_packed_by: ["Tag Team"],
            in_ring_start_of_turn: [Boost((applies_to: ManeuverType(Strike), duration: NextCard, damage: 2))],
        ),
        // The ACE (skipping the Draw Segment) and the Ankle Breaker text are not supported yet.
        "Raw Reunion": (not_with: ["Dance, Coach, Dance"]),
        // Approximation: "Edge-specific cards" is Edge's logo. The Ring General text is not supported yet.
        "Ring Presence": (
            not_packed_by: ["Edge"],
            in_ring_on_play: [
                (whose: Some(Opponent), filter: Maneuver, effects: [AsOpponent([Optional([Search(filter: Title("Roll Out Of The Ring"), ringside: true)])])]),
            ],
            ring_ability: Some((
                effects: [
                    ReturnThis(to: Removed),
                    RingToHand(who: You, n: 4, filter: Title("Roll Out Of The Ring"), up_to: true),
                    RingsideToHand(who: You, n: 4, up_to: true, filter: Some(Title("Roll Out Of The Ring"))),
                ],
            )),
        ),
        // Approximation: the Starting Hand Size changes are a draw / discard at the end of the Pre-match phase.
        "Trending Worldwide": (
            pre_match_limit: -1,
            mid_match_limit: 1,
            end_of_prematch: [
                If(condition: Not(SuperstarValueBelowOpponent), effects: [Draw(who: You, n: 2)]),
                If(condition: SuperstarValueBelowOpponent, effects: [Discard(who: Opponent, n: 2, pick: Chosen)]),
            ],
        ),

        // Mid-match
        // The Undertaker restriction, the Theodore Long text and the ACE are not supported yet.
        "One-on-One With The Undertaker!": (
            reverses: Some((targets: AnyOf([Action, All([Maneuver, Not(SuperstarSpecific), DamageAtLeast(10)])]))),
        ),

        // Strikes
        // Approximation: "no Ring non-Superstar-specific D: 1+ Pre-match cards or maneuvers" is any such Ring card. The
        // Classic Competitor text is not supported yet.
        "Greco-Roman Thumb to the Eye": (
            reversal_limits: [(from: [Hand, Backlash, Ringside, Ring, Under], when: Not(InYourRing(All([Not(SuperstarSpecific), DamageAtLeast(1)]))))],
            on_play: [
                Boost((
                    applies_to: All([Maneuver, Not(ManeuverType(HighRisk)), Not(TitleContains("Illegal"))]),
                    duration: NextMatching,
                    fortitude: -5,
                    ignore_play_after: true,
                )),
            ],
        ),
        // Its reveal, Panic / Desperate and Ring texts are not supported yet.
        "Sink Your Teeth In": (),
        // The Ric Flair text is not supported yet.
        "Mule Kick": (
            on_play: [MoveCards(who: You, from: Removed, to: Arsenal, n: 4, up_to: true), Discard(who: Opponent, n: 4, pick: Chosen)],
            reverses: Some((
                targets: All([ManeuverType(Grapple), DamageAtLeast(8)]),
                effects: [MoveCards(who: You, from: Removed, to: Arsenal, n: 2, up_to: true), Discard(who: Opponent, n: 2, pick: Chosen)],
            )),
        ),
        // Approximation: any Counter. The WWE Homecoming packing and Multi texts are not supported yet.
        "Hero Dive": (play_after: Some(Any), play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn]))),
        // Approximation: any Counter. The damage lock and the Arsenal reversal draw are not supported yet.
        "Series of Punches": (
            play_after: Some(Title("Throw Into the Corner Turnbuckle")),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            reversal_limits: [(from: [Hand], when: After(Trait(SetUp)))],
        ),
        // Approximation: any Counter. Blanking Ring cards is not supported yet.
        "Savate Kick": (play_after: Some(Trait(SmackDown)), play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn]))),

        // Grapples
        // The reversal restriction is not supported yet. (The RFG 4 text is printed twice; it is applied once.)
        "Gorilla Press Drop": (
            on_play: [
                Discard(who: Opponent, n: 2, pick: Chosen),
                BacklashToRingside(who: Opponent, n: 2),
                RemoveFromGame(who: Opponent, from: Ringside, n: 4, pick: Controller),
                Search(filter: ManeuverType(TrademarkFinisher), ringside: true),
            ],
        ),

        // Reversals
        // Playing it when the opponent plays a card with a reversal restriction is not supported yet.
        "Hometown Crowd Support": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // Approximation: reverse any card that makes you discard. Its other texts are not supported yet.
        "He's Playing Possum?": (reverses: Some((targets: ForcesDiscard))),

        // Actions
        "A Devilish Smile": (
            on_play: [
                Counted(count: AtMost(YourRingMatching(Trait(FanFavorite)), 5), effect: Draw(who: You, n: 1)),
                Counted(count: AtMost(YourRingMatching(Trait(Heel)), 5), effect: Discard(who: Opponent, n: 1, pick: Chosen)),
            ],
        ),
        "The Anti-Hero": (
            on_play: [
                Counted(count: AtMost(YourRingMatching(Trait(Cheater)), 5), effect: RingsideToArsenal(who: You, n: 1, up_to: true)),
                Counted(count: AtMost(YourRingMatching(Trait(Face)), 5), effect: MoveCards(who: You, from: Removed, to: Arsenal, n: 1, up_to: true)),
            ],
        ),
        // Approximation: your Grapples and Trademark Finishers are +2D (not +1D per RFG maneuver, not for all
        // players). The ACE is not supported yet.
        "Thumb Tacks": (
            while_in_ring: [(applies_to: AnyOf([ManeuverType(Grapple), ManeuverType(TrademarkFinisher)]), damage: 2)],
        ),

        // Keith Lee
        // Approximation: overturn 4 (2 with lower Fortitude, then Bury 1) to draw 1. The Title Belt and reversal-cost
        // texts are not supported yet.
        "The Moment Maker": (
            not_with: ["First of All"],
            backstage_abilities: [NoSlotFor(Keyword("NXT"))],
            backstage_ability: Some((
                effects: [
                    If(condition: FortitudeBelowOpponent, effects: [Mill(who: You, n: 2), Draw(who: You, n: 1), RingsideToArsenalBottom(who: You, n: 1)]),
                    If(condition: Not(FortitudeBelowOpponent), effects: [Mill(who: You, n: 4), Draw(who: You, n: 1)]),
                ],
            )),
        ),
        // Stacking unsuccessful maneuvers and the opponent's Arsenal text are not supported yet.
        "Bask In His Glory": (in_ring_on_play: [(whose: Some(You), filter: Maneuver, effects: [RingsideToArsenalBottom(who: You, n: 1)])]),
        // Approximation: the ACE takes any non-Unique Ringside maneuver (no damage comparison). The protection texts
        // are not supported yet.
        "Limitless": (
            ring_ability: Some((
                requires: Some(All([InYourRing(Not(Trait(Active))), CountAtLeast(count: YourRingsideMatching(All([Maneuver, Not(Trait(Unique))])), n: 1)])),
                cost: [RemoveFromGame(who: You, from: Ring, n: 1, filter: Some(Not(Trait(Active))))],
                effects: [RingsideToHand(who: You, n: 1, filter: Some(All([Maneuver, Not(Trait(Unique))])))],
            )),
        ),
        // Approximation: your next card this turn, if it is a non-Unique non-Hybrid High Risk, is -5F and ignores its
        // "can only be played after" text.
        "Limitless Leegion": (
            requires: Some(Not(FirstTurnOfGame)),
            on_play: [
                Boost((applies_to: All([ManeuverType(HighRisk), Not(Trait(Unique)), Not(Hybrid)]), duration: NextCard, fortitude: -5, ignore_play_after: true)),
            ],
            while_in_ring: [
                (
                    applies_to: All([ManeuverType(HighRisk), After(AnyOf([TitleContains("Power"), TitleContains("Running"), ManeuverType(Submission)]))]),
                    no_hand_reversal: true,
                ),
            ],
        ),
        // Choosing reversals the opponent cannot play and the return-to-hand text are not supported yet.
        "Grizzly Magnum": (bonuses: [(when: Not(InYourRing(Maneuver)), damage: 5)]),
        "The Pounce": (
            on_play: [RemoveFromGame(who: Opponent, from: Ring, n: 1, up_to: true, filter: Some(Not(All([Maneuver, FortitudeAtMost(0)]))), pick: Controller)],
            reverses: Some((
                targets: After(Trait(SetUp)),
                fortitude: Some(0),
                effects: [RemoveFromGame(who: Opponent, from: Ring, n: 2, up_to: true, filter: Some(Not(All([Maneuver, FortitudeAtMost(0)]))), pick: Controller)],
            )),
        ),
        // The non-Multi, blank and Ringside texts are not supported yet.
        "Spirit Bomb": (not_reversed_by: Some(DamageAtLeast(1))),
        // The Backlash choice and the hand text are not supported yet.
        "Big Bang Catastrophe": (bonuses: [(when: All([ReversedLastTurn(Any), FirstCardThisTurn]), fortitude: -10)]),
        "I Ain't Playing Around": (
            reverses: Some((
                targets: Any,
                effects: [Boost((applies_to: All([Maneuver, Not(Trait(Multi))]), duration: NextTurnFirstCard, irreversible: true))],
            )),
        ),
        // Approximation: 'Rope' in the title instead of the text.
        "It's Best You Stay On The Ground": (
            as_action: Some((on_play: [ShuffleThisIntoArsenal, RemoveFromGame(who: Opponent, from: Hand, n: 1)])),
            reverses: Some((
                targets: AnyOf([ManeuverType(HighRisk), All([ManeuverType(TrademarkFinisher), TitleContains("Rope")])]),
                counts_as: 2,
                effects: [RemoveFromGame(who: Opponent, from: Hand, n: 2)],
            )),
        ),
        "Think You Can Stand Up To Me?": (on_play: [RingsideToArsenalCount(who: You, count: Half(OpponentFortitude))]),

        // The Hurt Business
        // Moving between the Backstage and the Ring is not supported yet.
        "I'm In": (),
        // The ACE's blank-Ability option is not supported yet.
        "Putting the Hurt in The Business": (
            while_in_ring: [(applies_to: Maneuver, damage: 3, stun_value: 1)],
            in_ring_on_play: [
                (whose: Some(You), filter: All([Maneuver, FortitudeAtLeast(1)]), effects: [RemoveFromGame(who: Opponent, from: Ringside, n: 1, pick: Random)]),
            ],
            ring_ability: Some((
                requires: Some(HandHas(All([ManeuverType(TrademarkFinisher), SuperstarSpecific]))),
                cost: [MoveCards(who: You, from: Hand, to: Arsenal, n: 1, filter: Some(All([ManeuverType(TrademarkFinisher), SuperstarSpecific])), bottom: true)],
                effects: [Choice([[RingsideToArsenal(who: You, n: 1)], [Draw(who: You, n: 1)]])],
            )),
        ),
        // The Maintain Hold text is not supported yet.
        "The Hurt Lock": (
            requires: Some(AnyOf([Not(Superstar("Lashley")), InYourRing(Title("The Hurt Business"))])),
            play_after: Some(Maneuver),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            reversal_limits: [(from: [Arsenal, Backlash, Ringside, Ring, Under])],
            reverses: Some((targets: Not(Maneuver))),
        ),
        // Playing it after an unsuccessful maneuver is not supported yet.
        "Business is Booming": (requires: Some(Never)),

        // Cedric Alexander
        // Its packing, Fan Favorite and Ringside Search texts are not supported yet.
        "PLEASE SIGN CEDRIC!": (),
        // Approximation: always hidden (revealing it when you play The Hurt Business is not supported).
        "Prime Alexander": (
            starts_hidden: true,
            backstage_ability: Some((requires: Some(FortitudeAboveOpponent), effects: [Draw(who: You, n: 1)])),
        ),
        // Approximation: -5F instead of -half the opponent's Fortitude. Cards under 205 Live are not supported.
        "In The Dark I Feel At Home": (
            while_in_ring: [
                (
                    applies_to: All([
                        Holds(FortitudeBelowOpponent),
                        AnyOf([All([Reversal, Not(Hybrid)]), All([ManeuverType(HighRisk), Not(Trait(Unique))])]),
                    ]),
                    fortitude: -5,
                ),
            ],
        ),
        // Approximation: "cannot respond" is "cannot be reversed"; the opponent picks between RFG 1 hand card and
        // RFG 1 of his Ring maneuvers. The -15F and Ringside-play texts are not supported yet.
        "Now It's Mine And I Won't Let Go": (
            irreversible: true,
            in_ring_on_play: [
                (
                    whose: Some(Opponent),
                    filter: Maneuver,
                    effects: [
                        If(
                            condition: All([HandAtLeast(2), FortitudeAboveOpponent]),
                            effects: [Choice([[RemoveFromGame(who: You, from: Hand, n: 1)], [RemoveFromGame(who: You, from: Ring, n: 1, filter: Some(Maneuver))]])],
                        ),
                    ],
                ),
            ],
        ),
        "Backflip Head Scissors": (reversal_limits: [(from: [Hand], when: All([ReversedLastTurn(Any), FirstCardThisTurn]))], reverses: Some((targets: After(Trait(SetUp))))),
        // Approximation: any Counter. The High Risk change is not supported yet.
        "Springboard Flatliner": (play_after: Some(Trait(SetUp)), play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn]))),
        // Approximation: the Counter text applies when you reversed to end the opponent's last turn; the
        // unsuccessful text only when it is reversed from hand.
        "The Neuralyzer": (
            on_play: [If(condition: ReversedLastTurn(Any), effects: [LookAtHand(who: Opponent), Discard(who: Opponent, n: 2, pick: Controller)])],
            on_reversed_from_hand: [Discard(who: Opponent, n: 2, pick: Chosen)],
        ),
        // Cards under 205 Live are not supported yet.
        "Lumbar Check": (on_play: [If(condition: Superstar("The Hurt Business"), effects: [Discard(who: Opponent, n: 3, pick: Chosen)])]),
        // Cards under 205 Live are not supported yet.
        "Used To Dream I'd Have It All": (
            reverses: Some((
                targets: Any,
                effects: [
                    MoveCards(who: You, from: Removed, to: Backlash, n: 1, up_to: true, filter: Some(Title("Now It's Mine And I Won't Let Go"))),
                    MoveCards(who: You, from: Ringside, to: Backlash, n: 1, up_to: true, filter: Some(Title("Now It's Mine And I Won't Let Go"))),
                ],
            )),
        ),
        // Only Ringside maneuvers are shuffled in; the Prime Alexander text is not supported yet.
        "Time Has Passed And Now I'm Grown": (on_play: [RingsideToArsenal(who: You, n: 30, up_to: true, filter: Some(All([Maneuver, Not(Hybrid)])))]),

        // Bianca Belair
        // Face-down cards and gaining maneuver types are not supported yet.
        "Watch Me Shine": (),
        // Approximation: draw 1 at the end of the Pre-match phase, and 1 more before your Draw Segment while you
        // have greater Fortitude; the 3-reversal text works on printed Multi maneuvers.
        "The EST of WWE": (
            end_of_prematch: [Draw(who: You, n: 1)],
            in_ring_start_of_turn: [If(condition: FortitudeAboveOpponent, effects: [Draw(who: You, n: 1)])],
            while_in_ring: [
                (
                    applies_to: All([Maneuver, Trait(Multi), Holds(CountBelow(a: Plus(YourFortitude, Const(4)), b: OpponentFortitude))]),
                    reversals_needed: 3,
                ),
            ],
            while_in_ring_opponent: [(applies_to: Holds(OpponentHandLarger), damage: -1, stun_value: -1)],
        ),
        // Approximation: # is 2 (maneuver types in the Ring are not counted).
        "Beware The Hair of Bianca Belair": (
            on_play: [RingsideToArsenalBottom(who: You, n: 2)],
            on_reversed_from_hand: [ReversedCardTo(to: Backlash)],
            reverses: Some((targets: AnyOf([ManeuverType(HighRisk), After(Trait(SetUp))]), effects: [HandToArsenalBottom(who: Opponent, n: 2)])),
        ),
        // Approximation: the opponent always discards 3.
        "Alley-Oop": (reversal_limits: [(from: [Backlash], when: All([ReversedLastTurn(Any), FirstCardThisTurn]))], on_play: [Discard(who: Opponent, n: 3, pick: Chosen)]),
        // Approximation: "as a Counter" is "you reversed to end his last turn".
        "Chicken Wing Facebuster": (
            reversal_limits: [(from: [Backlash, Ringside, Ring, Under], when: AnyOf([FortitudeAboveOpponent, HandLargerBy(1)]))],
            on_play: [If(condition: ReversedLastTurn(Any), effects: [RingsideToArsenal(who: You, n: 5, up_to: true)])],
        ),
        // Approximation: the number of different maneuver types is taken as 2.
        "Kiss of Death": (
            reversal_limits: [(from: [Hand], when: All([ReversedLastTurn(Maneuver), FirstCardThisTurn]))],
            on_play: [Counted(count: Plus(Const(2), YourFaceDown), effect: RemoveFromGame(who: Opponent, from: Arsenal, n: 0))],
        ),
        // The Allegiance and Multi follow-up texts are not supported yet.
        "I'm On My Own, Against the Wall": (
