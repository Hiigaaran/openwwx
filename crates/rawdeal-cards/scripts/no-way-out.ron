                Discard(who: Opponent, n: 4, pick: Chosen),
                Search(filter: Any),
                RingsideToArsenal(who: You, n: 9),
                Arrange(who: Opponent, n: 8),
            ],
        ),
        // Discarding a card for less F is not supported yet.
        "No Fault Drop": (),
        // Removing cards from the game for its Ring ability is not supported yet.
        "Jillian Hall: The Fixer": (
            reverses: Some((
                targets: AnyOf([ManeuverType(Strike), ManeuverType(Grapple)]),
                fortitude_when: Some((FortitudeBelowOpponent, 0)),
            )),
        ),
        // Its Ringside pile ability is not supported yet.
        "The Brain": (),
        "The Thump": (bonuses: [(per: Some(ManeuverType(Grapple)), fortitude: -3, damage: 3)]),
        // Reversing non-damage card effects is not supported yet.
        // Approximation: as an action the card is shuffled into the Arsenal instead of put on the bottom.
        "At Ease, Soldier": (
            on_play: [ShuffleThisIntoArsenal, LookAtHand(who: Opponent), Discard(who: Opponent, n: 1, pick: Controller)],
            reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]), overturned_only: true)),
        ),
        // Overturning 3 cards for less F and the ACE ability are not supported yet.
        "The Intensity of Ten Cities": (
            on_play: [
                Boost((applies_to: Maneuver, duration: NextCard, damage: 10)),
                Boost((applies_to: Action, duration: NextCard, fortitude: -10)),
            ],
        ),
        // Shuffling removed cards back is not supported yet, so overturning gains nothing.
        "Should've Seen This Coming": (reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]), from_hand_only: true))),
        // Approximation: one of the opponent's top cards goes to the Ringside pile instead of leaving the game, the
        // other stays on top; you take 1 of your top 3 cards and the rest go to the bottom of your Arsenal.
        "Pails o' Fun": (end_of_prematch: [Mill(who: Opponent, n: 2), Dig(n: 3, take: 1)]),
    },
)
