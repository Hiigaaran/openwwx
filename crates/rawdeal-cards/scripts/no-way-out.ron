            on_play: [
                Counted(
                    count: YourRingMatching(Trait(FanFavorite)),
                    effect: Boost((applies_to: Maneuver, duration: ThisTurn, damage: 1)),
                ),
                Counted(count: SuperstarValue, effect: Boost((applies_to: Maneuver, duration: ThisTurn, damage: 1))),
            ],
        ),

        // Carlito
        "Carlito's Cabana": (
            pre_match_limit: 1,
            ring_ability: Some((sacrifice: true, effects: [Search(filter: All([Maneuver, Not(Trait(Unique))]))])),
            ringside_ability: Some((
                cost: [RemoveFromGame(who: You, from: Ringside, n: 1, filter: Some(Title("Carlito's Cabana")))],
                effects: [RingsideToArsenal(who: You, n: 4, up_to: true)],
            )),
