// Hand-written scripts for No Way Out cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
(
    abilities: {
        // Spit At Opponent losing the Heel trait is not supported yet. The 'cool' cards are the ones known so far.
        "Carlito": [
            DrawSegment(4),
            CardFortitude(title: "Spit At Opponent", delta: -4),
            OpponentCannotPlay("Everything's Cool When You're..."),
            OpponentCannotPlay("Freaks Are Cool!"),
            OpponentCannotPlay("...People Who Don't Want to Be Cool"),
        ],
        // Approximation: the DDT card is discarded instead of put on the bottom of the Arsenal, and the opponent
        // chooses which card goes on the bottom of his Arsenal.
        "Jake the Snake": [
            CannotBeReversedBy(played: TitleContains("DDT"), reversal: All([Reversal, AnyOf([Maneuver, Action])])),
            Activated(
                cost: [DiscardMatching(who: You, n: 1, filter: TitleContains("DDT"), pick: Chosen)],
                effects: [LookAtHand(who: Opponent), HandToArsenalBottom(who: Opponent, n: 1)],
            ),
        ],
        // Removing cards from the game is not supported yet. He counts as The Million Dollar Man so he can pack
        // the cards with that logo.
        "The Million Dollar Man Ted DiBiase": [CountsAs(["The Million Dollar Man"])],
        // Volley is not supported yet.
        // Approximation: he counts as Booker T for card effects too.
        "The Bookerman": [CountsAs(["Booker T"])],
        // Your opponent removing a Ring card when you end your turn without a maneuver is not supported yet.
        // Approximation: he counts as Big Show for card effects too.
        "The Largest Athlete in Sports Entertainment": [
            CannotPackMatching(ManeuverType(HighRisk)),
            FortitudeFor(
                filter: All([
                    AnyOf([ManeuverType(Strike), ManeuverType(Grapple), ManeuverType(Submission)]),
                    Not(Trait(Multi)),
                ]),
                delta: -100,
            ),
            OnPlayMatching(filter: Maneuver, effects: [EndTurn]),
            CountsAs(["Big Show"]),
        ],
        // Approximation: the 2 cards go to the Ringside pile instead of leaving the game. She counts as Lita for
        // card effects too.
        "X-treme Diva": [
            OnOpponentPlayMatching(
                filter: Maneuver,
                effects: [Choice([[Mill(who: Opponent, n: 2)], [Mill(who: Opponent, n: 3)]])],
            ),
            CountsAs(["Lita"]),
        ],
        // Approximation: only one of the two abilities can be used each turn.
        "Chavo Guerrero": [
            Activated(
                cost: [DiscardMatching(who: You, n: 1, filter: ManeuverType(HighRisk), pick: Chosen)],
                effects: [RingsideToArsenalBottom(who: You, n: 3)],
            ),
            Activated(
                cost: [Mill(who: You, n: 3)],
                effects: [RingsideToHand(who: You, n: 1, filter: Some(ManeuverType(HighRisk)))],
            ),
        ],
        // The added text on 'Funaki' Pre-match cards is not supported yet. Hybrids with two maneuver types are not
        // caught by the packing limit.
        "Funaki": [
            CannotPackMatching(AnyOf([All([Maneuver, Action]), All([Maneuver, Reversal]), All([Action, Reversal])])),
            OpponentCannotPlay("SmackDown! #1 Announcer Funaki"),
        ],
        "Mexicools": [
            Activated(
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [
                    Search(
                        filter: AnyOf([
                            All([Trait(SetUp), TitleContains("From the")]),
                            All([
                                Maneuver,
                                AnyOf([TitleContains("blindside"), TitleContains("precision"), TitleContains("technical")]),
                            ]),
                        ]),
                    ),
                ],
            ),
        ],
        "Viscera": [
            CardFortitude(title: "Irish Whip", delta: -8),
            CardFortitude(title: "Throw Into the Corner Turnbuckle", delta: -8),
            CardFortitude(title: "Gut Wrench", delta: -8),
            FortitudeFor(
                filter: All([
                    AnyOf([ManeuverType(Strike), ManeuverType(Grapple)]),
                    After(AnyOf([Title("Irish Whip"), Title("Throw Into the Corner Turnbuckle"), Title("Gut Wrench")])),
                ]),
                delta: -8,
            ),
        ],
    },
    scripts: {
        // High Risk
        // Approximation: as an action the card is shuffled into the Arsenal instead of put on the bottom.
        "Technical Stomp": (
            play_after: Some(Any),
            on_play: [Optional([Search(filter: TitleContains("technical"))])],
            as_action: Some((fortitude: Some(0), on_play: [ShuffleThisIntoArsenal, Discard(who: Opponent, n: 1, pick: Chosen)])),
        ),
        // Keeping the opponent from playing Over Sell Maneuver after it is not supported yet.
        "Shoot Aerial 360-Degree Kick": (
            play_after: Some(AnyOf([All([Action, Trait(SetUp)]), TitleContains("shoot")])),
            not_reversed_by: Some(AnyOf([Title("Lift a Boot"), Title("Overshot Your Mark")])),
        ),
        // Discarding Backlash cards for less F is not supported yet.
        "Precision Knee Drop": (
            play_after: Some(All([Maneuver, DamageAtLeast(2)])),
            on_play: [
                RingsideToHand(who: You, n: 1, filter: Some(ManeuverType(HighRisk))),
                RingsideToHand(who: You, n: 1),
            ],
        ),

        // Strikes
        "Dynamic Punch": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        "Dynamic Hook": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        // Volley is not supported yet.
        "Straight Clothesline": (bonuses: [(when: FortitudeAtMostOpponent, fortitude: -4)]),
        // Coming back from the Ringside pile and Volley are not supported yet.
        "Thrust Kick": (),
        // Keeping the opponent from playing Over Sell Maneuver and removing cards from the game are not supported yet.
        "Shoot Punch": (not_reversed_by: Some(Title("Step Aside"))),
        "Dynamic Forearm": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        // Approximation: as an action, at most 2 other 'technical' cards can be discarded.
        "Technical Clothesline": (
            on_play: [Optional([Search(filter: TitleContains("technical"))])],
            as_action: Some((
                fortitude: Some(4),
                on_play: [
                    DiscardThis,
                    Choice([
                        [],
                        [
                            If(
                                condition: HandHas(TitleContains("technical")),
                                effects: [
                                    DiscardMatching(who: You, n: 1, filter: TitleContains("technical"), pick: Chosen),
                                    LookAtHand(who: Opponent),
                                    Discard(who: Opponent, n: 1, pick: Controller),
                                ],
                            ),
                        ],
                        [
                            If(
                                condition: HandHas(TitleContains("technical")),
                                effects: [
                                    DiscardMatching(who: You, n: 1, filter: TitleContains("technical"), pick: Chosen),
                                    If(
                                        condition: HandHas(TitleContains("technical")),
                                        effects: [
                                            DiscardMatching(who: You, n: 1, filter: TitleContains("technical"), pick: Chosen),
                                            LookAtHand(who: Opponent),
                                            Discard(who: Opponent, n: 2, pick: Controller),
                                        ],
                                    ),
                                ],
                            ),
                        ],
                    ]),
                ],
            )),
        ),
        "Dynamic Knee Lift": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        // Naming a number above 0 for less F is not supported yet (it is played as naming 0).
        "Precision Kick": (no_arsenal_reversal: true, on_play: [Discard(who: You, n: 1, pick: Chosen)]),
        // Playing it from the Ringside pile is not supported yet.
        "Blindside Tornado Strike": (),
        "Whirling Elbow": (
            on_play: [
                Choice([
                    [],
                    [If(condition: HandAtLeast(1), effects: [Discard(who: You, n: 1, pick: Chosen), Draw(who: You, n: 1)])],
                    [If(condition: HandAtLeast(2), effects: [Discard(who: You, n: 2, pick: Chosen), Draw(who: You, n: 2)])],
                    [If(condition: HandAtLeast(3), effects: [Discard(who: You, n: 3, pick: Chosen), Draw(who: You, n: 3)])],
                    [If(condition: HandAtLeast(4), effects: [Discard(who: You, n: 4, pick: Chosen), Draw(who: You, n: 4)])],
                    [If(condition: HandAtLeast(5), effects: [Discard(who: You, n: 5, pick: Chosen), Draw(who: You, n: 5)])],
                ]),
            ],
        ),
        "Dynamic Lariat": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        // Removing cards from the game and Volley are not supported yet. Female Superstars cannot play it anyway
        // (Multi).
        "Punch After Punch": (),

        // Grapples
        // Putting discarded DDT cards on the bottom of the Arsenal to draw is not supported yet.
        "Snap DDT": (before_reversal: [Discard(who: You, n: 2, pick: Chosen)]),
        "Dynamic Throw": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        "Dynamic Drop": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        // Approximation: the overturned card is drawn even when it is a Heat card.
        "Delayed Atomic Drop": (on_play: [Draw(who: You, n: 1)]),
        // Playing it from the Ringside pile is not supported yet.
        "Blindside Beal Toss": (),
        "Rolling Neck Breaker": (
            not_reversed_by: Some(All([Reversal, AnyOf([Maneuver, Action])])),
            reverses: Some((targets: TitleContains("dynamic"))),
        ),
        "Dynamic Takedown": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        "Dynamic Slam": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        // Naming a number above 0 for less F and removed cards are not supported yet (it is played as naming 0).
        "Precision Suplex": (),
        "Dynamic Driver": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        // Approximation: the 4 Backlash cards are picked at random.
        "Technical Power Bomb": (
            on_play: [Optional([Search(filter: TitleContains("technical"))])],
            as_action: Some((
                fortitude: Some(8),
                on_play: [
                    ShuffleThisIntoArsenal,
                    Choice([[Draw(who: You, n: 1)], [BacklashToRingside(who: Opponent, n: 4, random: true)]]),
                ],
            )),
        ),
        // The +2 Stun Value for each listed card is not supported yet.
        "Vertical Power Bomb": (
            requires: Some(
                InYourRing(
                    AnyOf([
                        Title("Face Driver"),
                        Title("Go-behind"),
                        Title("Slap"),
                        Title("Shoulder Thrust"),
                        Title("Throw"),
                        Title("Toss"),
                        Title("Vertical DDT Drop"),
                    ]),
                ),
            ),
            bonuses: [
                (
                    per: Some(
                        AnyOf([
                            Title("Face Driver"),
                            Title("Go-behind"),
                            Title("Slap"),
                            Title("Shoulder Thrust"),
                            Title("Throw"),
                            Title("Toss"),
                            Title("Vertical DDT Drop"),
                        ]),
                    ),
                    fortitude: -4,
                ),
            ],
        ),
        "Atomic Power Slam": (bonuses: [(per: Some(Trait(Chain)), fortitude: -1, damage: 1)]),

        // Submissions
        "Dynamic Arm Bar": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        // Approximation: the opponent's Ringside pile is not checked for Heat cards.
        "Arm Twist": (
            on_play: [
                Search(filter: Keyword("Heat")),
                Boost((applies_to: All([Maneuver, Keyword("Heat")]), duration: NextMatching, damage: 6)),
            ],
        ),
        "Dynamic Headlock": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        // Playing it from the Ringside pile is not supported yet.
        "Blindside Abdominal Stretch": (),
        // Approximation: the chosen cards are discarded instead of kept under it, so the -2F to your cards is lost.
        "Arm Wrench": (
            not_reversed_by: Some(All([Reversal, AnyOf([Maneuver, Action])])),
            on_play: [DiscardForDamage(per: 1)],
        ),
        // Keeping cards under it is not supported yet (it is played choosing no cards).
        "Vise Lock": (),
        "Dynamic Stretch": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        "Dynamic Bear Hug": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        // Naming a number above 0 for less F is not supported yet (it is played as naming 0).
        "Precision Sleeper": (play_after: Some(Any), no_hand_reversal: true),
        // Approximation: as an action the cards are shuffled into the Arsenal instead of put on the bottom.
        "Technical Crab": (
            on_play: [Optional([Search(filter: TitleContains("technical"))])],
            as_action: Some((
                fortitude: Some(2),
                on_play: [ShuffleThisIntoArsenal, RingsideToArsenal(who: You, n: 1), Mill(who: Opponent, n: 1)],
            )),
        ),
        "Fujiwara Arm Bar": (play_after: Some(Any), on_play: [Optional([RingsideToHand(who: You, n: 1)])]),
        "Dynamic Figure Four": (
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    DiscardThis,
                    Search(filter: TitleContains("dynamic"), ringside: true),
                    CannotPlay(who: You, filter: All([Action, TitleContains("dynamic")]), turns: 1),
                ],
            )),
        ),
        "Atomic Body Lock": (
            on_play: [
                Counted(
                    count: YourRingMatching(
                        AnyOf([
                            Title("Face Driver"),
                            Title("Go-behind"),
                            Title("Slap"),
                            Title("Shoulder Thrust"),
                            Title("Throw"),
                            Title("Toss"),
                            Title("Vertical DDT Drop"),
                        ]),
                    ),
                    effect: Discard(who: Opponent, n: 0, pick: Chosen),
                ),
                Counted(
                    count: YourRingMatching(
                        AnyOf([
                            Title("Face Driver"),
                            Title("Go-behind"),
                            Title("Slap"),
                            Title("Shoulder Thrust"),
                            Title("Throw"),
                            Title("Toss"),
                            Title("Vertical DDT Drop"),
                        ]),
                    ),
                    effect: RingsideToArsenal(who: You, n: 0),
                ),
            ],
        ),

        // Reversals
        // Telling which cards have a 'can only be reversed' restriction is not supported yet.
        "It's Great To Be Back Here In...": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // Removing the reversed card from the game is not supported yet.
        "Just What the Game Needs": (
            reverses: Some((
                targets: AnyOf([
                    TitleContains("blindside"),
                    TitleContains("dynamic"),
                    TitleContains("precision"),
                    TitleContains("technical"),
                ]),
            )),
        ),
        // Removing cards from the game and the +10F to the opponent's Mid-match Reversals are not supported yet.
        "The Coach Says, 'Today's the Day!'": (reverses: Some((targets: Trait(MidMatch)))),
        // Its Ringside pile ability is not supported yet.
        "Once Again, Kissing Up to the Fans!": (
            reverses: Some((
                targets: AnyOf([
                    Keyword("Fan Favorite"),
                    All([Not(Trait(Unique)), PlayerRingHas(filter: Keyword("Fan Favorite"), n: 4)]),
                ]),
            )),
        ),
        // Its Ringside pile ability is not supported yet.
        "You Can't Cheat an Honest Man...": (
            reverses: Some((
                targets: AnyOf([
                    Keyword("Cheater"),
                    All([Not(Trait(Unique)), PlayerRingHas(filter: Keyword("Cheater"), n: 4)]),
                ]),
            )),
        ),

        // Actions
        // Its Ring ability (removing it from the game) is not supported yet.
        "Contrary to Popular Opinion": (
            on_play: [
                Counted(
                    count: OpponentValueTimes(1),
                    effect: BoostOpponent((applies_to: Maneuver, duration: NextTurn, fortitude: 1)),
                ),
            ],
        ),
        // Playing cards from the Ringside pile is not supported yet.
        "Between the Ropes": (requires: Some(Never)),
        // Removing cards from the game is not supported yet.
        "Over the Ropes": (requires: Some(Never)),
        "Painfully Obvious Precision": (
            on_play: [RingsideToArsenal(who: You, n: 6, up_to: true, filter: Some(TitleContains("precision")))],
            while_in_ring: [(applies_to: All([Maneuver, TitleContains("precision")]), stun_value: 1)],
        ),
        // Making the next card a Multi card is not supported yet.
        "...And the Crowd Roars": (on_play: [Draw(who: You, n: 2)]),
        // The extra discards for the Cheater cards in your Ring are not supported yet.
        "By Any Means Necessary": (on_play: [Discard(who: Opponent, n: 2, pick: Random)]),
        // Naming the cards that can reverse it is not supported yet.
        "Shoot Action": (),
        // Reversing cards not played from hand from the Ring is not supported yet.
        "Ashley: Pretty Punk": (requires: Some(Never)),
        // WWE Divas cards are not in the game yet.
        "Mickie: Fervent Fanatic": (on_play: [Search(filter: Not(Trait(Unique)), n: 2)]),
        // Its Ring ability (ending the opponent's turn after damage) is not supported yet.
        "Kick Out!": (
            bonuses: [(fortitude: -10)],
            on_play: [Draw(who: You, n: 1)],
            reverses: Some((
                targets: All([Maneuver, Not(Trait(Unique))]),
                overturned_only: true,
                requires: Some(FortitudeBelowOpponent),
            )),
        ),

        // Pre-match
        // Approximation: the other 3 cards go to the bottom of the Arsenal instead of leaving the game.
        "Givin' 'em High Fives": (end_of_prematch: [Dig(n: 5, take: 2)]),
        // Comparing the Reversal cards in both hands is not supported yet.
        "In The Interest Of Fairness": (requires: Some(Never)),
        "Technically Sound and Brutal": (
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: All([Maneuver, TitleContains("technical")]),
                    effects: [
                        Choice([
                            [Draw(who: You, n: 1), HandToArsenalBottom(who: You, n: 1)],
                            [RingsideToArsenalBottom(who: You, n: 1)],
                        ]),
                    ],
                ),
            ],
        ),
        // Approximation: only one of the two abilities can be used each turn.
        "I Have A Major Announcement": (
            restricts_self: Some((
                filter: All([
                    Maneuver,
                    Not(SuperstarSpecific),
                    Not(
                        AnyOf([
                            Title("Superplex"),
                            Title("Wheelbarrow Slam"),
                            Title("Neck Breaker"),
                            Title("Arm Breaker"),
                            Title("Waist Lock"),
                            Title("Flying Head Scissors"),
                            Title("Leg Drop"),
                            Title("Splash"),
                            Title("Moonsault"),
                            Title("Whirling Backhand"),
                            Title("European Uppercut"),
                            Title("Rib Breaker"),
                            Title("Back Breaker"),
                            Title("Double Leg Takedown"),
                            Title("Fireman's Carry"),
                            Title("Brainbuster"),
                            Title("Airplane Spin"),
                            Title("Chin Lock"),
                            Title("Chicken Wing"),
                            Title("Abdominal Stretch"),
                            Title("STF"),
                            Title("Figure Four Leg Lock"),
                        ]),
                    ),
                ]),
            )),
            ring_ability: Some((
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [
                    Choice([
                        [
                            RingsideToArsenal(
                                who: You,
                                n: 2,
                                filter: Some(
                                    AnyOf([
                                        Title("Superplex"),
                                        Title("Wheelbarrow Slam"),
                                        Title("Neck Breaker"),
                                        Title("Arm Breaker"),
                                        Title("Waist Lock"),
                                        Title("Flying Head Scissors"),
                                        Title("Leg Drop"),
                                        Title("Splash"),
                                        Title("Moonsault"),
                                        Title("Whirling Backhand"),
                                        Title("European Uppercut"),
                                        Title("Rib Breaker"),
                                        Title("Back Breaker"),
                                        Title("Double Leg Takedown"),
                                        Title("Fireman's Carry"),
                                        Title("Brainbuster"),
                                        Title("Airplane Spin"),
                                        Title("Chin Lock"),
                                        Title("Chicken Wing"),
                                        Title("Abdominal Stretch"),
                                        Title("STF"),
                                        Title("Figure Four Leg Lock"),
                                    ]),
                                ),
                            ),
                        ],
                        [
                            Search(
                                filter: AnyOf([
                                    Title("Superplex"),
                                    Title("Wheelbarrow Slam"),
                                    Title("Neck Breaker"),
                                    Title("Arm Breaker"),
                                    Title("Waist Lock"),
                                    Title("Flying Head Scissors"),
                                    Title("Leg Drop"),
                                    Title("Splash"),
                                    Title("Moonsault"),
                                    Title("Whirling Backhand"),
                                    Title("European Uppercut"),
                                    Title("Rib Breaker"),
                                    Title("Back Breaker"),
                                    Title("Double Leg Takedown"),
                                    Title("Fireman's Carry"),
                                    Title("Brainbuster"),
                                    Title("Airplane Spin"),
                                    Title("Chin Lock"),
                                    Title("Chicken Wing"),
                                    Title("Abdominal Stretch"),
                                    Title("STF"),
                                    Title("Figure Four Leg Lock"),
                                ]),
                            ),
                        ],
                    ]),
                ],
            )),
        ),
        // Approximation: Volley maneuvers cannot be told apart, so they cannot be searched for or played, and the
        // two cards found do not have to be different.
        "You Will Witness History": (
            end_of_prematch: [
                Search(
                    filter: All([Maneuver, Not(Trait(Unique)), AnyOf([Trait(Chain), Keyword("Heat")])]),
                    n: 2,
                ),
            ],
            restricts_self: Some((
                filter: AnyOf([
                    All([Maneuver, Not(AnyOf([SuperstarSpecific, Trait(Chain), Keyword("Heat")]))]),
                    All([Maneuver, SameTitleInRing]),
                ]),
            )),
        ),
        // Virtual maneuvers and the Back to Basics card list are not supported yet.
        "There Is No Escape": (requires: Some(Never)),
        // Removing cards from the game and losing the game are not supported yet.
        "Denville, New Jersey": (requires: Some(Never)),
        "WWE Homecoming": (
            restricts_self: Some((filter: All([Reversal, Trait(MidMatch)]))),
            ring_ability: Some((
                effects: [
                    Search(
                        filter: AnyOf([
                            Title("Back Breaker Torture Rack"),
                            Title("Front Chancery"),
                            Title("Rolling Headlock Vise"),
                            Title("Short Arm Rib Breaker"),
                            Title("Super Hold"),
                            Title("Superkick"),
                            Title("Suplex"),
                        ]),
                    ),
                ],
            )),
        ),
        // Keeping cards under it and changing the Pre-match limit are not supported yet.
        "That's Value!": (requires: Some(Never)),

        // Mid-match
        // Approximation: Kick Out! goes to the Ringside pile instead of leaving the game.
        "Go For the Cover!": (
            play_after: Some(Maneuver),
            requires: Some(FortitudeAboveOpponent),
            on_play: [
                If(
                    condition: OpponentRingHas(filter: Title("Kick Out!"), n: 1),
                    effects: [
                        OpponentChooses(
                            n: 1,
                            options: [
                                [RemoveFromRing(who: Opponent, n: 1, filter: Title("Kick Out!"))],
                                [
                                    MillUntil(who: Opponent, filter: All([Reversal, Not(AnyOf([Maneuver, Action]))])),
                                    MillUntil(who: Opponent, filter: All([Reversal, Not(AnyOf([Maneuver, Action]))])),
                                    MillUntil(who: Opponent, filter: All([Reversal, Not(AnyOf([Maneuver, Action]))])),
                                ],
                            ],
                        ),
                    ],
                ),
                If(
                    condition: Not(OpponentRingHas(filter: Title("Kick Out!"), n: 1)),
                    effects: [
                        MillUntil(who: Opponent, filter: All([Reversal, Not(AnyOf([Maneuver, Action]))])),
                        MillUntil(who: Opponent, filter: All([Reversal, Not(AnyOf([Maneuver, Action]))])),
                        MillUntil(who: Opponent, filter: All([Reversal, Not(AnyOf([Maneuver, Action]))])),
                    ],
                ),
            ],
        ),
        "A Punch That'll Take Someone's Head Off": (
            on_play: [LookAtHand(who: Opponent), Discard(who: Opponent, n: 1, pick: Controller)],
        ),
        "Precision Personified": (on_play: [Search(filter: TitleContains("precision"))]),
        // Reversing cards that move Ringside cards or non-unique hybrids, and the +3D, are not supported yet.
        "Shoot Counter": (reverses: Some((targets: Draws, requires: Some(InYourRing(TitleContains("shoot")))))),
        // Putting removed cards back on the Arsenal is not supported yet.
        "Blindsided Rage": (
            on_play: [
                Counted(
                    count: YourRingMatching(All([Maneuver, TitleContains("blindside")])),
                    effect: Discard(who: Opponent, n: 0, pick: Chosen),
                ),
                Counted(
                    count: YourRingMatching(All([Maneuver, TitleContains("blindside")])),
                    effect: RingsideToArsenal(who: You, n: 0),
                ),
                Counted(count: YourRingMatching(All([Maneuver, TitleContains("blindside")])), effect: Draw(who: You, n: 0)),
            ],
        ),
        // Discarding Reversals from the Backlash decks is not supported yet.
