                Counted(
                    count: YourRingMatching(All([Maneuver, TitleContains("blindside")])),
                    effect: RingsideToArsenal(who: You, n: 0),
                ),
                Counted(count: YourRingMatching(All([Maneuver, TitleContains("blindside")])), effect: Draw(who: You, n: 0)),
            ],
