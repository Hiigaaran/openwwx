                            effects: [HandToArsenalTop(who: You, n: 1), RingsideToArsenal(who: You, n: 2, up_to: true)],
                        ),
                    ],
                    [
                        If(
                            condition: HandAtLeast(2),
                            effects: [HandToArsenalTop(who: You, n: 2), RingsideToArsenal(who: You, n: 4, up_to: true)],
                        ),
                    ],
                    [
                        If(
