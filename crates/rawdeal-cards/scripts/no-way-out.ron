            on_play: [Optional([Search(filter: TitleContains("technical"))])],
            as_action: Some((
                fortitude: Some(8),
                on_play: [
                    ShuffleThisIntoArsenal,
                    Choice([[Draw(who: You, n: 1)], [BacklashToRingside(who: Opponent, n: 4, random: true)]]),
                ],
