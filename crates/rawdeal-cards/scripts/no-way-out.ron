        ),
        // Approximation: as an action, at most 2 other 'technical' cards can be discarded.
        "Technical Clothesline": (
            on_play: [Optional([Search(filter: TitleContains("technical"))])],
            as_action: Some((
                fortitude: Some(4),
                on_play: [
                    DiscardThis,
                    Choice([
                        [],
