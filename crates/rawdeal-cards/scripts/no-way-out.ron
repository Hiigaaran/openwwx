                    ],
                    [
                        If(
                            condition: HandAtLeast(2),
                            effects: [HandToArsenalBottom(who: You, n: 2), RemoveFromRing(who: Opponent, n: 2, filter: Any)],
                        ),
                    ],
                    [
                        If(
                            condition: HandAtLeast(3),
                            effects: [HandToArsenalBottom(who: You, n: 3), RemoveFromRing(who: Opponent, n: 3, filter: Any)],
                        ),
