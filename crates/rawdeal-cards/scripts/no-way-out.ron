        // Mid-match
        "Go For the Cover!": (
            play_after: Some(Maneuver),
            requires: Some(FortitudeAboveOpponent),
            on_play: [
                If(
                    condition: OpponentRingHas(filter: Title("Kick Out!"), n: 1),
                    effects: [
                        OpponentChooses(
                            n: 1,
                            options: [
                                [RemoveFromGame(who: Opponent, from: Ring, n: 1, filter: Some(Title("Kick Out!")))],
                                [
                                    MillUntil(who: Opponent, filter: All([Reversal, Not(AnyOf([Maneuver, Action]))])),
                                    MillUntil(who: Opponent, filter: All([Reversal, Not(AnyOf([Maneuver, Action]))])),
                                    MillUntil(who: Opponent, filter: All([Reversal, Not(AnyOf([Maneuver, Action]))])),
                                ],
                            ],
                        ),
                    ],
                ),
                If(
                    condition: Not(OpponentRingHas(filter: Title("Kick Out!"), n: 1)),
                    effects: [
                        MillUntil(who: Opponent, filter: All([Reversal, Not(AnyOf([Maneuver, Action]))])),
                        MillUntil(who: Opponent, filter: All([Reversal, Not(AnyOf([Maneuver, Action]))])),
                        MillUntil(who: Opponent, filter: All([Reversal, Not(AnyOf([Maneuver, Action]))])),
                    ],
                ),
            ],
        ),
