        "Thrust Kick": (
            ringside_ability: Some((requires: Some(After(All([Maneuver, Keyword("Volley")]))), effects: [ReturnThis(to: Hand)])),
        ),
        // Keeping the opponent from playing Over Sell Maneuver is not supported yet, and the removal only happens
