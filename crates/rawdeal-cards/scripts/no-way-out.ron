        ],
        "Viscera": [
            CardFortitude(title: "Irish Whip", delta: -8),
            CardFortitude(title: "Throw Into the Corner Turnbuckle", delta: -8),
            CardFortitude(title: "Gut Wrench", delta: -8),
            FortitudeFor(
                filter: All([
                    AnyOf([ManeuverType(Strike), ManeuverType(Grapple)]),
                    After(AnyOf([Title("Irish Whip"), Title("Throw Into the Corner Turnbuckle"), Title("Gut Wrench")])),
                ]),
                delta: -8,
            ),
