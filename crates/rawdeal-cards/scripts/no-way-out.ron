            Activated(
                cost: [Mill(who: You, n: 3)],
                effects: [RingsideToHand(who: You, n: 1, filter: Some(ManeuverType(HighRisk)))],
            ),
        ],
        // The added text on 'Funaki' Pre-match cards is not supported yet. Hybrids with two maneuver types are not
