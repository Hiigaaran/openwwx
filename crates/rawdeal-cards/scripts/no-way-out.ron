        // Putting a Pre-match card from the Ringside pile into the Ring is not supported yet.
        "Just the Way I Planned...": (on_play: [RingsideToHand(who: You, n: 3, up_to: true)]),
        "Girly Choke": (no_arsenal_reversal: true, on_play: [Search(filter: SuperstarSpecific)]),
        "Don't Call Me A...": (
            reverses: Some((
                targets: AnyOf([All([Maneuver, Not(Trait(Unique))]), All([Action, SuperstarSpecific])]),
            )),
        ),
        "Love-Fury-Passion-Energy": (
            on_play: [RingToHand(who: You, n: 1, filter: Any), RemoveFromRing(who: Opponent, n: 1, filter: Any), EndTurn],
            reverses: Some((targets: ManeuverType(HighRisk), fortitude: Some(0), effects: [DrawUpTo(who: You, n: 3)])),
        ),

        // Chavo Guerrero
        "One for One": (
            reverses: Some((
                targets: Not(Trait(Unique)),
                effects: [Optional([RingsideToArsenal(who: You, n: 1), Draw(who: You, n: 1)])],
            )),
        ),
        "My Life For You": (
            opponent_pre_match_limit: -1,
            end_of_prematch: [Search(filter: AnyOf([ManeuverType(HighRisk), Keyword("Foreign Object")]))],
        ),
        // Checking the size of your own Arsenal is not supported yet.
        "Guerreros por Siempre!": (requires: Some(Never)),
        "A Family Tradition": (
            bonuses: [(when: FortitudeBelowOpponent, fortitude: -7)],
            on_play: [Draw(who: You, n: 3)],
            ring_ability: Some((sacrifice: true, effects: [Discard(who: Opponent, n: 1, pick: Chosen)])),
        ),
        "The Gory Bomb": (
            play_after: Some(Any),
            on_play: [
                If(
                    condition: After(ManeuverType(HighRisk)),
                    effects: [RingsideToHand(who: You, n: 3, up_to: true, filter: Some(ManeuverType(HighRisk)))],
                ),
            ],
        ),

        // Funaki
        // Only being reversible from hand after the listed cards is not supported yet.
        "The Rising Sun": (play_after: Some(Any)),
        "Japanese Flying Bulldog": (
            play_after: Some(Any),
            on_play: [Search(filter: Trait(Unique)), Search(filter: Title("Springboard"))],
        ),
        // Reversing Activated Card Effects is not supported yet.
        "I'll Do Anything For the Scoop, But...": (
            reverses: Some((
                targets: Not(Trait(Unique)),
                effects: [Search(filter: Title("...I Do Ask the Tough Questions"), ringside: true)],
            )),
        ),
        "...I Do Ask the Tough Questions": (
            requires: Some(InYourRing(Title("I'll Do Anything For the Scoop, But..."))),
            on_play: [
                Counted(count: YourRingMatching(Action), effect: RingsideToArsenal(who: You, n: 0)),
                Counted(count: YourRingMatching(Action), effect: Discard(who: Opponent, n: 0, pick: Chosen)),
            ],
        ),
        // The -10F after the opponent used an Activated Card Effect is not supported yet.
        "Springboard Body Block": (
            play_after: Some(AnyOf([Maneuver, Title("Springboard")])),
            bonuses: [(when: After(Title("Springboard")), fortitude: -5)],
        ),

        // Mexicools
        "Lawn Maintenance Professionals": (
            while_in_ring: [
                (applies_to: TitleContains("blindside"), fortitude: -1),
                (applies_to: All([Maneuver, TitleContains("precision")]), fortitude: -2),
                (applies_to: All([Maneuver, TitleContains("technical")]), damage: 1),
            ],
            reverses_from_ring: Some((
                targets: All([Maneuver, Not(AnyOf([Trait(Chain), Keyword("Heat"), Keyword("Volley")]))]),
                fortitude: Some(0),
            )),
        ),
        "Forget Your Stereotypes": (
            reverses: Some((
                targets: AnyOf([
                    All([Maneuver, Not(Trait(Unique)), PlayerRingHas(filter: Maneuver, n: 1)]),
                    All([Action, Not(Trait(Unique)), PlayerRingHas(filter: Action, n: 1)]),
                ]),
                effects: [LookAtHand(who: Opponent), Discard(who: Opponent, n: 1, pick: Controller)],
            )),
        ),
        "Crazy Moonsault": (
            play_after: Some(AnyOf([Title("From the Middle Turnbuckle"), Title("From the Top Rope")])),
            no_arsenal_reversal: true,
        ),
        "Psychotic Guillotine Leg Drop": (
            play_after: Some(AnyOf([Title("From the Middle Turnbuckle"), Title("From the Top Rope")])),
            no_hand_reversal: true,
        ),
        "Mexi-Leg-Lace Powerbomb": (before_reversal: [Mill(who: You, n: 3)]),

        // Viscera
        "The Sex Drive": (
            play_after: Some(Maneuver),
            ringside_ability: Some((
                requires: Some(
                    All([
                        InYourRing(Title("Irish Whip")),
                        InYourRing(Title("Throw Into the Corner Turnbuckle")),
                        InYourRing(Title("Gut Wrench")),
                    ]),
                ),
                effects: [
                    ReturnThis(to: Hand),
                    RingToHand(who: You, n: 1, filter: Title("Irish Whip")),
                    RingToHand(who: You, n: 1, filter: Title("Throw Into the Corner Turnbuckle")),
                    RingToHand(who: You, n: 1, filter: Title("Gut Wrench")),
                ],
            )),
        ),
        "A Big Man Has A Big ... Appetite": (
            reverses: Some((
                targets: Not(Trait(Unique)),
                effects: [
                    RemoveFromGame(who: You, from: Arsenal, n: 5),
                    RemoveFromGame(who: Opponent, from: Arsenal, n: 5),
                ],
            )),
        ),
        "500 Pound Love Machine": (
            on_play: [RingsideToArsenal(who: You, n: 5, up_to: true), DrawUpTo(who: You, n: 5)],
        ),
        "Take It Like a Man": (
            play_after: Some(Maneuver),
            no_arsenal_reversal: true,
            on_play: [BacklashToRingside(who: Opponent, n: 50)],
        ),
        // Its card type is not Reversal, so the reversal part is not supported yet.
        "Flying Somersault Kick": (play_after: Some(Title("Irish Whip"))),

        // Cards for earlier Superstars
        "STUNNER!": (
            play_after: Some(Title("Patented Austin Kick to the Gut")),
            on_play: [
                Choice([
                    [Search(filter: Title("Stone Cold Stunner"))],
                    [RingToHand(who: You, n: 1, filter: Title("Stone Cold Stunner"))],
                ]),
                Boost((applies_to: Title("Stone Cold Stunner"), duration: ThisTurn, fortitude: -100)),
            ],
        ),
        "Death Waits for No Man": (
            on_play: [
                Counted(count: YourRingMatching(SuperstarSpecific), effect: RingsideToArsenalBottom(who: You, n: 0)),
                Counted(count: YourRingMatching(SuperstarSpecific), effect: Mill(who: Opponent, n: 0)),
            ],
        ),
        // Searching Superstar-specific cards for less F is not supported yet.
        "Bring the Hammer Down": (
            while_in_ring: [
                (
                    applies_to: All([
                        Title("Sledgehammer Shot"),
                        PlayerRingHas(filter: Title("Bring the Hammer Down"), n: 3),
                    ]),
                    no_hand_reversal: true,
                ),
            ],
        ),
        "This Is The Rock's Show": (
            reverses: Some((targets: Action, effects: [Search(filter: All([SuperstarSpecific, Not(Reversal)]))])),
        ),
        // Overturning when the opponent draws is not supported yet.
        // Approximation: the 2 random discards come from the opponent's whole hand.
        "Journey Into Darkness": (on_play: [Draw(who: Opponent, n: 3), Discard(who: Opponent, n: 2, pick: Random)]),
        "American By Birth-Angry By Choice": (
            irreversible_when: Some(After(Maneuver)),
            on_play: [RingsideToArsenal(who: You, n: 12, up_to: true)],
            reverses: Some((targets: Action, effects: [Search(filter: Any)])),
        ),
        // Putting a Ringside card on top of the Arsenal is not supported yet.
        // Approximation: as an action any 3 Ringside cards may go to the bottom of the Arsenal, not only maneuvers.
        "I'm Driven by Anger": (
            as_action: Some((fortitude: Some(0), on_play: [DiscardThis, RingsideToArsenalBottom(who: You, n: 3)])),
            reverses: Some((targets: Not(ManeuverType(TrademarkFinisher)), effects: [Search(filter: Any)])),
        ),
        "Liaison with Lita": (mid_match_limit: 1, on_play: [Search(filter: Title("Roll Out of the Ring"), ringside: true)]),
        "It's Us vs. Them": (
            on_play: [Counted(count: YourRingMatching(SuperstarSpecific), effect: Discard(who: Opponent, n: 0, pick: Chosen))],
            reverses: Some((targets: AnyOf([ManeuverType(Strike), ManeuverType(Submission)]))),
        ),
        // Approximation: the opponent chooses the card he puts on top of his Arsenal.
        "Nobody Gets Higher": (
            on_play: [
                LookAtHand(who: Opponent),
                HandToArsenalTop(who: Opponent, n: 1),
                OpponentChooses(n: 1, options: [[RemoveFromGame(who: Opponent, from: Arsenal, n: 4)], [Mill(who: Opponent, n: 20)]]),
            ],
        ),
        "Walking a Golden Mile": (
            reverses: Some((
                targets: All([Action, Not(Trait(Unique))]),
                effects: [Search(filter: All([Maneuver, Trait(Unique)]))],
            )),
        ),
        // Approximation: as an action the card is shuffled into the Arsenal instead of put on the bottom.
        "24-inch Pythons": (
            on_play: [ShuffleThisIntoArsenal, Draw(who: You, n: 2)],
            reverses: Some((targets: All([Maneuver, DamageAtMost(9)]))),
            while_in_ring: [(applies_to: Maneuver, damage: 2)],
        ),
        // Packing 4 copies is not supported yet.
        // Approximation: the extra starting card is drawn at the end of the Pre-match phase.
        "Walk That Aisle": (pre_match_limit: 1, end_of_prematch: [Draw(who: You, n: 1), HandToArsenalBottom(who: You, n: 1)]),
        "Trish's Chick Kick": (bonuses: [(fortitude: -16)], reverses: Some((targets: Any))),
        // Continuing the turn after a reversal is not supported yet.
        "Old School Luche Libre Extravaganza": (requires: Some(Never)),
        "Tuning Up the Band": (
            on_play: [
                Search(filter: Trait(Unique), ringside: true),
                Boost((applies_to: Maneuver, duration: NextCard, ignore_play_after: true)),
            ],
        ),
        "One Issue On My Mind": (reverses: Some((targets: Action, effects: [Search(filter: Trait(Unique))]))),
        "The B!tch Is Back!": (
            reverses: Some((
                targets: Trait(Unique),
                effects: [
                    Choice([
                        [],
                        [
                            If(
                                condition: HandAtLeast(1),
                                effects: [HandToArsenalTop(who: You, n: 1), RingsideToArsenal(who: You, n: 3)],
                            ),
                        ],
                        [
                            If(
                                condition: HandAtLeast(2),
                                effects: [HandToArsenalTop(who: You, n: 2), RingsideToArsenal(who: You, n: 6)],
                            ),
                        ],
                        [
                            If(
                                condition: HandAtLeast(3),
                                effects: [HandToArsenalTop(who: You, n: 3), RingsideToArsenal(who: You, n: 9)],
                            ),
                        ],
                    ]),
                ],
            )),
        ),
        // Approximation: you choose once even with several copies in your Ring.
        "You Want Some? Come Get Some!": (
            on_play: [
                If(
                    condition: InYourRing(Title("You Want Some? Come Get Some!")),
                    effects: [
                        Choice([
                            [Counted(count: YourRingStun, effect: RingsideToArsenal(who: You, n: 0))],
                            [Counted(count: YourRingStun, effect: Draw(who: You, n: 0))],
                            [Counted(count: YourRingStun, effect: Discard(who: Opponent, n: 0, pick: Chosen))],
                        ]),
                    ],
                ),
            ],
        ),
        // Completely reversing a Multi card with one Reversal is not supported yet.
        "Too Hot For TV": (
            on_play: [
                Choice([
                    [RingsideToHand(who: You, n: 1, filter: Some(AnyOf([Trait(Unique), Title("Diversion")])))],
                    [RingsideToBacklash(who: You, n: 1)],
                ]),
            ],
            reverses: Some((targets: Trait(Multi))),
        ),
        "Is Chloe Your Favorite Puppy?": (
            on_play: [
                ShuffleThisIntoArsenal,
                RingsideToHand(who: You, n: 1, filter: Some(Title("Puppies! Puppies!"))),
                Mill(who: Opponent, n: 2),
            ],
            reverses: Some((targets: AnyOf([ManeuverType(Strike), ManeuverType(HighRisk)]), overturned_only: true)),
        ),
        // Keeping cards under it is not supported yet.
        "Backed by Torrie and Candice": (on_play: [RingsideToHand(who: You, n: 1, filter: Some(Trait(Unique)))]),
        "It's Good For Business": (
            on_play: [Search(filter: Not(Reversal))],
            reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]), overturned_only: true)),
        ),
        "I Am a Wrestling God": (
            on_play: [Optional([Discard(who: You, n: 1, pick: Chosen)])],
            while_in_ring: [
                (applies_to: All([Maneuver, Holds(Not(HandAtLeast(7)))]), damage: 1),
                (applies_to: All([Maneuver, Holds(Not(HandAtLeast(6)))]), damage: 1),
                (applies_to: All([Maneuver, Holds(Not(HandAtLeast(5)))]), damage: 1),
                (applies_to: All([Maneuver, Holds(Not(HandAtLeast(4)))]), damage: 1),
                (applies_to: All([Maneuver, Holds(Not(HandAtLeast(3)))]), damage: 1),
                (applies_to: All([Maneuver, Holds(Not(HandAtLeast(2)))]), damage: 1),
                (applies_to: All([Maneuver, Holds(Not(HandAtLeast(1)))]), damage: 1),
            ],
        ),
        // Only being reversible from the Arsenal under those conditions is not supported yet.
        "The Ego Cutter": (),
        "Hold On, Hotshot!": (on_play: [Search(filter: Maneuver)], reverses: Some((targets: Trait(Unique)))),
        "Shelton's Lunging Lariat": (
            bonuses: [(fortitude: -7)],
            on_play: [Search(filter: All([SuperstarSpecific, Maneuver]))],
            reverses: Some((targets: AnyOf([ManeuverType(Submission), ManeuverType(HighRisk)]))),
        ),
        "Dernier Slam": (on_play: [Search(filter: Maneuver)]),
        // The -6F and Arsenal-only reversal when your Fortitude is 0 and his is 10 or more are not supported yet.
        "Unleashed Bomb": (on_play: [RingsideToArsenal(who: You, n: 4, up_to: true)]),
        // The -4F to 'sleeper' cards while it is in your Ringside pile is not supported yet.
        "The Rowdy Sleeper": (
            on_play: [RingsideToArsenal(who: You, n: 5, up_to: true)],
            as_action: Some((fortitude: Some(0), on_play: [DiscardThis, Search(filter: TitleContains("sleeper"))])),
        ),
        // Shuffling removed cards back is not supported yet.
        // Approximation: the 9 Ringside cards are shuffled into the Arsenal instead of put on top, and the opponent's
        // top 8 cards are only put back on top in any order.
        "Listen Up, Playa!": (
            on_play: [
                Draw(who: You, n: 4),
                Discard(who: Opponent, n: 4, pick: Chosen),
                Search(filter: Any),
                RingsideToArsenal(who: You, n: 9),
                Arrange(who: Opponent, n: 8),
            ],
        ),
        "No Fault Drop": (fortitude_discount: Some((per: 10, max: 1))),
        // Approximation: its Ring ability can be used with fewer than 3 cards in the Ringside pile.
        "Jillian Hall: The Fixer": (
            reverses: Some((
                targets: AnyOf([ManeuverType(Strike), ManeuverType(Grapple)]),
                fortitude_when: Some((FortitudeBelowOpponent, 0)),
            )),
            ring_ability: Some((
                cost: [RemoveFromGame(who: You, from: Ringside, n: 3)],
                effects: [RingsideToHand(who: You, n: 1, filter: Some(Trait(Unique)))],
            )),
        ),
        // Approximation: this card is shuffled into the Arsenal instead of put on the bottom.
        "The Brain": (
            ringside_ability: Some((
                requires: Some(HandAtLeast(1)),
                cost: [HandToArsenalBottom(who: You, n: 1)],
                effects: [ReturnThis(to: Arsenal)],
            )),
        ),
        "The Thump": (bonuses: [(per: Some(ManeuverType(Grapple)), fortitude: -3, damage: 3)]),
        // Reversing non-damage card effects is not supported yet.
        // Approximation: as an action the card is shuffled into the Arsenal instead of put on the bottom.
        "At Ease, Soldier": (
            on_play: [ShuffleThisIntoArsenal, LookAtHand(who: Opponent), Discard(who: Opponent, n: 1, pick: Controller)],
            reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]), overturned_only: true)),
        ),
        // The ACE ability is not supported yet.
        // Approximation: each overturned card is -4F (up to 3 cards) instead of -10F for overturning 3.
        "The Intensity of Ten Cities": (
            fortitude_discount: Some((per: 4, max: 3, overturn: true)),
            on_play: [
                Boost((applies_to: Maneuver, duration: NextCard, damage: 10)),
                Boost((applies_to: Action, duration: NextCard, fortitude: -10)),
            ],
        ),
        // Shuffling removed cards back is not supported yet, so overturning gains nothing.
        "Should've Seen This Coming": (reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]), from_hand_only: true))),
        // Approximation: the card for your Backstage area goes to your Ringside pile.
        "Pails o' Fun": (
            end_of_prematch: [
                Arrange(who: Opponent, n: 3),
                RemoveFromGame(who: Opponent, from: Arsenal, n: 1),
                Mill(who: Opponent, n: 1),
                Arrange(who: You, n: 3),
                Draw(who: You, n: 1),
                Mill(who: You, n: 2),
            ],
        ),
    },
)
