        "I Spit In the Face Of...": (
            on_play: [
                Choice([
                    [],
                    [
                        If(
                            condition: HandAtLeast(1),
                            effects: [HandToArsenalBottom(who: You, n: 1), RemoveFromRing(who: Opponent, n: 1, filter: Any)],
