        ],
        // His restriction on Reversals to his Volley cards (Volley rules) is not supported yet.
        "The Bookerman": [PacksLogos(["Booker T"])],
        // Your opponent removing a Ring card when you end your turn without a maneuver is not supported yet.
        "The Largest Athlete in Sports Entertainment": [
            CannotPackMatching(ManeuverType(HighRisk)),
            FortitudeFor(
                filter: All([
                    AnyOf([ManeuverType(Strike), ManeuverType(Grapple), ManeuverType(Submission)]),
                    Not(Trait(Multi)),
                ]),
                delta: -100,
            ),
            OnPlayMatching(filter: Maneuver, effects: [EndTurn]),
            PacksLogos(["Big Show"]),
        ],
        "X-treme Diva": [
            OnOpponentPlayMatching(
                filter: Maneuver,
                effects: [Choice([[RemoveFromGame(who: Opponent, from: Arsenal, n: 2)], [Mill(who: Opponent, n: 3)]])],
            ),
            PacksLogos(["Lita"]),
        ],
        // Approximation: only one of the two abilities can be used each turn.
        "Chavo Guerrero": [
            Activated(
                cost: [DiscardMatching(who: You, n: 1, filter: ManeuverType(HighRisk), pick: Chosen)],
                effects: [RingsideToArsenalBottom(who: You, n: 3)],
