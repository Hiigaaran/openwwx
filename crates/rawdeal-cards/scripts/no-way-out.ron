    scripts: {
        // High Risk
        // Approximation: as an action the card is shuffled into the Arsenal instead of put on the bottom.
        "Technical Stomp": (
            play_after: Some(Any),
            on_play: [Optional([Search(filter: TitleContains("technical"))])],
            as_action: Some((fortitude: Some(0), on_play: [ShuffleThisIntoArsenal, Discard(who: Opponent, n: 1, pick: Chosen)])),
        ),
        // Keeping the opponent from playing Over Sell Maneuver after it is not supported yet.
        "Shoot Aerial 360-Degree Kick": (
            play_after: Some(AnyOf([All([Action, Trait(SetUp)]), TitleContains("shoot")])),
            not_reversed_by: Some(AnyOf([Title("Lift a Boot"), Title("Overshot Your Mark")])),
        ),
        // Approximation: the cards for less F are discarded from your hand instead of your Backlash deck.
        "Precision Knee Drop": (
            play_after: Some(All([Maneuver, DamageAtLeast(2)])),
            fortitude_discount: Some((per: 2, max: 5)),
            on_play: [
                RingsideToHand(who: You, n: 1, filter: Some(ManeuverType(HighRisk))),
                RingsideToHand(who: You, n: 1),
