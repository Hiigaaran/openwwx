// Hand-written scripts for Vengeance cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// Enforcers are not supported, so no Superstar ever has an Enforcer revealed.
(
    abilities: {
        // The Tag Team Title Belts are not supported yet. A F:0 maneuver is never shuffled back into the Arsenal.
        "Evolution": [
            StartOfTurn([Arrange(who: You, n: 3), Mill(who: You, n: 2)]),
            Activated(
                cost: [Discard(who: You, n: 3, pick: Chosen)],
                effects: [Mill(who: You, n: 3), RemoveFromRing(who: Opponent, n: 1, filter: Any)],
            ),
        ],
        // Limiting the opponent's Action cards is not supported yet.
        "The Highlight of the Night": [PacksLogos(["Chris Jericho"])],
        // Enforcers, the 50-card Arsenal and the extra Mankind cards are not supported yet.
        // Approximation: he never reveals, and the +8 Starting Hand Size is drawn at the end of the Pre-match phase.
        "The Mystery Wrestler": [EndOfPrematch([Draw(who: You, n: 8)])],
        "Leader of the Edge Army": [
            OnOpponentPlayMatching(
                filter: Action,
                effects: [Choice([[Draw(who: You, n: 1)], [Discard(who: Opponent, n: 1, pick: Chosen)]])],
            ),
            PacksLogos(["Edge"]),
        ],
        // Enforcers, revealed Stipulations, the 'Heyman' ban and the 50-card Arsenal are not supported yet, so he
        // plays with Hand Size 0.
        "Paul Heyman": [],
        // Changing the alignment of It's True! It's True! is not supported yet.
        "Your Freaking Hero": [
            OnPlayMatching(filter: Trait(Chain), effects: [Optional([Draw(who: You, n: 1)])]),
            PacksLogos(["Kurt Angle"]),
        ],
        // Making maneuvers Multi and reversing Actions by discarding 3 cards are not supported yet.
        "FBI": [],
        "A-Train": [
            Activated(
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [
                    Search(
                        filter: All([
                            Not(Trait(Unique)),
                            AnyOf([TitleContains("power"), TitleContains("bomb"), TitleContains("slam")]),
                        ]),
                    ),
                ],
            ),
            FortitudeFor(filter: AnyOf([TitleContains("power"), TitleContains("bomb"), TitleContains("slam")]), delta: -4),
        ],
    },
    scripts: {
        // High Risk
        "Leaping Neck Snap": (
            play_after: Some(All([Maneuver, DamageAtLeast(5)])),
            on_play: [
                Counted(count: BothRemoved, effect: Damage(who: Opponent, n: 0)),
            ],
            as_action: Some((
                fortitude: Some(0),
                on_play: [RemoveThis, LookAtHand(who: Opponent), RingsideToArsenal(who: You, n: 2, up_to: true)],
            )),
        ),
        "Revolving Takedown": (
            bonuses: [(fortitude: -5)],
            play_after: Some(Maneuver),
            reverses: Some((targets: TitleContains("takedown"))),
        ),
        "Flying Leg Scissors": (play_after: Some(All([Maneuver, DamageAtLeast(2)]))),

        // Strikes
        "Spinning Kick": (),
        "Right Cross Punch": (
            bonuses: [(per: Some(TitleContains("cross")), damage: 1)],
            on_play: [Optional([Search(filter: Title("Left Cross Punch"))])],
        ),
        "Left Cross Punch": (
            bonuses: [(per: Some(TitleContains("cross")), damage: 1)],
            on_play: [Optional([Search(filter: Title("Right Cross Punch"))])],
        ),
        // Putting it into the Ring from hand when the opponent looks at your hand is not supported yet.
        "Judo Thrust": (),
        "Lariat": (),
        // Losing the Heel trait for Deadman Inc. and John Cena and the +5D to maneuvers without text are not
        // supported yet.
        // Approximation: it comes back from the Ringside pile in your Main Segment right after a successful maneuver.
        "Steel Chain Shot": (
            play_after: Some(Any),
            reverses_from_ring: Some((targets: Action, fortitude: Some(0), discard_cost: 1)),
            ringside_ability: Some((
                requires: Some(After(Maneuver)),
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [ReturnThis(to: Hand)],
            )),
        ),
        "Short Arm Rib Breaker": (not_packed_by: ["Female"]),
        "Blindside Kick": (
            from_ringside: Some(Always),
            on_play: [
                If(
                    condition: PlayedFromRingside,
                    effects: [RemoveFromGame(who: You, from: Ringside, n: 60, filter: Some(Reversal), pick: Random)],
                ),
            ],
        ),
        // The Enforcer part is not supported yet.
        "Struck by an Unknown Foreign Object": (
            requires: Some(
                AnyOf([
                    InYourRing(Title("Roll Out of the Ring")),
                    OpponentRingHas(filter: Title("Roll Out of the Ring"), n: 1),
                ]),
            ),
            on_play: [RemoveFromRing(who: Opponent, n: 2, filter: Not(Maneuver))],
        ),

        // Grapples
        "Snap Neckbreaker": (),
        "Pretzel Jerk": (
            on_play: [
                Optional([Discard(who: You, n: 1, pick: Chosen), Search(filter: All([Action, Not(Trait(Unique))]))]),
            ],
        ),
        "Face Driver": (play_after: Some(Trait(Chain))),
        "Vertical DDT Drop": (
            play_after: Some(Maneuver),
            play_after_unless: Some(All([FirstCardThisTurn, ReversedLastTurn(Trait(SetUp))])),
        ),
        // Putting it into the Ring from hand when the opponent moves your Ring cards is not supported yet.
        "Judo Takedown": (),
        "Quick Snap Body Slam": (
            on_play: [Boost((applies_to: Maneuver, duration: NextCard, no_backlash_reversal: true))],
        ),
        "Double Underhook Power Bomb": (),
        "Blindside Slam": (
            from_ringside: Some(Always),
            on_play: [
                If(
                    condition: PlayedFromRingside,
                    effects: [RemoveFromGame(who: You, from: Ringside, n: 60, filter: Some(Action), pick: Random)],
                ),
            ],
        ),
        // Choosing an Enforcer for the opponent is not supported yet, so the next card is always -2F.
        "Suplex": (on_play: [Boost((applies_to: Any, duration: NextCard, fortitude: -2))]),
        "Military Slam": (),
        "Takedown": (
            bonuses: [(fortitude: -14)],
            reverses: Some((targets: All([Action, Not(Trait(Unique))]))),
        ),
        "Death Valley Driver": (bonuses: [(fortitude: -5)], reverses: Some((targets: ManeuverType(HighRisk)))),

        // Submissions
        "Ankle Torque": (on_play: [Optional([Search(filter: Title("Minute Hold"))])]),
        "Triangle Choke": (),
        "Body Lock": (),
        // Putting it into the Ring from hand after the opponent's second Action is not supported yet.
        "Judo Choke": (),
        "Wraparound Wrist Lock": (
            on_play: [Boost((applies_to: Maneuver, duration: NextCard, no_backlash_reversal: true))],
        ),
        "Headlock": (),
        "Apply Legal Leverage": (play_after: Some(AnyOf([ManeuverType(Submission), All([Maneuver, Trait(Chain)])]))),
        "Blindside Choke": (
            from_ringside: Some(Always),
            on_play: [
                If(
                    condition: PlayedFromRingside,
                    effects: [RemoveFromGame(who: You, from: Ringside, n: 60, filter: Some(Maneuver), pick: Random)],
                ),
            ],
        ),
        "Super Hold": (bonuses: [(when: FortitudeBelowOpponent, fortitude: -7)]),

        // Reversals
        "I Already Warned You": (
            from_ringside: Some(CountAtLeast(count: YourRingsideMatching(Keyword("Heat")), n: 6)),
            reverses: Some((
                targets: AnyOf([
                    All([Action, EarlierThisTurn(filter: Action, n: 1)]),
                    EarlierThisTurn(filter: Any, n: 2),
                ]),
                ringside_only: true,
                requires: Some(FortitudeAtMostOpponent),
            )),
        ),
        "Quick Reflexes": (
            not_with: ["Step Aside"],
            reverses: Some((
                targets: AnyOf([
                    All([ManeuverType(Strike), DamageAtMost(7)]),
                    All([
                        ManeuverType(Strike),
                        DamageAtMost(10),
                        Holds(All([SuperstarValueAtLeast(4), Not(SuperstarValueAtMostOpponent)])),
                    ]),
                ]),
                effects: [Draw(who: You, n: 1)],
            )),
        ),
        "Unexpected Turn of Events": (
            not_with: ["Escape Move"],
            reverses: Some((
                targets: AnyOf([
                    All([ManeuverType(Grapple), DamageAtMost(7)]),
                    All([
                        ManeuverType(Grapple),
                        DamageAtMost(10),
                        Holds(All([SuperstarValueAtLeast(4), Not(SuperstarValueAtMostOpponent)])),
                    ]),
                ]),
                effects: [Draw(who: You, n: 1)],
            )),
        ),
        "Blindsided Ego": (
            from_ringside: Some(Always),
            reverses: Some((
                targets: AnyOf([All([Maneuver, Not(Trait(Unique))]), TitleContains("ego")]),
                ringside_only: true,
                effects: [
                    Discard(who: You, n: 2, pick: Chosen),
                    RemoveFromGame(who: You, from: Ringside, n: 60, filter: Some(Reversal), pick: Random),
                ],
            )),
        ),
        // Searching for a maneuver without text and the rule for your next turn are not supported yet.
        "Leave Me Alone": (
            from_ringside: Some(CountAtLeast(count: YourRingsideMatching(Keyword("Heat")), n: 6)),
            reverses: Some((
                targets: All([Action, Not(Trait(SetUp))]),
                ringside_only: true,
            )),
        ),
        "Blindsided Control": (
            from_ringside: Some(Always),
            reverses: Some((
                targets: All([Action, Not(Trait(Unique))]),
                ringside_only: true,
                effects: [RemoveFromGame(who: You, from: Ringside, n: 60, filter: Some(Action), pick: Random)],
            )),
        ),
        "Two!": (
            reverses: Some((
                targets: All([Maneuver, Not(ManeuverType(TrademarkFinisher))]),
                overturned_only: true,
                effects: [
                    ReturnThis(to: Removed),
                    RemoveFromGame(who: You, from: Ringside, n: 2),
                    Discard(who: You, n: 2, pick: Chosen),
                ],
            )),
        ),
        // Being Permanent is not supported yet.
        "Headstrong": (
            from_ringside: Some(CountAtLeast(count: YourRingsideMatching(Keyword("Heat")), n: 6)),
            reverses: Some((
                targets: All([Maneuver, Not(Trait(Unique)), DamageAtMost(10)]),
                ringside_only: true,
                effects: [
                    If(
                        condition: Not(Superstar("Al Snow")),
                        effects: [
                            RemoveFromGame(who: You, from: Ring, n: 60, filter: Some(Action), pick: Random),
                            RemoveFromGame(who: You, from: Ringside, n: 60, filter: Some(Action), pick: Random),
                        ],
                    ),
                ],
            )),
        ),
        "Sloppy ... Very Sloppy": (
            reverses: Some((
                targets: Any,
                from_hand_only: true,
                fortitude_when: Some((AnyOf([Superstar("Mae Young"), Superstar("Moolah")]), 5)),
            )),
        ),

        // Actions
        // Choosing an Enforcer is not supported yet.
        "Suplex into the Ring": (
            on_play: [
                DiscardThis,
                Choice([
                    [],
                    [RingsideToHand(who: You, n: 1, filter: Some(All([Maneuver, Not(Trait(Unique))])))],
                    [RingsideToHand(who: You, n: 2, filter: Some(All([Maneuver, TitleContains("suplex")])))],
                ]),
            ],
            reverses: Some((targets: Title("Roll Out of the Ring"), effects: [Mill(who: Opponent, n: 2)])),
        ),
        "Chain Wrestling": (
            on_play: [
                Search(filter: All([Maneuver, Trait(Chain)])),
                NextCardMustBe(Not(Title("Chain Wrestling"))),
            ],
        ),
        // Approximation: wherever it is played from it reverses both 'hell' cards and cards played from the
        // opponent's Ringside pile (the reversed card is always removed from the game), it is not removed from the
        // game itself after reversing from the Ringside pile, and as an action it can only be played from hand (or
        // while you hold a copy).
        "When Hell Freezes Over!": (
            requires: Some(HandHas(Title("When Hell Freezes Over!"))),
            from_ringside: Some(Always),
            on_play: [DiscardThis, Draw(who: You, n: 1)],
            reverses: Some((targets: AnyOf([TitleContains("hell"), Holds(PlayedFromRingside)]), reversed_removed: true)),
        ),
        "Minute Hold": (
            play_after: Some(ManeuverType(Submission)),
            on_play: [Draw(who: You, n: 1)],
            while_in_ring: [(applies_to: ManeuverType(Submission), damage: 1)],
            restricts_opponent: Some((filter: Title("Elbow to the Face"))),
            in_ring_on_play: [
                (whose: Some(You), filter: All([Maneuver, Not(ManeuverType(Submission))]), effects: [SacrificeThis]),
            ],
        ),
        // Approximation: the opponent always puts 2 cards in your Ringside pile, even with a Venue in a Ring.
        "Throw Into the Ring": (
            on_play: [
                MillChosen(who: You, n: 2, filter: Some(Not(Trait(Unique)))),
                AsOpponent([MillChosen(who: Opponent, n: 2)]),
            ],
        ),
        // Leaving the Ring when your turn ends without a maneuver and the Enforcer part are not supported yet.
        "J.R. Style Donnybrook": (
            restricts_opponent: Some((filter: All([AnyOf([Trait(Face), Trait(Heel)]), AnyOf([Action, Maneuver])]))),
        ),
        // Playing without discarding to reverse a Chain card is not supported yet.
        "Chained Heat": (
            on_play: [
                DiscardThis,
                RingsideToArsenal(who: You, n: 2, up_to: true, filter: Some(All([Trait(Chain), Not(Title("Chained Heat"))]))),
            ],
            reverses: Some((targets: AnyOf([Trait(Chain), Keyword("Heat")]), reversed_removed: true)),
        ),
        // The Venue and Enforcer parts are not supported yet.
        "Down and Out": (
            on_play: [
                DiscardThis,
                Draw(who: You, n: 1),
                Boost((applies_to: Not(Maneuver), duration: NextCard, end_turn: true)),
            ],
        ),
        // Naming a card for other cards to count as is not supported yet.
        "According to the Contract Table": (requires: Some(Never)),
        // Becoming Permanent and removing the maneuver from the game are not supported yet.
        // Approximation: the maneuver must be your next card, instead of ending your turn if it is not.
        "Last Chance": (
            bonuses: [(when: FortitudeBelowOpponent, fortitude: -5)],
            ring_ability: Some((
                cost: [Discard(who: You, n: 2, pick: Chosen)],
                effects: [RingsideToHand(who: You, n: 1, filter: Some(Maneuver)), NextCardMustBeChosen],
            )),
        ),
        // Revealing cards to send it to the Ringside pile is not supported yet.
        "J.R. Style Authentic BBQ Sauce!": (
            ring_ability: Some((
                effects: [
                    ReturnThis(to: Removed),
                    Counted(count: YourRingMatching(TitleContains("J.R.")), effect: DrawUpTo(who: You, n: 0)),
                    DrawUpTo(who: You, n: 2),
                ],
            )),
        ),
        // Blanking the text of a card in the Ring is not supported yet.
        "For the Love of God-Why, King, Why?": (requires: Some(Never)),
        // Removing a card with an Activated Card Effect is not supported yet.
        "Escape the Rules": (
            on_play: [
                ShuffleThisIntoArsenal,
                Optional([
                    RingsideToHand(who: You, n: 1, filter: Some(All([Not(Trait(Unique)), Not(Action)]))),
                    EndTurn,
                ]),
            ],
            reverses: Some((
                targets: AnyOf([
                    ManeuverType(HighRisk),
                    Title("Superplex"),
                    All([Maneuver, After(Title("Throw Into the Corner Turnbuckle"))]),
                ]),
                overturned_only: true,
            )),
        ),
        // Keeping cards under it is not supported yet.
        "That's Broken!": (requires: Some(Never)),
        "He's Playing Possum?": (
            on_play: [Mill(who: Opponent, n: 1)],
            in_ring_on_play: [(whose: Some(Opponent), filter: Maneuver, effects: [Mill(who: You, n: 1)])],
        ),
        // Continuing the turn after a reversal is not supported yet.
        "J.R. Style Push": (requires: Some(Never)),
        // Approximation: he skips at most 1 turn (with 3 or more Reversals in his Ring).
        "Now or Never": (
            requires: Some(CountBelow(a: YourRingMatching(Reversal), b: OpponentRingMatching(Reversal))),
            on_play: [If(condition: OpponentRingHas(filter: Reversal, n: 3), effects: [SkipNextTurn(who: Opponent)])],
        ),
        // Reversing Arsenal searches is not supported yet.
        // Approximation: it reverses any card that lets the opponent draw.
        "Enough With the Trash Talk": (
            on_play: [RemoveFromGame(who: Opponent, from: Ringside, n: 1, pick: Controller)],
            reverses: Some((targets: All([AnyOf([Maneuver, Action]), Draws]))),
        ),

        // Pre-match
        "Anaheim, California": (
            restricts_self: Some((
                filter: All([
                    Not(Trait(Unique)),
                    AnyOf([Trait(Raw), Trait(SmackDown)]),
                    EarlierThisTurn(filter: All([Not(Trait(Unique)), AnyOf([Trait(Raw), Trait(SmackDown)])]), n: 1),
                ]),
            )),
            restricts_opponent: Some((
                filter: All([
                    Not(Trait(Unique)),
                    AnyOf([Trait(Raw), Trait(SmackDown)]),
                    EarlierThisTurn(filter: All([Not(Trait(Unique)), AnyOf([Trait(Raw), Trait(SmackDown)])]), n: 1),
                ]),
            )),
        ),
        "Atlanta, Georgia": (not_packed_by: ["Edge"], value_bonus: 1, opponent_value_bonus: 2),
        // Doubling the Face and Heel cards in the Ring is not supported yet.
        "Newcastle, England": (
            restricts_self: Some((
                filter: All([AnyOf([Trait(Face), Trait(Heel)]), EarlierThisTurn(filter: AnyOf([Trait(Face), Trait(Heel)]), n: 1)]),
            )),
            restricts_opponent: Some((
                filter: All([AnyOf([Trait(Face), Trait(Heel)]), EarlierThisTurn(filter: AnyOf([Trait(Face), Trait(Heel)]), n: 1)]),
            )),
        ),
        "Omaha, Nebraska": (value_bonus: -2, opponent_value_bonus: -3),
        // Effects when the opponent reverses a card are not supported yet.
        "Calgary, Alberta, Canada": (requires: Some(Never)),
        // Changing Raw Roulette Wheel's text, removing cards from the game and picking who starts are not supported
        // yet.
        // Approximation: the top 3 cards are overturned into your Ringside pile, then you put 1 card from your Ringside
        // pile into your hand and remove 1 from the game (any Ringside cards, not only those 3).
        "Las Vegas, Nevada": (
            end_of_prematch: [
                Mill(who: You, n: 3),
                RingsideToHand(who: You, n: 1),
                RemoveFromGame(who: You, from: Ringside, n: 1),
            ],
        ),
        "New York, New York": (not_packed_by: ["Edge"], value_bonus: 2, opponent_value_bonus: 4),
        "Saskatoon, Saskatchewan, Canada": (value_bonus: -4, opponent_value_bonus: -6),
        // Picking cards at random until a Reversal and Starting Hand Size changes are not supported yet.
        "Houston, Texas": (requires: Some(Never)),
        "Philadelphia, Pennsylvania": (
            end_of_prematch: [
                Search(filter: All([Not(Trait(Unique)), AnyOf([Keyword("Foreign Object"), TitleContains("hardcore")])]), n: 3),
                SkipNextTurn(who: You),
            ],
        ),
        // Approximation: the +1 Starting Hand Size is drawn at the end of the Pre-match phase, and the opponent's
        // Pre-match limit is -1 whatever the Superstar Values.
        "Raleigh, North Carolina": (
            end_of_prematch: [If(condition: SuperstarValueBelowOpponent, effects: [Draw(who: You, n: 1)])],
            opponent_pre_match_limit: -1,
        ),
        // Approximation: the Mid-match limit is +2 whatever the Superstar Values.
        "Springfield, Illinois": (mid_match_limit: 2),
        "A Chorus of Boos": (
            ring_ability: Some((
                sacrifice: true,
                effects: [
                    Counted(
                        count: OpponentValueTimes(1),
                        effect: Boost((applies_to: Any, duration: NextCard, fortitude: -1)),
                    ),
                ],
            )),
        ),
        "Spontaneous Combustion": (
            end_of_prematch: [Optional([MillChosen(who: You, n: 1, filter: Some(Keyword("Heat")))])],
            while_in_ring: [(applies_to: All([Maneuver, Keyword("Heat")]), damage: 1)],
        ),
        // Making a maneuver Multi is not supported yet.
        "This Is Gonna Be a Rocket Buster": (requires: Some(Never)),
        "Old School Beating": (
            while_in_ring: [(applies_to: Maneuver, damage: 1)],
            ring_ability: Some((sacrifice: true, effects: [Boost((applies_to: Maneuver, duration: NextCard, damage: 3))])),
        ),
        // Winning by the Foreign Objects in the Ring is not supported yet.
        "First Blood Match": (requires: Some(Never), not_packed_by: ["Female"]),
        // Title Belts are not supported yet.
        "The Title Is On the Line!": (requires: Some(Never)),
        // Choosing the opponent's next Pre-match card after Calling You Out is not supported yet.
        "You Rang?": (mid_match_limit: 1),
        // Tag Team matches are not supported yet.
        "You, Me, and Whoever!?!": (requires: Some(Never)),
        // Changing the Pre-match order and Title Belts are not supported yet.
        "Bitter Rivals": (requires: Some(Never)),
        "It's All About the Game": (),
        // Removing a card with an Activated Card Effect is not supported yet.
        // Approximation: the +1 Starting Hand Size is drawn at the end of the Pre-match phase.
        "Managed by Dawn Marie": (end_of_prematch: [Draw(who: You, n: 1)]),

        // Mid-match
        // Its text is cut short in the data, and checking for a Feud card is not supported yet.
        "Hardcore Style": (requires: Some(Never)),
        // Not being Active for Mankind or Cactus Jack is not supported yet.
        "Immune to Pain": (while_in_ring_opponent: [(applies_to: Maneuver, damage: -1)]),
        // Title Belts are not supported yet.
        "Number One Contender": (requires: Some(Never)),
        // Effects when you play a Reversal are not supported yet.
        "The Beautiful People": (requires: Some(Never)),
        // Reversing effects that change your Reversals is not supported yet.
        "Grab the Ref": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // Tag Team matches are not supported yet.
        "Desperate Tag": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // Approximation: a Pre-match Manager is a card with "Managed by" in the title, and you overturn a multiple of
        // 3 cards.
        "Ringside Assistance": (
            requires: Some(InYourRing(TitleContains("Managed by"))),
            on_play: [
                Choice([
                    [],
                    [Mill(who: You, n: 3), Boost((applies_to: Maneuver, duration: NextCard, damage: 2))],
                    [Mill(who: You, n: 6), Boost((applies_to: Maneuver, duration: NextCard, damage: 4))],
                    [Mill(who: You, n: 9), Boost((applies_to: Maneuver, duration: NextCard, damage: 6))],
                    [Mill(who: You, n: 12), Boost((applies_to: Maneuver, duration: NextCard, damage: 8))],
                    [Mill(who: You, n: 15), Boost((applies_to: Maneuver, duration: NextCard, damage: 10))],
                ]),
            ],
        ),
        "You're as Graceful as a Cow on Ice": (
            reverses: Some((
                targets: EarlierThisTurn(filter: Any, n: 2),
                requires: Some(AnyOf([OpponentHandLarger, FortitudeBelowOpponent])),
            )),
        ),
        "Revolutionizing the Business": (on_play: [DrawUpTo(who: You, n: 4), Discard(who: You, n: 6, pick: Chosen)]),
        "Chain Finisher": (play_after: Some(All([Maneuver, Trait(Chain)])), after_damage: [EndTurn]),
        // Checking what the opponent attempted last turn is not supported yet.
        "All That ... and Nothing?": (requires: Some(Never)),
        "Divas Revealed": (
            bonuses: [(when: Not(OpponentFemale), fortitude: -10)],
            on_play: [
                If(condition: Not(OpponentFemale), effects: [DiscardThis, Draw(who: You, n: 1)]),
                If(condition: OpponentFemale, effects: [Discard(who: Opponent, n: 4, pick: Chosen)]),
            ],
            reveals_opponent_hand: true,
        ),
        "To the Rescue!": (
            ring_ability: Some((sacrifice: true, effects: [RingsideToHand(who: You, n: 1), EndTurn])),
            ringside_ability: Some((cost: [Discard(who: You, n: 3, pick: Chosen)], effects: [ReturnThis(to: Backlash)])),
        ),
        // Reversing Activated Card Effects is not supported yet.
        "Unscrupulous S.O.B.": (
            reverses: Some((
                targets: All([Action, Not(Trait(Unique))]),
                fortitude_when: Some((SuperstarValueBelowOpponent, 5)),
            )),
        ),
        "Cheap Accolades": (
            bonuses: [(when: SuperstarValueBelowOpponent, fortitude: -8)],
            on_play: [Boost((applies_to: Maneuver, duration: NextMatching, damage: 6, reversal_fortitude: 20))],
        ),

        // Evolution
        // Approximation: you discard 3 hand and 3 Backlash cards for each card, and the chosen cards may be Unique.
        "Evolution Is a Mystery": (
            end_of_prematch: [
