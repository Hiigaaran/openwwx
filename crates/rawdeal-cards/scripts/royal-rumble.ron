// Hand-written scripts for Royal Rumble cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// The Throwback, Heat and Volley traits are read as printed keywords; Fan Favorite and Cheater are added as traits.
// The Heat and Volley rules are applied by the engine; cards that change those rules are not supported yet.
(
    abilities: {
        // Approximation: the 3 cards are overturned like a Mill.
        "Hollywood Hulk Hogan": [
            CannotPackMatching(AnyOf([ManeuverType(Submission), ManeuverType(HighRisk)])),
            Activated(
                cost: [Mill(who: You, n: 3)],
                effects: [Search(filter: All([Maneuver, Not(Trait(Unique)), Not(Keyword("Throwback"))]))],
            ),
        ],
        "Sgt. Slaughter": [
            CannotPackMatching(ManeuverType(HighRisk)),
            Activated(
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [Search(filter: All([Maneuver, Keyword("Throwback")]))],
            ),
        ],
        // Tag Team partners are not supported yet.
        // Approximation: the discard and shuffle happen when the opponent's maneuver succeeds, before its damage.
        "The Home Team": [
            Activated(
                cost: [HandToArsenalBottom(who: You, n: 1)],
                requires: Some(HandAtLeast(1)),
                effects: [RingsideToHand(who: You, n: 1, filter: Some(AnyOf([Trait(Face), Trait(FanFavorite), Keyword("Fan Favorite")])))],
            ),
            OnOpponentPlayMatching(
                filter: Maneuver,
                effects: [Optional([Discard(who: You, n: 2, pick: Chosen), RingsideToArsenal(who: You, n: 4, up_to: true)])],
            ),
        ],
        // Tag Team partners are not supported yet.
        "The Heat Seekers": [
            Activated(
                cost: [Discard(who: You, n: 2, pick: Chosen)],
                effects: [
                    RemoveFromGame(who: You, from: Ringside, n: 2),
                    RingsideToArsenal(who: You, n: 2),
                    Choice([[Draw(who: You, n: 2)], [Search(filter: AnyOf([Trait(Heel), AnyOf([Trait(Cheater), Keyword("Cheater")])]))]]),
                ],
            ),
        ],
    },
    scripts: {
        // High Risk
        "Roundhouse Kick": (play_after: Some(Any), bonuses: [(when: After(Trait(Raw)), damage: 3)]),
        // Letting every male Superstar pack it is not supported yet.
        "Big Splash in the Corner": (
            play_after: Some(AnyOf([All([Maneuver, DamageAtLeast(3)]), Title("Throw Into the Corner Turnbuckle")])),
            bonuses: [(when: After(Title("Throw Into the Corner Turnbuckle")), damage: 5, reversal_fortitude: 8)],
        ),
        "Technical Topé": (
            play_after: Some(All([Maneuver, DamageAtLeast(4)])),
            on_play: [Optional([Search(filter: TitleContains("technical"))])],
            as_action: Some((
                fortitude: Some(0),
                on_play: [ThisToArsenal(bottom: false), Optional([Search(filter: TitleContains("technical"))])],
            )),
        ),

        // Strikes
        // Over Sell Maneuver cannot be played yet, so its restriction is left out.
        "Handcuffed": (
            on_play: [DrawUpTo(who: You, n: 3)],
            on_reversed_from_hand: [If(condition: OpponentReversedFrom([Hand]), effects: [Discard(who: Opponent, n: 2, pick: Chosen)])],
            in_ring_on_play: [(whose: Some(Opponent), filter: Trait(Face), effects: [Discard(who: You, n: 1, pick: Chosen)])],
        ),
        "Fisticuffs": (
            on_reversed_from_hand: [
                If(
                    condition: OpponentReversedFrom([Hand]),
                    effects: [RemoveFromGame(who: Opponent, from: Ringside, n: 4, pick: Controller)],
                ),
            ],
        ),
        "Armed and Dangerous": (
            on_play: [
                LookAtHand(who: Opponent),
                Discard(who: Opponent, n: 1, pick: Controller),
                Boost((applies_to: Any, duration: NextCard, fortitude: -3)),
            ],
        ),
        // Not playing it as an action again this turn is not supported yet.
        "Technical Drop Kick": (
            on_play: [Search(filter: TitleContains("technical"))],
            as_action: Some((
                on_play: [ThisToArsenal(bottom: true), RingsideToHand(who: You, n: 1, filter: Some(TitleContains("technical")))],
            )),
        ),
        "Ankle Breaker": (bonuses: [(count: Some(YourFortitude), damage: 1)]),
        "Running Clothesline": (bonuses: [(when: After(Title("Irish Whip")), fortitude: -7)]),

        // Grapples
        "Slingshot Into the Ring Post": (
            reversal_limits: [(from: [Arsenal, Backlash, Ringside, Ring, Under])],
            on_play: [If(condition: FortitudeLeadAtLeast(30), effects: [WinByPin])],
            reverses: Some((targets: After(Trait(SetUp)))),
        ),
        // Counting as 2 Heat cards in your Ringside pile (for the Heat rule) is not supported yet.
        "Slam": (on_play: [HandToArsenalBottom(who: You, n: 1), HandToArsenalBottom(who: Opponent, n: 1)]),
        "Scoop Slam": (not_packed_by: ["Female"]),
        "Thunder Bulldog": (
            after_damage: [
                Optional([
                    Discard(who: You, n: 1, pick: Chosen),
                    Boost((applies_to: Maneuver, duration: NextCard, irreversible: true)),
                ]),
            ],
        ),
        "Fall-Away Suplex": (
            bonuses: [(when: FortitudeAtMostOpponent, fortitude: -3)],
            on_play: [Optional([Search(filter: All([Maneuver, Keyword("Throwback"), Not(Action), Not(Reversal)]))])],
        ),
        "Technical Slam": (
            on_play: [Optional([Search(filter: TitleContains("technical"))])],
            as_action: Some((fortitude: Some(0), on_play: [ThisToArsenal(bottom: true), Draw(who: You, n: 1)])),
        ),

        // Submissions
        "Hair Pull": (
            reversal_limits: [(from: [Hand, Backlash, Ringside, Ring, Under], when: All([YouAre("Diva"), OpponentFemale]))],
            on_play: [Boost((applies_to: Maneuver, duration: NextMatching, reversal_fortitude: 6))],
        ),
        // Counting as 2 Heat cards in your Ringside pile (for the Heat rule) is not supported yet.
        "Entangle in the Ropes": (
            on_play: [
                Choice([
                    [HandToArsenalBottom(who: Opponent, n: 3)],
                    [CannotPlay(who: Opponent, filter: Any, turns: 1)],
                ]),
            ],
        ),
        "Key Lock": (not_packed_by: ["Female"], bonuses: [(when: YouAre("Tag Team"), damage: 3)]),
        // Approximation: Pre-match Objects in the opponent's Ring do not count, only Heel cards.
        "Take Your Own Medicine": (
            requires: Some(
                AnyOf([OpponentRingHas(filter: Trait(Heel), n: 1), All([ReversedLastTurn(Maneuver), FirstCardThisTurn])]),
            ),
            not_reversed_by: Some(All([Not(Trait(Unique)), AnyOf([Maneuver, Action])])),
        ),
        "Face Stretch": (
            bonuses: [(when: Not(FortitudeAtLeast(8)), fortitude: -8, damage: -8)],
            on_play: [Optional([RingToHand(who: You, n: 1, filter: Trait(Face))])],
        ),
        "Technical Body Lock": (
            on_play: [Optional([Search(filter: TitleContains("technical"))])],
            as_action: Some((
                fortitude: Some(0),
                on_play: [
                    Optional([
                        ThisToArsenal(bottom: false),
                        RingsideToArsenal(who: You, n: 3, up_to: true, filter: Some(TitleContains("technical"))),
                    ]),
                ],
            )),
        ),

        // Reversals
        // Reversing Activated Card Effects is not supported yet.
        "How Many Do You Need?": (
            reverses: Some((
                targets: All([Maneuver, Not(Trait(Unique))]),
                from_hand_only: true,
                requires: Some(OpponentRingHas(filter: Maneuver, n: 5)),
            )),
        ),
        // It goes to the Ring when it reverses, and a copy is then removed from the game from there.
        "Always Have a Plan B": (
            reverses: Some((
                targets: AnyOf([ManeuverType(Strike), ManeuverType(Grapple), ManeuverType(Submission)]),
                overturned_only: true,
                effects: [
                    RemoveFromGame(who: You, from: Ring, n: 1, filter: Some(Title("Always Have a Plan B"))),
                    HandToArsenalBottom(who: You, n: 1),
                ],
            )),
        ),
        // Approximation: a Multi card still needs a second Reversal. The Sloppy... Very Sloppy part is not supported yet.
        "Once is Enough": (reverses: Some((targets: AnyOf([SameTitleInRing, Trait(Multi)])))),

        // Actions
        "Volley Call": (
            on_play: [Counted(count: YourRingsideMatching(Keyword("Volley")), effect: RingsideToArsenal(who: You, n: 1))],
        ),
        "Everyone Wants to Watch Women Wrestle": (
            only_packed_by: ["Female"],
            bonuses: [(when: OpponentFemale, fortitude: -1)],
            on_play: [
                If(
                    condition: Not(OpponentFemale),
                    effects: [
                        RemoveFromGame(who: Opponent, from: Arsenal, n: 3, filter: Some(All([Maneuver, Not(Trait(Unique))])), pick: Controller),
                    ],
                ),
                If(condition: OpponentFemale, effects: [DiscardThis, Discard(who: Opponent, n: 1, pick: Chosen)]),
            ],
        ),
        "Everyone Wants to Watch Women, Period": (
            only_packed_by: ["Female"],
            bonuses: [(when: OpponentFemale, fortitude: -1)],
            on_play: [
                If(condition: Not(OpponentFemale), effects: [Discard(who: Opponent, n: 3, pick: Chosen)]),
                If(condition: OpponentFemale, effects: [DiscardThis, Draw(who: You, n: 1)]),
            ],
        ),
        "Chained Aggression": (
            on_play: [
                AsOpponent([
                    If(
                        condition: OpponentRingHas(filter: All([Maneuver, Trait(Chain)]), n: 1),
                        effects: [Discard(who: You, n: 1, pick: Chosen)],
                    ),
                    If(
                        condition: OpponentRingHas(filter: All([Maneuver, Trait(Chain)]), n: 2),
                        effects: [Discard(who: You, n: 1, pick: Chosen)],
                    ),
                    If(
                        condition: OpponentRingHas(filter: All([Maneuver, Trait(Chain)]), n: 3),
                        effects: [Discard(who: You, n: 1, pick: Chosen)],
                    ),
                ]),
                Boost((applies_to: Title("No Pain, No Chain"), duration: NextCard, irreversible: true)),
            ],
        ),
        "No Pain, No Chain": (
            on_play: [
                Draw(who: You, n: 3),
                RingsideToArsenal(who: You, n: 3),
                Discard(who: You, n: 3, pick: Chosen),
                Boost((applies_to: Title("Chained Aggression"), duration: NextCard, irreversible: true)),
            ],
        ),
        // Playing 1 more Heat card from your Ringside pile each turn is not supported yet.
        "Feel the Fire": (on_play: [Discard(who: Opponent, n: 2, pick: Chosen)]),
        // Playing 1 more Heat card from your Ringside pile each turn is not supported yet.
        "Sparks of Glory": (on_play: [Draw(who: You, n: 2)]),
        "Underestimated Prowess": (
            requires: Some(InYourRing(All([Maneuver, Keyword("Volley")]))),
            on_play: [
                Draw(who: You, n: 3),
                LookAtHand(who: Opponent),
                MoveCards(who: Opponent, from: Ringside, to: Arsenal, n: 255, up_to: true, pick: Controller, bottom: true),
            ],
        ),
        "Backed by Eric Bischoff": (
            on_play: [
                Counted(
                    count: OpponentValueTimes(1),
                    effect: RemoveFromGame(who: Opponent, from: Ringside, n: 1, pick: Controller),
                ),
                Counted(
                    count: OpponentRingMatching(AnyOf([Trait(Face), Trait(FanFavorite)])),
                    effect: RemoveFromGame(who: Opponent, from: Ringside, n: 1, pick: Controller),
                ),
                MoveCards(who: You, from: Removed, to: Arsenal, n: 1),
            ],
        ),
        "Backed by Theodore Long": (
            on_play: [
                Counted(count: SuperstarValue, effect: RingsideToArsenal(who: You, n: 0)),
                Counted(count: YourRingMatching(AnyOf([Trait(Cheater), Keyword("Cheater")])), effect: RingsideToArsenal(who: You, n: 0)),
                Mill(who: Opponent, n: 3),
            ],
        ),
        "Grab the Mic": (
            on_play: [
                Draw(who: You, n: 1),
                If(
                    condition: AnyOf([
                        YouAre("Tag Team"),
                        InYourRing(Title("Trash Talkin' Interview")),
                        CountAtLeast(count: YourRingsideMatching(Title("Trash Talkin' Interview")), n: 1),
                    ]),
                    effects: [Draw(who: You, n: 1)],
                ),
                Boost((applies_to: Any, duration: NextCard, no_backlash_reversal: true, reversal_fortitude: 5)),
                Counted(count: SuperstarValue, effect: Boost((applies_to: Any, duration: NextCard, reversal_fortitude: 1))),
            ],
        ),
        // Approximation: it watches your next maneuver not of the named type.
        "You Feeling Lucky?": (
            on_play: [
                OpponentChooses(
                    n: 1,
                    options: [
                        [
                            NextPlayWatch(
                                filter: All([Maneuver, Not(ManeuverType(Strike))]),
                                on_reversed: [
                                    If(
                                        condition: OpponentReversedFrom([Hand, Backlash]),
                                        effects: [Discard(who: You, n: 2, pick: Chosen), DiscardAll(who: Opponent, filter: Any)],
                                    ),
                                ],
                            ),
                        ],
                        [
                            NextPlayWatch(
                                filter: All([Maneuver, Not(ManeuverType(Grapple))]),
                                on_reversed: [
                                    If(
                                        condition: OpponentReversedFrom([Hand, Backlash]),
                                        effects: [Discard(who: You, n: 2, pick: Chosen), DiscardAll(who: Opponent, filter: Any)],
                                    ),
                                ],
                            ),
                        ],
                        [
                            NextPlayWatch(
                                filter: All([Maneuver, Not(ManeuverType(Submission))]),
                                on_reversed: [
                                    If(
                                        condition: OpponentReversedFrom([Hand, Backlash]),
                                        effects: [Discard(who: You, n: 2, pick: Chosen), DiscardAll(who: Opponent, filter: Any)],
                                    ),
                                ],
                            ),
                        ],
                    ],
                ),
            ],
        ),
        // The limit of 6 cards is not enforced.
        "Face the Music": (on_play: [Counted(count: YourRingMatching(Trait(Face)), effect: Discard(who: Opponent, n: 0, pick: Chosen))]),
        // The limit of 6 cards is not enforced.
        "Let the Heeling Begin": (on_play: [Counted(count: YourRingMatching(Trait(Heel)), effect: Draw(who: You, n: 0))]),
        // Its Volley: # (# = your Fortitude) is not supported yet: it cannot be reversed by the Volley rule.
        "I Waited Long Enough": (
            on_play: [
                Counted(
                    count: YourRingMatching(Keyword("Volley")),
                    effect: MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Random, bottom: true),
                ),
                Counted(
                    count: YourRingMatching(Keyword("Volley")),
                    effect: MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Random, bottom: true),
                ),
            ],
        ),

        // Pre-match
        "Chain Reaction": (
            while_in_ring: [(applies_to: All([Maneuver, Trait(Chain)]), damage: 1)],
            ring_ability: Some((
                sacrifice: true,
                effects: [Counted(count: YourRingMatching(Trait(Chain)), effect: RingsideToArsenal(who: You, n: 0))],
            )),
        ),
        // Approximation: the opponent shuffles 1 card of the starting hand back into the Arsenal.
        "Argue With Tony Chimel": (
            requires: Some(AnyOf([Not(SuperstarValueAtMostOpponent), Superstar("Ken Kennedy")])),
            end_of_prematch: [
                HandToArsenal(who: Opponent, n: 1),
                HandToArsenalBottom(who: You, n: 1),
                Draw(who: You, n: 1),
            ],
        ),
        // A Superstar Value change worked out from your Value and Ring, and giving added text to the next Face
        // Pre-match card, are not supported yet.
        "Product Endorsements": (requires: Some(Never)),
        // Changing Volley: # values is not supported yet.
        "Unrelenting Assault": (requires: Some(Never)),
        "Restart the Match": (
            end_of_prematch: [
                If(
                    condition: HandHas(All([Maneuver, AnyOf([Trait(Chain), Keyword("Heat"), Keyword("Volley")])])),
                    effects: [
                        Choice([
                            [ShuffleRingsideIntoArsenal(who: You), ShuffleRingsideIntoArsenal(who: Opponent)],
                            [ShuffleHandAndRedraw(who: You), ShuffleHandAndRedraw(who: Opponent)],
                        ]),
                    ],
                ),
            ],
        ),
        // Approximation: ending the turn without playing a card is a Ring ability used before any card this turn
        // (put 1 Ringside card under it, then end the turn); it shares the once-per-turn use with the second part.
        // "Triple that many" counts the cards under all of your cards (exact while it is the only card with cards
        // under it); it is not used with no cards under it.
        "Sit Right Here and Bide My Time": (
            ring_ability: Some((
                effects: [
                    Choice([
                        [If(condition: FirstCardThisTurn, effects: [PutUnder(from: Ringside, n: 1), EndTurn])],
                        [
                            If(
                                condition: CountAtLeast(count: YourUnderSize, n: 1),
                                effects: [
                                    RingsideToArsenalCount(who: You, count: Plus(YourUnderSize, Plus(YourUnderSize, YourUnderSize))),
                                    AllFromUnder(to: Arsenal),
                                    SacrificeThis,
                                ],
                            ),
                        ],
                    ]),
                ],
            )),
        ),
        "It's Getting Hot in Here": (
            end_of_prematch: [
                Optional([
                    DiscardMatching(who: You, n: 1, filter: Keyword("Heat"), pick: Chosen),
                    Optional([
                        DiscardMatching(who: You, n: 1, filter: Keyword("Heat"), pick: Chosen),
                        Discard(who: Opponent, n: 1, pick: Chosen),
                        Optional([
                            DiscardMatching(who: You, n: 1, filter: Keyword("Heat"), pick: Chosen),
                            Discard(who: Opponent, n: 1, pick: Chosen),
                            Optional([
                                DiscardMatching(who: You, n: 1, filter: Keyword("Heat"), pick: Chosen),
                                Discard(who: Opponent, n: 1, pick: Chosen),
                            ]),
                        ]),
                    ]),
                ]),
            ],
        ),
        // Approximation: the 2 extra starting cards are drawn at the end of the Pre-match phase. Not playing
        // Pre-match cards afterwards is not supported yet.
        "Let's Get It On!": (end_of_prematch: [Draw(who: You, n: 2)]),
        "Managed by Lita": (
            extra_traits: [UniversallyUnique],
            end_of_prematch: [Optional([HandToArsenalTop(who: You, n: 1), Search(filter: All([Maneuver, Keyword("Volley")]))])],
            in_ring_on_play: [(whose: Some(You), filter: All([Maneuver, Keyword("Volley")]), effects: [Optional([Draw(who: You, n: 1)])])],
        ),

        // Mid-match
        "A Technical Shoot": (
            on_play: [Search(filter: AnyOf([TitleContains("shoot"), TitleContains("technical")]))],
            while_in_ring: [(applies_to: Maneuver, damage: 1)],
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: All([Maneuver, AnyOf([TitleContains("shoot"), TitleContains("technical")])]),
                    effects: [Discard(who: Opponent, n: 1, pick: Chosen)],
                ),
            ],
        ),
        // Approximation: the maneuver goes to the Ringside pile and you take a maneuver from there.
        "Quick Poke": (
            not_packed_by: ["Female"],
            on_play: [MillUntil(who: You, filter: Maneuver), RingsideToHand(who: You, n: 1, filter: Some(Maneuver))],
        ),
        "Small Concealed Foreign Object": (
            while_in_ring: [(applies_to: ManeuverType(Strike), damage: 1, stun_value: 1)],
            in_ring_on_play: [(whose: Some(You), filter: All([Maneuver, Not(ManeuverType(Strike))]), effects: [SacrificeThis])],
        ),
        "USA! USA! USA!": (
            multi_when: Some(YouAre("Tag Team")),
            requires: Some(AnyOf([FortitudeBelowOpponent, OpponentHandLarger])),
            on_play: [RingsideToHand(who: You, n: 1, filter: Some(All([Maneuver, FortitudeAtMost(0)]))), RingsideToArsenal(who: You, n: 3, up_to: true)],
        ),
        // Changing the discard cost of reversing Chain cards is not supported yet.
        "Chain Barrier": (requires: Some(Never)),
        // Raising the number of Heat cards the opponent needs for the Heat rule is not supported yet.
        "Heat Barrier": (requires: Some(Never)),
        // Changing Volley: # values is not supported yet.
        "Volley Barrier": (requires: Some(Never)),
        // Playing 2 additional Heat cards from your Ringside pile is not supported yet, so the optional Heat discard
        // is left out.
        "Too Hot to Handle": (on_play: [Counted(count: YourRingMatching(Keyword("Heat")), effect: Mill(who: Opponent, n: 0))]),
        "Future Considerations": (
            in_ring_on_play: [
                (
                    whose: Some(You),
                    filter: All([Maneuver, Keyword("Volley")]),
                    effects: [Optional([PutUnder(from: Ringside, n: 1, filter: Some(Keyword("Volley")))])],
                ),
            ],
            play_from_under: Some(Any),
        ),
        "The Sex, the Gods, the Freaks, the Frauds": (
            on_play: [
                Discard(who: You, n: 1, pick: Chosen),
                Draw(who: You, n: 2),
                MoveCards(who: You, from: Removed, to: Arsenal, n: 3),
                LookAtHand(who: Opponent),
                Choice([
                    [],
                    [
                        If(
                            condition: OpponentHandAtLeast(1),
                            effects: [MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Controller), Draw(who: Opponent, n: 1)],
                        ),
                    ],
                    [
                        If(
                            condition: OpponentHandAtLeast(2),
                            effects: [MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 2, pick: Controller), Draw(who: Opponent, n: 2)],
                        ),
                    ],
                    [
                        If(
                            condition: OpponentHandAtLeast(3),
                            effects: [MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 3, pick: Controller), Draw(who: Opponent, n: 3)],
                        ),
                    ],
                    [
                        If(
                            condition: OpponentHandAtLeast(4),
                            effects: [MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 4, pick: Controller), Draw(who: Opponent, n: 4)],
                        ),
                    ],
                ]),
            ],
        ),
        "Ready to Fight": (
            bonuses: [(when: FortitudeBelowOpponent, fortitude: -8)],
            on_play: [RingsideToArsenal(who: You, n: 5, up_to: true)],
            ring_ability: Some((sacrifice: true, effects: [RingsideToHand(who: You, n: 1, filter: Some(Maneuver))])),
        ),
        "Break It Out, Break You Down, Breakin' Rules, Breakin' Ground": (
            on_play: [
                RemoveFromRing(
                    who: You,
                    n: 1,
                    filter: Not(Title("Break It Out, Break You Down, Breakin' Rules, Breakin' Ground")),
                ),
                RemoveFromRing(who: Opponent, n: 2, filter: Any),
                LookAtHand(who: Opponent),
                Discard(who: Opponent, n: 3, pick: Chosen),
                RemoveFromGame(who: Opponent, from: Ringside, n: 4, pick: Controller),
            ],
        ),

        // Hollywood Hulk Hogan
        "Whatcha Gonna Do, Brother?": (
            ring_ability: Some((
                sacrifice: true,
                effects: [Boost((applies_to: Maneuver, duration: NextCards(2), no_reversal_from: [Hand, Backlash, Ringside, Ring, Under]))],
            )),
        ),
        // Approximation: only the chosen card is removed from the game, not every card in his hand with its title.
        "When Hulkamania Runs Wild on You!": (
            on_play: [
                LookAtHand(who: Opponent),
                RemoveFromGame(who: Opponent, from: Hand, n: 1, pick: Controller),
                Boost((applies_to: Any, duration: NextCards(2), irreversible: true)),
            ],
        ),
        "I Live for My Hulkamaniacs...": (
            on_play: [
                Counted(count: SuperstarValue, effect: MoveCards(who: You, from: Ringside, to: Arsenal, n: 0, top: true)),
                Search(filter: SuperstarSpecific),
            ],
        ),
        // Played after a maneuver succeeds, outside the reversal window: not supported yet.
        "Hulkin' Up": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        "Original WWE Icon": (
            reverses: Some((targets: Action, effects: [Choice([[RingsideToHand(who: You, n: 1)], [Search(filter: Any)]])])),
        ),
        // Approximation: only Mid-match cards go back into the Backlash deck.
        "Hollywood's Big Boot": (
            on_play: [
                Optional([
                    Choice([
                        [RingsideToBacklash(who: You, n: 1)],
                        [MoveCards(who: You, from: Ringside, to: Ring, n: 1, filter: Some(Title("I Am a Real American")))],
                    ]),
                ]),
            ],
        ),
        "Say Your Prayers and Eat Your Vitamins": (
            on_play: [Discard(who: Opponent, n: 3, pick: Random), BacklashToRingside(who: Opponent, n: 3, random: true)],
        ),
        "Hollywood Leg Drop": (play_after: Some(Maneuver)),

        // Sgt. Slaughter
        "Real American Cobra Clutch": (
            bonuses: [(fortitude: -10)],
            on_play: [Boost((applies_to: Title("Maintain Hold"), duration: NextCard, ignore_play_after: true))],
            reverses: Some((targets: Action)),
        ),
        // Reducing damage by removing Throwback cards from the game is not supported yet.
        "The Motor Pool": (while_in_ring: [(applies_to: All([Maneuver, Keyword("Throwback")]), damage: 2)]),
        // Its two abilities are one Ring ability with a choice (once per turn for both).
        "Boot Camp Match": (
            ring_ability: Some((
                effects: [
                    Choice([
                        [
                            If(
                                condition: FortitudeAboveOpponent,
                                effects: [
                                    RemoveFromGame(who: You, from: Ringside, n: 1),
                                    RemoveFromGame(who: Opponent, from: Ringside, n: 1, pick: Controller),
                                ],
                            ),
                        ],
                        [MoveCards(who: You, from: Removed, to: Arsenal, n: 10, up_to: true), ReturnThis(to: Removed)],
                    ]),
                ],
            )),
        ),
        "At-Ten-HUT!": (
            reverses: Some((
                targets: All([Maneuver, Not(Trait(Unique))]),
                from_hand_only: true,
                on_reverse: [Choice([[Draw(who: You, n: 1)], [MoveCards(who: You, from: Removed, to: Arsenal, n: 1, bottom: true)]])],
            )),
        ),
        // Approximation: the opponent picks how many cards to discard from 0 to 10.
        "Gimme Ten, Maggot!": (
            on_play: [
                OpponentChooses(
                    n: 1,
                    options: [
                        [Mill(who: Opponent, n: 10)],
                        [
                            If(condition: OpponentHandAtLeast(1), effects: [Discard(who: Opponent, n: 1, pick: Chosen), Mill(who: Opponent, n: 9)]),
                            If(condition: Not(OpponentHandAtLeast(1)), effects: [Mill(who: Opponent, n: 10)]),
                        ],
                        [
                            If(condition: OpponentHandAtLeast(2), effects: [Discard(who: Opponent, n: 2, pick: Chosen), Mill(who: Opponent, n: 8)]),
                            If(condition: Not(OpponentHandAtLeast(2)), effects: [Mill(who: Opponent, n: 10)]),
                        ],
                        [
                            If(condition: OpponentHandAtLeast(3), effects: [Discard(who: Opponent, n: 3, pick: Chosen), Mill(who: Opponent, n: 7)]),
                            If(condition: Not(OpponentHandAtLeast(3)), effects: [Mill(who: Opponent, n: 10)]),
                        ],
                        [
                            If(condition: OpponentHandAtLeast(4), effects: [Discard(who: Opponent, n: 4, pick: Chosen), Mill(who: Opponent, n: 6)]),
                            If(condition: Not(OpponentHandAtLeast(4)), effects: [Mill(who: Opponent, n: 10)]),
                        ],
                        [
                            If(condition: OpponentHandAtLeast(5), effects: [Discard(who: Opponent, n: 5, pick: Chosen), Mill(who: Opponent, n: 5)]),
                            If(condition: Not(OpponentHandAtLeast(5)), effects: [Mill(who: Opponent, n: 10)]),
                        ],
                        [
                            If(condition: OpponentHandAtLeast(6), effects: [Discard(who: Opponent, n: 6, pick: Chosen), Mill(who: Opponent, n: 4)]),
                            If(condition: Not(OpponentHandAtLeast(6)), effects: [Mill(who: Opponent, n: 10)]),
                        ],
                        [
                            If(condition: OpponentHandAtLeast(7), effects: [Discard(who: Opponent, n: 7, pick: Chosen), Mill(who: Opponent, n: 3)]),
                            If(condition: Not(OpponentHandAtLeast(7)), effects: [Mill(who: Opponent, n: 10)]),
                        ],
                        [
                            If(condition: OpponentHandAtLeast(8), effects: [Discard(who: Opponent, n: 8, pick: Chosen), Mill(who: Opponent, n: 2)]),
                            If(condition: Not(OpponentHandAtLeast(8)), effects: [Mill(who: Opponent, n: 10)]),
                        ],
                        [
                            If(condition: OpponentHandAtLeast(9), effects: [Discard(who: Opponent, n: 9, pick: Chosen), Mill(who: Opponent, n: 1)]),
                            If(condition: Not(OpponentHandAtLeast(9)), effects: [Mill(who: Opponent, n: 10)]),
                        ],
                        [
                            If(condition: OpponentHandAtLeast(10), effects: [Discard(who: Opponent, n: 10, pick: Chosen)]),
                            If(condition: Not(OpponentHandAtLeast(10)), effects: [Mill(who: Opponent, n: 10)]),
                        ],
                    ],
                ),
            ],
        ),

        // The Home Team
        "Because the Fans Demanded It": (
            end_of_prematch: [ShuffleHandAndRedraw(who: Opponent)],
            ring_ability: Some((sacrifice: true, effects: [Search(filter: All([Maneuver, Not(Trait(Unique))]))])),
        ),
        "Flurry of Finishers": (play_after: Some(Maneuver)),
        "The Shhhhh Chop": (
            extra_traits: [FanFavorite],
            on_play: [Optional([RingsideToArsenal(who: You, n: 1)]), Optional([RingsideToBacklash(who: You, n: 1)])],
        ),
        "Never Back Down - Never Quit": (
            extra_traits: [FanFavorite],
            reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]))),
            ringside_on_opponent_reverses: [
                If(
                    condition: All([OpponentReversed(Maneuver), OpponentReversedFrom([Hand])]),
                    effects: [Optional([ReturnThis(to: Hand)])],
                ),
            ],
        ),
        "I Will Not Die": (
            extra_traits: [FanFavorite],
            reverses: Some((
                targets: AnyOf([ManeuverType(Submission), ManeuverType(HighRisk)]),
                effects: [
                    Search(filter: Any),
                    Boost((applies_to: Any, duration: NextTurnFirstCard, ignore_play_after: true)),
                ],
            )),
        ),
        "The Whole Dam Show": (
            extra_traits: [FanFavorite],
            on_play: [
                RemoveFromGame(who: Opponent, from: Ringside, n: 7, up_to: true, pick: Controller),
                RingsideToArsenal(who: You, n: 7, up_to: true),
            ],
        ),

        // The Heat Seekers
        "On Your Home Turf": (
            end_of_prematch: [
                OpponentChooses(
                    n: 1,
                    options: [
                        [HandToArsenalBottom(who: Opponent, n: 4)],
                        [RemoveFromGame(who: Opponent, from: Hand, n: 2, pick: Random)],
                    ],
                ),
            ],
        ),
        // Approximation: the Arsenal-only limit also applies when it is played as an Action.
        "A Good Old-Fashioned Mugging": (
            reversal_limits: [(from: [Hand, Backlash, Ringside, Ring, Under])],
            as_action: Some((
                fortitude: Some(0),
                on_play: [ThisToArsenal(bottom: true), MoveCards(who: You, from: Removed, to: Arsenal, n: 2, bottom: true)],
            )),
        ),
        "I Know Cool ... And You're Not Cool": (
            extra_traits: [Cheater],
            while_in_ring: [(applies_to: Title("Spit At Opponent"), multi: true)],
            reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]), overturned_only: true)),
        ),
        "Kokubetsu": (
            extra_traits: [Cheater],
            reverses: Some((
                targets: Action,
                effects: [Counted(count: YourRingMatching(SuperstarSpecific), effect: Discard(who: Opponent, n: 0, pick: Chosen))],
            )),
        ),
        "The Proper Punch": (
            extra_traits: [Cheater],
            play_after: Some(Any),
            reversal_limits: [(from: [Backlash, Ringside, Ring, Under], when: After(Maneuver))],
        ),
        // Not playing Reversals from hand during his next turn is not supported yet.
        "We're Not Mexicans ... We're Mexicools!": (
            extra_traits: [Cheater],
            on_play: [
                RemoveFromGame(who: Opponent, from: Hand, n: 5),
                MoveCards(who: You, from: Removed, to: Arsenal, n: 4, up_to: true, bottom: true),
                MoveCards(who: You, from: Removed, to: Hand, n: 3, up_to: true),
                DrawUpTo(who: You, n: 2),
                Discard(who: You, n: 1, pick: Chosen),
                EndTurn,
            ],
        ),
        "Violent Vendetta": (
            on_play: [RemoveFromGame(who: Opponent, from: Hand, n: 1)],
            ring_ability: Some((effects: [ThisToArsenal(bottom: true)])),
        ),
    },
)
