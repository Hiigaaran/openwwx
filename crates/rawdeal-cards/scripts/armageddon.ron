                        CountAtLeast(count: Minus(OpponentRemoved, YourRemoved), n: 20),
                    ]),
                    effects: [WinByPin],
                ),
                // You lose: your opponent wins.
                AsOpponent([
                    If(
                        condition: All([
                            CountAtLeast(count: Minus(HandSize, OpponentHandSize), n: 5),
                            CountAtLeast(count: Minus(YourFortitude, OpponentFortitude), n: 10),
