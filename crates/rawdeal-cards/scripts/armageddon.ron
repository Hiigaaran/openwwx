// Hand-written scripts for Armageddon cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// The engine applies the Heat and Volley rules; Throwback and RMS are only matched as printed keywords.
(
    abilities: {
        "Babe of the Year": [
            PacksLogos(["Trish Stratus"]),
            Activated(
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [RemoveFromGame(who: Opponent, from: Ringside, n: 2, up_to: true, pick: Controller)],
            ),
        ],
        "JBL": [],
        // Packing 4 copies and the one-logo packing rule are not supported yet. The added text (+1 Pre-match limit)
        // of his Superstar-specific Pre-match cards is read as them not taking up a Pre-match slot.
        "The Phenom": [
            PacksLogos(["Undertaker", "Deadman Inc"]),
            CannotPack("I'm the Biggest Dog on this Block!"),
            NoSlotFor(All([SuperstarSpecific, Not(Trait(MidMatch))])),
        ],
        // Ego Boost and European Uppercut are not made Set-up cards.
        "Randy Orton": [
            CannotBeReversedBy(played: Title("Ego Boost"), reversal: Any),
            CardFortitude(title: "European Uppercut", delta: -2),
            Activated(cost: [Discard(who: You, n: 1, pick: Chosen)], effects: [Search(filter: Trait(SetUp))]),
        ],
        // Approximation: each turn his High Risk maneuvers may ignore their "Can only be played after" text
        // when played right after any successful card.
        "Shane O' Mac": [
            CannotPackMatching(All([AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]), DamageAtLeast(4)])),
            StartOfTurn([
                Boost((applies_to: All([ManeuverType(HighRisk), After(Any)]), duration: ThisTurn, ignore_play_after: true)),
            ]),
        ],
        // Packing It's All About the Benjamins is not supported yet. Approximation: the opponent's top Arsenal
        // card is removed from the game instead of one chosen from his top 5.
        "Shelton Benjamin": [
            OnOpponentReverses([Optional([RingsideToArsenal(who: You, n: 1)])]),
            OnPlayMatching(filter: Maneuver, effects: [RemoveFromGame(who: Opponent, from: Arsenal, n: 1)]),
        ],
        // Packing other Superstars' maneuvers and the Superstar Value (opponent's - 1) are not supported yet.
        // Approximation: he cannot pack Superstar-specific 4D+ Reversals instead of not playing them.
        "Eugene": [
            CannotPlayMatching(All([Trait(Unique), EarlierThisTurn(filter: Trait(Unique), n: 1)])),
            CannotPackMatching(All([Reversal, SuperstarSpecific, DamageAtLeast(4)])),
            CannotPack("There Is No Escape"),
        ],
        // The 1-copy packing limit is not supported yet.
        "Rene Dupree": [
            Activated(
                cost: [RemoveFromGame(who: You, from: Backlash, n: 1)],
                effects: [RingsideToArsenal(who: You, n: 2, up_to: true)],
            ),
        ],
    },
    scripts: {
        "Ten Gallon Hat": (
            backstage_ability: Some((sacrifice: true, effects: [RingsideToHand(who: You, n: 1)])),
        ),
        // High Risk
        "Flying Head Scissors": (
            play_after: Some(All([Maneuver, DamageAtLeast(2)])),
            bonuses: [(when: FortitudeBelowOpponent, fortitude: -4), (per: Some(Trait(SmackDown)), damage: 1)],
        ),
        "Double Axe Handle": (play_after: Some(All([Maneuver, DamageAtLeast(3)]))),
        "Leg Drop": (
            play_after: Some(All([Maneuver, DamageAtLeast(5)])),
            as_action: Some((
                fortitude: Some(0),
                on_play: [Choice([[DiscardThis], [ShuffleThisIntoArsenal]]), Draw(who: You, n: 1)],
            )),
        ),
        "Splash": (
            play_after: Some(All([Maneuver, DamageAtLeast(4)])),
            on_play: [LookAtHand(who: Opponent), Discard(who: Opponent, n: 1, pick: Controller)],
        ),
        "Flying Clothesline": (play_after: Some(Maneuver), on_play: [Mill(who: You, n: 2)]),
        "Moonsault": (
            play_after: Some(All([Maneuver, DamageAtLeast(5)])),
            on_play: [
                RingsideToArsenal(who: You, n: 4, up_to: true),
                Optional([RingsideToHand(who: You, n: 1, filter: Some(ManeuverType(TrademarkFinisher)))]),
            ],
        ),
        "Suicide Plancha": (
            play_after: Some(All([Maneuver, DamageAtLeast(5)])),
            reversal_limits: [
                (from: [Hand, Backlash, Ringside, Ring, Under], when: After(All([Maneuver, After(Title("Irish Whip"))]))),
            ],
            bonuses: [(when: After(All([Maneuver, After(Title("Irish Whip"))])), damage: 5)],
        ),

        // Strikes
        "Chump Punch": (
            on_play: [Optional([RemoveFromGame(who: Opponent, from: Ringside, n: 2, up_to: true, pick: Controller)])],
        ),
        "Slap": (
            on_play: [Optional([Choice([[Draw(who: You, n: 1)], [RingsideToArsenal(who: You, n: 1)]])])],
        ),
        "Super Punch": (
            bonuses: [(when: After(TitleContains("punch")), damage: 2)],
            not_reversed_by: Some(Title("Step Aside")),
            ringside_ability: Some((
                cost: [DiscardMatching(who: You, n: 1, filter: Keyword("Volley"), pick: Chosen)],
                effects: [ReturnThis(to: Hand)],
            )),
        ),
        "Struck by a Kendo Stick": (on_play: [Search(filter: Keyword("Foreign Object"))]),
        "Shoulder Thrust": (on_play: [Optional([RingsideToHand(who: You, n: 1, filter: Some(Keyword("Heat")))])]),
        // Blanking the text of the opponent's maneuver is not supported yet.
        "Solarplex Knife Chop": (),
        // Approximation: only when it is reversed from the opponent's hand (not by the Volley removal).
        "Cold-cocked": (
            on_reversed_from_hand: [
                RingsideToHand(who: You, n: 2, up_to: true, filter: Some(All([Keyword("Volley"), Not(Title("Cold-cocked"))]))),
            ],
        ),
        // Playing it as a Reversal from hand with a 'kick' card in your Ring is not supported yet.
        "Ensugiri": (
            bonuses: [(when: FortitudeBelowOpponent, fortitude: -3)],
            reverses: Some((
                targets: ManeuverType(Strike),
                overturned_only: true,
                fortitude_when: Some((FortitudeBelowOpponent, 5)),
            )),
        ),
        "Knee Lift": (
            bonuses: [(fortitude: -7)],
            reverses: Some((targets: All([Action, Not(Trait(Unique))]), requires: Some(FortitudeBelowOpponent))),
        ),
        "Whirling Backhand": (
            on_play: [Optional([RemoveFromGame(who: Opponent, from: Ringside, n: 1, pick: Controller)])],
        ),
        // Over Sell Maneuver cannot be played yet, so its restriction is not needed.
        "European Uppercut": (on_play: [Optional([Draw(who: You, n: 1)])]),
        // Removing Strikes from the game for +#D and +# Stun Value is not supported yet (no bonus from the
        // number of cards removed).
        "Flurry of Strikes": (
            not_packed_by: ["Female"],
            reverses: Some((targets: Keyword("Heat"), fortitude: Some(5), damage: Fixed(0))),
        ),

        // Grapples
        "Throw": (
            on_play: [
                Choice([
                    [RingsideToArsenal(who: You, n: 2, up_to: true)],
                    [RemoveFromGame(who: Opponent, from: Ringside, n: 1, pick: Controller)],
                ]),
            ],
        ),
        // Approximation: you decide before looking whether the top card goes to the bottom.
        "Inverse Atomic Drop": (on_play: [Optional([Dig(n: 1, take: 0)])]),
        "Rib Breaker": (while_in_ring: [(applies_to: TitleContains("breaker"), damage: 1)]),
        "Back Breaker": (while_in_ring: [(applies_to: TitleContains("breaker"), stun_value: 1)]),
        "Double Leg Takedown": (on_play: [RemoveFromGame(who: Opponent, from: Ringside, n: 1, pick: Controller)]),
        "Fireman's Carry": (on_play: [Choice([[Draw(who: You, n: 1)], [LookAtHand(who: Opponent)]])]),
        "Toss": (on_play: [Boost((applies_to: Maneuver, duration: NextCard, no_backlash_reversal: true))]),
        "Leg Drag": (
            bonuses: [(fortitude: -3)],
            reverses: Some((targets: All([ManeuverType(Strike), DamageAtLeast(6)]))),
        ),
        // Approximation: any card of his Backlash deck may be chosen.
        "Brainbuster": (on_play: [BacklashToRingside(who: Opponent, n: 1)]),
        "Airplane Spin": (
            on_play: [
                AsOpponent([
                    Choice([
                        [BacklashToRingside(who: You, n: 60)],
                        [DiscardAll(who: You, filter: Any), DiscardAll(who: Opponent, filter: Any)],
                    ]),
                ]),
            ],
        ),
        "Power Slam": (
            on_play: [
                Counted(
                    count: YourRingMatching(All([Maneuver, Keyword("Throwback")])),
                    effect: Discard(who: Opponent, n: 1, pick: Chosen),
                ),
            ],
            reverses: Some((targets: All([ManeuverType(Strike), Not(TitleContains("kick"))]))),
        ),
        // Atomic Spine Buster counting as a High Risk maneuver is not supported yet.
        "Atomic Driver": (on_play: [Search(filter: Trait(Unique))]),

        // Submissions
        "Short Arm Hammerlock": (on_play: [AsOpponent([Optional([RingsideToBacklash(who: You, n: 1)])])]),
        "Cranial Crunch": (
            not_packed_by: ["Female"],
            on_play: [RevealHand(who: You), AsOpponent([Discard(who: Opponent, n: 1, pick: Controller)])],
        ),
        "Chin Lock": (
            on_play: [
                Optional([
                    Discard(who: You, n: 1, pick: Chosen),
                    RingsideToHand(who: You, n: 1, filter: Some(Keyword("Throwback"))),
                ]),
            ],
        ),
        // Looking at the opponent's Backlash deck is not supported yet.
        "Go-behind": (
            on_play: [
                LookAtHand(who: Opponent),
                Boost((applies_to: Maneuver, duration: NextCard, fortitude: -5, reversal_fortitude: 5)),
            ],
        ),
        "Grab": (on_play: [Optional([Search(filter: Not(Trait(Unique)))])]),
        "Head Vise": (on_play: [BacklashToRingside(who: You, n: 1, random: true)]),
        "Chicken Wing": (on_play: [RingsideToArsenal(who: You, n: 3, up_to: true)]),
        "Asphyxiater": (bonuses: [(per: Some(Keyword("Heat")), damage: 1)]),
        // Blanking a card's text is not supported yet. Over Sell Maneuver cannot be played yet.
        "Rest Hold": (
            on_play: [
                Choice([
                    [RingsideToBacklash(who: You, n: 1)],
                    [RemoveFromRing(who: Opponent, n: 1, filter: Not(Trait(Unique)))],
                ]),
            ],
        ),
        "Abdominal Stretch": (on_play: [Search(filter: Any)]),
        "STF": (
            play_after: Some(Any),
            bonuses: [(per: Some(All([Maneuver, Keyword("Throwback")])), damage: 1)],
        ),
        "Figure Four Leg Lock": (play_after: Some(Maneuver), reversal_limits: [(from: [Backlash, Ringside, Ring, Under])]),

        // Reversals
        "Anything and Hate It": (
            reverses: Some((
                targets: All([Maneuver, Not(Trait(Unique))]),
                from_hand_only: true,
                // As the opponent: the Fortitude of his card that was reversed.
                effects: [AsOpponent([Counted(count: OpponentReversedFortitude, effect: DrawUpTo(who: You, n: 0))])],
            )),
        ),
        "I Gotta Say, Out of Play": (
            reverses: Some((targets: AnyOf([Keyword("Throwback"), Keyword("Volley")]), reversed_removed: true)),
        ),
        // Reversing a maneuver after it was successfully played is not supported yet.
        "Raw and Ready": (requires: Some(Never), reverses: Some((targets: Not(Any)))),

        // Actions
        // Putting the card on top does not matter: the search shuffles the Arsenal.
        "Ask Yourself: How Many Are There?": (
            on_play: [RingsideToArsenal(who: You, n: 1), Search(filter: Title("Ask Yourself: How Many Are There?"))],
        ),
        // Searching for a title in the opponent's Ring is not supported yet.
        "I Got That, Too": (requires: Some(Never)),
        "Hmmmm... Don't Think Too Hard": (
            on_play: [
                Arrange(who: You, n: 8),
                Optional([Shuffle(who: You)]),
                Arrange(who: Opponent, n: 8),
                Optional([Shuffle(who: Opponent)]),
            ],
        ),
        "Back in Style": (on_play: [RingsideToArsenal(who: You, n: 5, up_to: true, filter: Some(Keyword("Throwback")))]),
        "From the Middle Turnbuckle": (
            play_after: Some(Maneuver),
            play_after_unless: Some(All([ReversedLastTurn(Any), YouReversedFrom([Arsenal])])),
            on_play: [
                RingsideToHand(who: You, n: 1, filter: Some(All([ManeuverType(HighRisk), Not(Trait(Unique))]))),
                Boost((
                    applies_to: ManeuverType(HighRisk),
                    duration: NextCard,
                    ignore_play_after: true,
                    no_backlash_reversal: true,
                )),
            ],
        ),
        "Throw Opponent Out of the Ring": (
            play_after: Some(AnyOf([Maneuver, Trait(SetUp)])),
            on_play: [
                Optional([Search(filter: All([Maneuver, Not(Trait(Unique))])), Search(filter: Title("Roll Out of the Ring"))]),
                CannotPlay(who: You, filter: Title("Throw Opponent Out of the Ring"), turns: 1),
            ],
        ),
        "From the Top Rope": (
            play_after: Some(AnyOf([ManeuverType(Strike), ManeuverType(Grapple)])),
            play_after_unless: Some(All([ReversedLastTurn(Any), YouReversedFrom([Hand, Backlash])])),
            on_play: [
                Search(filter: ManeuverType(HighRisk)),
                Boost((
                    applies_to: ManeuverType(HighRisk),
                    duration: NextCard,
                    ignore_play_after: true,
                    damage: 5,
                    stun_value: 2,
                )),
            ],
        ),
        "I'm Desperate": (
            requires: Some(AnyOf([FortitudeBelowOpponent, CountAtLeast(count: OpponentHandExcess, n: 5)])),
            on_play: [Boost((applies_to: Any, duration: NextCard, irreversible: true))],
        ),
        "J.R. Style Action": (on_play: [Boost((applies_to: Maneuver, duration: NextCard, multi: true))]),
        // Removing cards from the game as the cost of the Reversal is not supported yet.
        "Volley This!": (
            on_play: [DiscardThis, Search(filter: Keyword("Volley"))],
            reverses: Some((targets: Not(Any))),
        ),
        "Flawless Execution": (
            in_ring_on_play: [
                (whose: Some(You), filter: Maneuver, effects: [Optional([RingsideToArsenalBottom(who: You, n: 1)])]),
            ],
        ),
        "Great Power Brawl": (
            on_play: [Draw(who: You, n: 1)],
            while_in_ring: [
                (applies_to: ManeuverType(Submission), damage: 1),
                (applies_to: ManeuverType(Strike), damage: 2),
                (applies_to: ManeuverType(Grapple), damage: 3),
            ],
        ),
        "The Rub": (
            requires: Some(AnyOf([OpponentHandLarger, InYourRing(Title("The Show Must Go On"))])),
            irreversible_when: Some(InYourRing(Title("The Show Must Go On"))),
            on_play: [
                OpponentChooses(
                    n: 2,
                    options: [
                        [Optional([Draw(who: You, n: 2)])],
                        [Optional([RingsideToArsenal(who: You, n: 3)])],
                        [Discard(who: Opponent, n: 4, pick: Chosen)],
                    ],
                ),
            ],
        ),
        // Removing overturned cards from the game is not supported yet.
        "Egomaniacal": (requires: Some(Never)),
        "It's Not Always the Charisma": (
            requires: Some(AnyOf([SuperstarValueBelowOpponent, FortitudeAboveOpponent])),
            on_play: [
                Counted(
                    count: SuperstarValue,
                    effect: Boost((applies_to: Maneuver, duration: NextMatching, reversal_fortitude: 1)),
                ),
                Boost((applies_to: Maneuver, duration: NextMatching, reversal_fortitude: 6)),
            ],
        ),
        "Throwback Represent": (
            on_play: [
                Search(filter: All([Keyword("Throwback"), Not(SuperstarSpecific)])),
                Discard(who: You, n: 1, pick: Chosen),
            ],
        ),
        // Checking what the opponent played last turn is not supported yet.
        "Calculated Revenge": (requires: Some(Never)),
        // Counting as having played no cards this turn is not supported yet.
        "The Show Must Go On": (on_play: [Draw(who: You, n: 1), Discard(who: You, n: 1, pick: Chosen)]),
        // Approximation: the two cards may have the same title.
        "I'm Giving You a Chance": (on_play: [Search(filter: Any, n: 2, random_back: 1)]),
        // The Feud card condition is not supported yet.
        "Personal Vendetta": (
            on_play: [
                Choice([
                    [],
                    [
                        If(
                            condition: HandAtLeast(1),
                            effects: [
                                Discard(who: You, n: 1, pick: Chosen),
                                RingsideToArsenalBottom(who: You, n: 1),
                                Optional([Search(filter: Trait(Chain))]),
                            ],
                        ),
                    ],
                    [
                        If(
                            condition: HandAtLeast(2),
                            effects: [
                                Discard(who: You, n: 2, pick: Chosen),
                                RingsideToArsenalBottom(who: You, n: 2),
                                Optional([Search(filter: Trait(Chain), n: 2)]),
                            ],
                        ),
                    ],
                    [
                        If(
                            condition: HandAtLeast(3),
                            effects: [
                                Discard(who: You, n: 3, pick: Chosen),
                                RingsideToArsenalBottom(who: You, n: 3),
                                Optional([Search(filter: Trait(Chain), n: 3)]),
                            ],
                        ),
                    ],
                ]),
            ],
        ),
        "I Won't Stop": (
            on_opponent_reverses: [
                If(
                    condition: All([OpponentReversedFrom([Hand]), OpponentReversed(Maneuver)]),
                    effects: [
                        Optional([
                            ReturnThis(to: Removed),
                            Discard(who: You, n: 1, pick: Chosen),
                            RingsideToHand(who: You, n: 1, filter: Some(Trait(Chain))),
                            ContinueTurn,
                        ]),
                    ],
                ),
            ],
        ),
        "Defensive Style": (
            reverses_from_ring: Some((
                targets: All([
                    AnyOf([ManeuverType(Strike), ManeuverType(Grapple), ManeuverType(Submission)]),
                    Not(Trait(Unique)),
                ]),
                fortitude: Some(0),
                removed_after: true,
            )),
        ),
        "Take It Back": (
            on_play: [RingsideToArsenalCount(who: You, count: YourRingMatching(Keyword("Throwback")))],
            ring_ability: Some((
                cost: [DiscardMatching(who: You, n: 1, filter: Keyword("Throwback"), pick: Chosen)],
                effects: [
                    RingsideToArsenalCount(who: You, count: AtMost(Half(YourRingMatching(Keyword("Throwback"))), 5)),
                ],
            )),
        ),
        "The Switch": (
            on_play: [
                Choice([
                    [],
                    [If(condition: HandAtLeast(1), effects: [Discard(who: You, n: 1, pick: Chosen), RingsideToHand(who: You, n: 1)])],
                    [If(condition: HandAtLeast(2), effects: [Discard(who: You, n: 2, pick: Chosen), RingsideToHand(who: You, n: 2)])],
                    [If(condition: HandAtLeast(3), effects: [Discard(who: You, n: 3, pick: Chosen), RingsideToHand(who: You, n: 3)])],
                    [If(condition: HandAtLeast(4), effects: [Discard(who: You, n: 4, pick: Chosen), RingsideToHand(who: You, n: 4)])],
                    [If(condition: HandAtLeast(5), effects: [Discard(who: You, n: 5, pick: Chosen), RingsideToHand(who: You, n: 5)])],
                    [If(condition: HandAtLeast(6), effects: [Discard(who: You, n: 6, pick: Chosen), RingsideToHand(who: You, n: 6)])],
                ]),
            ],
        ),
        // Approximation: 1 card removed from the game is put into your hand (it need not be the next card played).
        "Like a Bat Out of Hell": (on_play: [MoveCards(who: You, from: Removed, to: Hand, n: 1)]),
        "Out of the Hellfire": (
            irreversible: true,
            on_play: [Choice([[RingsideToArsenal(who: You, n: 5, up_to: true)], [RingsideToHand(who: You, n: 1)]])],
        ),
        "You're Just a Puppet": (
            on_play: [Search(filter: Action)],
            while_in_ring: [(applies_to: Action, fortitude: -5)],
        ),
        "I Ain't No Minor Leaguer": (
            bonuses: [(when: Not(SuperstarValueAtMostOpponent), fortitude: -5)],
            on_play: [Search(filter: Trait(Unique)), Search(filter: Title("Booker's Scissor Kick"))],
        ),
        // Approximation: the up to 4 Mid-match cards all come from the Ring area or all from the Ringside pile.
        "The Best Thing Going Today": (
            on_play: [
                HandToArsenalBottom(who: You, n: 4),
                RingsideToArsenalBottom(who: You, n: 4),
                Choice([
                    [
                        MoveCards(
                            who: You,
                            from: Ringside,
                            to: Backlash,
                            n: 4,
                            up_to: true,
                            filter: Some(All([Trait(MidMatch), Not(Trait(Unique))])),
                        ),
                    ],
                    [
                        MoveCards(
                            who: You,
                            from: Ring,
                            to: Backlash,
                            n: 4,
                            up_to: true,
                            filter: Some(All([Trait(MidMatch), Not(Trait(Unique))])),
                        ),
                    ],
                ]),
                Draw(who: You, n: 4),
            ],
        ),
        "Crossing Borders": (on_play: [Search(filter: Not(Trait(Unique))), Search(filter: Title("Springboard"))]),
        "Throwback": (
            on_play: [
                MoveCards(
                    who: You,
                    from: Removed,
                    to: Arsenal,
                    n: 10,
                    up_to: true,
                    filter: Some(AnyOf([Keyword("Volley"), Keyword("Throwback")])),
                ),
                EndTurn,
            ],
        ),
        "The Inmates Aren't Running My Asylum": (
            only_packed_by: ["GM", "Chairman"],
            requires: Some(FortitudeBelowOpponent),
            on_play: [RemoveFromRing(who: Opponent, n: 30, filter: Not(Maneuver))],
        ),
        "Drastic Times - Drastic Measures": (
            only_packed_by: ["Diva"],
            ring_ability: Some((
                requires: Some(FortitudeBelowOpponent),
                cost: [RemoveFromGame(who: You, from: Ring, n: 1)],
                effects: [RemoveFromRing(who: Opponent, n: 1, filter: Any)],
            )),
        ),
        // Approximation: one round only (you, then he may answer once) instead of repeating until one stops.
        "If You Want To Play You Gotta Pay": (
            in_ring_start_of_turn: [
                If(
                    condition: OpponentHandAtLeast(1),
                    effects: [
                        Optional([
                            Discard(who: You, n: 1, pick: Chosen),
                            RemoveFromGame(who: Opponent, from: Arsenal, n: 3),
                            AsOpponent([
                                Optional([
                                    Discard(who: You, n: 1, pick: Chosen),
                                    RemoveFromGame(who: Opponent, from: Arsenal, n: 3),
                                ]),
                            ]),
                        ]),
                    ],
                ),
            ],
        ),
        "Master Manipulator": (
            only_packed_by: ["GM", "Chairman"],
            on_play: [LookAtHand(who: Opponent), Discard(who: Opponent, n: 1, pick: Controller)],
            reverses: Some((targets: Not(Trait(Unique)), effects: [PurgeReversedTitle])),
        ),

        // Pre-match
        "Boston, Massachusetts": (
            while_in_ring_all: [
                (applies_to: All([Action, Trait(SetUp), Holds(FirstCardThisTurn)]), irreversible: true),
            ],
        ),
        // Approximation: any Backlash card may be chosen, not only non-Superstar-specific Event cards.
        "I Want to Play the Game": (
            on_play: [BacklashToRingside(who: Opponent, n: 1), AsOpponent([BacklashToRingside(who: Opponent, n: 1)])],
        ),
        "Old School Antics": (
            pre_match_limit: 1,
            ring_ability: Some((sacrifice: true, effects: [RingsideToArsenal(who: You, n: 2, up_to: true)])),
        ),
        // Approximation: each player discards 6 Backlash cards of his choice, of any kind, and nothing is revealed.
        "San Diego, California": (
            on_play: [BacklashToRingside(who: You, n: 6), AsOpponent([BacklashToRingside(who: You, n: 6)])],
        ),
        "Unbreakable Chain": (
            on_opponent_reverses: [
                If(
                    condition: OpponentReversed(Trait(Chain)),
                    effects: [
                        Optional([
                            SacrificeThis,
                            MoveCards(
