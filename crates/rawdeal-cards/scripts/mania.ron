        "Rolling Thunder": (
            irreversible: true,
            play_after: Some(All([Maneuver, DamageAtLeast(4), Not(Title("From the Top Rope"))])),
            play_after_unless: Some(All([FirstCardThisTurn, ReversedLastTurn(Maneuver), YouReversedFrom([Hand])])),
