        // Lita
        "Lita-sault": (
            play_after: Some(All([Maneuver, DamageAtLeast(4)])),
            bonuses: [(per: Some(AnyOf([TitleContains("Hurricanrana"), TitleContains("Moonsault")])), damage: 3)],
