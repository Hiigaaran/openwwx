// Hand-written scripts for Mania cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
(
    abilities: {
        "Big Show": [
            CannotPackMatching(ManeuverType(HighRisk)),
            PlayCost(filter: All([Maneuver, EarlierThisTurn(filter: Maneuver, n: 1)]), discard: 2),
            OpponentDamageCap(filter: ManeuverType(Grapple), max: 3),
        ],
        "Lita": [
            CannotPackMatching(All([ManeuverType(Grapple), DamageAtLeast(4)])),
            CardFortitude(title: "Drop Kick", delta: -100),
            Activated(
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [Search(filter: AnyOf([TitleContains("dropkick"), TitleContains("drop kick")]))],
            ),
            FortitudeFor(filter: All([Maneuver, Holds(FortitudeAboveOpponent)]), delta: -5),
        ],
        // Chair Shot is still Heel, and the extra Mid-match slots are not supported yet.
        "Rob Van Dam": [
            Activated(
                cost: [DiscardMatching(who: You, n: 1, filter: AnyOf([ManeuverType(Strike), ManeuverType(HighRisk)]), pick: Chosen)],
                effects: [
                    Counted(
                        count: LastDiscardedFortitude,
                        effect: Boost((
                            applies_to: AnyOf([ManeuverType(Strike), ManeuverType(HighRisk)]),
                            duration: NextCard,
                            fortitude: -1,
                        )),
                    ),
                ],
            ),
        ],
        "Booker T": [
            CardFortitude(title: "Don't Hate da Playa, Hate da Game!", delta: -3),
            StartOfTurn([
                If(
                    condition: FortitudeAboveOpponent,
                    effects: [Optional([RingsideToArsenalBottom(who: You, n: 2)])],
                ),
            ]),
        ],
        // "Hand cards" are read as maneuvers.
        "APA": [
            DamageFor(filter: Maneuver, delta: 1),
            CannotPlayMatching(All([Action, Not(SuperstarSpecific), Not(Trait(MidMatch))])),
            CannotPack("White Wedding"),
            CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))])),
        ],
        // The Mid-match limit is not changed.
        "Spike Dudley": [
            CannotPackMatching(All([AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]), DamageAtLeast(4)])),
            CannotPackMatching(All([Trait(SetUp), Not(Title("From the Top Rope"))])),
            DrawSegmentOption([Draw(who: You, n: 1), DrawUpTo(who: You, n: 2)]),
        ],
        "William Regal": [
            Activated(
                cost: [],
                effects: [
                    Search(
                        filter: AnyOf([
                            Title("Commission-er Rules!"),
                            Title("Great Technical Knowledge"),
                            Title("Who Booked This Match?"),
                            Title("Charismatic Style"),
                            Title("Drawing Extra Heat"),
                            Title("Apply Illegal Leverage"),
                        ]),
                    ),
                ],
            ),
            CardFortitude(title: "Brass 'Nuks' Shot", delta: -3),
        ],
        "Raven": [
            OnPlayMatching(filter: Maneuver, effects: [Mill(who: You, n: 1)]),
            OnOpponentPlayMatching(filter: Maneuver, effects: [Optional([Draw(who: You, n: 1)])]),
        ],
    },
    scripts: {
        // High Risk
        "Spinning Crescent Kick": (
            play_after: Some(Maneuver),
            on_play: [
                If(
                    condition: AnyOf([Superstar("X-Pac"), Superstar("Lita"), Superstar("Rob Van Dam"), Superstar("Tajiri")]),
                    effects: [Discard(who: Opponent, n: 1, pick: Chosen)],
                ),
            ],
        ),
        "Flying Reverse Elbow": (
            play_after: Some(Title("From the Top Rope")),
            on_play: [Discard(who: You, n: 1, pick: Chosen)],
            as_action: Some((fortitude: Some(0), on_play: [DiscardThis, Draw(who: You, n: 1)])),
        ),
        // Its text names nothing to reverse.
        "Flying Tope": (
            play_after: Some(AnyOf([All([Maneuver, DamageAtLeast(5)]), Title("Throw Opponent Out of the Ring")])),
            on_play: [DiscardMirror(max: 10)],
            reverses: Some((targets: Not(Any))),
        ),
        "Stackplex": (
            only_packed_by: ["Tag Team"],
            bonuses: [(when: AnyOf([Superstar("Dudley Boyz"), Superstar("Edge and Christian")]), fortitude: -7)],
            play_after: Some(AnyOf([All([Maneuver, DamageAtLeast(5)]), Title("Throw Into the Corner Turnbuckle")])),
            on_play: [HandToArsenalTop(who: Opponent, n: 2)],
            reverses: Some((targets: AnyOf([Title("Superplex"), Title("From the Top Rope")]))),
        ),
        "Asai Moonsault": (
            play_after: Some(All([Maneuver, DamageAtLeast(5)])),
            on_reversed_from_hand: [RevealHand(who: You)],
        ),

        // Strikes
        "Forearm Shot": (
            on_play: [
                Boost((applies_to: All([Maneuver, StunValueAtLeast(1)]), duration: NextCard, reversal_fortitude: 5)),
            ],
        ),
        "Feign Strike": (
            on_play: [Discard(who: Opponent, n: 2, pick: Chosen)],
            on_reversed_from_hand: [
                Choice([[Draw(who: You, n: 1)], [RemoveFromRing(who: Opponent, n: 1, filter: Action)]]),
            ],
        ),
        "Gut Punch": (
            on_play: [
                Choice([
                    [],
                    [
                        Discard(who: You, n: 1, pick: Chosen),
                        RemoveFromRing(who: Opponent, n: 1, filter: Not(Maneuver)),
                    ],
                    [
                        Discard(who: You, n: 2, pick: Chosen),
                        RemoveFromRing(who: Opponent, n: 2, filter: Not(Maneuver)),
                    ],
                    [
                        Discard(who: You, n: 3, pick: Chosen),
                        RemoveFromRing(who: Opponent, n: 3, filter: Not(Maneuver)),
                    ],
                ]),
            ],
        ),
        "Step on Opponent's Noggin": (
            play_after: Some(ManeuverType(Grapple)),
            not_reversed_by: Some(Title("Backlash!")),
            on_play: [HandToArsenalTop(who: Opponent, n: 1, random: true)],
        ),
        "Into the Barricade": (
            play_after: Some(
                AnyOf([
                    Title("Roll Out of the Ring"),
                    Title("Throw Opponent Out of the Ring"),
                    Title("Over the Top Rope"),
                    Title("Airplane Spin"),
                    Title("Giant Swing"),
                    All([Maneuver, After(Title("Irish Whip"))]),
                ]),
            ),
            on_play: [Optional([RingsideToArsenal(who: You, n: 3, up_to: true)])],
            reverses: Some((targets: AnyOf([Title("Suicide Plancha"), Title("Flying Tope")]))),
        ),
        // The "first card of the game" part is not supported yet.
        "Pump Kick": (requires: Some(Not(Superstar("Brothers of Destruction")))),

        // Grapples
        // Approximation: the next card may ignore any "can only be played after" text.
        "Catapult": (
            play_after: Some(All([Maneuver, DamageAtLeast(3)])),
            not_reversed_by: Some(Title("Backlash!")),
            on_play: [
                Discard(who: Opponent, n: 1, pick: Chosen),
                Boost((applies_to: Any, duration: NextCard, ignore_play_after: true)),
            ],
        ),
        "Within Your Grasp": (
            on_play: [Optional([RemoveFromRing(who: Opponent, n: 1, filter: Action)])],
            on_reversed_from_hand: [Discard(who: Opponent, n: 2, pick: Chosen)],
        ),
        "Butterfly Suplex": (
            before_reversal: [
                If(
                    condition: Superstar("Chris Jericho"),
                    effects: [Optional([Discard(who: You, n: 3, pick: Chosen), IrreversibleThis])],
                ),
            ],
        ),
        "Beal Toss": (
            play_after: Some(Title("Throw Into the Corner Turnbuckle")),
            reverses: Some((targets: Title("Throw Into the Corner Turnbuckle"))),
        ),
        "Backslide": (
            play_after: Some(All([Maneuver, DamageAtLeast(5)])),
            on_play: [If(condition: AnyOf([FortitudeLeadAtLeast(20), RingStunLeadAtLeast(5)]), effects: [WinByPin])],
            reverses: Some((targets: ManeuverType(Strike))),
        ),
        "Tandem Flapjack": (
            only_packed_by: ["Tag Team"],
            on_play: [RingsideToArsenalBottom(who: You, n: 1), Search(filter: Action)],
        ),
        "Running Bulldog": (
            irreversible_when: Some(After(All([Maneuver, DamageAtLeast(8)]))),
            on_play: [
                If(
                    condition: AnyOf([Superstar("Chris Jericho"), Superstar("Raven")]),
                    effects: [Optional([Draw(who: You, n: 1)])],
                ),
            ],
        ),

        // Submissions
        "Short Arm Hammerlock": (on_play: [HandToArsenalTop(who: You, n: 1)]),
        "Knee Bar": (
            on_play: [
                Optional([Search(filter: Title("Workin' on the Knee"))]),
                Boost((applies_to: Title("Workin' on the Knee"), duration: NextCard, no_hand_reversal: true)),
            ],
        ),
        "Strangle Hold": (
            play_after: Some(Maneuver),
            on_play: [
                Discard(who: Opponent, n: 2, pick: Chosen),
                NextCardMustBe(Not(AnyOf([Title("Maintain Hold"), Title("Apply Illegal Leverage")]))),
            ],
            reverses: Some((
                targets: AnyOf([ManeuverType(Submission), Title("Clutch onto Opponent")]),
                from_hand_only: true,
            )),
        ),
        "Arm Grapevine": (
            play_after: Some(Maneuver),
            not_reversed_by: Some(Title("Backlash!")),
            on_play: [Optional([Search(filter: Title("Guillotine Stretch"))])],
        ),
        // "Can be reversed by Clean Break" is not supported yet.
        "Indian Deathlock": (
            play_after: Some(Maneuver),
            not_reversed_by: Some(Title("Backlash!")),
            reverses: Some((targets: ManeuverType(Submission))),
        ),

        // Actions
        "All Talk, No Action!": (
            reverses: Some((targets: Action)),
            restricts_self: Some((filter: All([Action, Not(Trait(MidMatch))]))),
        ),
        "Iron Will": (
            not_packed_by: ["The Rock"],
            on_play: [
                DiscardThis,
                RingsideToArsenal(who: You, n: 2, up_to: true, filter: Some(Not(Title("Iron Will")))),
                Draw(who: You, n: 1),
            ],
            reverses: Some((
                targets: AnyOf([
                    Title("Sleeper"),
                    Title("Claw"),
                    Title("Clutch onto Opponent"),
                    Title("Apply Illegal Leverage"),
                    Title("Indian Deathlock"),
                    Title("Test of Strength"),
                ]),
                overturned_only: true,
            )),
        ),
        "Not Today, Pal!": (
            reverses: Some((
                targets: AnyOf([
                    All([Trait(MidMatch), Not(Trait(Unique)), AnyOf([Maneuver, Action])]),
                    TitleContains("J.R."),
                ]),
            )),
        ),
        // Approximation: the opponent never names the top card.
        "Out Think the Fink": (on_play: [Mill(who: Opponent, n: 3)]),
        // Approximation: you look at the top 5 cards, whatever the overturned card's F.
        "Stratusfied": (on_play: [Mill(who: You, n: 1), Dig(n: 5, take: 1), Shuffle(who: You)]),
        "Got Wood?": (
            on_play: [
                If(
                    condition: AnyOf([
                        Superstar("Dudley Boyz"),
                        Superstar("Buh-Buh Ray Dudley"),
                        Superstar("D-Von Dudley"),
                    ]),
                    effects: [RingsideToHand(who: You, n: 2, up_to: true, filter: Some(Keyword("Foreign Object")))],
                ),
                If(
                    condition: Not(
                        AnyOf([
                            Superstar("Dudley Boyz"),
                            Superstar("Buh-Buh Ray Dudley"),
                            Superstar("D-Von Dudley"),
                        ]),
                    ),
                    effects: [RingsideToHand(who: You, n: 1, filter: Some(Keyword("Foreign Object")))],
                ),
            ],
        ),
        // Stopping Arsenal searches is not supported yet.
        "Playing by the Rules": (requires: Some(Never)),
        "Kay-Fabe": (
            on_play: [
                Choice([[Arrange(who: You, n: 5)], [Shuffle(who: You)]]),
                LookAtHand(who: Opponent),
                Optional([ShuffleHandAndRedraw(who: Opponent)]),
                Choice([[Arrange(who: Opponent, n: 5)], [Shuffle(who: Opponent)]]),
            ],
        ),
        // Approximation: reverses any card that lets the opponent draw.
        "Totally Bogus!": (
            on_play: [Discard(who: You, n: 3, pick: Chosen), DrawUpTo(who: You, n: 3)],
            reverses: Some((targets: All([AnyOf([Maneuver, Action]), Draws]), from_hand_only: true)),
        ),
        "Little She Devil": (
            only_packed_by: ["Tag Team"],
            on_play: [
                Choice([
                    [
                        Counted(
                            count: YourFortitude,
                            effect: Boost((applies_to: Maneuver, duration: NextMatching, reversal_fortitude: 1)),
                        ),
                    ],
                    [DiscardThis, DrawUpTo(who: You, n: 3)],
                ]),
            ],
        ),
        "Gut Wrench": (
            on_play: [
                RingsideToHand(who: You, n: 1, filter: Some(ManeuverType(Grapple))),
                Boost((applies_to: ManeuverType(Grapple), duration: NextCard, reversal_fortitude: 10)),
            ],
            reverses: Some((
                targets: Title("Gut Wrench"),
                effects: [
                    Discard(who: Opponent, n: 1, pick: Chosen),
                    NextTurnAfterThis,
                    Boost((applies_to: ManeuverType(Grapple), duration: NextTurnFirstCard, reversal_fortitude: 15)),
                ],
            )),
        ),
        // Discarding the hand unless a High Risk maneuver follows is not enforced.
        "X-treme Measures": (
            on_play: [
                If(
                    condition: Not(
                        AnyOf([
                            Superstar("Hardy Boyz"),
                            Superstar("Matt Hardy"),
                            Superstar("Jeff Hardy"),
                            Superstar("Lita"),
                        ]),
                    ),
                    effects: [Discard(who: You, n: 1, pick: Chosen)],
                ),
                Boost((applies_to: All([Maneuver, DamageAtMost(6)]), duration: NextCard, irreversible: true)),
            ],
        ),
        // Approximation: you choose after looking, without naming first.
        "Cole Calls It Right!": (
            on_play: [LookAtHand(who: Opponent), Discard(who: Opponent, n: 1, pick: Controller)],
        ),
        // Ignoring "face" on Kissing Up to the Stinkin' Fans is not supported yet.
        "Trailer Park Trash!": (
            on_play: [
                Optional([RingsideToHand(who: You, n: 1, filter: Some(Not(Trait(Unique))))]),
                AsOpponent([Optional([RingsideToHand(who: You, n: 1, filter: Some(Not(Trait(Unique))))])]),
            ],
        ),
        // Changing Disqualification!'s text is not supported yet.
        "Veteran Referee: Tim White": (requires: Some(Never)),
        "Daddy's Little Girl": (
            requires: Some(
                Not(
                    AnyOf([
                        OpponentSuperstar("Triple H"),
                        OpponentSuperstar("Stephanie McMahon-Helmsley"),
                        OpponentSuperstar("Vince McMahon"),
                    ]),
                ),
            ),
            on_play: [
                Counted(count: OpponentRingMatching(Trait(Face)), effect: Mill(who: Opponent, n: 0)),
                DamageSuperstarValue(who: Opponent),
            ],
        ),
        "Messing With the Champ": (
            requires: Some(All([OpponentRingHas(filter: TitleBelt, n: 1), Not(InYourRing(TitleBelt))])),
            on_play: [
                RemoveFromRing(who: Opponent, n: 1, filter: TitleBelt),
                OpponentChooses(n: 1, options: [[Discard(who: Opponent, n: 2, pick: Chosen)], [DrawUpTo(who: You, n: 2)]]),
            ],
        ),
        "Everybody Wants (and Needs) a ... Snow Job?": (
            requires: Some(Not(OpponentSuperstar("Al Snow"))),
            irreversible_when: Some(Superstar("Al Snow")),
            on_play: [
                Discard(who: You, n: 3, pick: Chosen),
                LookAtHand(who: Opponent),
                Choice([
                    [Counted(count: OpponentRingStun, effect: DrawUpTo(who: You, n: 0))],
                    [
                        Counted(
                            count: OpponentRingMatching(StunValueAtLeast(1)),
                            effect: RemoveFromRing(who: Opponent, n: 0, filter: StunValueAtLeast(1)),
                        ),
                        DiscardAll(who: Opponent, filter: StunValueAtLeast(1)),
                    ],
                ]),
            ],
        ),
        "Wooden Palette": (
            on_play: [Mill(who: You, n: 1)],
            ring_ability: Some((
                sacrifice: true,
                effects: [
                    Boost((
                        applies_to: ManeuverType(Grapple),
                        duration: NextMatching,
                        damage: 4,
                        no_backlash_reversal: true,
                    )),
                ],
            )),
        ),
        "Judgment Day": (
            not_reversed_by: Some(Title("No Chance in Hell!")),
            on_play: [
                Choice([
                    [
                        Counted(
                            count: YourRingMatching(AnyOf([Trait(Face), Trait(Heel)])),
                            effect: RingsideToArsenal(who: You, n: 0),
                        ),
                    ],
                    [
                        Counted(
                            count: OpponentRingMatching(AnyOf([Trait(Face), Trait(Heel)])),
                            effect: Mill(who: Opponent, n: 0),
                        ),
                    ],
                ]),
            ],
        ),
        "Mania": (on_play: [WinGame]),
        // Reacting when your hand is revealed (to hide cards under it) is not supported yet.
        "Torrie Wilson, On It!": (reverses_from_ring: Some((targets: All([Action, Trait(Heel)]), fortitude: Some(0)))),
        // Approximation: the up to 2 cards go under it in one go, while none of your cards has cards under it.
        "Keibler's Cookies": (
            ring_ability: Some((
                requires: Some(CountAtMost(count: YourUnderSize, n: 0)),
                effects: [PutUnder(from: Hand, n: 2, up_to: true)],
            )),
            play_from_under: Some(Any),
        ),
        "V.K.M.'s Patented Big Gulp": (
            requires: Some(All([Not(Superstar("The Rock")), FortitudeBelowOpponent])),
            on_play: [
                Counted(count: HandSize, effect: RingsideToArsenal(who: You, n: 0)),
                DiscardAll(who: You, filter: Any),
            ],
            reverses: Some((
                targets: Maneuver,
                from_hand_only: true,
                requires: Some(All([Not(Superstar("The Rock")), FortitudeBelowOpponent])),
                on_reverse: [DiscardAll(who: You, filter: Any)],
            )),
        ),
        "Money Talks, 'BS' Walks!": (
            on_play: [
                RemoveFromRing(who: Opponent, n: 1, filter: Action),
                Boost((applies_to: Maneuver, duration: NextCard, no_backlash_reversal: true)),
            ],
        ),
        "Ring Rats": (
            on_play: [
                If(
                    condition: Not(
                        AnyOf([
                            Superstar("Chyna"),
                            Superstar("Two-Man Power Trip"),
                            Superstar("Brothers of Destruction"),
                        ]),
                    ),
                    effects: [
                        Counted(count: SuperstarValue, effect: DrawUpTo(who: You, n: 0)),
                        Counted(count: YourRingStun, effect: DrawUpTo(who: You, n: 0)),
                    ],
                ),
                AsOpponent([
                    If(
                        condition: Not(
                            AnyOf([
                                Superstar("Chyna"),
                                Superstar("Two-Man Power Trip"),
                                Superstar("Brothers of Destruction"),
                            ]),
                        ),
                        effects: [Counted(count: SuperstarValue, effect: DrawUpTo(who: You, n: 0))],
                    ),
                ]),
                Counted(count: SuperstarValue, effect: Discard(who: You, n: 0, pick: Chosen)),
                AsOpponent([Counted(count: SuperstarValue, effect: Discard(who: You, n: 0, pick: Chosen))]),
            ],
        ),
        "Billion Dollar Princess": (
            requires: Some(All([Not(OpponentSuperstar("Stephanie McMahon-Helmsley")), RingStunValueGreater])),
            on_play: [Search(filter: SuperstarSpecific, n: 3, up_to: true), EndTurn],
        ),
        "Unforgiven": (
            requires: Some(Not(AnyOf([Superstar("Two-Man Power Trip"), Superstar("The Rock")]))),
            on_play: [Search(filter: ManeuverType(TrademarkFinisher))],
            restricts_opponent: Some((
                when: RingStunValueGreater,
                filter: Title("When You Thought You Had All the Answers ..."),
            )),
        ),
        "Ring Steps": (
            on_play: [Discard(who: You, n: 1, pick: Chosen), Mill(who: You, n: 2), EndTurn],
            ring_ability: Some((
                sacrifice: true,
                effects: [
                    AsOpponent([
                        Choice([
                            [DiscardMatching(who: You, n: 1, filter: Title("Step Aside"), pick: Chosen)],
                            [Discard(who: You, n: 5, pick: Chosen), Mill(who: You, n: 10)],
                        ]),
                    ]),
                ],
            )),
        ),
        "No Way Out": (
            while_in_ring: [(applies_to: All([Maneuver, Holds(FortitudeAboveOpponent)]), no_hand_reversal: true)],
            in_ring_start_of_turn: [If(condition: FortitudeAtMostOpponent, effects: [SacrificeThis])],
        ),

        // Pre-match
        // That it cannot be removed from your Ring is not enforced.
        "Superior Training": (
            requires: Some(InYourRing(Title("Study the Tapes"))),
            on_play: [Mill(who: You, n: 3)],
            mid_match_limit: 2,
        ),
        // Who goes first on a tie is not changed.
        "Slandered Online": (on_play: [RemoveFromRing(who: Opponent, n: 1, filter: Title("Fans Love an Underdog"))]),
        // A Superstar Value change that depends on your own Value and on the opponent's Face cards is not supported yet.
        "Product Endorsements": (requires: Some(Never)),
        "Backstage Ambush Attempt": (
            on_play: [
                Shuffle(who: You),
                Counted(count: TopArsenalDamage, effect: Mill(who: Opponent, n: 0)),
                Shuffle(who: You),
            ],
        ),
        // Disqualification! still works when overturned.
        "No Disqualification Match": (
            while_in_ring_all: [(applies_to: AnyOf([Keyword("Foreign Object"), Keyword("Run-in")]), fortitude: -3)],
            restricts_self: Some((filter: AnyOf([Title("Disqualification!"), Title("Hebner Calls It")]))),
            restricts_opponent: Some((filter: AnyOf([Title("Disqualification!"), Title("Hebner Calls It")]))),
        ),
        // The Spectacular Ring Entrance part is not supported yet.
        "Personal Appearance": (
            value_bonus: 1,
            ring_ability: Some((
                requires: Some(InYourRing(Title("Here a Mark, There a Mark, Everywhere a Mark Mark..."))),
                sacrifice: true,
                effects: [Choice([[Arrange(who: You, n: 5)], [Shuffle(who: You)]])],
            )),
        ),
        // The exception for an opponent with a Pre-match Heel card is not checked.
        "Snubbed by the Fans": (opponent_value_bonus: 1),
        // Stopping a Victory Condition by discarding the hand is not supported yet.
        "Not Done with Any Flair": (on_play: [Mill(who: You, n: 3)], pre_match_limit: 1),
        // Only you can use its ability, and the Dem Damn Dudleyz! part is not supported yet.
        "Chicago Street Fight": (
            on_play: [Mill(who: You, n: 3)],
            ring_ability: Some((
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [RingsideToHand(who: You, n: 1, filter: Some(Keyword("Foreign Object")))],
            )),
        ),
        // The pin victory is on the Touch Turnbuckle cards.
        "Four Corners Match": (pre_match_limit: 1, mid_match_limit: 1),
        // Moving cards from Ringside piles is not blocked yet.
        "Hell in a Cell Match": (
            restricts_self: Some((filter: Keyword("Run-in"))),
            restricts_opponent: Some((filter: Keyword("Run-in"))),
        ),
        "Indian Strap Match": (requires: Some(Never)),
        // Approximation: the count out part can be used at any time.
        "Duchess of Queensbury Rules": (
            ring_ability: Some((
                sacrifice: true,
                effects: [
                    Choice([
                        [RemoveFromRing(who: Opponent, n: 1, filter: Title("Hell in a Cell Match"))],
                        [
                            If(
                                condition: Superstar("William Regal"),
                                effects: [RingsideToArsenal(who: You, n: 12, up_to: true)],
                            ),
                            If(
                                condition: Not(Superstar("William Regal")),
                                effects: [RingsideToArsenal(who: You, n: 8, up_to: true)],
                            ),
                            EndTurn,
                        ],
                    ]),
                ],
            )),
        ),
        // Approximation: the face-up hand is shown once, and the smaller Mid-match limit is not an option.
        "Handicap Match": (
            only_packed_by: ["Tag Team"],
            end_of_prematch: [OpponentChooses(n: 1, options: [[RevealHand(who: Opponent)], [Mill(who: Opponent, n: 10)]])],
        ),
        "Signed Contract with Linda McMahon": (
            ring_ability: Some((
                requires: Some(InYourRing(Title("V.K.M.'s Patented Big Gulp"))),
                sacrifice: true,
                effects: [Counted(count: OpponentHandExcess, effect: Discard(who: Opponent, n: 0, pick: Chosen))],
            )),
        ),

        // Mid-match
        "Fortitude Surge": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        "Fan Appreciation Day!": (
            on_play: [
                RingsideToArsenal(who: You, n: 2, up_to: true),
                Counted(count: SuperstarValue, effect: Boost((applies_to: Any, duration: NextCard, fortitude: -1))),
            ],
        ),
        "Here Comes the Money!": (
            reverses: Some((
                targets: Keyword("Run-in"),
                requires: Some(All([Not(OpponentSuperstar("Shane McMahon")), Not(Superstar("The Rock"))])),
                effects: [
                    If(condition: Superstar("Shane McMahon"), effects: [DrawUpTo(who: You, n: 2)]),
                    If(condition: Not(Superstar("Shane McMahon")), effects: [Optional([Draw(who: You, n: 1)])]),
                ],
            )),
        ),
        "Remove Corner Turnbuckle": (
            on_play: [Optional([RemoveFromRing(who: Opponent, n: 1, filter: TitleContains("Touch Turnbuckle"))]), EndTurn],
            reverses: Some((targets: TitleContains("Touch Turnbuckle"))),
            in_ring_on_play: [
                (filter: Title("Throw Into the Corner Turnbuckle"), effects: [Mill(who: Opponent, n: 5), SacrificeThis]),
            ],
        ),
        "Over the Barricade": (
            reverses: Some((
                targets: AnyOf([
                    Title("Suicide Plancha"),
                    All([
                        Maneuver,
                        AnyOf([
                            After(Title("Roll Out of the Ring")),
                            After(Title("Throw Opponent Out of the Ring")),
                            After(Title("Over the Top Rope")),
                        ]),
                    ]),
                ]),
                requires: Some(
                    Not(
                        AnyOf([
                            InYourRing(Title("Hell in a Cell Match")),
                            OpponentRingHas(filter: Title("Hell in a Cell Match"), n: 1),
                        ]),
                    ),
                ),
            )),
        ),
        // Approximation: Touch Turnbuckles go back to the Backlash deck from the Ringside pile
        // with a once-per-turn Ringside ability, not right away.
        "Touch Turnbuckle #1": (
            ringside_ability: Some((effects: [ReturnThis(to: Backlash)])),
            requires: Some(
                All([
                    InYourRing(Title("Four Corners Match")),
                    ReversedLastTurn(Maneuver),
                    YouReversedFrom([Hand]),
                    FirstCardThisTurn,
                ]),
            ),
            on_play: [
                Optional([RingsideToArsenal(who: You, n: 2)]),
                If(
                    condition: All([
                        InYourRing(Title("Touch Turnbuckle #2")),
                        InYourRing(Title("Touch Turnbuckle #3")),
                        InYourRing(Title("Touch Turnbuckle #4")),
                    ]),
                    effects: [WinByPin],
                ),
            ],
        ),
        "Touch Turnbuckle #2": (
            ringside_ability: Some((effects: [ReturnThis(to: Backlash)])),
            play_after: Some(Maneuver),
            requires: Some(All([InYourRing(Title("Four Corners Match")), FortitudeAboveOpponent])),
            on_play: [
                Optional([Draw(who: You, n: 1)]),
                If(
                    condition: All([
                        InYourRing(Title("Touch Turnbuckle #1")),
                        InYourRing(Title("Touch Turnbuckle #3")),
                        InYourRing(Title("Touch Turnbuckle #4")),
                    ]),
                    effects: [WinByPin],
                ),
            ],
        ),
        "Touch Turnbuckle #3": (
            ringside_ability: Some((effects: [ReturnThis(to: Backlash)])),
            mid_match_limit: 1,
            requires: Some(
                All([
                    InYourRing(Title("Four Corners Match")),
                    LastPlayedThisTurn(filter: Maneuver, n: 2),
                    FortitudeAboveOpponent,
                ]),
            ),
            on_play: [
                If(
                    condition: All([
                        InYourRing(Title("Touch Turnbuckle #1")),
                        InYourRing(Title("Touch Turnbuckle #2")),
                        InYourRing(Title("Touch Turnbuckle #4")),
                    ]),
                    effects: [WinByPin],
                ),
            ],
        ),
        "Touch Turnbuckle #4": (
            ringside_ability: Some((effects: [ReturnThis(to: Backlash)])),
            requires: Some(All([InYourRing(Title("Four Corners Match")), HandHas(Reversal)])),
            on_play: [
                DiscardMatching(who: You, n: 3, filter: Reversal, pick: Chosen),
                Optional([RemoveFromRing(who: Opponent, n: 1, filter: Maneuver)]),
                If(
                    condition: All([
                        InYourRing(Title("Touch Turnbuckle #1")),
                        InYourRing(Title("Touch Turnbuckle #2")),
                        InYourRing(Title("Touch Turnbuckle #3")),
                    ]),
                    effects: [WinByPin],
                ),
            ],
        ),
        // Approximation: the next card may ignore any "can only be played after" text.
        "Over the Top Rope": (
            not_reversed_by: Some(Title("Just Bring It!")),
            as_action: Some((
                requires: Some(After(AnyOf([All([Maneuver, DamageAtLeast(5)]), Title("Jockeying for Position")]))),
                on_play: [
                    Boost((applies_to: Any, duration: NextCard, ignore_play_after: true)),
                    Choice([[Discard(who: Opponent, n: 3, pick: Chosen)], [Mill(who: Opponent, n: 6)]]),
                ],
            )),
            reverses: Some((
                targets: Title("Jockeying for Position"),
                effects: [Choice([[Discard(who: Opponent, n: 3, pick: Chosen)], [Mill(who: Opponent, n: 6)]])],
            )),
        ),
        // Checking whether the opponent played a maneuver when the turn ends is not supported yet.
        "Second Wind": (requires: Some(Never)),
        "Sustained Damage": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        "Happy You're Here, Happier You're Gone": (requires: Some(Never)),
        "Test of Strength": (requires: Some(Never)),
        "Debilitating Injury: Concussion": (
            requires: Some(LastPlayedThisTurn(filter: StunValueAtLeast(1), n: 2)),
            on_play: [Discard(who: Opponent, n: 4, pick: Random)],
            in_ring_opponent_start_of_turn: [Discard(who: You, n: 1, pick: Random)],
        ),

        // Big Show
        "Final Cut": (on_play: [Discard(who: Opponent, n: 2, pick: Chosen)]),
        "Wellllllllllll!!!": (
            ring_ability: Some((
                sacrifice: true,
                effects: [
                    Boost((applies_to: AnyOf([ManeuverType(Strike), ManeuverType(Grapple)]), duration: NextCard, damage: 5)),
                    NextPlayWatch(
                        filter: AnyOf([ManeuverType(Strike), ManeuverType(Grapple)]),
