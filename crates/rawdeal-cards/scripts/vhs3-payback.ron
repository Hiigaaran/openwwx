// Hand-written scripts for VHS3: Payback (Raw Deal Virtual) cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// "Counter" = you reversed a card to end your opponent's last turn and this is your first card this turn.
// "Promo: N" is approximated as `Dig`: you keep 1 of the top N cards and the rest go on the bottom of the Arsenal.
// "Reversal: Special" cards: "Reverse any X" is the reversal target. Reversals of card effects and of Activated
// Card Effects are not supported. "Can only be reversed by D: 0 / non-Unique / hybrid cards", Stun Value changes,
// Pre-match Capacity per card, Heat, playing cards face-down, cards played "as if from hand" from the Ringside, and
// packing named cards from other sets are not supported yet. Cards under a Backstage card (and maneuvers kept in the
// Backstage Area to be played from there) are approximated as cards under your Superstar card.
// "When played from hand" on maneuvers is read as "not played from Ringside".
// "When you are unsuccessful" texts on cards use the card's Ringside trigger, checking that this card was the one
// reversed.
(
    abilities: {
        // Approximation: any non-Unique non-hybrid maneuver (not only one with another title). The Activated Card
        // Effect text and packing High-Flying Style are not supported yet.
        "AJ Styles": [
            OnOpponentReverses([
                If(
                    condition: OpponentReversed(Maneuver),
                    effects: [Optional([Search(filter: All([Not(Trait(Unique)), Not(Hybrid), Maneuver]), up_to: true)])],
                ),
            ]),
        ],
        // Approximation: the Backstage Area maneuvers are put under your Superstar card at the end of the Pre-match
        // phase and can be played from there without the discard (different titles are not checked). Only
        // non-Revolution CM Punk cards may be packed.
        "The Best Wrestler In The World": [
            EndOfPrematch([
                PutUnder(from: Arsenal, n: 5, up_to: true, filter: Some(All([Maneuver, Not(Keyword("RMS"))])), superstar: true),
            ]),
            PlayFromUnder(Maneuver),
            PacksLogos(["CM Punk"]),
            CannotPackMatching(All([SuperstarSpecific, TitleContains("Revolution")])),
        ],
        // The damage protection, the opponent's reversal draws and the extra packing texts are not supported yet.
        "Braun Strowman": [
            CannotPackTrait(Face),
            CannotPackTrait(Heel),
            CannotPackMatching(Keyword("BASH")),
            CannotPackMatching(TitleContains("In My Corner")),
        ],
        "Drew McIntyre": [
            Activated(
                cost: [],
                effects: [
                    Counted(count: HandSize, effect: Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -1))),
                    MoveCards(who: You, from: Hand, to: Arsenal, n: 30),
                    Draw(who: You, n: 4),
                    MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Random, bottom: true),
                    Mill(who: Opponent, n: 1),
                ],
                requires: Some(HandAtLeast(5)),
            ),
        ],
        // Approximation: any card removed from the game that is not Mid-match. The Heat texts are not supported yet.
        "Jinder Mahal": [
            Activated(
                cost: [RemoveFromGame(who: You, from: Ringside, n: 1)],
                effects: [MoveCards(who: You, from: Removed, to: Ringside, n: 1, up_to: true, filter: Some(Not(Trait(MidMatch))))],
                requires: Some(CountAtLeast(count: YourRingsideSize, n: 1)),
            ),
        ],
        // Playing From the Top Rope as an irreversible Counter is not supported yet.
        "Bayley": [
            OnOpponentPlayMatching(
                filter: All([Not(Reversal), DamageAtLeast(1)]),
                effects: [
                    RingsideToHand(
                        who: You,
                        n: 1,
                        up_to: true,
                        filter: Some(AnyOf([All([Maneuver, Not(Reversal)]), Trait(SetUp)])),
                    ),
                ],
            ),
        ],
        // Approximation: the 'reversed' text exception is not checked. The extra packing texts are not supported yet.
        "Natalya": [
            Activated(
                cost: [Discard(who: You, n: 2, pick: Chosen)],
                effects: [
                    Boost((applies_to: AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]), duration: NextCard, multi: true)),
                ],
            ),
            CannotPack("There Is No Escape"),
        ],
        // Approximation: the overturn when the opponent plays a maneuver and the single-reversal limit are not
        // supported yet; only the Title Belt packing rule is scripted.
        "Gallows and Anderson": [CannotPackMatching(All([TitleBelt, Not(TitleContains("Tag Team"))]))],
    },
    scripts: {
        // AJ Styles
        // The Pre-match Capacity, Stun Value, Ringside play and damage-limit texts are not supported yet.
        "The Phenomenal One": (),
        // Approximation: -2F (this card and one more AJ Styles card). The ACE puts it into the Ringside pile.
        "The Champ That Runs The Camp": (
            while_in_ring: [(applies_to: All([Not(Trait(Unique)), ManeuverType(HighRisk)]), fortitude: -2)],
            ring_ability: Some((
                requires: Some(FirstCardThisTurn),
                effects: [Boost((applies_to: ManeuverType(HighRisk), duration: NextCard, ignore_play_after: true))],
                sacrifice: true,
            )),
        ),
        // The Springboard and Ability texts are not supported yet. The second ACE is scripted.
        "They Don't Want None": (
            ring_ability: Some((
                requires: Some(HandHas(All([SuperstarSpecific, Maneuver]))),
                cost: [MoveCards(who: You, from: Hand, to: Arsenal, n: 1, filter: Some(All([SuperstarSpecific, Maneuver])), bottom: true)],
                effects: [
                    MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, filter: Some(Not(Reversal)), bottom: true),
                    Draw(who: You, n: 1),
                ],
            )),
        ),
        // Going to the Backlash is not supported yet.
        "AJ's Phenomenal Combination": (mid_match_limit: 1, reversals_needed: 3),
        // Ignoring the opponent's 'psychology' cards is not supported yet.
        "Ain't Nobody Breakin' This Redneck": (reverses: Some((targets: AnyOf([TitleContains("break"), Not(Maneuver)])))),
        // The Backlash discard to reverse it is not supported yet.
        "Phenomenal Dropkick": (
            play_after: Some(Any),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
        ),
        "Phenomenal Forearm": (
            play_after: Some(All([Maneuver, DamageAtLeast(5)])),
            play_after_unless: Some(All([ReversedLastTurn(DamageAtLeast(5)), FirstCardThisTurn])),
            on_play: [
                If(
                    condition: Not(InYourRing(ManeuverType(TrademarkFinisher))),
                    effects: [Choice([[DrawUpTo(who: You, n: 1)], [RingsideToHand(who: You, n: 1, up_to: true)]])],
                ),
                If(
                    condition: InYourRing(ManeuverType(TrademarkFinisher)),
                    effects: [Choice([[DrawUpTo(who: You, n: 2)], [RingsideToHand(who: You, n: 2, up_to: true)]])],
                ),
            ],
        ),
        "AJ's Pele Kick": (
            bonuses: [(fortitude: -10)],
            reverses: Some((targets: AnyOf([ManeuverType(HighRisk), After(Trait(SetUp))]))),
        ),
        // It is printed Multi (2 Reversals). The Maintain Hold text is not supported yet.
        "Calf Crusher": (reversal_limits: [(by: Some(DamageAtLeast(1)))]),
        // Approximation: "ignore any reversal restrictions" reverses cards that cannot be reversed. The Ringside text
        // is not supported yet.
        "Styles Clash": (
            reversal_limits: [(from: [Arsenal], when: CountAtLeast(count: YourRingMatching(ManeuverType(TrademarkFinisher)), n: 2))],
            reverses: Some((targets: TitleContains("rana"), ignores_irreversible: true, ignores_limits: true)),
        ),
        // The removed-from-the-game text is not supported yet.
        "I Am Phenomenal": (reverses: Some((targets: Any))),

        // CM Punk (The Best Wrestler In The World)
        // Packing Backed by Paul Heyman, the Fortitude Rating and Luck is for Losers texts are not supported yet.
        "It's Clobberin' Time!": (
            backstage_ability: Some((
                requires: Some(HandAtLeast(1)),
                cost: [Discard(who: You, n: 1, pick: Chosen)],
                effects: [RingsideToArsenal(who: You, n: 2, up_to: true, filter: Some(All([Maneuver, Not(Reversal)])))],
            )),
        ),
        // Approximation: only 'Heyman' cards in your Ring count; the Promo is for maneuvers with 'shoot' in the
        // title. The draw during the opponent's turn is not supported yet.
        "The Second City Saint": (
            backstage_abilities: [
                FortitudeFor(
                    filter: All([SuperstarSpecific, AnyOf([Maneuver, Action]), Holds(Not(InYourRing(TitleContains("Heyman"))))]),
                    delta: -5,
                ),
                OnPlayMatching(filter: All([Maneuver, TitleContains("shoot")]), effects: [Optional([Dig(n: 2, take: 1)])]),
            ],
        ),
        // Approximation: only 'Heyman' cards in your Ring count. Hiding Backstage cards and the draws per CM Punk
        // card are not supported yet.
        "Cult of Personality": (
            bonuses: [(when: Not(InYourRing(TitleContains("Heyman"))), fortitude: -5)],
            on_play: [
                RingsideToHand(who: You, n: 2, up_to: true),
                Choice([
                    [Counted(count: Plus(YourRemoved, YourRemoved), effect: Boost((applies_to: Maneuver, duration: NextMatching, reversal_fortitude: 1)))],
                    [Counted(count: Plus(YourRemoved, YourRemoved), effect: Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -1)))],
                ]),
            ],
        ),
        "Punk's Shoot Roundhouse Kick": (
            bonuses: [(fortitude: -3, damage: 3)],
            reverses: Some((
                targets: AnyOf([TitleContains("BASH"), TitleContains("precision"), TitleContains("shoot"), TitleContains("technical")]),
            )),
        ),
        "Punk's Shoot Knee Strike": (
            not_packed_by: ["New Nexus"],
            reversals_needed: 2,
            reversals_needed_when: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            reversal_limits: [(by: Some(DamageAtLeast(1)), when: All([ReversedLastTurn(Any), FirstCardThisTurn]))],
            reverses_ace: Some(()),
            bonuses: [(fortitude: -5)],
            reverses: Some((targets: ManeuverType(Strike))),
        ),
        // Approximation: never played from the Backstage Area, so it cannot be reversed from hand.
        "Punk's Springboard Lariat": (
            play_after: Some(Maneuver),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            reversal_limits: [(from: [Hand])],
        ),
        // The hand text is not supported yet.
        "Savage Flying Elbow Drop": (
            not_packed_by: ["New Nexus"],
            play_after: Some(All([Maneuver, DamageAtLeast(6)])),
            play_after_unless: Some(All([ReversedLastTurn(DamageAtLeast(5)), FirstCardThisTurn])),
            reversal_limits: [(from: [Hand, Backlash, Ringside, Ring, Under], when: After(AnyOf([Maneuver, Title("From the Top Rope")])))],
        ),
        // The Rock-specific cards and the ACE are not supported yet.
        "Your Arms Are Just Too Short to Box With God": (
            not_packed_by: ["New Nexus"],
            reverses: Some((targets: All([SuperstarSpecific, Maneuver]))),
        ),
        // The overturned text is not supported yet.
        "My Addiction Is Wrestling": (
            on_play: [ShuffleThisIntoArsenal, RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Maneuver, Not(Hybrid)])))],
        ),

        // Braun Strowman
        // Not counting the opponent's cards for his Fortitude and the damage reversal are not supported yet.
        "The Black Sheep Mask": (),
        // Approximation: hiding it after a D: 8+ maneuver is its once-per-turn ability. Keeping the other maneuvers
        // on the bottom is the Promo itself.
        "The Four Horsemen of the Apocalypse": (
            backstage_abilities: [
                EndOfPrematch([
                    Choice([
                        [],
                        [HandToArsenalBottom(who: You, n: 1), Draw(who: You, n: 1)],
                        [HandToArsenalBottom(who: You, n: 2), Draw(who: You, n: 2)],
                        [HandToArsenalBottom(who: You, n: 3), Draw(who: You, n: 3)],
                        [HandToArsenalBottom(who: You, n: 4), Draw(who: You, n: 4)],
                    ]),
                ]),
            ],
            backstage_ability: Some((requires: Some(After(All([Maneuver, DamageAtLeast(8)]))), effects: [Dig(n: 4, take: 1)], sacrifice: true)),
        ),
        // Cannot be blanked, the No Sell Maneuver and win-replacement texts are not supported yet.
        "Sister Abigail's Black Sheep": (
            while_in_ring: [
                (
                    applies_to: All([Maneuver, Holds(All([ReversedLastTurn(Any), FirstCardThisTurn]))]),
                    fortitude: -1,
                    count: Some(YourRingStun),
                ),
            ],
        ),
        "Braun's Lariat": (
            bonuses: [(fortitude: -6)],
            not_reversed_by: Some(DamageAtLeast(1)),
            reverses: Some((targets: EarlierThisTurn(filter: Any, n: 2))),
        ),
        // Approximation: the Counter's reversal is not checked for being non-Unique.
        "Braun's Big Beal Toss": (
            reversal_limits: [(from: [Hand, Backlash], by: Some(Not(Trait(Unique))), when: All([ReversedLastTurn(Any), FirstCardThisTurn]))],
            reverses: Some((targets: After(Trait(SetUp)))),
        ),
        "Strowman's Strong Strike to the Chest": (
            bonuses: [(fortitude: -5)],
            multi_when: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            reverses: Some((targets: AnyOf([ManeuverType(Strike), ManeuverType(Grapple)]), from_hand_only: true)),
            ringside_on_opponent_reverses: [
                If(
                    condition: OpponentReversed(Title("Strowman's Strong Strike to the Chest")),
                    effects: [RingsideToHand(who: You, n: 1, up_to: true)],
                ),
            ],
        ),
        "The Strowman Slam": (
            ringside_on_opponent_reverses: [
                If(condition: OpponentReversed(Title("The Strowman Slam")), effects: [DrawUpTo(who: You, n: 2)]),
            ],
        ),
        // Approximation: it wins whenever it is not reversed (also from hand).
        "Strowman's Squeeze": (after_damage: [WinByPin]),
        // The Ring text is not supported yet.
        "The Abominable Strowman": (reverses: Some((targets: Maneuver, effects: [DrawUpTo(who: You, n: 2)]))),
        // The -#F for Braun Strowman is not supported yet.
        "The New Face of Destruction": (
            reverses: Some((
                targets: AnyOf([Not(Maneuver), All([Maneuver, Not(Trait(Unique))])]),
                damage: None,
                from_hand_only: true,
            )),
        ),
        // The Ring text is not supported yet.
        "I Am Stronger": (
            bonuses: [(fortitude: -4)],
            on_play: [DrawUpTo(who: You, n: 3), Discard(who: Opponent, n: 2, pick: Random)],
            reverses: Some((targets: Not(SuperstarSpecific))),
        ),

        // Drew McIntyre
        // The McMahon, F: 1 / D: 1 and International House of Hits texts are not supported yet.
        "The Chosen One": (),
        "The Sinister Scotsman": (
            end_of_prematch: [
                Discard(who: Opponent, n: 1, pick: Random),
                Optional([HandToArsenalTop(who: You, n: 1), Search(filter: All([Not(Trait(Unique)), FortitudeAtLeast(1), FortitudeAtMost(1)]))]),
            ],
            // The Fortitude Rating bonus per D: 1 card is not supported yet.
        ),
        // Approximation: only Unique reversals can reverse it after a maneuver or Set-up card or as a Counter (not
        // the cards that reverse a maneuver played after Irish Whip or a Set-up card).
        "Drew's Tilt-a-Whirl Backbreaker": (
            bonuses: [(fortitude: -10)],
            reversal_limits: [(by: Some(Not(Trait(Unique))), when: AnyOf([After(AnyOf([Maneuver, Trait(SetUp)])), All([ReversedLastTurn(Any), FirstCardThisTurn])]))],
            reverses: Some((targets: All([Maneuver, After(Trait(SetUp))]), damage: Fixed(10))),
        ),
        // Exchanging cards under it and the opponent's text are not supported yet.
        "I Dream Broken Dreams": (
            not_reversed_by: Some(Not(SuperstarSpecific)),
            on_play: [Mill(who: You, n: 1), PutUnder(from: Hand, n: 1)],
        ),
        // The Ringside text is not supported yet.
        "McIntyre's Arm Bar": (
            bonuses: [(when: CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 5), fortitude: -1)],
        ),
        "The Chosen Clothesline": (
            play_after: Some(All([Maneuver, DamageAtLeast(3)])),
            play_after_unless: Some(All([FortitudeBelowOpponent, ReversedLastTurn(Maneuver), FirstCardThisTurn])),
        ),
        "Drew's Big Boot": (
            bonuses: [(fortitude: -1, damage: 7)],
            reversal_limits: [(from: [Hand], by: Some(Not(Trait(Unique))), when: FortitudeBelowOpponent)],
            reverses: Some((
                targets: ManeuverType(Strike),
                effects: [
                    DrawUpTo(who: You, n: 1),
                    HandToArsenalBottom(who: Opponent, n: 1),
                    Mill(who: Opponent, n: 4),
                ],
            )),
        ),
        "Drew's Double-Knee Arm Breaker": (
            on_play: [Discard(who: Opponent, n: 1, pick: Random), Search(filter: All([Maneuver, TitleContains("arm")]), up_to: true)],
        ),
        // Not playing it again this turn and the Chain text are not supported yet.
        "All Your Dreams Are Just Illusion": (
            on_play: [ShuffleThisIntoArsenal, RingsideToArsenal(who: You, n: 1, up_to: true), DrawUpTo(who: You, n: 1)],
            reverses: Some((targets: Not(Maneuver), fortitude: Some(6), effects: [Discard(who: Opponent, n: 1, pick: Random)])),
        ),

        // Jinder Mahal
        // Rewriting Drawing a Blank, the Camel Clutch / Full Nelson Slam and Ability texts are not supported yet.
        "The Maharaja of Metal": (),
        // Counting as We're a 3 Man Band! and putting cards under it are not supported yet.
        "The Maharaja's Protective Turban Case": (),
        // Putting it under the Turban Case is not supported yet.
        "The Man Who Comes In Peace": (
            reverses: Some((
                targets: All([Maneuver, Not(ManeuverType(TrademarkFinisher))]),
                effects: [
                    DrawUpTo(who: You, n: 2),
                    Boost((applies_to: All([Maneuver, Not(Trait(Unique)), DamageAtMost(6)]), duration: NextTurnFirstCard, no_hand_reversal: true)),
                ],
            )),
        ),
        "Punjab Knee Drops": (
            play_after: Some(Maneuver),
            play_after_unless: Some(All([Not(PlayedFromRingside), ReversedLastTurn(Any), FirstCardThisTurn])),
            on_play: [Discard(who: Opponent, n: 2, pick: Random)],
        ),
        "Punjab Spine Buster": (
            bonuses: [(when: Not(PlayedFromRingside), fortitude: -10)],
            reverses: Some((targets: AnyOf([ManeuverType(Grapple), ManeuverType(Submission)]), from_hand_only: true)),
        ),
        // The blank-text and greater-Fortitude texts are not supported yet.
        "Mahal's Knee Strike": (bonuses: [(when: Not(PlayedFromRingside), fortitude: -15)]),
        "Maharaja Full Nelson Slam": (
            bonuses: [(when: Not(PlayedFromRingside), fortitude: -15)],
            on_play: [Discard(who: Opponent, n: 2, pick: Random)],
            reverses: Some((targets: ManeuverType(Strike), effects: [Discard(who: Opponent, n: 2, pick: Random)])),
        ),
        // Playing it from the Ringside pile is not supported yet.
        "Don't Hinder Jinder": (reverses: Some((targets: All([Maneuver, Not(SuperstarSpecific)]), from_hand_only: true))),
        "The Punjabi Nightmare": (
            reversal_limits: [(from: [Hand], when: YouAre("Jinder Mahal"))],
            bonuses: [(fortitude: -6)],
            on_play: [
                RingsideToArsenal(who: You, n: 4, up_to: true),
                Optional([RemoveFromGame(who: You, from: Hand, n: 1), MoveCards(who: You, from: Removed, to: Hand, n: 1)]),
            ],
            reverses: Some((targets: All([Maneuver, Not(Trait(Unique))]))),
        ),

        // Bayley
        // Approximation: the cards under it are under your Superstar card; the flip-and-Promo only happens during your
        // turn.
        "Bayley's Headband": (
            backstage_abilities: [
                OnPlayMatching(
                    filter: AnyOf([Maneuver, Keyword("NXT")]),
                    effects: [
                        If(
                            condition: CountAtLeast(count: Minus(YourRingSize, YourFaceDown), n: 2),
                            effects: [Optional([FlipDown(who: You, n: 1), Dig(n: 2, take: 1)])],
                        ),
                    ],
                ),
                OnOpponentPlayMatching(
                    filter: All([Not(Reversal), DamageAtLeast(1)]),
                    effects: [Optional([PutUnder(from: Ring, n: 1, up_to: true, filter: Some(FaceDown), superstar: true)])],
                ),
            ],
            backstage_ability: Some((
                requires: Some(CountAtLeast(count: YourUnderSuperstar, n: 1)),
                cost: [TakeFromUnder(to: Ringside, n: 1, superstar: true)],
                effects: [LookAtHand(who: Opponent), MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Controller, bottom: true)],
            )),
        ),
        // It works with face-down cards and Bayley's Headband, which are not supported yet.
        "Turn It Up and Give Me Some More": (),
        // The protection texts and the ACE (which needs the hand comparison) are partly scripted.
        "Wacky Waving Inflatable Arm-Flailing Tubemen!": (
            pre_match_limit: 2,
            ring_ability: Some((
                requires: Some(AnyOf([FortitudeBelowOpponent, OpponentHandLarger])),
                cost: [HandToArsenalBottom(who: You, n: 2)],
                effects: [DrawUpTo(who: You, n: 4)],
                sacrifice: true,
            )),
        ),
        // Approximation: you shuffle up to 3 chosen cards and he shuffles up to 3 chosen by you; he draws 2 fewer.
        // The unsuccessful text is not supported yet.
        "Do You Want a Hug?": (
            on_play: [
                RevealHand(who: Opponent),
                Mulligan(n: 3),
                LookAtHand(who: Opponent),
                Choice([
                    [],
                    [MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 1, pick: Controller)],
                    [MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 2, pick: Controller)],
                    [MoveCards(who: Opponent, from: Hand, to: Arsenal, n: 3, pick: Controller), Draw(who: Opponent, n: 1)],
                ]),
            ],
        ),
        // Ignoring 'completely' is not supported yet.
        "Bayley's Sliding Clothesline": (
            bonuses: [(when: CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 10), fortitude: -5)],
        ),
        // Bayley's Headband is not supported yet.
        "Bayley's Flying Back Elbow": (
            play_after: Some(Maneuver),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
        ),
        "Bayley's Exploder Suplex": (
            reversal_limits: [(from: [Hand, Ringside, Ring, Under])],
            reverses: Some((
                targets: AnyOf([ManeuverType(Strike), ManeuverType(Assault), ManeuverType(Extreme)]),
                effects: [RingsideToArsenal(who: You, n: 2, up_to: true)],
            )),
        ),
        // Approximation: the cards under Bayley's Headband are the cards under your Superstar card.
        "Bayleycanrana": (
            play_after: Some(Maneuver),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            bonuses: [(fortitude: -4), (count: Some(YourUnderSuperstar), fortitude: -2)],
            irreversible: true,
            on_play: [
                Counted(
                    count: Plus(Const(4), Plus(YourUnderSuperstar, YourUnderSuperstar)),
                    effect: MoveCards(who: You, from: Ringside, to: Arsenal, n: 4, up_to: true, bottom: true),
                ),
            ],
        ),
        // Counting as a High Risk for From the Top Rope is not supported yet.
        "Bayley-to-Belly Hugplex": (
            reversal_limits: [(from: [Hand, Ringside, Ring, Under], when: After(AnyOf([Title("From the Top Rope"), TitleContains("hug")])))],
        ),
        // Approximation: he discards 3 random cards (the choice to discard 2 reversals is not supported yet).
        "I'm a Hugger": (reverses: Some((targets: Maneuver, effects: [Discard(who: Opponent, n: 3, pick: Random)]))),
        "There Ain't No Stoppin' Us Now": (
            on_play: [
                Search(filter: TitleContains("plex"), up_to: true),
                Boost((applies_to: Any, duration: NextCard, irreversible: true)),
            ],
            reverses: Some((
                targets: All([Not(Trait(Unique)), Not(Maneuver)]),
                effects: [
                    HandToArsenalBottom(who: You, n: 1),
                    Boost((applies_to: Any, duration: NextTurnFirstCard, irreversible: true)),
                ],
            )),
        ),

        // Natalya
        // Counting your maneuvers as Chain, the Chain discount and the Pin-Up Strong texts are not supported yet.
        "Nattie by Nature": (),
        // The Heat text is not supported yet.
        "Backed by Tyson Kidd": (
            on_opponent_reverses: [
                If(
                    condition: OpponentReversed(Maneuver),
                    effects: [Optional([Search(filter: All([Not(Trait(Unique)), Maneuver]), up_to: true)])],
                ),
            ],
        ),
        "Natalya's German Suplex": (reversal_limits: [(by: Some(Hybrid), when: All([ReversedLastTurn(Any), FirstCardThisTurn]))]),
        // Approximation: it is printed Multi, so it always needs 2 reversals.
        "Natalya's Abdominal Stretch": (
            bonuses: [(when: CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 5), fortitude: -8)],
        ),
        // Choosing Multi or Chain and the Pin-Up Strong text are not supported yet.
        "The Pin-Up Strong Hold": (),
        // Becoming a Trademark Finisher is not supported yet.
        "Natalya's Discus Clothesline": (
            bonuses: [(fortitude: -10)],
            chain_when: Some(Always),
            reverses: Some((
                targets: AnyOf([Trait(Chain), Keyword("Heat"), Trait(Multi), Keyword("Volley")]),
            )),
        ),
        // The Maintain Hold text and the ACE are not supported yet.
        "Natalya's Sharpshooter": (chain_when: Some(Always)),
        // Approximation: the draw is "draw up to 1".
        "The Era of The Pretty Little Diva is Over!": (
            while_in_ring: [(applies_to: Maneuver, fortitude: -4, damage: 2)],
            in_ring_on_play: [(whose: Some(You), filter: Maneuver, effects: [DrawUpTo(who: You, n: 1)])],
        ),
        // The Ring text is not supported yet.
        "Inspired by The Anvil": (
            on_play: [Choice([[DrawUpTo(who: You, n: 3)], [Search(filter: All([SuperstarSpecific, Maneuver]), up_to: true)]])],
        ),

        // Gallows and Anderson
        "Omen in the Sky": (
            backstage_ability: Some((requires: Some(HandAtLeast(1)), effects: [PutUnder(from: Hand, n: 1)])),
            // Playing maneuvers from under it and hiding it are not supported yet.
        ),
        // Approximation: the 2 cards go on the bottom of your Arsenal after the reversal (up to 2 if you have fewer).
        // The Pre-match text and the 2 overturned cards against a Superstar-specific card are not supported yet.
        "We Came to Conquer and Divide": (ring_reverses_ace: Some((effects: [HandToArsenalBottom(who: You, n: 2)]))),
        // Putting the maneuver back in his hand as not played is not supported yet.
        "More Than What You Bargained For": (
            reverses: Some((
                targets: Maneuver,
                effects: [RingsideToHand(who: Opponent, n: 2, up_to: true)],
            )),
        ),
        // The Ability text is not supported yet.
        "Rocket Kick": (bonuses: [(when: CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 5), fortitude: -5)]),
        // Approximation: the Omen in the Sky choice is not supported; you put cards from the Ringside into your hand.
        "Machine Gun Spinebuster": (
            bonuses: [(fortitude: -15)],
            on_play: [RingsideToHand(who: You, n: 2, up_to: true)],
            reverses: Some((
                targets: ManeuverType(Submission),
                effects: [Mill(who: You, n: 2), RingsideToHand(who: You, n: 1, up_to: true)],
            )),
        ),
        // The Ring text is not supported yet.
        "Boot of Doom": (
            on_play: [
                Counted(count: YourRingMatching(Maneuver), effect: RingsideToArsenal(who: You, n: 0, up_to: true)),
                Counted(count: YourRingMatching(Maneuver), effect: Mill(who: Opponent, n: 0)),
            ],
            as_action: Some((
                fortitude: Some(5),
                on_play: [
                    ThisToArsenal(bottom: true),
                    MoveCards(who: You, from: Ringside, to: Arsenal, n: 2, up_to: true, bottom: true),
                    RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Maneuver, Not(Hybrid)]))),
                ],
            )),
        ),
        // Becoming a Trademark Finisher and the Superstar-specific overturn are not supported yet.
        "Gallows Pole": (bonuses: [(fortitude: -10, damage: 10)], reverses: Some((targets: Not(Maneuver)))),
        "Magic Killer": (
            bonuses: [(fortitude: -10)],
            reversal_limits: [(from: [Hand, Arsenal], by: Some(Not(Trait(Unique))), when: After(Maneuver))],
            reverses: Some((targets: ManeuverType(Grapple))),
        ),
        // Approximation: doubled when you are a Tag Team. The John Cena text and the hand / Ringside text are not
        // supported yet.
        "Beat Up by The Club": (
            reverses: Some((
                targets: All([Maneuver, Not(SuperstarSpecific)]),
                effects: [
                    If(
                        condition: Not(YouAre("Tag Team")),
                        effects: [Discard(who: Opponent, n: 1, pick: Random), RingsideToArsenal(who: You, n: 2, up_to: true)],
                    ),
                    If(
                        condition: YouAre("Tag Team"),
                        effects: [Discard(who: Opponent, n: 2, pick: Random), RingsideToArsenal(who: You, n: 4, up_to: true)],
                    ),
                ],
            )),
        ),
        // Playing it from under Omen in the Sky is not supported yet. Approximation: the top card goes to your hand
        // or the bottom of the Arsenal (Dig of 1).
        "No One Is Safe": (
            on_play: [
                ShuffleThisIntoArsenal,
                RingsideToArsenal(who: You, n: 1, up_to: true, filter: Some(Not(Reversal))),
                MoveCards(who: You, from: Removed, to: Arsenal, n: 1, up_to: true, filter: Some(Not(Reversal))),
                Optional([Dig(n: 1, take: 1)]),
            ],
        ),
        // The single-reversal limit and the Arsenal cost are not supported yet.
        "The Club Stands Together": (),
    },
)
