        "Revolution Backed By The Nest": (mid_match_limit: 2, end_of_prematch: [Mill(who: You, n: 3)]),
        // The Momentum option on the first turn is not supported yet.
        "Revolution Slumped in the Corner": (
            on_play: [
                RingsideToHand(who: You, n: 1, up_to: true),
                MoveCards(who: You, from: Ringside, to: Arsenal, n: 5, up_to: true, bottom: true),
            ],
        ),
        // The overturn when the reversed card had no 'bulldog' or 'lariat' in the title is not supported yet.
        "Revolution Raven's Bulldog Lariat": (bonuses: [(fortitude: -10)]),
        // The Backlash reversal limit is not supported yet.
        "Revolution Evenflow DDT": (bonuses: [(fortitude: -5)]),
        // Putting the reversed card into his Ring is not supported yet.
        "Revolution Quote the Raven: 'Nevermore'": (),

        // Tazz
        "Revolution The FTW Title Belt": (
            end_of_prematch: [
                Search(filter: AnyOf([TitleContains("plex"), TitleContains("choke")]), n: 2, up_to: true),
                Discard(who: Opponent, n: 1, pick: Chosen),
            ],
        ),
        "Revolution Beat Me If You Can...": (
            momentum_when: Some(CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 10)),
            on_play: [
                Boost((applies_to: Maneuver, duration: NextMatching, momentum: true)),
                Boost((applies_to: All([Maneuver, AnyOf([TitleContains("plex"), TitleContains("choke")])]), duration: NextMatching, fortitude: -13)),
            ],
        ),
        "Revolution Tazz-Line": (
            on_play: [DrawUpTo(who: You, n: 1)],
            ringside_ability: Some((effects: [ThisToArsenal(bottom: true), DrawUpTo(who: You, n: 1)])),
        ),
        "Revolution Katahajime": (bonuses: [(damage: 10)], momentum_when: Some(FortitudeLeadAtLeast(13))),
        "Revolution Survive If I Let You": (
            requires: Some(InYourRing(Title("Revolution Beat Me If You Can..."))),
            on_play: [RingsideToArsenal(who: You, n: 13, up_to: true, filter: Some(Maneuver))],
        ),

        // Rhyno
        // The -1F per Rhyno card is not supported yet.
        "Revolution The Manbeast": (
            end_of_prematch: [
                Choice([
                    [Draw(who: You, n: 1)],
                    [Discard(who: You, n: 1, pick: Chosen), Draw(who: You, n: 2)],
                    [Discard(who: You, n: 2, pick: Chosen), Draw(who: You, n: 3)],
                ]),
            ],
        ),
        "Revolution Rhyno's Flurry of Punches": (
            bonuses: [(per: Some(AnyOf([ManeuverType(Assault), ManeuverType(Extreme)])), fortitude: -1, damage: 1)],
        ),
        "Revolution Manbeast Suplex": (
            bonuses: [(fortitude: -7)],
            on_play: [Search(filter: AnyOf([ManeuverType(Assault), ManeuverType(Extreme), Keyword("Foreign Object")]), up_to: true)],
        ),
        "Revolution Rhyno's Spike Piledriver": (on_play: [Discard(who: Opponent, n: 3, pick: Chosen)]),
        "Revolution The Gore!": (bonuses: [(fortitude: -10)], momentum_when: Some(After(AnyOf([SuperstarSpecific, Trait(Colossal)])))),

        // Tajiri
        // The Arsenal reversal text is not supported yet.
        "Revolution Backed by The Sinister Minister": (
            end_of_prematch: [
                Search(filter: All([Not(Trait(Unique)), Maneuver, TitleContains("kick")]), up_to: true),
                MoveCards(who: You, from: Arsenal, to: Ringside, n: 1, up_to: true, filter: Some(All([Not(Trait(Unique)), Maneuver, TitleContains("kick")]))),
            ],
        ),
        // The 'Reversal: Card' text is not supported yet.
        "Revolution Tarantula": (bonuses: [(fortitude: -4)], momentum_when: Some(After(Trait(FollowUp)))),
        // The -15D after moving it from your Ring is not supported yet (it never moves back from the Ring).
        "Revolution Buzzsaw Kick": (),
        // Going to the Ring when reversing from the Arsenal is not supported yet.
        "Revolution Tajiri's Asian Mist": (),
        // Ending the opponent's turn after a Core dealt its damage is not supported yet.
        "Revolution Japanese Buzzsaw": (
            bonuses: [(fortitude: -7)],
            on_play: [RingsideToArsenal(who: You, n: 2, up_to: true, filter: Some(AnyOf([Target("chest"), Target("head")])))],
            reverses: Some((targets: All([Maneuver, AnyOf([Target("chest"), Target("back")])]))),
        ),

        // Dudley Boyz
        // The Set the Table texts are not supported yet.
        "Revolution Get the Table!": (),
        // The reversal limit after a maneuver is not supported yet.
        "Revolution Wazzzzzup!!": (
            on_play: [DrawUpTo(who: You, n: 2), Discard(who: You, n: 1, pick: Chosen), Discard(who: Opponent, n: 2, pick: Chosen)],
        ),
        // Becoming a Colossal is not supported yet.
        "Revolution Buh Buh Bomb": (
            bonuses: [(when: After(TitleContains("table")), damage: 10)],
            on_play: [RingsideToHand(who: You, n: 1, up_to: true)],
        ),
        "Revolution 3D": (
            bonuses: [(fortitude: -10)],
            momentum_when: Some(AnyOf([After(Trait(Colossal)), All([ReversedLastTurn(Trait(Colossal)), FirstCardThisTurn])])),
        ),
        "Revolution Testify!": (
            on_play: [
                RingsideToHand(who: You, n: 1, up_to: true, filter: Some(Maneuver)),
                RingsideToArsenal(who: You, n: 3, up_to: true),
                Optional([Draw(who: Opponent, n: 1), RingsideToArsenal(who: You, n: 3, up_to: true)]),
            ],
        ),

        // bWo
        // The overturn and "antic or action" texts are not supported yet.
        "Revolution We're Taking Over!": (
            end_of_prematch: [Search(filter: Antic, up_to: true)],
            storyline: [
                OnPlayMatching(
                    filter: All([Antic, Not(EarlierThisTurn(filter: Antic, n: 1))]),
                    effects: [MoveCards(who: You, from: Ring, to: Arsenal, n: 1, up_to: true, filter: Some(Not(Trait(Unique))), bottom: true)],
                ),
                CannotPackMatching(TitleContains("In My Corner")),
            ],
        ),
        "Revolution Meanie Elbow Drop": (
            on_play: [RingsideToArsenal(who: You, n: 4, up_to: true, filter: Some(All([Antic, Not(Hybrid)])))],
        ),
        "Revolution Stevie Bomb": (on_play: [Counted(count: AtMost(YourRingMatching(Antic), 5), effect: Mill(who: Opponent, n: 0))]),
        "Revolution Dance, Meanie, Dance!": (
            on_play: [
                Counted(
                    count: AtMost(Plus(YourRingMatching(Antic), OpponentRingMatching(Antic)), 10),
                    effect: RingsideToArsenal(who: You, n: 0, up_to: true),
                ),
            ],
        ),
        "Revolution Novamania Runs Wild On You!": (on_play: [Boost((applies_to: Maneuver, duration: NextCards(2), momentum: true))]),

        // Other Superstars' cards
        // The extra -10F as an antic when you have lower Fortitude is not supported yet.
        "Revolution The Rock's Sharpshooter": (
            bonuses: [(when: FortitudeBelowOpponent, fortitude: -10)],
            on_play: [
                Choice([
                    [],
                    [HandToArsenalBottom(who: You, n: 1), RingsideToHand(who: You, n: 1)],
                    [HandToArsenalBottom(who: You, n: 2), RingsideToHand(who: You, n: 2)],
                ]),
            ],
            as_action: Some((fortitude: Some(10), on_play: [ShuffleThisIntoArsenal, RingsideToArsenal(who: You, n: 2, up_to: true)])),
        ),
        "Revolution Suplex City": (
            requires: Some(Not(InYourRing(TitleContains("In My Corner")))),
            momentum_when: Some(CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 5)),
            from_ringside: Some(CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 5)),
            on_play: [
                RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Not(Reversal), TitleContains("suplex")]))),
                ThisToArsenal(bottom: true),
            ],
        ),
        // Ending the opponent's turn is not supported yet.
        "Revolution The Highlight Reel": (pre_match_limit: 1),
        // The Ring texts are not supported yet.
        "Revolution Aid From the King's Court": (
            reverses: Some((targets: Maneuver, fortitude_when: Some((CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 5), 0)))),
        ),
        // Approximation: any Superstar-specific card (Sheamus-specific).
        "Revolution The Celtic Warrior": (
            pre_match_limit: 1,
            in_ring_on_play: [(whose: Some(You), filter: AnyOf([ManeuverType(Assault), SuperstarSpecific]), effects: [DrawUpTo(who: You, n: 1)])],
        ),
        // The non-Unique reversal limit and naming a Target are not supported yet.
        "Revolution The YES! Movement": (
            on_play: [
                RingsideToHand(who: You, n: 1, up_to: true),
                MoveCards(who: You, from: Ringside, to: Arsenal, n: 3, up_to: true, bottom: true),
            ],
            reverses: Some((
                targets: Trait(Momentum),
                fortitude_when: Some((AnyOf([FortitudeBelowOpponent, OpponentHandLarger]), 0)),
                effects: [
                    RingsideToHand(who: You, n: 1, up_to: true),
                    MoveCards(who: You, from: Ringside, to: Arsenal, n: 3, up_to: true, bottom: true),
                ],
            )),
        ),
        "Revolution Ziggler's Famous-er": (
            bonuses: [(when: All([ReversedLastTurn(Any), FirstCardThisTurn]), fortitude: -5, damage: 5)],
            on_play: [RingsideToHand(who: You, n: 1, up_to: true)],
        ),
        // The text is cut off after the Ring ability's cost; only the search and the Capacity are scripted.
        "Revolution That's What I Do!": (
            mid_match_limit: 1,
            on_play: [Search(filter: All([Not(Reversal), SuperstarSpecific]), up_to: true)],
        ),
        // Making a reversed maneuver successful is not supported yet.
        "Revolution We, The People!": (on_play: [DrawUpTo(who: You, n: 4)]),
        "Revolution Carlito's Mean Streak": (
            on_play: [
                Counted(count: Plus(Const(3), OpponentRingsideMatching(Trait(MidMatch))), effect: RingsideToArsenal(who: You, n: 0, up_to: true)),
                DrawUpTo(who: You, n: 2),
                NextPlayWatch(filter: Any, on_reversed: [RingsideToHand(who: You, n: 1, up_to: true)]),
            ],
        ),
        // Going to the Ring from the Arsenal and the Air Kofi text are not supported yet.
        "Revolution The Dreadlocked Dynamo": (
            reverses: Some((
                targets: AnyOf([Trait(Core), Trait(Mean)]),
                effects: [
                    Choice([
                        [Draw(who: You, n: 2)],
                        [HandToArsenalBottom(who: You, n: 1), Draw(who: You, n: 3)],
                        [HandToArsenalBottom(who: You, n: 2), Draw(who: You, n: 4)],
                        [HandToArsenalBottom(who: You, n: 3), Draw(who: You, n: 5)],
                    ]),
                ],
            )),
        ),
        "Revolution The Milan Miracle": (
            requires: Some(All([HandAtLeast(5), Not(InYourRing(TitleContains("In My Corner")))])),
            from_ringside: Some(Always),
            on_play: [
                HandToArsenal(who: You, n: 4),
                MoveCards(who: You, from: Ring, to: Arsenal, n: 1, up_to: true, filter: Some(Not(Trait(Unique)))),
                RingsideToArsenal(who: You, n: 6, up_to: true),
                DrawUpTo(who: You, n: 7),
                Boost((applies_to: Any, duration: NextCard, momentum: true)),
            ],
        ),
        // The Arsenal limit for non-Unique cards is not supported yet.
        "Revolution Van Terminator": (not_reversed_by: Some(Hybrid)),
        "Revolution Big Johnny": (
            on_play: [
                RingsideToArsenal(who: You, n: 3, up_to: true),
                Boost((applies_to: Any, duration: NextCard, fortitude: -4, no_backlash_reversal: true)),
                Search(filter: Any, up_to: true),
            ],
            reverses: Some((
                targets: AnyOf([ManeuverType(Hold), Trait(Mean)]),
                effects: [Discard(who: Opponent, n: 1, pick: Random), Search(filter: Any, up_to: true)],
            )),
        ),
    },
)
