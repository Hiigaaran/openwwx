// Hand-written scripts for VR5: Battleground (Raw Deal Virtual) cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// Every title starts with "Revolution ": text naming a card means the Revolution card.
// "Overturn N cards" with no player named is the player of the card (Mill on You).
// "Counter" = you reversed a card to end your opponent's last turn and this is your first card this turn.
// "Requirement: Tag Team" = you are a Tag Team (Superstar trait). "A maneuver with 'Requirement: Tag Team'" is one
// of the nine Tag Team maneuvers of this set (Double / Tandem / Spike Piledriver).
// Factions: only Superstars with a logo on them can pack them (the engine's logo rule), so the "when your logo is
// on this card" parts always apply. "You can pack this card regardless of Superstar" is not supported yet.
// "You are a Powerhouse": Revolution Cesaro, Revolution Ryback, or Revolution WWE's Powerhouses in your Ring.
// "When you are a Revolution Superstar" is treated as always true. "You cannot pack Corners" is approximated as
// cards with "In My Corner" in the title. Pre-match / Mid-match Capacity +N is `pre_match_limit` / `mid_match_limit`.
// "Ignore the Follow-up" is `ignore_play_after`. "-#F" with a # the engine cannot count is approximated (said so).
(
    abilities: {
        "Revolution The Shield": [
            Activated(
                cost: [Mill(who: You, n: 3)],
                effects: [
                    RingsideToHand(
                        who: You,
                        n: 1,
                        up_to: true,
                        filter: Some(AnyOf([
                            Title("Revolution Double Shoulder Block"),
                            Title("Revolution Double Hip Toss"),
                            Title("Revolution Double Wrist Lock"),
                            Title("Revolution Double Clothesline"),
                            Title("Revolution Tandem Suplex"),
                            Title("Revolution Tandem Face Stretch"),
                            Title("Revolution Double Elbow Drop"),
                            Title("Revolution Double Superkick"),
                            Title("Revolution Spike Piledriver"),
                        ])),
                    ),
                ],
            ),
            CannotPackMatching(TitleContains("In My Corner")),
        ],
        // Approximation: after any reversal you make (not only complete reversals of maneuvers), and the searched
        // maneuver's damage is not compared.
        "Revolution The Wyatt Family": [
            OnYouReverse([
                Choice([
                    [DrawUpTo(who: You, n: 1)],
                    [Optional([Search(filter: All([Not(Trait(Unique)), Not(Hybrid), Maneuver]), up_to: true)])],
                ]),
            ]),
            CannotPackMatching(TitleContains("In My Corner")),
        ],
        // The Fortitude and damage changes counted per card in your Ring are not supported yet.
        "Revolution Cesaro": [],
        "Revolution Ryback": [
            Activated(
                cost: [
                    HandToArsenalBottom(who: You, n: 1),
                    MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, filter: Some(Not(Reversal)), bottom: true),
                ],
                effects: [
                    If(
                        condition: InYourRing(Not(TitleContains("Revolution"))),
                        effects: [Boost((applies_to: Trait(Colossal), duration: NextMatching, fortitude: -3))],
                    ),
                    If(
                        condition: Not(InYourRing(Not(TitleContains("Revolution")))),
                        effects: [Boost((applies_to: Trait(Colossal), duration: NextMatching, fortitude: -6))],
                    ),
                ],
                requires: Some(HandAtLeast(1)),
            ),
            CannotPackMatching(TitleContains("In My Corner")),
        ],
        // Approximation: you arrange the top 7 cards (none go to the bottom), then overturn 1. The Inverted
        // Jackhammer text is not supported yet.
        "Revolution Goldberg": [
            StartOfTurn([Optional([Arrange(who: You, n: 7), Mill(who: You, n: 1)])]),
            CannotPackMatching(TitleContains("In My Corner")),
        ],
        // Packing Matt Facts is not supported yet.
        "Revolution Matt Hardy": [
            Activated(cost: [Mill(who: You, n: 2)], effects: [Draw(who: You, n: 1)], requires: Some(OpponentHandLarger)),
            Activated(cost: [Mill(who: You, n: 3)], effects: [Draw(who: You, n: 1)]),
        ],
        // "Once during each of your turns" is the first antic you play each turn.
        "Revolution Hulk Hogan": [
            OnPlayMatching(
                filter: All([Antic, Not(EarlierThisTurn(filter: Antic, n: 1))]),
                effects: [
                    Choice([
                        [Search(filter: All([Not(Trait(Unique)), Trait(Core)]), up_to: true)],
                        [
                            Discard(who: You, n: 2, pick: Chosen),
                            RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Not(Trait(Unique)), Trait(Colossal)]))),
                        ],
                    ]),
                ],
            ),
            CannotPackMatching(ManeuverType(Extreme)),
            CannotPackMatching(TitleContains("In My Corner")),
        ],
        // Approximation: "non-action Backlash cards" are Mid-match cards. The We Face Each Other text is not
        // supported yet; the Obey text is on Revolution Obey.
        "Revolution Andre The Giant": [
            Activated(
                cost: [DiscardMatching(who: You, n: 2, filter: Trait(MidMatch), pick: Chosen)],
                effects: [Boost((applies_to: All([Not(Trait(Unique)), Maneuver]), duration: NextMatching, fortitude: -8))],
                requires: Some(CountAtLeast(count: YourHandMatching(Trait(MidMatch)), n: 2)),
            ),
            CannotPackMatching(TitleContains("In My Corner")),
            CannotPackMatching(ManeuverType(Extreme)),
            CannotPackMatching(ManeuverType(HighRisk)),
            CannotPack("Frankie Takes Ho-llywood"),
        ],
        // The Multi text is not supported yet.
        "Revolution The Ultimate Warrior": [
            Activated(
                cost: [Discard(who: You, n: 2, pick: Chosen)],
                effects: [RingToHand(who: You, n: 1, filter: All([Not(Trait(Unique)), Not(Hybrid), Maneuver]), up_to: true)],
                requires: Some(HandAtLeast(2)),
            ),
            CannotPackMatching(TitleContains("In My Corner")),
            CannotPackMatching(ManeuverType(Extreme)),
        ],
        "Revolution Rowdy Roddy Piper": [
            OnPlayMatching(
                filter: AnyOf([TitleContains("classic"), TitleContains("sleeper"), TitleContains("drop")]),
                effects: [RingsideToHand(who: You, n: 1, up_to: true, filter: Some(Not(Reversal)))],
            ),
            OnPlayMatching(
                filter: Antic,
                effects: [
                    RingsideToHand(
                        who: You,
                        n: 1,
                        up_to: true,
                        filter: Some(AnyOf([TitleContains("classic"), TitleContains("sleeper"), TitleContains("drop")])),
                    ),
                ],
            ),
        ],
        // Discarding from the Backlash instead is not supported yet. Approximation: every Triple H and Shawn
        // Michaels card may be packed (not only Arsenal maneuvers).
        "Revolution DX": [
            PacksLogos(["Triple H", "Shawn Michaels"]),
            CannotPack("Revolution Smacked with the Sledgehammer"),
            CannotPackMatching(TitleContains("In My Corner")),
        ],
        // Overturning instead of discarding is not supported yet. Approximation: every Kane and Undertaker card may
        // be packed (not only maneuvers).
        "Revolution Brothers Of Destruction": [
            PacksLogos(["Kane", "Undertaker"]),
            CannotPackMatching(TitleContains("In My Corner")),
        ],
        // Approximation: every Jeff Hardy and Matt Hardy card may be packed (not only maneuvers).
        "Revolution Hardy Boyz": [
            OnOpponentReverses([
                If(
                    condition: OpponentReversed(Not(EarlierThisTurn(filter: Any, n: 1))),
                    effects: [
                        Optional([
                            Mill(who: You, n: 3),
                            ContinueTurn,
                            NextCardMustBe(Trait(FollowUp)),
                            Boost((applies_to: Any, duration: NextCard, ignore_play_after: true, end_turn: true)),
                        ]),
                    ],
                ),
            ]),
            PacksLogos(["Jeff Hardy", "Matt Hardy"]),
            CannotPackMatching(TitleContains("In My Corner")),
        ],
        // Ignoring the Follow-up / Requirement for a discard is not supported yet. Approximation: every Chris Jericho
        // and Big Show card may be packed.
        "Revolution JeriShow": [
            PacksLogos(["Chris Jericho", "Big Show"]),
            CannotPackMatching(TitleContains("In My Corner")),
        ],
        // "Once during each of your turns" is the first such card you play each turn.
        "Revolution Raven": [
            OnPlayMatching(
                filter: All([
                    AnyOf([ManeuverType(Extreme), ManeuverType(Throw), Keyword("Foreign Object"), ManeuverType(Grapple)]),
                    Not(EarlierThisTurn(
                        filter: AnyOf([ManeuverType(Extreme), ManeuverType(Throw), Keyword("Foreign Object"), ManeuverType(Grapple)]),
                        n: 1,
                    )),
                ]),
                effects: [Optional([RingsideToHand(who: You, n: 1), Mill(who: You, n: 3)])],
            ),
        ],
        // Hybrid reversals dealing no damage is not supported yet.
        "Revolution Tazz": [
            CannotBeReversedBy(
                played: All([AnyOf([TitleContains("plex"), TitleContains("choke")]), Holds(FortitudeBelowOpponent)]),
                reversal: Hybrid,
            ),
            DamageFor(
                filter: All([AnyOf([TitleContains("plex"), TitleContains("choke")]), Holds(InYourRing(Not(TitleContains("Revolution"))))]),
                delta: 3,
            ),
            CannotPackMatching(TitleContains("In My Corner")),
        ],
        // The Fortitude and damage changes counted per Extreme / Assault are not supported yet.
        "Revolution Rhyno": [],
        // The cards in your Ring are not supported yet (only the Ringside pile).
        "Revolution Tajiri": [
            Activated(
                cost: [],
                effects: [
                    RingsideToHand(
                        who: You,
                        n: 1,
                        up_to: true,
                        filter: Some(All([Not(Trait(Multi)), Not(Reversal), TitleContains("kick")])),
                    ),
                ],
            ),
        ],
        "Revolution Dudley Boyz": [
            Activated(
                cost: [],
                effects: [
                    Search(
                        filter: All([Not(Trait(Unique)), Not(Hybrid), AnyOf([ManeuverType(Throw), ManeuverType(Extreme)])]),
                        up_to: true,
                    ),
                    Mill(who: You, n: 3),
                ],
            ),
            CannotPackMatching(TitleContains("In My Corner")),
        ],
        // "Once during each of your turns" is the first antic you play each turn. Packing Stevie Richards cards
        // from other formats is not supported.
        "Revolution bWo": [
            OnPlayMatching(
                filter: All([Antic, Not(EarlierThisTurn(filter: Antic, n: 1))]),
                effects: [MoveCards(who: You, from: Ring, to: Arsenal, n: 1, up_to: true, filter: Some(Not(Trait(Unique))), bottom: true)],
            ),
            CannotPackMatching(TitleContains("In My Corner")),
        ],
    },
    scripts: {
        // Tag Team maneuvers
        "Revolution Double Shoulder Block": (
            requires: Some(YouAre("Tag Team")),
            on_play: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, pick: Random, bottom: true)],
        ),
        "Revolution Double Hip Toss": (requires: Some(YouAre("Tag Team")), on_play: [Mill(who: Opponent, n: 1)]),
        "Revolution Double Wrist Lock": (
            requires: Some(YouAre("Tag Team")),
            on_play: [Optional([HandToArsenalBottom(who: You, n: 1), Draw(who: You, n: 1)])],
        ),
        "Revolution Double Clothesline": (
            requires: Some(YouAre("Tag Team")),
            on_play: [DrawUpTo(who: You, n: 2), HandToArsenalBottom(who: You, n: 1)],
        ),
        "Revolution Tandem Suplex": (
            requires: Some(YouAre("Tag Team")),
            on_play: [OpponentChooses(n: 1, options: [[Discard(who: Opponent, n: 1, pick: Chosen)], [Mill(who: Opponent, n: 3)]])],
        ),
        "Revolution Tandem Face Stretch": (
            requires: Some(YouAre("Tag Team")),
            on_play: [RingsideToArsenal(who: You, n: 2, up_to: true, filter: Some(Maneuver))],
        ),
        "Revolution Double Elbow Drop": (
            requires: Some(YouAre("Tag Team")),
            on_play: [Draw(who: You, n: 1)],
            ringside_ability: Some((requires: Some(HandAtLeast(3)), cost: [Discard(who: You, n: 3, pick: Chosen)], effects: [ReturnThis(to: Hand)])),
        ),
        // Becoming a Trademark is not supported yet.
        "Revolution Double Superkick": (
            requires: Some(YouAre("Tag Team")),
            on_play: [
                If(
                    condition: CountAtLeast(
                        count: YourRingMatching(AnyOf([
                            Title("Revolution Double Shoulder Block"),
                            Title("Revolution Double Hip Toss"),
                            Title("Revolution Double Wrist Lock"),
                            Title("Revolution Double Clothesline"),
                            Title("Revolution Tandem Suplex"),
                            Title("Revolution Tandem Face Stretch"),
                            Title("Revolution Double Elbow Drop"),
                            Title("Revolution Spike Piledriver"),
                        ])),
                        n: 5,
                    ),
                    effects: [DrawUpTo(who: You, n: 2), Discard(who: Opponent, n: 2, pick: Chosen)],
                ),
                If(
                    condition: CountAtMost(
                        count: YourRingMatching(AnyOf([
                            Title("Revolution Double Shoulder Block"),
                            Title("Revolution Double Hip Toss"),
                            Title("Revolution Double Wrist Lock"),
                            Title("Revolution Double Clothesline"),
                            Title("Revolution Tandem Suplex"),
                            Title("Revolution Tandem Face Stretch"),
                            Title("Revolution Double Elbow Drop"),
                            Title("Revolution Spike Piledriver"),
                        ])),
                        n: 4,
                    ),
                    effects: [DrawUpTo(who: You, n: 1), Discard(who: Opponent, n: 1, pick: Chosen)],
                ),
            ],
        ),
        "Revolution Spike Piledriver": (
            requires: Some(YouAre("Tag Team")),
            on_play: [Discard(who: Opponent, n: 4, pick: Chosen), Mill(who: Opponent, n: 2)],
        ),

        // Antics and Reversals
        "Revolution It's No Big Deal": (
            on_play: [Search(filter: All([Not(SuperstarSpecific), Trait(Unique)]), up_to: true)],
            reverses: Some((
                targets: AnyOf([
                    All([Trait(Unique), Trait(Core)]),
                    All([
                        Not(Trait(Unique)),
                        SuperstarSpecific,
                        Maneuver,
                        Holds(OpponentRingHas(filter: Not(TitleContains("Revolution")), n: 1)),
                    ]),
                ]),
                fortitude: Some(5),
                fortitude_when: Some((InYourRing(Title("Revolution Good Luck With That!")), 0)),
            )),
        ),
        // Approximation: "Overturn 1 card" is the opponent overturning 1 card; the extra cards for Mean / Colossal
        // are not supported yet.
        "Revolution Luck Is On MY Side!": (
            reverses: Some((
                targets: ManeuverType(Trademark),
                requires: Some(InYourRing(Title("Revolution Good Luck With That!"))),
                effects: [Mill(who: Opponent, n: 1)],
                reversed_to_arsenal: true,
            )),
        ),
        // Approximation: # is 15 (the maximum).
        "Revolution Making a Legendary Comeback": (
            reverses: Some((
                targets: AnyOf([Trait(Mean), Trait(Colossal)]),
                requires: Some(YouAre("Legend")),
                fortitude: Some(5),
                effects: [
                    RingsideToArsenal(who: You, n: 3, up_to: true, filter: Some(All([Maneuver, Not(Hybrid)]))),
                    DrawUpTo(who: You, n: 1),
                ],
            )),
        ),
        "Revolution Ryback Rules": (
            play_after_unless: Some(CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 5)),
            momentum_when: Some(CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 5)),
            // Approximation: -8F (the whole printed F) when you have 5+ lower Fortitude.
            bonuses: [(when: CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 5), fortitude: -8)],
            on_play: [Boost((applies_to: Any, duration: NextCard, momentum: true)), DrawUpTo(who: You, n: 2)],
            reverses: Some((targets: All([Not(Trait(Unique)), Antic]), effects: [DrawUpTo(who: You, n: 2)])),
        ),

        // Pre-match
        // The Ringside texts are not supported yet.
        "Revolution A Ruckus At Ringside": (
            pre_match_limit: 1,
            end_of_prematch: [Optional([BuryHand(who: You, then: Draw), Draw(who: You, n: 1)])],
        ),
        "Revolution Defiance of Authority": (
            not_with: ["Revolution Theodore Long is In My Corner!"],
            reverses_from_ring: Some((
                targets: Trait(Momentum),
                damage: None,
                requires: Some(CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 5)),
                effects: [Mill(who: You, n: 3)],
            )),
        ),
        // Blank-text cards and blanking cards are not supported yet.
        "Revolution Filling in the Blanks": (),
        // Continuing the turn after an Arsenal reversal is not supported yet.
        "Revolution Setting Him Up": (pre_match_limit: 1),
        // The F: 0 Outmaneuver / You Telegraphed It and the same-title Pre-match rule are not supported yet.
        "Revolution Royal Rumble": (pre_match_limit: 1),
        // The F: 0 Outmaneuver / You Telegraphed It and blanking cards are not supported yet.
        "Revolution Wrestlemania": (pre_match_limit: 1),
        // The F: 0 Outmaneuver / You Telegraphed It and blanking cards are not supported yet.
        "Revolution SummerSlam": (pre_match_limit: 1),
        // The F: 0 Outmaneuver / You Telegraphed It and blanking cards are not supported yet.
        "Revolution Survivor Series": (pre_match_limit: 1),

        // Incredible High Flyers
        // Rewriting Follow-ups, the overturn reduction and being an Extremist are not supported yet.
        "Revolution Incredible High Flyers": (pre_match_limit: 1),
        // Going to the Backlash when reversed is not supported yet.
        "Revolution Flying Forearm": (
            requires: Some(InYourRing(Title("Revolution Incredible High Flyers"))),
            mid_match_limit: 1,
            on_play: [RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Trait(FollowUp), Not(SameTitleInRing)])))],
        ),
        // The Trademark text is not supported yet.
        "Revolution Just Too Quick": (
            reverses: Some((
                targets: All([Trait(Colossal), Not(Trait(MidMatch))]),
                requires: Some(InYourRing(Title("Revolution Incredible High Flyers"))),
                effects: [DrawUpTo(who: You, n: 2)],
            )),
        ),
        "Revolution Extreme Determination": (
            requires: Some(InYourRing(Title("Revolution Incredible High Flyers"))),
            on_play: [RingsideToHand(who: You, n: 1, up_to: true, filter: Some(Not(Trait(Unique))))],
            ring_ability: Some((requires: Some(HandAtLeast(1)), cost: [Discard(who: You, n: 1, pick: Chosen)], effects: [DrawUpTo(who: You, n: 1)])),
        ),
        "Revolution X-Treme Initiative": (
            requires: Some(InYourRing(Title("Revolution Incredible High Flyers"))),
            on_play: [
                RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Trait(FollowUp), Not(SameTitleInRing)]))),
                DrawUpTo(who: You, n: 1),
                Boost((applies_to: Trait(FollowUp), duration: NextCard, damage: 3, ignore_play_after: true)),
                If(condition: FortitudeBelowOpponent, effects: [Boost((applies_to: Trait(FollowUp), duration: NextCard, momentum: true))]),
            ],
        ),
        "Revolution Architect of Innovative Offense": (
            requires: Some(InYourRing(Title("Revolution Incredible High Flyers"))),
            on_play: [
                RingsideToHand(who: You, n: 2, up_to: true),
                MoveCards(who: You, from: Ringside, to: Arsenal, n: 2, up_to: true, bottom: true),
            ],
            in_ring_on_play: [
                (whose: Some(You), filter: All([Maneuver, Trait(FollowUp), Not(SameTitleInRing)]), effects: [Discard(who: Opponent, n: 1, pick: Chosen)]),
            ],
        ),

        // WWE's Extremely Charismatic Wrestlers
        // Ignoring the Requirement on Overexposure is not supported yet.
        "Revolution WWE's Extremely Charismatic Wrestlers": (pre_match_limit: 1),
        // Reducing the opponent's draws is not supported yet.
        "Revolution Extremely Popular With The Peeps!": (
            requires: Some(InYourRing(Title("Revolution WWE's Extremely Charismatic Wrestlers"))),
            from_ringside: Some(Always),
            on_play: [RemoveFromRing(who: Opponent, n: 1, filter: All([Not(SuperstarSpecific), DamageAtMost(4)])), EndTurn],
        ),
        // Becoming a Trademark is not supported yet.
        "Revolution Extreme Show of Power": (
            requires: Some(InYourRing(Title("Revolution WWE's Extremely Charismatic Wrestlers"))),
            on_play: [
                Counted(
                    count: YourRingMatching(AnyOf([Trait(FollowUp), TitleContains("extreme")])),
                    effect: MoveCards(who: You, from: Ringside, to: Arsenal, n: 0, up_to: true, bottom: true),
                ),
            ],
        ),
        "Revolution Extreme Push-Ups": (
            requires: Some(InYourRing(Title("Revolution WWE's Extremely Charismatic Wrestlers"))),
            on_play: [
                Choice([
                    [Draw(who: You, n: 2)],
                    [Discard(who: You, n: 1, pick: Chosen), Draw(who: You, n: 3)],
                    [Discard(who: You, n: 2, pick: Chosen), Draw(who: You, n: 4)],
                    [Discard(who: You, n: 3, pick: Chosen), Draw(who: You, n: 5)],
                ]),
                Boost((applies_to: All([ManeuverType(Extreme), Trait(FollowUp)]), duration: NextMatching, ignore_play_after: true)),
                NextPlayWatch(
                    filter: All([ManeuverType(Extreme), Trait(FollowUp)]),
                    on_success: [Search(filter: All([ManeuverType(Extreme), Trait(FollowUp)]), up_to: true)],
                ),
            ],
        ),
        "Revolution Extreme Wrestling Skill": (
            requires: Some(InYourRing(Title("Revolution WWE's Extremely Charismatic Wrestlers"))),
            on_play: [
                DrawUpTo(who: You, n: 1),
                Boost((applies_to: All([ManeuverType(Extreme), Trait(FollowUp)]), duration: NextCard, damage: 3, ignore_play_after: true)),
                Optional([Discard(who: You, n: 2, pick: Chosen), LookAtHand(who: Opponent), Discard(who: Opponent, n: 1, pick: Controller)]),
            ],
        ),
        "Revolution Extreme Naughtiness": (
            requires: Some(InYourRing(Title("Revolution WWE's Extremely Charismatic Wrestlers"))),
            on_play: [
                Discard(who: Opponent, n: 1, pick: Chosen),
                Mill(who: Opponent, n: 2),
                Search(
                    filter: AnyOf([All([ManeuverType(Extreme), Trait(FollowUp)]), ManeuverType(Assault), ManeuverType(Hold)]),
                    up_to: true,
                ),
                Boost((applies_to: Any, duration: NextCard, ignore_play_after: true)),
            ],
            reverses: Some((
                targets: AnyOf([ManeuverType(Assault), ManeuverType(Hold)]),
                requires: Some(InYourRing(Title("Revolution WWE's Extremely Charismatic Wrestlers"))),
            )),
        ),

        // WWE's Powerhouses
        "Revolution WWE's Powerhouses": (end_of_prematch: [DrawUpTo(who: You, n: 1), Arrange(who: You, n: 5)]),
        // Blanking and ending the turn from the Ring are not supported yet.
        "Revolution Powerful Resistance": (requires: Some(InYourRing(Title("Revolution WWE's Powerhouses"))), pre_match_limit: 1),
        "Revolution Powerful and Devastating": (
            requires: Some(InYourRing(Title("Revolution WWE's Powerhouses"))),
            momentum_when: Some(AnyOf([Superstar("Revolution Cesaro"), Superstar("Revolution Ryback"), InYourRing(Title("Revolution WWE's Powerhouses"))])),
            mid_match_limit: 1,
            on_play: [Search(filter: All([Not(Trait(Unique)), Not(Reversal), Maneuver]), n: 2, up_to: true)],
        ),
        // Approximation: the Unique search does not need the Counter.
        "Revolution Powerful Overhead Press": (
            requires: Some(InYourRing(Title("Revolution WWE's Powerhouses"))),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            on_play: [Discard(who: Opponent, n: 3, pick: Chosen), Search(filter: Trait(Unique), up_to: true)],
        ),
        "Revolution Powering Out": (
            reverses: Some((
                targets: Maneuver,
                requires: Some(InYourRing(Title("Revolution WWE's Powerhouses"))),
                effects: [
                    Choice([
                        [RingsideToArsenal(who: You, n: 5, up_to: true)],
                        [Boost((applies_to: All([Not(Trait(Unique)), Maneuver]), duration: NextTurnFirstCard, momentum: true))],
                    ]),
                ],
            )),
        ),
        "Revolution Flexing Powerful Muscles": (
            requires: Some(All([InYourRing(Title("Revolution WWE's Powerhouses")), HandAtLeast(3)])),
            on_play: [
                Discard(who: You, n: 2, pick: Random),
                Search(filter: All([Not(Trait(Unique)), Maneuver]), up_to: true),
                Search(filter: All([Not(Trait(Unique)), Antic]), up_to: true),
                Search(filter: All([Not(Trait(Unique)), Reversal]), up_to: true),
                Boost((applies_to: Any, duration: NextCard, fortitude: -5)),
            ],
        ),

        // The Shield
        "Revolution The Hounds of Justice": (
            end_of_prematch: [
                If(
                    condition: Superstar("Revolution The Shield"),
                    effects: [
                        Discard(who: You, n: 2, pick: Chosen),
                        MoveCards(who: You, from: Ringside, to: Arsenal, n: 2, up_to: true, bottom: true),
                        DrawUpTo(who: You, n: 3),
                        Discard(who: Opponent, n: 1, pick: Chosen),
                    ],
                ),
            ],
            while_in_ring: [
                (
                    applies_to: AnyOf([
