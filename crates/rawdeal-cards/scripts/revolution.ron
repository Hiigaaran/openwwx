        // Test
        "Revolution Test's TKO": (
            ringside_ability: Some((
                requires: Some(All([HandHas(ManeuverType(Assault)), HandHas(ManeuverType(Throw))])),
                cost: [
                    DiscardMatching(who: You, n: 1, filter: ManeuverType(Assault), pick: Chosen),
                    DiscardMatching(who: You, n: 1, filter: ManeuverType(Throw), pick: Chosen),
                ],
                effects: [ReturnThis(to: Hand)],
            )),
