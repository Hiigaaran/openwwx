        "Revolution Rey-Rey's Wheelbarrow Bulldog": (bonuses: [(fortitude: -10)]),
        "Revolution Think Nothing of It... But Love It": (
            reverses: Some((
                targets: AnyOf([Trait(Mean), Trait(Colossal)]),
                effects: [RingsideToArsenal(who: You, n: 11, up_to: true)],
            )),
        ),
        "Revolution Too Much Damage for One to Manage": (
            on_play: [Boost((applies_to: Maneuver, duration: NextCard, momentum: true))],
        ),
        // Approximation: "read as F:0" is -10F for your printed non-F:0 Cores.
        "Revolution From Cruiserweight to Heavyweight Champ": (
            on_play: [Draw(who: You, n: 1)],
            value_bonus: 2,
            storyline: [
                FortitudeFor(filter: All([Trait(Core), FortitudeAtLeast(1)]), delta: -10),
                OnPlayMatching(
                    filter: All([Trait(Core), FortitudeAtLeast(1)]),
                    effects: [RingsideToHand(who: You, n: 1, up_to: true, filter: Some(Trait(Core)))],
                ),
            ],
        ),
        "Revolution Do It For My People": (on_play: [Search(filter: Any, up_to: true)]),
        "Revolution Droppin' Da Dime": (
            on_play: [Discard(who: You, n: 10, pick: Chosen), Discard(who: Opponent, n: 10, pick: Chosen)],
        ),
        "Revolution Mysterio's West Coast Pop": (),

        // Triple H
        "Revolution The Triple H High Knee": (
            on_play: [MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, bottom: true)],
        ),
        "Revolution The Cerebral Sleeper": (on_play: [RemoveFromRing(who: Opponent, n: 2, filter: Any)]),
        "Revolution Smacked with the Sledgehammer": (on_play: [Search(filter: Any, up_to: true)]),
        "Revolution Behold the King": (on_play: [Mill(who: Opponent, n: 7), RingsideToHand(who: You, n: 3, up_to: true)]),
        "Revolution Bow Before the Throne": (
            reverses: Some((targets: ManeuverType(Hold), effects: [DrawUpTo(who: You, n: 2)])),
        ),
        // Reversing a Maneuver that has dealt 10 damage (the new Superstar Ability) is not supported yet.
        "Revolution Ten Time World Champion": (requires: Some(Never), value_bonus: 3),
        "Revolution Feel Your Fear": (
            on_play: [
                Counted(
                    count: YourRingsideMatching(Trait(Unique)),
                    effect: RingsideToArsenal(who: You, n: 0, up_to: true, filter: Some(Trait(Unique))),
                ),
            ],
        ),
        "Revolution The Game Spinebuster": (bonuses: [(fortitude: -15)]),
        "Revolution The King of Kings Pedigree": (on_play: [Discard(who: Opponent, n: 7, pick: Chosen)]),

        // CM Punk
        "Revolution Straight Edge": (
            reverses: Some((
                targets: AnyOf([Trait(Mean), Trait(Colossal)]),
                effects: [Mill(who: You, n: 1), RingsideToArsenal(who: You, n: 9, up_to: true)],
            )),
        ),

        // Sabu
        "Revolution Suicidal-Homicidal-Genocidal": (
            in_ring_start_of_turn: [
                MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, filter: Some(ManeuverType(Assault)), top: true),
            ],
        ),

        // Sandman
        // Approximation: the opponent's Superstar Value is counted at the start of each of your turns.
        "Revolution The Extreme Icon": (
            in_ring_start_of_turn: [
                Counted(
                    count: OpponentValueTimes(1),
                    effect: Boost((applies_to: Trait(Mean), duration: ThisTurn, fortitude: -1)),
                ),
