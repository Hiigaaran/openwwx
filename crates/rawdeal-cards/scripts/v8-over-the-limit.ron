// Hand-written scripts for V8: Over the Limit (Raw Deal Virtual set 38) cards, merged by the OCTGN importer.
// Keys are card titles. Only the parts of the text the engine can express are
// scripted; cards marked `requires: Some(Never)` cannot be played yet.
// "Counter" = you reversed a card to end your opponent's last turn and this is your first card this turn.
// "Promo: N" is approximated as `Dig`: you keep 1 of the top N cards and the rest go on the bottom of the Arsenal.
// "Bury" puts cards on the bottom of the Arsenal; "RFG" removes them from the game; "Recover" shuffles Ringside
// cards into the Arsenal.
// "Reversal: Special" cards: "Reverse any X" is the reversal target. Reversals played after a card was successfully
// played use `after_success`; reversals of card effects and of Activated Card Effects are not supported
// (`targets: Not(Any)`).
// ACE (Activated Card Effects) are ring abilities used during your own turn. Packing permissions printed on
// Superstar cards ("You can pack X") are not supported unless they are other Superstars' logos (`PacksLogos`).
// Playing cards face-down "as" another card, "cannot be blanked" and reversal limits that depend on the reversal's
// type (non-Unique, hybrid, D:0) are not supported. Multi / Chain granted by Superstar abilities or Backstage cards
// is a start-of-turn Boost for that turn (not in the opponent's turn).
// Pre-match Managers are approximated as cards with "Managed by" in the title, Corners as "In My Corner".
(
    abilities: {
        // Approximation: in your Draw Segment you may put 1 Ringside card into your hand instead of drawing (the
        // Superstar Value difference draw is not supported yet).
        "Dusty Rhodes": [
            DrawSegmentOption([RingsideToHand(who: You, n: 1, up_to: true)]),
            CannotPackMatching(All([AnyOf([TitleContains("Managed by"), TitleContains("In My Corner")]), Not(SuperstarSpecific)])),
        ],
        // Playing a Foreign Object with the first Classic maneuver, the Heel / Raw text and the No Sell Maneuver
        // permission are not supported yet.
        "Terry Funk": [
            CannotPack("There is No Escape"),
            CannotPack("Everything and the Kitchen Sink"),
            CannotPackMatching(All([TitleContains("Managed by"), Not(SuperstarSpecific)])),
        ],
        // Approximation: "once per turn" is your first maneuver each turn. He may pack every Jeff Hardy card.
        "The Charismatic Enigma": [
            PacksLogos(["Jeff Hardy"]),
            OnPlayMatching(
                filter: All([Maneuver, Not(EarlierThisTurn(filter: Maneuver, n: 1))]),
                effects: [
                    If(
                        condition: CountAtLeast(count: Minus(YourRingSize, YourFaceDown), n: 3),
                        effects: [Optional([FlipDown(who: You, n: 2), RingsideToHand(who: You, n: 1, up_to: true)])],
                    ),
                ],
            ),
        ],
        // Approximation: Backlash cards are Mid-match cards.
        "British Bulldog": [
            StartOfTurn([
                Boost((
                    applies_to: All([
                        ManeuverType(Grapple),
                        Not(Trait(Unique)),
                        Not(EarlierThisTurn(filter: All([ManeuverType(Grapple), Not(Trait(Unique))]), n: 2)),
                    ]),
                    duration: ThisTurn,
                    multi: true,
                )),
            ]),
            Activated(
                requires: Some(InYourRing(Trait(MidMatch))),
                cost: [RemoveFromGame(who: You, from: Ring, n: 1, filter: Some(Trait(MidMatch)))],
                effects: [RingsideToArsenal(who: You, n: 3, up_to: true, filter: Some(ManeuverType(Grapple)))],
            ),
        ],
        // Approximation: the 'reversed' exception is not supported; any unsuccessful maneuver counts, not only one
        // played from hand.
        "Ken Shamrock": [
            StartOfTurn([
                If(
                    condition: CountAtMost(count: YourArsenalSize, n: 30),
                    effects: [Boost((applies_to: Maneuver, duration: NextMatching, damage: 4, multi: true))],
                ),
            ]),
            OnOpponentReverses([
                If(
                    condition: OpponentReversed(Maneuver),
                    effects: [
                        Optional([
                            Mill(who: You, n: 3),
                            ReversedCardTo(to: Hand),
                            If(
                                condition: OpponentReversed(AnyOf([TitleContains("shoot"), TitleContains("Shamrock")])),
                                effects: [
                                    MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, up_to: true, filter: Some(Not(Reversal)), bottom: true),
                                ],
                            ),
                        ]),
                    ],
                ),
            ]),
        ],
        // The Mid-match slot, extra Pre-match cards and Raw / Run-in texts are not supported yet.
        "Val Venis": [
            OnOpponentReverses([
                If(
                    condition: All([
                        OpponentReversedFrom([Hand, Backlash]),
                        CountAtLeast(count: YourRingsideMatching(Title("Hello, Ladies!")), n: 1),
                    ]),
                    effects: [
                        Optional([
                            RemoveFromGame(who: You, from: Ringside, n: 1, filter: Some(Title("Hello, Ladies!"))),
                            ReversedCardTo(to: Hand),
                        ]),
                    ],
                ),
            ]),
            EndOfPrematch([
                MoveCards(who: You, from: Backlash, to: Ring, n: 1, up_to: true, filter: Some(Title("You'll Really Be Stunned"))),
            ]),
            CannotPackMatching(TitleContains("the hell")),
        ],
        // Continuing the turn after revealing a same-title card is not supported yet. Approximation: he may pack
        // every A-Train card.
        "Tensai": [PacksLogos(["A-Train"])],
        // The Pre-match Capacity and the packing permissions are not supported yet.
        "The Lionheart": [OnPlayMatching(filter: Keyword("WCW"), effects: [Mill(who: Opponent, n: 1)])],
        // Playing maneuvers from under other cards is not tracked yet; the Heel / Raw text is not supported.
        "Fandango": [],
        // The packing permissions are not supported yet.
        "Summer Rae": [
            OnOpponentReverses([
                If(
                    condition: OpponentReversed(All([Maneuver, TitleContains("precision")])),
                    effects: [Optional([ReversedCardTo(to: Arsenal, bottom: true)])],
                ),
            ]),
        ],
        // The WCW trait change, the hybrid Reversal text and the packing permissions are not supported yet.
        "Arn Anderson": [
            StartOfTurn([
                Boost((
                    applies_to: All([Maneuver, AnyOf([TitleContains("buster"), TitleContains("breaker"), TitleContains("knee")])]),
                    duration: NextMatching,
                    fortitude: -4,
                    damage: 4,
                )),
            ]),
        ],
        // Mirroring the opponent's Ringside-to-Arsenal moves, the By Any Means Necessary text, the packing
        // permissions and the Faction ban are not supported yet.
        "Nation of Domination": [CannotPackMatching(All([TitleContains("In My Corner"), Not(SuperstarSpecific)]))],
        // Face-down cards and packing Set-up cards in the Backstage Area are not supported yet.
        "The Hart Dynasty": [],
        // Approximation: he may pack every Hardy Boyz, Matt Hardy, Jeff Hardy and Lita card. The reversal
        // restriction and the blank Spin Cycle / Poetry In Motion texts are not supported yet.
        "Team X-Treme": [
            Activated(
                requires: Some(HandHas(ManeuverType(HighRisk))),
                cost: [DiscardMatching(who: You, n: 1, filter: ManeuverType(HighRisk), pick: Chosen)],
                effects: [RingsideToHand(who: You, n: 2, up_to: true, filter: Some(All([Maneuver, Not(Hybrid)])))],
            ),
            PacksLogos(["Hardy Boyz", "Matt Hardy", "Jeff Hardy", "Lita"]),
            CannotPack("There is No Escape"),
        ],
        // Approximation: only during your own turn, from hand. The packing permissions are not supported yet.
        "The Brood": [
            Activated(
                requires: Some(HandHas(All([Reversal, Not(Hybrid)]))),
                cost: [RemoveFromGame(who: You, from: Hand, n: 1, filter: Some(All([Reversal, Not(Hybrid)])))],
                effects: [Boost((applies_to: SuperstarSpecific, duration: NextMatching, fortitude: -6))],
            ),
            CannotPackMatching(All([TitleContains("In My Corner"), Not(SuperstarSpecific)])),
        ],
        // Counting maneuvers as Foreign Objects is not supported yet. Approximation: he may pack every Stevie
        // Richards card.
        "bWo": [
            PacksLogos(["Stevie Richards"]),
            CannotPack("Everything and the Kitchen Sink"),
            CannotPackMatching(All([TitleContains("In My Corner"), Not(SuperstarSpecific)])),
        ],
    },
    scripts: {
        // Strikes
        // "Reversed as if non-Unique" is not supported yet.
        "Classic Chop": (on_play: [Boost((applies_to: Maneuver, duration: NextMatching, fortitude: -4, damage: 4))]),

        // High Risk
        // "Reversed as if non-Unique" is not supported yet.
        "Classic Splash": (
            play_after: Some(All([Maneuver, DamageAtLeast(4)])),
            on_play: [Choice([[Discard(who: Opponent, n: 1, pick: Random)], [Discard(who: Opponent, n: 2, pick: Chosen)]])],
        ),

        // Actions
        // The packing rule and the action (blanking a Ring card) are not supported yet.
        "Revolutionizing the Division": (
            reverses: Some((
                targets: AnyOf([Trait(Unique), All([Not(Maneuver), Holds(YouAre("Diva"))])]),
                from_hand_only: true,
                on_reverse: [
                    Mill(who: Opponent, n: 3),
                    RingsideToHand(who: You, n: 1, up_to: true, filter: Some(All([Maneuver, Not(Hybrid)]))),
                ],
            )),
        ),
        // The blank text, the one-Reversal limit and the On One Arena / Tournament doubling are not supported yet.
        "Take One Second": (
            on_play: [
                Choice([
                    [Draw(who: You, n: 1)],
                    [MoveCards(who: You, from: Ringside, to: Arsenal, n: 1, pick: Random, bottom: true)],
                    [Discard(who: Opponent, n: 1, pick: Chosen)],
                ]),
            ],
        ),
        "DDP Yoga": (
            on_play: [
                If(
                    condition: Not(YouAre("DDP")),
                    effects: [
                        Mill(who: You, n: 2),
                        RingsideToHand(who: You, n: 1, up_to: true),
                        MoveCards(who: You, from: Removed, to: Arsenal, n: 1, up_to: true, bottom: true),
                    ],
                ),
                If(
                    condition: YouAre("DDP"),
                    effects: [
                        Mill(who: You, n: 6),
                        RingsideToHand(who: You, n: 3, up_to: true),
                        MoveCards(who: You, from: Removed, to: Arsenal, n: 3, up_to: true, bottom: true),
                    ],
                ),
            ],
        ),

        // Pre-match
        // The Superstar-specific, Stipulation and Luck of the Draw texts are not supported yet.
        "Too Dynamic To Hold Down": (pre_match_limit: 1),
        // Playing extra Pre-match cards regardless of effects is not supported yet.
        "This is MY Hometown!": (requires: Some(Never)),
        // Approximation: every D:4+ maneuver (not once per turn). The Pre-match Ringside lock and the hybrid reversal
        // text are not supported yet.
        "Dubuque, Iowa": (
            in_ring_on_play: [
                (whose: Some(You), filter: All([Maneuver, DamageAtLeast(4)]), effects: [RingsideToArsenal(who: You, n: 1, up_to: true)]),
            ],
            reverses_from_ring: Some((
                targets: AnyOf([Keyword("RMS"), TitleContains("shoot")]),
                requires: Some(FortitudeAtLeast(10)),
                removed_after: true,
                ignores_limits: true,
                effects: [RingsideToArsenal(who: You, n: 4, up_to: true)],
            )),
        ),
        // Putting it into the Ring from any area and its Pre-match effects are not supported yet.
        "Special Guest Referee": (requires: Some(Never)),

        // Mid-match
        // Playing it from the Backlash deck during the opponent's turn is not supported yet.
        "The Horsemen Have Something to Say About That": (requires: Some(Never), reverses: Some((targets: Not(Any)))),
        // The packing rule is not supported yet.
        "The Women's Evolution": (
            reverses_ace: Some((
                filter: Trait(Unique),
                effects: [
                    If(condition: OpponentHandLarger, effects: [DrawUpTo(who: You, n: 2)]),
                    If(condition: Not(OpponentHandLarger), effects: [DrawUpTo(who: You, n: 1)]),
                ],
            )),
            reverses: Some((
                targets: Trait(Unique),
                effects: [
                    If(condition: OpponentHandLarger, effects: [DrawUpTo(who: You, n: 2)]),
                    If(condition: Not(OpponentHandLarger), effects: [DrawUpTo(who: You, n: 1)]),
                ],
            )),
        ),

        // Backstage cards
        // Approximation: always hidden (revealing it later is not supported).
        "Cruiserweight-Style Action": (not_packed_by: ["Doink"], starts_hidden: true),
        "Nostalgia Shenanigans": (),
        // Approximation: "played as a Counter" is judged for every maneuver. The GM ban (not_packed_by with a trait
        // breaks auto decks), the Diva and hand-protection texts are not supported yet.
        "The Era of the Superstar": (
            only_packed_by: ["Female"],
            backstage_abilities: [
                FortitudeFor(filter: All([Maneuver, Holds(All([ReversedLastTurn(Any), FirstCardThisTurn]))]), delta: -2),
            ],
        ),

        // Dusty Rhodes
        // Approximation: Elbow Drop / Bionic Elbow cards are -15F instead of F: 0. The draw-count texts are not
        // supported yet.
        "The American Dream": (
            backstage_abilities: [
                DamageFor(filter: AnyOf([TitleContains("Elbow Drop"), TitleContains("Bionic Elbow")]), delta: 2),
                FortitudeFor(filter: AnyOf([TitleContains("Elbow Drop"), TitleContains("Bionic Elbow")]), delta: -15),
            ],
        ),
        // The non-Unique packing and hiding texts are not supported yet.
        "The Common Man": (
            not_with: ["Classic Competitor"],
            backstage_abilities: [DamageFor(filter: All([Maneuver, TitleContains("classic")]), delta: 2)],
        ),
        "Texas Bullrope Match": (
            in_ring_on_play: [
                (
                    whose: Some(Opponent),
                    filter: All([Not(Maneuver), Not(SuperstarSpecific)]),
                    effects: [Discard(who: You, n: 1, pick: Random)],
                    on_attempt: true,
                ),
                (whose: Some(You), filter: All([Not(Maneuver), Not(Trait(Unique))]), effects: [Discard(who: You, n: 1, pick: Chosen)], on_attempt: true),
            ],
        ),
        // Blanking the opponent's Managers and his Pre-match answer are not supported yet.
        "Managed by Sapphire": (
            pre_match_limit: 1,
            reverses_from_ring: Some((targets: All([Maneuver, Not(SuperstarSpecific)]), removed_after: true)),
        ),
        // Saving the game from a pinfall is not supported yet.
        "Dusty's Legendary Longevity": (requires: Some(Never)),
        "The Common Man Elbow Drop": (
            play_after: Some(All([Maneuver, DamageAtLeast(4)])),
            play_after_unless: Some(All([ReversedLastTurn(Maneuver), FirstCardThisTurn])),
            reversal_limits: [(from: [Backlash, Ringside, Ring, Under]), (from: [Hand], by: Some(Not(Trait(Unique))))],
        ),
        // The draw-count bonus and its reversal restriction are not supported yet.
        "Dusty's Figure Four Leglock": (on_play: [Optional([RingsideToHand(who: You, n: 1, filter: Some(Title("Maintain Hold")))])]),
        // The draw-count bonus and its reversal restriction are not supported yet.
        "American Dream Bionic Elbow": (),
        "The Son of a Plumber": (
            reverses: Some((targets: Maneuver, from_hand_only: true, on_reverse: [RingsideToArsenal(who: You, n: 4, up_to: true)])),
        ),
        // The Hell in a Cell and removal texts are not supported yet.
        "Common Man Boogie": (on_play: [ShuffleThisIntoArsenal, RingsideToArsenal(who: You, n: 2, up_to: true)]),
        // Approximation: only Ringside cards are moved and you draw up to 2.
        "Hard Times": (
            irreversible: true,
            on_play: [RingsideToArsenal(who: You, n: 10, up_to: true, filter: Some(TitleContains("classic"))), DrawUpTo(who: You, n: 2)],
        ),

        // Terry Funk
        // Only the Step Over Toe Hold damage is scripted.
        "The Hardcore Icon": (backstage_abilities: [DamageFor(filter: TitleContains("Step Over Toe Hold"), delta: 2)]),
        // Approximation: Terry Funk-specific cards are Superstar-specific cards. The Foreign Object and overturn
        // texts are not supported yet.
        "From The Double Cross Ranch": (hand_size_bonus: 2, frees_slots: Some(SuperstarSpecific)),
        "Rip Through You Like a Chainsaw": (
            reverses: Some((targets: AnyOf([Keyword("Foreign Object"), All([Maneuver, Not(SuperstarSpecific)])]))),
            while_in_ring: [
                (applies_to: All([Maneuver, AnyOf([Keyword("Foreign Object"), TitleContains("classic")])]), damage: 2, stun_value: 1),
                (applies_to: All([Action, Keyword("Foreign Object")]), chain: true),
            ],
        ),
        "Funkin Clothesline": (
            bonuses: [(when: CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 10), fortitude: -8)],
            reversal_limits: [(from: [Hand, Backlash, Ringside, Ring, Under], when: CountAtLeast(count: Minus(OpponentFortitude, YourFortitude), n: 10))],
            on_play: [DrawUpTo(who: You, n: 1)],
        ),
        "Funk's Hangman's Neck Breaker": (on_play: [RemoveFromGame(who: Opponent, from: Hand, n: 2, pick: Random)]),
        // Returning School of Hard Knocks is not supported yet.
        "Hit With Whatever's Available": (
            bonuses: [(when: InYourRing(Title("Funk U: School of Hard Knocks")), damage: 5)],
            reversal_limits: [
                (from: [Backlash], when: InYourRing(Title("Funk's Branding Iron"))),
                (by: Some(Hybrid), when: InYourRing(Title("Funk's Branding Iron"))),
            ],
            on_play: [
                Counted(
                    count: YourRingMatching(All([Maneuver, Not(Hybrid), DamageAtLeast(3)])),
                    effect: Discard(who: Opponent, n: 1, pick: Chosen),
                ),
            ],
        ),
        // D:30+ = 10+ Foreign Objects or 'classic' cards in your Ring (printed D: 20).
        "Funk's Pulling Piledriver": (
            bonuses: [(per: Some(AnyOf([Keyword("Foreign Object"), TitleContains("classic")])), damage: 1)],
            multi_when: Some(CountAtLeast(count: YourRingMatching(AnyOf([Keyword("Foreign Object"), TitleContains("classic")])), n: 10)),
            reversal_limits: [
                (from: [Arsenal], when: CountAtLeast(count: YourRingMatching(AnyOf([Keyword("Foreign Object"), TitleContains("classic")])), n: 10)),
            ],
            on_play: [Discard(who: Opponent, n: 3, pick: Chosen)],
        ),
        "Funk U: School of Hard Knocks": (
            reverses: Some((
                targets: Not(Trait(Unique)),
                effects: [
                    Choice([
                        [Counted(count: AtMost(YourRingMatching(All([Maneuver, TitleContains("classic")])), 5), effect: Draw(who: You, n: 1))],
                        [
                            Counted(
                                count: AtMost(YourRingMatching(All([Maneuver, TitleContains("classic")])), 5),
                                effect: RingsideToArsenalBottom(who: You, n: 1),
                            ),
                        ],
                    ]),
                ],
            )),
            while_in_ring_opponent: [(applies_to: Reversal, damage: -2)],
        ),
        "What Are You, Chicken?": (
            reverses: Some((targets: Not(Maneuver))),
            in_ring_on_play: [
                (whose: Some(Opponent), filter: All([Not(Maneuver), Not(EarlierThisTurn(filter: Any, n: 1))]), effects: [Mill(who: You, n: 2)]),
            ],
        ),
        // Approximation: as a reversal it reverses Poke and Shake only (reversal restrictions are not tracked). The
        // Chainsaw F: 0 text is not supported yet.
        "You Egg-Sucking Dog!": (
            on_play: [Discard(who: Opponent, n: 4, pick: Chosen), Mill(who: Opponent, n: 1)],
            reverses: Some((targets: AnyOf([Title("Poke"), Title("Shake")]), fortitude: Some(4), reversed_removed: true)),
        ),
        // Approximation: the reveal-and-shuffle works from the Ring and the Ringside pile, not from hand.
        "Funk's Branding Iron": (
            not_reversed_by: Some(Hybrid),
            on_play: [Discard(who: Opponent, n: 1, pick: Random)],
            ring_ability: Some((effects: [ReturnThis(to: Arsenal), DrawUpTo(who: You, n: 1)])),
            ringside_ability: Some((effects: [ReturnThis(to: Arsenal), DrawUpTo(who: You, n: 1)])),
        ),

        // The Charismatic Enigma / Jeff Hardy
        // Approximation: Events are Pre-match cards; Jeff Hardy-specific actions are Superstar-specific actions (Multi,
        // so they need 2 reversals). The High-Flying Style and Bury texts are not supported yet.
        "The X-Treme Enigma": (
            backstage_abilities: [
                NoSlotFor(All([SuperstarSpecific, Not(AnyOf([Maneuver, Action, Reversal, Antic]))])),
                StartOfTurn([Boost((applies_to: All([Action, SuperstarSpecific]), duration: ThisTurn, multi: true))]),
            ],
        ),
        // Approximation: any face-down card can be taken (printed reversals too). The From Daredevil to WWE Champion
        // texts are not supported yet.
        "X-Treme Face Paint": (
            backstage_ability: Some((
                requires: Some(CountAtLeast(count: YourFaceDown, n: 1)),
                cost: [Mill(who: You, n: 3)],
                effects: [MoveCards(who: You, from: Ring, to: Hand, n: 1, filter: Some(FaceDown))],
            )),
        ),
        // Face-down cards and the reversal restrictions are not supported yet.
        "From Daredevil to WWE Champion": (),
        "Jeff's Fall-Away Drop Kick": (
            reversal_limits: [(by: Some(DamageAtLeast(1)), when: FortitudeBelowOpponent)],
            play_after: Some(Any),
            play_after_unless: Some(All([ReversedLastTurn(Any), FirstCardThisTurn])),
            on_play: [
                If(condition: Superstar("The Charismatic Enigma"), effects: [RingsideToHand(who: You, n: 2, up_to: true)]),
                If(condition: Not(Superstar("The Charismatic Enigma")), effects: [RingsideToHand(who: You, n: 1, up_to: true)]),
            ],
        ),
        // Approximation: the "when reversed" choice only when reversed from hand.
        "Jeff's Jawbreaker": (
            bonuses: [(fortitude: -9)],
            on_reversed_from_hand: [Choice([[ReversedCardTo(to: Arsenal, bottom: true)], [DrawUpTo(who: You, n: 2)]])],
            as_action: Some((on_play: [ThisToArsenal(bottom: true), RingsideToHand(who: You, n: 1, up_to: true)])),
            reverses: Some((targets: ManeuverType(Grapple), requires: Some(Not(Superstar("Team X-Treme"))))),
        ),
        // Approximation: the cards shuffled from hand are chosen, not random. The non-Unique reversal restriction is
        // not supported yet.
        "Jeff's Twist of Fate": (
            not_packed_by: ["Team X-Treme"],
            on_play: [Boost((applies_to: SuperstarSpecific, duration: NextCard, ignore_play_after: true))],
            as_action: Some((
                fortitude: Some(10),
                on_play: [DiscardThis, HandToArsenal(who: You, n: 2), HandToArsenal(who: Opponent, n: 2), Draw(who: You, n: 3), Draw(who: Opponent, n: 1)],
            )),
            reverses: Some((
                targets: AnyOf([ManeuverType(Submission), Title("Clutch onto Opponent"), All([Not(Maneuver), Not(SuperstarSpecific)])]),
            )),
        ),
        // Approximation: the opponent chooses the card he buries. The Counter bonus is not supported yet.
        "No More Words": (
            reverses: Some((
                targets: Not(Maneuver),
                effects: [
                    DrawUpTo(who: You, n: 1),
                    HandToArsenalBottom(who: Opponent, n: 1),
                    CannotPlay(who: You, filter: Not(AnyOf([Maneuver, All([Action, Trait(SetUp)])])), turns: 1),
                ],
            )),
        ),
        "X-Treme Evasion": (
            reverses: Some((
                targets: AnyOf([
                    All([Maneuver, Not(Trait(Unique))]),
                    All([Maneuver, Not(ManeuverType(TrademarkFinisher)), Holds(OpponentSuperstar("The Charismatic Enigma"))]),
                ]),
                effects: [If(condition: Superstar("The Charismatic Enigma"), effects: [RingsideToHand(who: You, n: 1)])],
            )),
        ),
        // Approximation: the "when reversed" text applies only when it is reversed from hand.
        "The Rainbow-Haired Warrior": (
            on_reversed_from_hand: [Optional([FlipDown(who: You, n: 1), ReversedCardTo(to: Hand)])],
            on_play: [
                ShuffleThisIntoArsenal,
                RingsideToArsenal(who: You, n: 1, up_to: true, filter: Some(Reversal)),
                RingsideToArsenal(who: You, n: 1, up_to: true, filter: Some(Maneuver)),
                Draw(who: You, n: 1),
            ],
        ),

        // British Bulldog
        // Not supported yet.
        "The British Powerhouse": (),
        // Cannot be blanked or moved, and the 'Classic' and Venue texts are not supported yet.
        "The First European Champion": (
            while_in_ring: [
                (applies_to: Maneuver, fortitude: -1, count: Some(YourRingMatching(TitleContains("European")))),
                (applies_to: Maneuver, damage: 2, count: Some(YourRingMatching(All([TitleBelt, TitleContains("European")])))),
            ],
        ),
        "Bulldog's Classic Headlock Takedown": (
            bonuses: [(fortitude: -3, damage: 2)],
            on_play: [DrawUpTo(who: You, n: 1), Boost((applies_to: Maneuver, duration: NextCard, reversal_fortitude: 6))],
            as_action: Some((
                on_play: [
                    ThisToArsenal(bottom: true),
                    RingsideToArsenalBottom(who: You, n: 1),
                    DrawUpTo(who: You, n: 1),
                    Boost((applies_to: Maneuver, duration: NextCard, reversal_fortitude: 6)),
                ],
            )),
        ),
